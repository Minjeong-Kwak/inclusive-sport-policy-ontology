    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multilingual adaptation information for long-stay immigrants</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">제4차 외국인정책 기본계획</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">법무부</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">government_policy_document</isp:source_type>
    <isp:source_section rdf:datatype="http://www.w3.org/2001/XMLSchema#string">이민자 조기적응 프로그램</isp:source_section>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대한민국의 기초 법·제도, 사회적응 정보를 18개국 언어로 제공하여 장기체류하려는 이민자의 조기 적응을 지원한다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-18</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">물리적 거리 지원보다 정보 접근성 격차 완화 자원으로 보수적으로 매핑하였다.</isp:note>
    <isp:supports_target_group rdf:resource="#target_group__long_term_residence_aspiring_immigrants"/>
    <isp:is_utilized_by_program rdf:resource="#program__social_integration_program_for_immigrants"/>
    <isp:is_utilized_by_program rdf:resource="#program__early_adaptation_program_for_immigrants"/>
    <rdfs:label xml:lang="en">Multilingual adaptation information for long-stay immigrants</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Multilingual adaptation information for long-stay immigrants in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Multilingual adaptation information for long-stay immigrants</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">장기체류 이민자 다국어 적응정보 제공</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__long_term_residence_aspiring_immigrants"/>
  </rdf:Description>
