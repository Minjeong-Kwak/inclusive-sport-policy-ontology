    <rdf:type rdf:resource="#participation_continuity"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">족구 운동지속의도</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exercise adherence intention in foot volleyball</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">족구 동호인의 지속적 운동 참여 의도를 나타내는 참여 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">족구 동호인의 계획행동, 참여동기, 운동지속의도의 관계</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지각된 행동통제와 주관적 규범이 운동지속의도의 하위요인에 긍정적 영향을 미침.</isp:evidence_excerpt>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">확실하게 문헌 내용에서 확인 가능한 요소만 제한 반영함.</isp:note>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__foot_volleyball_exercise_adherence_intention</isp:entity_id>
    <rdfs:label xml:lang="en">Exercise adherence intention in foot volleyball</rdfs:label>
    <rdfs:comment xml:lang="ko">족구 동호인의 지속적 운동 참여 의도를 나타내는 참여 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Exercise adherence intention in foot volleyball</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">족구 운동지속의도</skos:prefLabel>
  </rdf:Description>
