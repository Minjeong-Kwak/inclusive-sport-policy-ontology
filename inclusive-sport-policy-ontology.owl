    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#delivery_setting_program"/>
    <rdfs:label xml:lang="en">Online Remote Program</rdfs:label>
    <rdfs:comment xml:lang="en">A program class representing online remote programs or interventions that support sport participation.</rdfs:comment>
    <skos:definition xml:lang="en">A program class representing online remote programs or interventions that support sport participation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="#sport_activity__scoliosis_schroth_stability_functional_training">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#therapeutic_exercise"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__scoliosis_schroth_stability_functional_training</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">척추측만 슈로스·안정화·기능훈련</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Schroth, stability, and functional training for scoliosis</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">척추측만 아동·청소년의 자세와 척추 만곡 개선을 위해 활용되는 치료적 운동 활동</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Effects Of Different Exercise Interventions On Scoliosis In Children And Adolescents: A Reticulated Meta-Analysis</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022 3rd Asia Sport Science Conference Abstracts</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conference_abstract</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">109-110</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The conference abstract reviewed randomized controlled studies on exercise interventions for scoliosis in children and adolescents. Twenty-two studies with 1,110 samples were included, and Schroth training, functional training, and stability training showed significant effects compared with no exercise, with Schroth plus hippotherapy, Schroth, stability, and functional training ranked as leading approaches.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <rdfs:label xml:lang="en">Schroth, stability, and functional training for scoliosis</rdfs:label>
    <rdfs:comment xml:lang="ko">척추측만 아동·청소년의 자세와 척추 만곡 개선을 위해 활용되는 치료적 운동 활동</rdfs:comment>
    <skos:prefLabel xml:lang="en">Schroth, stability, and functional training for scoliosis</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">척추측만 슈로스·안정화·기능훈련</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__general_student_sport_career_counseling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">일반학생 체육진로 상담 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport career counseling program for general students</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">일반학생의 체육분야 진로 흥미를 진단하고 체육 관련 직업세계 이해를 확장하는 상담·교육 프로그램.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">일반학생용 체육진로흥미검사지 version2 개발 및 타당도 검증</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육 분야 진로교육 및 상담 시 유용하게 활용될 수 있다고 제시되었다.</isp:evidence_excerpt>
    <isp:targets_target_group rdf:resource="#target_group__general_middle_high_school_students_sport_career"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__sport_career_interest_scale_v2"/>
    <isp:produces_outcome rdf:resource="#outcome__sport_career_interest_clarification"/>
    <isp:produces_outcome rdf:resource="#outcome__sport_occupation_understanding_expansion"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__general_student_sport_career_counseling</isp:entity_id>
    <rdfs:label xml:lang="en">sport career counseling program for general students</rdfs:label>
    <rdfs:comment xml:lang="ko">일반학생의 체육분야 진로 흥미를 진단하고 체육 관련 직업세계 이해를 확장하는 상담·교육 프로그램.</rdfs:comment>
    <skos:prefLabel xml:lang="en">sport career counseling program for general students</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">일반학생 체육진로 상담 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__general_middle_high_school_students_sport_career"/>
  </rdf:Description>
