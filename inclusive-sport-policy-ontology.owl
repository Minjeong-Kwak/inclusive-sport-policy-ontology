  <rdf:Description rdf:about="#target_group__elderly_women_osteopenia_bone_health_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#elderly"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__elderly_women_osteopenia_bone_health_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">골감소증 관리가 필요한 여성노인</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elderly women with osteopenia requiring bone health support</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Characteristics of nutrient intakes, basal physical fitness and serum markers in elderly women with osteopenia</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition &amp; Biochemistry</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">60~77세 여성노인을 골감소증군과 정상군으로 구분하여 분석함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">골감소증 위험과 골건강 관리가 필요한 여성노인 대상 집단임</isp:definition_text>
    <rdfs:label xml:lang="en">Elderly women with osteopenia requiring bone health support</rdfs:label>
    <rdfs:comment xml:lang="ko">골감소증 위험과 골건강 관리가 필요한 여성노인 대상 집단임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Elderly women with osteopenia requiring bone health support</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">골감소증 관리가 필요한 여성노인</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__curriculum_instruction_assessment_alignment">
