  <rdf:Description rdf:about="#outcome__menopausal_women_metabolic_risk_reduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__menopausal_women_metabolic_risk_reduction</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">폐경기 여성 대사건강 위험 감소</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reduced metabolic health risk among menopausal women</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">폐경기 여성의 복부비만, 혈당, 혈중지질, 염증 관련 대사건강 위험이 완화되는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">폐경기 여성의 악력과 신체활동에 따른 대사적 건강위험 및 식생활평가지수와의 관련성 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체활동량이 많을수록 허리둘레, 공복혈당, 당화혈색소, 중성지방, 총콜레스테롤, hs-CRP 수준이 낮았다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">reduced metabolic health risk among menopausal women</rdfs:label>
    <rdfs:comment xml:lang="ko">폐경기 여성의 복부비만, 혈당, 혈중지질, 염증 관련 대사건강 위험이 완화되는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">reduced metabolic health risk among menopausal women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">폐경기 여성 대사건강 위험 감소</skos:prefLabel>
  </rdf:Description>
