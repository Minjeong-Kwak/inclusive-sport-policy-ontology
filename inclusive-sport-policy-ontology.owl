    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cognitive outcome</rdfs:label>
    <rdfs:comment xml:lang="en">An outcome representing improved cognitive function, understanding, attention, or learning-related capacity.</rdfs:comment>
