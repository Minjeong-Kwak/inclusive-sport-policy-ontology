    <isp:produces_outcome rdf:resource="#outcome__sedentary_behavior_health_risk_awareness"/>
    <rdfs:label xml:lang="en">program  sedentary behavior reduction school pe program</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing program  sedentary behavior reduction school pe program in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">program  sedentary behavior reduction school pe program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">여자 청소년 좌식행동 감소 학교체육 프로그램</skos:prefLabel>
