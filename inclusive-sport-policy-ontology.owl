  <rdf:Description rdf:about="#program__adolescent_martial_arts_mental_health_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#youth_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__adolescent_martial_arts_mental_health_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년 무술훈련 정신건강 지원 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adolescent martial arts mental health support program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년의 정신건강 개선을 지원하기 위해 무술훈련 참여를 활용하는 청소년 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Empirical Analysis on the Relation between Martial Arts Training and Adolescent Mental Health</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">31-43</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adolescents who participated in martial arts training showed significantly lower depression, anxiety, and hostility than non-participants; training for more than 1.5 hours per session and over 3 years was associated with better mental health indicators.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <isp:targets_target_group rdf:resource="#target_group__adolescents_martial_arts_mental_health_support"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__adolescent_martial_arts_training"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__regular_long_term_martial_arts_training"/>
    <isp:produces_outcome rdf:resource="#outcome__adolescent_depression_anxiety_reduction_martial_arts"/>
    <isp:produces_outcome rdf:resource="#outcome__adolescent_interpersonal_relationship_improvement_martial_arts"/>
    <rdfs:label xml:lang="en">Adolescent martial arts mental health support program</rdfs:label>
    <rdfs:comment xml:lang="ko">청소년의 정신건강 개선을 지원하기 위해 무술훈련 참여를 활용하는 청소년 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Adolescent martial arts mental health support program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">청소년 무술훈련 정신건강 지원 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__adolescents_martial_arts_mental_health_support"/>
  </rdf:Description>
