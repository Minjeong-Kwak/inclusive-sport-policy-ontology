  <rdf:Description rdf:about="#outcome__elderly_muscle_strength_health_risk_monitoring">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_competence_improvement"/>
