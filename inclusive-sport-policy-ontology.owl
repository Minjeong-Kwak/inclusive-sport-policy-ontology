    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">독일 엘리트스포츠 시스템은 독일올림픽스포츠연맹, 연구소, 올림픽훈련센터, 스포츠학교, 카더 시스템, 연방경찰·군·세관 지원을 핵심 요소로 제시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">outcome  elite athlete support system professionalization</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing outcome  elite athlete support system professionalization in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">outcome  elite athlete support system professionalization</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">엘리트 선수 지원체계 전문화</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__state_self_confidence_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#self_efficacy_improvement"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">상태자신감 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">State self-confidence improvement</isp:pref_label_en>
