    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024년 장애인복지시설 사업안내 제Ⅲ권</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
