  <rdf:Description rdf:about="#outcome__elite_sport_joy_beauty_experience_recovery">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#well_being_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__elite_sport_joy_beauty_experience_recovery</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">전문체육 즐거움·아름다움 회복</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recovery of joy and beauty in elite sport</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">전문체육의 비정상의 정상화</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">전문체육에서 즐거움과 아름다움의 체험교육이 필요하다고 제시되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <rdfs:label xml:lang="en">Recovery of joy and beauty in elite sport</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Recovery of joy and beauty in elite sport in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Recovery of joy and beauty in elite sport</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">전문체육 즐거움·아름다움 회복</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#policy__global_anti_doping_movement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#sport_policy"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy__global_anti_doping_movement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">세계 스포츠 반도핑 운동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Global anti-doping movement in sport</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IOC와 WADA를 중심으로 형성된 세계 스포츠 반도핑 정책 흐름</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠현장: 세계 스포츠 반도핑(World Anti-Doping in Sports) 움직임</isp:source_title>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IOC 반도핑 역사와 WADA 설립 배경, 세계 반도핑 움직임을 설명함</isp:evidence_excerpt>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2002</isp:source_year>
    <isp:shapes_participation_context rdf:resource="#participation_context__international_anti_doping_policy_context"/>
    <isp:has_policy_outcome rdf:resource="#outcome__global_anti_doping_rule_awareness"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__world_anti_doping_movement_material"/>
    <rdfs:label xml:lang="en">Global anti-doping movement in sport</rdfs:label>
    <rdfs:comment xml:lang="ko">IOC와 WADA를 중심으로 형성된 세계 스포츠 반도핑 정책 흐름</rdfs:comment>
    <skos:prefLabel xml:lang="en">Global anti-doping movement in sport</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">세계 스포츠 반도핑 운동</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__balance_walking_pt_mental_health_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#mental_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__balance_walking_pt_mental_health_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">밸런스워킹PT 정신건강 개선</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mental health improvement through Balance Walking PT</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간 밸런스워킹PT 참여 후 정신 건강 변화의 일부 하위 영역에서 긍정적 변화가 확인된 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간 밸런스워킹PT 운동이 중년 여성의 신체적·정신적 건강에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중년기 여성 30명을 대상으로 12주간 주 2회, 온라인 1회와 오프라인 1회 방식의 밸런스워킹PT 운동을 적용하였다. 운동 프로그램은 제자리 걷기, 사방돌기 회전, 스트레칭, 균형, 점핑 등을 조합하였고, 건강 관련 체력, 신체적 특성, 혈중 지질 지표, 정신 건강에서 긍정적 변화를 보고하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_significant_partial</isp:evidence_strength_level>
    <isp:outcome_indicator_name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mental health subdomains</isp:outcome_indicator_name>
    <isp:measurement_timepoint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pre-post</isp:measurement_timepoint>
    <rdfs:label xml:lang="en">Mental health improvement through Balance Walking PT</rdfs:label>
    <rdfs:comment xml:lang="ko">12주간 밸런스워킹PT 참여 후 정신 건강 변화의 일부 하위 영역에서 긍정적 변화가 확인된 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Mental health improvement through Balance Walking PT</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">밸런스워킹PT 정신건강 개선</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#partnership_resource__local_sports_councils_2024">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#ngo_cso"/>
    <rdfs:label xml:lang="ko">시·군·구 체육회 2024</rdfs:label>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">시·군·구 체육회 2024</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Local sports councils 2024</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024 체육백서</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">문화체육관광부·국민체육진흥공단 한국스포츠과학원</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy white paper</isp:source_type>
    <isp:source_section rdf:datatype="http://www.w3.org/2001/XMLSchema#string">제1장 체육정책 및 조직</isp:source_section>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6</isp:source_page>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육단체별 예산 현황에 포함된 지역 체육단체</isp:note>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-18</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">partnership_resource__local_sports_councils_2024</isp:entity_id>
    <rdfs:comment xml:lang="en">Named individual representing Local sports councils 2024 in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Local sports councils 2024</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">시·군·구 체육회 2024</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__elderly_woman_knee_osteoarthritis_aquatic_exercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#elderly"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__elderly_woman_knee_osteoarthritis_aquatic_exercise</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">수중운동 참여 무릎 퇴행성관절염 여성노인</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elderly woman with knee osteoarthritis in aquatic exercise</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주 수중운동 프로그램 사례연구의 대상이 된 무릎 퇴행성관절염 여성노인</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간의 수중운동프로그램이 퇴행성 관절염 환자의 보행에 미치는 영향: 사례연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">무릎 퇴행성관절염을 가진 66세 여성 노인 1명이 12주간 주 3회, 회당 60분 수중운동 프로그램에 참여하였다. 프로그램 후 보행 능력과 무릎 안정성에 긍정적 변화가 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:applies_to_age_range rdf:datatype="http://www.w3.org/2001/XMLSchema#string">66</isp:applies_to_age_range>
    <isp:applies_to_gender rdf:datatype="http://www.w3.org/2001/XMLSchema#string">female</isp:applies_to_gender>
    <isp:applies_to_health_condition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">knee osteoarthritis</isp:applies_to_health_condition>
    <isp:target_participant_size rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</isp:target_participant_size>
    <rdfs:label xml:lang="en">Elderly woman with knee osteoarthritis in aquatic exercise</rdfs:label>
    <rdfs:comment xml:lang="ko">12주 수중운동 프로그램 사례연구의 대상이 된 무릎 퇴행성관절염 여성노인</rdfs:comment>
    <skos:prefLabel xml:lang="en">Elderly woman with knee osteoarthritis in aquatic exercise</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">수중운동 참여 무릎 퇴행성관절염 여성노인</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__park_jogging_space">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#community_space"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__park_jogging_space</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">공원 조깅 공간</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Park jogging space</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년의 조깅 경험과 웰빙 형성을 지원하는 지역사회 공원 공간 자원</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Empirical Phenomenological Study of Youths’ Experiences Jogging in Singapore Parks</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1-16</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Six youth joggers aged 17-19 discussed experiences of jogging in Singapore parks; park jogging elicited positive experiences, reduced negative thoughts and stress, promoted well-being, sense of belonging, personal growth, and academic performance.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <isp:supports_target_group rdf:resource="#target_group__singapore_youth_park_joggers"/>
    <isp:supports_sport_activity rdf:resource="#sport_activity__youth_park_jogging"/>
    <rdfs:label xml:lang="en">Park jogging space</rdfs:label>
    <rdfs:comment xml:lang="ko">청소년의 조깅 경험과 웰빙 형성을 지원하는 지역사회 공원 공간 자원</rdfs:comment>
    <skos:prefLabel xml:lang="en">Park jogging space</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">공원 조깅 공간</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__singapore_youth_park_joggers"/>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__low_income_vulnerable_community_adults">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#target_group"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__low_income_vulnerable_community_adults</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저소득 취약계층 지역사회 성인</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">low-income vulnerable community adults</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지역사회에서 운동프로그램 지원이 필요한 저소득 취약계층 성인 주민.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지역사회 저소득 취약계층 주민을 위한 1년간의 운동프로그램이 대사 및 심혈관 건강 위험요인에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저소득층 성인 주민 34명을 대상으로 12개월 운동증진 프로그램 효과를 분석하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">low-income vulnerable community adults</rdfs:label>
    <rdfs:comment xml:lang="ko">지역사회에서 운동프로그램 지원이 필요한 저소득 취약계층 성인 주민.</rdfs:comment>
    <skos:prefLabel xml:lang="en">low-income vulnerable community adults</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">저소득 취약계층 지역사회 성인</skos:prefLabel>
  </rdf:Description>
