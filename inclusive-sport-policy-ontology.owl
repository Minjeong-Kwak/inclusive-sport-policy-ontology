  <rdf:Description rdf:about="#support_resource__local_sports_cluster_school_pe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#partnership_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__local_sports_cluster_school_pe</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학교체육 지역 스포츠 클러스터</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Local sports cluster for school physical education</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">정과 수업과 정과외 체육활동의 연계를 지원하는 지역 스포츠 클러스터 자원</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2015 개정 체육과 교육과정에 대한 체육 교사 인식 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육교사 5명을 대상으로 심층면담을 실시하여 2015 개정 체육과 교육과정의 학교 현장 적용 인식을 분석하였다. 교사들은 지역 스포츠 클러스터를 활용한 정과·정과외 수업 연계, 체육수업 내 인문적 활동과 간접체험을 시도하고 있었으며, 간접체험 수업 가이드라인과 체계적 교사 연수의 필요성을 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_qualitative</isp:evidence_strength_level>
    <isp:supports_program rdf:resource="#program__regular_extracurricular_pe_linkage_class"/>
    <rdfs:label xml:lang="en">Local sports cluster for school physical education</rdfs:label>
    <rdfs:comment xml:lang="ko">정과 수업과 정과외 체육활동의 연계를 지원하는 지역 스포츠 클러스터 자원</rdfs:comment>
    <skos:prefLabel xml:lang="en">Local sports cluster for school physical education</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">학교체육 지역 스포츠 클러스터</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__dedicated_football_stadium_fan_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__dedicated_football_stadium_fan_context</isp:entity_id>
