    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">주 1회 이상 근력운동은 복부비만 억제와 관련됨</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">근력운동이 복부비만 억제와 관련되어 프로그램화 가능한 근거가 제시됨</isp:definition_text>
    <isp:targets_target_group rdf:resource="#target_group__korean_adult_men_abdominal_obesity_pa_management"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__strength_training_for_abdominal_obesity_management"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__knhanes2019_2020_abdominal_obesity_pa_data"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__covid19_social_distancing_pa_change_context"/>
    <isp:produces_outcome rdf:resource="#outcome__abdominal_obesity_suppression_strength_training"/>
    <rdfs:label xml:lang="en">Strength-training-based abdominal obesity management program for adult men</rdfs:label>
    <rdfs:comment xml:lang="ko">근력운동이 복부비만 억제와 관련되어 프로그램화 가능한 근거가 제시됨</rdfs:comment>
    <skos:prefLabel xml:lang="en">Strength-training-based abdominal obesity management program for adult men</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">성인 남성 근력운동 기반 복부비만 관리 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__korean_adult_men_abdominal_obesity_pa_management"/>
  </rdf:Description>
