  <rdf:Description rdf:about="#outcome__deaf_baseball_social_belonging">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#social_integration_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__deaf_baseball_social_belonging</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청각장애 야구 사회적 소속감 형성</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">social belonging through deaf baseball</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청각장애인이 야구 동호회 활동을 통해 소외를 극복하고 공동체 소속감을 형성하는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청각장애 야구 동호인의 참여의도 및 상호작용의 탐색</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">참여자들은 비장애인 사회에서 경험한 소외와 단절을 야구 동호회를 통해 극복하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">social belonging through deaf baseball</rdfs:label>
    <rdfs:comment xml:lang="ko">청각장애인이 야구 동호회 활동을 통해 소외를 극복하고 공동체 소속감을 형성하는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">social belonging through deaf baseball</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">청각장애 야구 사회적 소속감 형성</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__university_students_physical_activity_enjoyment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#young_adult"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체활동 즐거움·만족도 연구 참여 대학생</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">University students in physical activity enjoyment and satisfaction program</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체활동 프로그램을 통한 즐거움 및 만족도에 관한 연구</isp:source_title>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">empirical_study</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D교육대학교 재학생을 표현활동 집단과 체육수업 집단으로 구분하여 분석함</isp:evidence_excerpt>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">v45 추가 인스턴스</isp:note>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">v45_batch</isp:source_identifier>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__university_students_physical_activity_enjoyment</isp:entity_id>
