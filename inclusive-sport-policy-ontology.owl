  <rdf:Description rdf:about="#outcome__regional_sports_welfare_gap_identification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#policy_effectiveness_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__regional_sports_welfare_gap_identification</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지역 스포츠복지 격차 식별</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Identification of regional sports welfare gaps</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Constructing a Composite Index of Sports Welfare: Application to the 17 Major Provinces and Cities in South Korea</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">International Journal of Applied Sports Sciences</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">시·도별 스포츠복지 수준 비교를 통해 지역 간 격차 확인 가능성을 제시함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠복지 정책평가를 통해 지역 간 불균형을 확인하는 성과임</isp:definition_text>
    <rdfs:label xml:lang="en">Identification of regional sports welfare gaps</rdfs:label>
    <rdfs:comment xml:lang="ko">스포츠복지 정책평가를 통해 지역 간 불균형을 확인하는 성과임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Identification of regional sports welfare gaps</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">지역 스포츠복지 격차 식별</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__twelve_week_balance_walking_pt_middle_aged_women">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#community_based_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__twelve_week_balance_walking_pt_middle_aged_women</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중년여성 12주 밸런스워킹PT 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twelve-week Balance Walking PT program for middle-aged women</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중년여성을 대상으로 12주간 온라인과 오프라인을 병행하여 운영된 밸런스워킹PT 운동 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간 밸런스워킹PT 운동이 중년 여성의 신체적·정신적 건강에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중년기 여성 30명을 대상으로 12주간 주 2회, 온라인 1회와 오프라인 1회 방식의 밸런스워킹PT 운동을 적용하였다. 운동 프로그램은 제자리 걷기, 사방돌기 회전, 스트레칭, 균형, 점핑 등을 조합하였고, 건강 관련 체력, 신체적 특성, 혈중 지질 지표, 정신 건강에서 긍정적 변화를 보고하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:program_duration_weeks rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</isp:program_duration_weeks>
    <isp:session_frequency_per_week rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</isp:session_frequency_per_week>
    <isp:sample_size rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</isp:sample_size>
    <isp:targets_target_group rdf:resource="#target_group__middle_aged_women_balance_walking_pt"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__balance_walking_pt_exercise"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__twelve_week_hybrid_balance_walking_pt_sessions"/>
    <isp:produces_outcome rdf:resource="#outcome__balance_walking_pt_health_fitness_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__balance_walking_pt_body_composition_lipid_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__balance_walking_pt_mental_health_improvement"/>
    <rdfs:label xml:lang="en">Twelve-week Balance Walking PT program for middle-aged women</rdfs:label>
    <rdfs:comment xml:lang="ko">중년여성을 대상으로 12주간 온라인과 오프라인을 병행하여 운영된 밸런스워킹PT 운동 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Twelve-week Balance Walking PT program for middle-aged women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">중년여성 12주 밸런스워킹PT 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__middle_aged_women_balance_walking_pt"/>
  </rdf:Description>
  <rdf:Description rdf:about="#applies_to_program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="#ontology_entity"/>
    <rdfs:range rdf:resource="#ontology_entity"/>
    <rdfs:label xml:lang="en">applies to program</rdfs:label>
    <rdfs:comment xml:lang="en">Links an ontology entity to a program to which it applies.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__elderly_metabolic_syndrome_prevention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_health_improvement"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인 대사증후군 예방</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Metabolic syndrome prevention in older adults</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인의 영양섭취와 신체활동 개선을 통해 대사증후군 위험을 낮추는 신체건강 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analysis of energy intakes, physical activities and metabolic syndrome according to the income level in Korean elderly people: Korean National Health and Nutrition Examination Survey 2016-2018</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">28-35</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data from 2,139 elderly individuals aged over 65 years from KNHANES 2016-2018 showed that older adults with metabolic syndrome and older adults with low income had lower energy intake and physical activity; the study suggested balanced nutrient intake, increased physical activity, education, and program development to prevent metabolic syndrome in the elderly.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__elderly_metabolic_syndrome_prevention</isp:entity_id>
    <rdfs:label xml:lang="en">Metabolic syndrome prevention in older adults</rdfs:label>
    <rdfs:comment xml:lang="ko">노인의 영양섭취와 신체활동 개선을 통해 대사증후군 위험을 낮추는 신체건강 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Metabolic syndrome prevention in older adults</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">노인 대사증후군 예방</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__screen_time_limit_recommendation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#guideline_manual"/>
