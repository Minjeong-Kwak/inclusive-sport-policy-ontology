    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">교사가 단계별 내용을 숙지하고 UDL 기반 통합체육에 따라 실행해야 한다고 제시함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__udl_inclusive_pe_guidance</isp:entity_id>
    <rdfs:label xml:lang="en">UDL-based inclusive PE guidance</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing UDL-based inclusive PE guidance in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">UDL-based inclusive PE guidance</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">UDL 기반 통합체육 지도지침</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__equestrian_pck_framework">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#guideline_manual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__equestrian_pck_framework</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">승마지도자 PCK 요소 틀</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equestrian instructor PCK framework</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">승마 교육 목표, 내용, 교수법, 평가, 학습자 이해, 교육환경 지식을 포함하는 교수내용지식 틀</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">승마지도자의 교수내용지식(PCK) 요소와 형성 과정 탐색</isp:source_title>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">승마의 교육 목표 지식, 교육 내용 지식, 교수법 지식, 평가 지식, 학습 지식, 교육환경 지식을 제시함</isp:evidence_excerpt>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <rdfs:label xml:lang="en">Equestrian instructor PCK framework</rdfs:label>
    <rdfs:comment xml:lang="ko">승마 교육 목표, 내용, 교수법, 평가, 학습자 이해, 교육환경 지식을 포함하는 교수내용지식 틀</rdfs:comment>
    <skos:prefLabel xml:lang="en">Equestrian instructor PCK framework</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">승마지도자 PCK 요소 틀</skos:prefLabel>
