    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Identification of youth cardiorespiratory fitness profile</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fitness Index on Physical Fitness, Obesity and Dietary Intake of Youths in Singapore</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년의 심폐체력, 유연성, 근력, 체지방률을 성별에 따라 비교함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년의 건강 관련 체력 수준과 취약 영역을 확인하는 건강 성과임</isp:definition_text>
    <rdfs:label xml:lang="en">Identification of youth cardiorespiratory fitness profile</rdfs:label>
    <rdfs:comment xml:lang="ko">청소년의 건강 관련 체력 수준과 취약 영역을 확인하는 건강 성과임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Identification of youth cardiorespiratory fitness profile</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">청소년 심폐체력 수준 식별</skos:prefLabel>
  </rdf:Description>
