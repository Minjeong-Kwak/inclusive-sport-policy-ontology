    <rdf:type rdf:resource="#participation_outcome"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유소년 동계스포츠 프로그램 만족도 향상</isp:pref_label_ko>
