    <skos:prefLabel xml:lang="ko">학생선수 인성·자아존중감·스트레스 설문자료</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__adult_taekwondo_specialized_program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#continuity_retention_program"/>
