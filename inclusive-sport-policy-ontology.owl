    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑선수와 스포츠구단, 경기단체, 후원단체, 상대선수 및 관중과의 관계에서 법적 문제가 발생할 수 있음을 제시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__doping_civil_liability_guideline</isp:entity_id>
