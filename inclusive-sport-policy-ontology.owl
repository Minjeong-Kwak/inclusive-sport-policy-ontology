  <rdf:Description rdf:about="#participation_context__taekwondo_caring_mastery_climate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__taekwondo_caring_mastery_climate</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">태권도 케어링·숙달 분위기</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">taekwondo caring and mastery climate</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">태권도 선수의 도덕행동을 촉진하기 위해 지도자가 조성하는 지지적이고 숙달중심적인 훈련 분위기.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">케어링 및 동기 분위기는 태권도 선수들의 도덕행동을 예측하는가</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">케어링 분위기와 숙달 분위기가 태권도 선수의 도덕행동에 영향을 미침.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated_v67_added_from_uploaded_literature</isp:note>
    <isp:conditions_outcome rdf:resource="#outcome__taekwondo_prosocial_behavior_growth"/>
    <isp:conditions_outcome rdf:resource="#outcome__taekwondo_antisocial_behavior_reduction"/>
    <isp:is_enabled_by_resource rdf:resource="#support_resource__coach_caring_mastery_guidance"/>
    <rdfs:label xml:lang="en">taekwondo caring and mastery climate</rdfs:label>
    <rdfs:comment xml:lang="ko">태권도 선수의 도덕행동을 촉진하기 위해 지도자가 조성하는 지지적이고 숙달중심적인 훈련 분위기.</rdfs:comment>
    <skos:prefLabel xml:lang="en">taekwondo caring and mastery climate</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">태권도 케어링·숙달 분위기</skos:prefLabel>
  </rdf:Description>
