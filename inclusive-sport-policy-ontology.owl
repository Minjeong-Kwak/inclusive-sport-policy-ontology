    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">금지목록 고시 개정을 통한 도핑 개념 확대와 AI 도핑 규제를 제안함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__ai_doping_prohibited_list_guideline</isp:entity_id>
