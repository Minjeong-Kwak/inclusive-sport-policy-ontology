    <isp:utilizes_support_resource rdf:resource="#support_resource__korea_china_child_adolescent_pa_guidelines"/>
    <isp:produces_outcome rdf:resource="#outcome__child_adolescent_pa_guideline_monitoring_need"/>
    <rdfs:label xml:lang="en">guideline-based physical activity intervention for children and adolescents</rdfs:label>
    <rdfs:comment xml:lang="ko">중고강도 활동과 근·골격 강화 활동을 포함하는 아동청소년 신체활동 참여지원 프로그램</rdfs:comment>
