    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DACUM 기법을 활용하여 중등 체육교사의 직무영역을 교육업무와 행정업무로 구분하고, 교과지도·학교체육행정 등 66개 직무내용을 도출함.</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DACUM 기법을 활용하여 중등 체육교사의 직무영역을 교육업무와 행정업무로 구분하고, 교과지도·학교체육행정 등 66개 직무내용을 도출함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <rdfs:label xml:lang="en">Secondary PE teachers in occupational domain analysis</rdfs:label>
    <rdfs:comment xml:lang="ko">DACUM 기법을 활용하여 중등 체육교사의 직무영역을 교육업무와 행정업무로 구분하고, 교과지도·학교체육행정 등 66개 직무내용을 도출함.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Secondary PE teachers in occupational domain analysis</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">중등 체육교사 직무분석 대상자</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__standing_work_leg_edema_increase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__standing_work_leg_edema_increase</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">입식근로 하지부종 증가 위험</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leg edema increase risk from prolonged standing work</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장시간의 입식 근로가 하지부종, 신체균형 및 통증지수 변화에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">근무 전과 2주 후 비교에서 두 집단 모두 하지부종이 유의하게 증가하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Added in v58 from uploaded academic literature; class assignment limited to directly evidenced entities.</isp:note>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <rdfs:label xml:lang="en">Leg edema increase risk from prolonged standing work</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Leg edema increase risk from prolonged standing work in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Leg edema increase risk from prolonged standing work</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">입식근로 하지부종 증가 위험</skos:prefLabel>
  </rdf:Description>
