    <rdfs:label xml:lang="en">Competitive Sport Ethics Assessment</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Competitive Sport Ethics Assessment in the participation_context dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Competitive Sport Ethics Assessment</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">경쟁 스포츠 윤리 평가 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#policy__child_adolescent_physical_activity_indicator_priority">
