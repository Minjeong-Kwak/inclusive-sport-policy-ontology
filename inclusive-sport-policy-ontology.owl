    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chaperone Pool Stability Improvement</isp:pref_label_en>
    <rdfs:label xml:lang="en">Chaperone Pool Stability Improvement</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Chaperone Pool Stability Improvement in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
