  <rdf:Description rdf:about="#support_resource__professional_baseball_team_sns_channel">
    <rdf:type rdf:resource="#information_resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__professional_baseball_team_sns_channel</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프로야구단 SNS 채널</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">professional baseball team SNS channel</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프로야구단의 SNS특성이 인게이지먼트를 매개로 브랜드(구단) 태도와 구단 충성도에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프로야구단 SNS는 구단소식, 선수정보, 이벤트, 경기 관련 정보, 사진 및 영상 업데이트 서비스로 활용된다고 설명하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:is_utilized_by_program rdf:resource="#program__professional_baseball_team_sns_engagement_strategy"/>
    <isp:supports_program rdf:resource="#program__professional_baseball_team_sns_engagement_strategy"/>
    <rdfs:label xml:lang="en">professional baseball team SNS channel</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing professional baseball team SNS channel in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">professional baseball team SNS channel</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">프로야구단 SNS 채널</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__high_school_athlete_doping_awareness_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__high_school_athlete_doping_awareness_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고교 선수 도핑의식 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">improved doping awareness among high school athletes</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">교교 엘리트 선수들의 경기력 향상을 위한 운동영향보조물 섭취형태와 도핑의식</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2008</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">일반고와 체육고 엘리트 선수 338명을 대상으로 경기력 향상을 위한 운동영양 보조물 섭취형태와 도핑의식을 조사하였고, 전체 섭취 경험은 60.9%, 체육고 선수의 도핑교육 경험은 74.6%, 일반고 선수의 도핑교육 경험은 14.9%로 나타났다고 보고하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Korea Sport Research</isp:source_publisher>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">선수의 보조물 섭취와 금지약물 위험에 대한 인식 및 판단 능력이 향상되는 성과임</isp:definition_text>
    <rdfs:label xml:lang="en">improved doping awareness among high school athletes</rdfs:label>
    <rdfs:comment xml:lang="ko">선수의 보조물 섭취와 금지약물 위험에 대한 인식 및 판단 능력이 향상되는 성과임</rdfs:comment>
    <skos:prefLabel xml:lang="en">improved doping awareness among high school athletes</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">고교 선수 도핑의식 향상</skos:prefLabel>
  </rdf:Description>
