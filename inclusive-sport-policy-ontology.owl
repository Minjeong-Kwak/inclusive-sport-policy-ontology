  <rdf:Description rdf:about="#program__sports_nutrition_education_curriculum_for_pe_majors">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육전공자 스포츠영양 교육과정</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sports nutrition education curriculum for physical education majors</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육전공 대학생과 예비 스포츠 지도자의 스포츠영양 지식 형성을 지원하는 역량 강화 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A study on the awareness and education status of sports nutrition in college students majoring in physical education: based on the career selection</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/pan.2025.0004</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">25-26</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Only approximately 30% of respondents took nutrition classes at universities, while many subjects perceived the necessity and importance of nutritional knowledge. The Exercise Nutrition Expert qualification training course is described as an opportunity for students and physical education majors.</isp:evidence_excerpt>
    <isp:targets_target_group rdf:resource="#target_group__physical_education_major_students_sports_nutrition"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__exercise_nutrition_expert_qualification_training"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__sports_nutrition_education_curriculum_for_pe_majors</isp:entity_id>
    <rdfs:label xml:lang="en">Sports nutrition education curriculum for physical education majors</rdfs:label>
    <rdfs:comment xml:lang="ko">체육전공 대학생과 예비 스포츠 지도자의 스포츠영양 지식 형성을 지원하는 역량 강화 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Sports nutrition education curriculum for physical education majors</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">체육전공자 스포츠영양 교육과정</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__physical_education_major_students_sports_nutrition"/>
  </rdf:Description>
