  <rdf:Description rdf:about="#program__athlete_mental_health_screening_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#medical_welfare_linked_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__athlete_mental_health_screening_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동선수 정신건강 선별 지원 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">athlete mental health screening support program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동선수의 우울, 불안, 공황, 불면 등 정신건강 위험을 조기에 식별하고 지원하는 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 정신의학: 스포츠 선수도 정신질환이 생긴다</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠과학</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 선수에게도 우울, 불안, 강박, 거식, 불면 등 정신질환이 나타날 수 있으며 선수 수행과 경력에 심각한 영향을 줄 수 있다고 설명하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <isp:targets_target_group rdf:resource="#target_group__athletes_with_mental_health_risk"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__sport_psychiatry_mental_health_information"/>
    <isp:produces_outcome rdf:resource="#outcome__athlete_mental_health_risk_awareness"/>
    <rdfs:label xml:lang="en">athlete mental health screening support program</rdfs:label>
    <rdfs:comment xml:lang="ko">운동선수의 우울, 불안, 공황, 불면 등 정신건강 위험을 조기에 식별하고 지원하는 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">athlete mental health screening support program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">운동선수 정신건강 선별 지원 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__athletes_with_mental_health_risk"/>
  </rdf:Description>
  <rdf:Description rdf:about="#program__disability_independent_living_support_2024">
