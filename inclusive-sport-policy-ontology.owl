    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Youth student athletes for moral decision assessment</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유소년 운동선수의 도덕적 의사결정 태도 척도의 타당화</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중고등학교 학생운동선수를 대상으로 척도 타당화를 수행함.</isp:evidence_excerpt>
