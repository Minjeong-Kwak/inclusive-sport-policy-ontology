  <rdf:Description rdf:about="#target_group__recreational_bodybuilding_participants">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#target_group"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__recreational_bodybuilding_participants</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">생활스포츠 보디빌딩 참가자</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recreational bodybuilding participants</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">전문선수가 아닌 생활스포츠 맥락에서 보디빌딩에 참여하는 대상 집단</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">생활스포츠 참가자의 무감각해진 윤리성: 보디빌딩에서 금지약물 복용을 중심으로</isp:source_title>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Convergence Consilience</isp:source_publisher>
    <rdfs:label xml:lang="en">Recreational bodybuilding participants</rdfs:label>
