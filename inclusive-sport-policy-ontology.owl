    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">제4차 외국인정책 기본계획</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">법무부</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">government_policy_document</isp:source_type>
    <isp:source_section rdf:datatype="http://www.w3.org/2001/XMLSchema#string">사회통합 프로그램 개요</isp:source_section>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">사회통합 프로그램은 법무부 출입국·외국인정책본부가 운영하는 공공 사회통합 교육 체계로 제시된다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-18</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">문서에 무료라는 표현은 직접 없으므로 무료 접근 일반화는 피하고 공공 접근 맥락으로만 주석 처리하였다.</isp:note>
    <isp:is_conditioned_by_context rdf:resource="#policy_domain__multicultural_family_and_integration_policy"/>
    <rdfs:label xml:lang="en">Public access to immigrant social integration education</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Public access to immigrant social integration education in the participation_context dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Public access to immigrant social integration education</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">공공 이민자 사회통합교육 접근</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__sport_enhancement_ethics_awareness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#cognitive_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__sport_enhancement_ethics_awareness</isp:entity_id>
