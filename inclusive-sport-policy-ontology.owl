    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__global_anti_doping_rule_awareness</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국제 반도핑 규정 인식 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Global anti-doping rule awareness improvement</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">선수와 지도자가 국제 반도핑 제도와 도핑관리의 역사적 필요성을 이해하는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠현장: 세계 스포츠 반도핑(World Anti-Doping in Sports) 움직임</isp:source_title>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">세계 스포츠 반도핑 규칙과 WADA 체계의 필요성을 다룸</isp:evidence_excerpt>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2002</isp:source_year>
    <rdfs:label xml:lang="en">Global anti-doping rule awareness improvement</rdfs:label>
    <rdfs:comment xml:lang="ko">선수와 지도자가 국제 반도핑 제도와 도핑관리의 역사적 필요성을 이해하는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Global anti-doping rule awareness improvement</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">국제 반도핑 규정 인식 향상</skos:prefLabel>
  </rdf:Description>
