    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">가상현실 스포츠실, 웨어러블 디바이스, 인공지능 로봇, IoT 등을 체육수업에 연계하는 학교 기반 프로그램.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4차 산업혁명 시대, AI와 초등체육교육의 초연결</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Journal of Korea Elementary Education</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://dx.doi.org/10.20972/Kjee.31.S.202101.S159</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">159-160</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">초등체육교육에서 가상현실 스포츠실, 웨어러블 디바이스, 인공지능 로봇, IoT 등이 연결될 수 있다고 제시하였다.</isp:evidence_excerpt>
    <isp:targets_target_group rdf:resource="#target_group__elementary_students_ai_pe"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__ai_elementary_physical_education"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__virtual_sports_room_school_setting"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__wearable_device_iot_robot_pe"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__virtual_sports_room_facility"/>
    <rdfs:label xml:lang="en">AI-supported hyperconnected elementary physical education program</rdfs:label>
    <rdfs:comment xml:lang="ko">가상현실 스포츠실, 웨어러블 디바이스, 인공지능 로봇, IoT 등을 체육수업에 연계하는 학교 기반 프로그램.</rdfs:comment>
    <skos:prefLabel xml:lang="en">AI-supported hyperconnected elementary physical education program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">AI 연계 초등체육교육 프로그램</skos:prefLabel>
