  <rdf:Description rdf:about="#policy__animal_use_in_sport_ethics_policy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#sport_policy"/>
    <rdfs:label xml:lang="ko">스포츠 동물 사용 윤리 정책</rdfs:label>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 동물 사용 윤리 정책</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">animal use in sport ethics policy</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">경쟁 스포츠에서 동물 사용의 정당성과 제한을 다루는 스포츠윤리 정책</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠에서 동물의 사용은 윤리적으로 정당한가</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">동물권리론, 동물해방론, 덕론을 통해 스포츠에서 동물 사용의 윤리적 정당성과 제한 기준을 검토하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary_evidence</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:utilizes_support_resource rdf:resource="#support_resource__animal_welfare_sport_ethics_guideline"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy__animal_use_in_sport_ethics_policy</isp:entity_id>
    <rdfs:comment xml:lang="ko">경쟁 스포츠에서 동물 사용의 정당성과 제한을 다루는 스포츠윤리 정책</rdfs:comment>
    <skos:prefLabel xml:lang="en">animal use in sport ethics policy</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠 동물 사용 윤리 정책</skos:prefLabel>
  </rdf:Description>
