    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__college_liberal_pe_students_body_satisfaction</isp:entity_id>
    <rdfs:label xml:lang="en">College liberal PE students in body satisfaction study</rdfs:label>
    <rdfs:comment xml:lang="ko">교양체육 수업을 듣는 대학생으로 신체만족도, 자아존중감, 심리적 행복감 관계를 분석한 대상 집단</rdfs:comment>
    <skos:prefLabel xml:lang="en">College liberal PE students in body satisfaction study</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">교양체육 수강 대학생 신체만족도 연구 대상</skos:prefLabel>
