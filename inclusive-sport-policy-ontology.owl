    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프로구단과의 연계와 프로 팀 코치의 유소년배구 인력 활용 방안 필요를 제시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__professional_volleyball_club_youth_support</isp:entity_id>
