  <rdf:Description rdf:about="#target_group__middle_high_school_soccer_players_career_anxiety">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#youth"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__middle_high_school_soccer_players_career_anxiety</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">진로불안 중·고 축구선수</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">middle and high school soccer players with career anxiety</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">진로불안과 권력거리신념 및 경기수행능력의 관계를 고려한 중·고등학교 축구선수 집단.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중ㆍ고 축구선수의 진로불안이 권력거리신념과 경기수행능력에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중·고등학교 축구선수 297명을 대상으로 진로불안이 권력거리신념과 경기수행능력에 미치는 영향을 분석하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">middle and high school soccer players with career anxiety</rdfs:label>
    <rdfs:comment xml:lang="ko">진로불안과 권력거리신념 및 경기수행능력의 관계를 고려한 중·고등학교 축구선수 집단.</rdfs:comment>
    <skos:prefLabel xml:lang="en">middle and high school soccer players with career anxiety</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">진로불안 중·고 축구선수</skos:prefLabel>
  </rdf:Description>
