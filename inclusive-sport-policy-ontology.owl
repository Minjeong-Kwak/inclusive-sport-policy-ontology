  <rdf:Description rdf:about="#outcome__animal_welfare_protection_in_sport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#equity_outcome"/>
    <rdfs:label xml:lang="ko">스포츠 동물복지 보호</rdfs:label>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 동물복지 보호</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">animal welfare protection in sport</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">동물 사용 스포츠에서 학대 위험을 줄이고 동물복지를 보호하는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠에서 동물의 사용은 윤리적으로 정당한가</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">동물권리론, 동물해방론, 덕론을 통해 스포츠에서 동물 사용의 윤리적 정당성과 제한 기준을 검토하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary_evidence</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__animal_welfare_protection_in_sport</isp:entity_id>
    <rdfs:comment xml:lang="ko">동물 사용 스포츠에서 학대 위험을 줄이고 동물복지를 보호하는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">animal welfare protection in sport</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠 동물복지 보호</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__autonomous_motivation_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#self_efficacy_improvement"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">자율적 동기 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">improvement of autonomous motivation</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육수업에서 학생들의 긍정적 정서는 숙련분위기, 기본심리욕구, 자율적 동기의 인과관계를 조절하는가</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">숙련분위기가 기본심리욕구를 통해 자율적 동기를 향상시키는 경로가 제시되었다.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__autonomous_motivation_improvement</isp:entity_id>
    <rdfs:label xml:lang="en">improvement of autonomous motivation</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing improvement of autonomous motivation in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">improvement of autonomous motivation</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">자율적 동기 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#sport_activity__shoulder_rom_stretching_exercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#therapeutic_exercise"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__shoulder_rom_stretching_exercise</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">어깨관절 가동범위 스트레칭 운동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">shoulder range-of-motion stretching exercise</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유방암 환자의 수술 후 어깨 재활 운동 고찰</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">어깨관절 가동범위 회복을 위한 근막이완요법과 스트레칭을 높은 빈도로 시행해야 한다고 제시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">shoulder range-of-motion stretching exercise</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing shoulder range-of-motion stretching exercise in the sport_activity dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">shoulder range-of-motion stretching exercise</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">어깨관절 가동범위 스트레칭 운동</skos:prefLabel>
  </rdf:Description>
