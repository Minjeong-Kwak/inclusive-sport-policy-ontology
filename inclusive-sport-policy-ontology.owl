  <rdf:Description rdf:about="#outcome__breast_cancer_recurrence_mortality_risk_reduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_health_improvement"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유방암 재발 및 사망 위험 감소</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reduced breast cancer recurrence and mortality risk</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체활동 및 구조화된 운동 참여와 연결되는 유방암 재발 및 사망 위험 감소 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A systematic review of the biological mechanisms linking physical activity and breast cancer</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">review_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/pan.2020.0018</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">25-26</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leisure-time physical activity and structured exercise before and after breast cancer diagnosis contribute to reducing the risk of breast cancer recurrence and mortality. The review describes physical activity as a non-pharmacological strategy for primary cancer prevention.</isp:evidence_excerpt>
    <isp:reflects_target_group rdf:resource="#target_group__breast_cancer_survivors_physical_activity_support"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__breast_cancer_recurrence_mortality_risk_reduction</isp:entity_id>
    <rdfs:label xml:lang="en">Reduced breast cancer recurrence and mortality risk</rdfs:label>
    <rdfs:comment xml:lang="ko">신체활동 및 구조화된 운동 참여와 연결되는 유방암 재발 및 사망 위험 감소 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Reduced breast cancer recurrence and mortality risk</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유방암 재발 및 사망 위험 감소</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__breast_cancer_survivors_physical_activity_support"/>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__american_korean_elite_swimmers">
