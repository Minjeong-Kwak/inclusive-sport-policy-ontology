  <rdf:Description rdf:about="#policy__soccer_weekend_league_learning_rights">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#sport_policy"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy__soccer_weekend_league_learning_rights</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">축구 주말리그 학생선수 학습권 보장정책</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soccer weekend league learning rights policy</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학생선수의 정규수업 참여와 학습권 보장을 목적으로 운영되는 축구 주말리그 기반 정책.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">축구 주말리그 도입 이후의 고등학교 학생선수 학습권 현황</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학생선수의 학습권 보장을 위해 2009년 축구주말리그제도가 시행됨.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated_v67_added_from_uploaded_literature</isp:note>
    <isp:reflects_target_group rdf:resource="#target_group__high_school_soccer_student_athletes_learning_rights"/>
    <isp:shapes_participation_context rdf:resource="#participation_context__soccer_weekend_league_context"/>
    <isp:has_policy_outcome rdf:resource="#outcome__student_athlete_regular_class_participation_protection"/>
    <isp:has_policy_outcome rdf:resource="#outcome__student_athlete_learning_rights_awareness"/>
    <rdfs:label xml:lang="en">soccer weekend league learning rights policy</rdfs:label>
    <rdfs:comment xml:lang="ko">학생선수의 정규수업 참여와 학습권 보장을 목적으로 운영되는 축구 주말리그 기반 정책.</rdfs:comment>
    <skos:prefLabel xml:lang="en">soccer weekend league learning rights policy</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">축구 주말리그 학생선수 학습권 보장정책</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__high_school_soccer_student_athletes_learning_rights"/>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__parent_satisfaction_increase">
