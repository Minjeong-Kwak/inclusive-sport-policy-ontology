  <rdf:Description rdf:about="#program__coach_led_anti_doping_control_strategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__coach_led_anti_doping_control_strategy</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지도자 주도 반도핑 제어전략</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Coach-led anti-doping control strategy</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동선수의 도핑방지에 관한 엘리트스포츠 지도자의 제어전략</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지도자는 예방전략, 사전계획전략, 통제전략을 통해 선수의 반도핑을 지원한다고 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Added in v52 from uploaded academic literature; class assignment limited to directly evidenced entities.</isp:note>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:targets_target_group rdf:resource="#target_group__elite_sport_athletes_doping_risk"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__elite_coach_anti_doping_knowledge"/>
    <isp:produces_outcome rdf:resource="#outcome__anti_doping_awareness_reinforcement"/>
    <rdfs:label xml:lang="en">Coach-led anti-doping control strategy</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Coach-led anti-doping control strategy in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Coach-led anti-doping control strategy</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">지도자 주도 반도핑 제어전략</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__elite_sport_athletes_doping_risk"/>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__science_intervention_criteria_guideline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#support_resource"/>
    <rdfs:label xml:lang="ko">스포츠 과학기술 개입 기준 지침</rdfs:label>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 과학기술 개입 기준 지침</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">science intervention criteria guideline in sport</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑, 의료기술, 장비, 종목별 필수 장비와 관련된 과학기술 개입 한계를 판단하기 위한 지침</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠에서 과학의 개입한도와 기준 문제</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠에서 과학기술의 허용과 금지 기준이 모호한 경우 도핑, 의료기술, 장비, 필수장비와 관련한 공정성 논쟁이 발생함을 논의하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary_evidence</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:enables_participation_context rdf:resource="#participation_context__technology_assisted_sport_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__science_intervention_criteria_guideline</isp:entity_id>
    <rdfs:comment xml:lang="ko">도핑, 의료기술, 장비, 종목별 필수 장비와 관련된 과학기술 개입 한계를 판단하기 위한 지침</rdfs:comment>
    <skos:prefLabel xml:lang="en">science intervention criteria guideline in sport</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠 과학기술 개입 기준 지침</skos:prefLabel>
  </rdf:Description>
