  <rdf:Description rdf:about="#program__older_adult_gait_adaptability_assessment_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#safety_risk_management_program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인 보행 적응성 평가 지원 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Older adult gait adaptability assessment support program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인의 보행 적응성과 낙상 위험 관련 기능을 평가하기 위한 과제 기반 안전 위험 관리 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A scoping review of voluntary gait adaptability tasks requiring cognitive demands in older adults</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/pan.2023.0004</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">30-31</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Older adults often suffer from walking problems including reduced adaptability to environmental changes and hazards, which can increase fall risk. The review identified voluntary gait adaptability tasks requiring cognitive demands while walking.</isp:evidence_excerpt>
    <isp:targets_target_group rdf:resource="#target_group__older_adults_gait_adaptability_support"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__voluntary_gait_adaptability_task_older_adults"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__cognitive_gait_adaptability_task_protocol"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__older_adult_gait_adaptability_assessment_support</isp:entity_id>
    <rdfs:label xml:lang="en">Older adult gait adaptability assessment support program</rdfs:label>
    <rdfs:comment xml:lang="ko">노인의 보행 적응성과 낙상 위험 관련 기능을 평가하기 위한 과제 기반 안전 위험 관리 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Older adult gait adaptability assessment support program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">노인 보행 적응성 평가 지원 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__older_adults_gait_adaptability_support"/>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__child_youth_sedentary_behavior_risk_reduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__child_youth_sedentary_behavior_risk_reduction</isp:entity_id>
