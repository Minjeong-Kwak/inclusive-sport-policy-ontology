    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__sport_dropout_intention_reduction</isp:entity_id>
    <rdfs:label xml:lang="en">Sport dropout intention reduction</rdfs:label>
