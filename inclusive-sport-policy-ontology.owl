  <rdf:Description rdf:about="">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Inclusive Sport Participation Policy Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">An ontology for representing inclusive sport participation policy components, target groups, sport activities, programs, support resources, participation contexts, and outcomes.</rdfs:comment>
    <owl:versionInfo xml:lang="en">v97 target-group hub enhancement: added a generic target-group anchoring property, strengthened target-group-related object property ranges, and materialized explicit target-group anchor assertions while preserving the BFO-free domain ontology design.</owl:versionInfo>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-20</dcterms:modified>
    <owl:versionIRI rdf:resource="https://w3id.org/inclusive-sport-policy/ontology/releases/v97"/>
    <dcterms:title xml:lang="en">Inclusive Sport Participation Policy Ontology</dcterms:title>
    <dcterms:description xml:lang="en">Public-release OWL ontology describing policy, program, target-group, sport-activity, support-resource, participation-context, and outcome entities for inclusive sport participation policy modeling.</dcterms:description>
    <dcterms:creator xml:lang="en">Inclusive Sport Policy Ontology Project</dcterms:creator>
    <dcterms:publisher xml:lang="en">Inclusive Sport Policy Ontology Project</dcterms:publisher>
    <dcterms:identifier>https://w3id.org/inclusive-sport-policy/ontology</dcterms:identifier>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-19</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <vann:preferredNamespacePrefix>isp</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/inclusive-sport-policy/ontology#</vann:preferredNamespaceUri>
    <dcterms:language>en</dcterms:language>
  </rdf:Description>
