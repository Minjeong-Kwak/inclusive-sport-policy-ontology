    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__elderly_life_sport_participation</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인 생활체육 참여</isp:pref_label_ko>
