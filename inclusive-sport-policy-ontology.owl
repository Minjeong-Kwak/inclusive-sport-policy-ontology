  <rdf:Description rdf:about="#program__structured_interval_training_pe_lessons">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_linked_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__structured_interval_training_pe_lessons</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">구조화 인터벌 트레이닝 체육수업</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Structured interval training PE lessons</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Effect of 4 weeks of Fun Game-Based and Structured Interval Training Physical Education Lessons on Aerobic Fitness in Adolescents</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4주간 구조화 인터벌 트레이닝 체육수업도 2.4km 달리기 기록을 유의하게 개선함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학교체육에서 청소년 유산소 체력 향상을 위해 적용된 구조화 트레이닝 프로그램임</isp:definition_text>
    <isp:targets_target_group rdf:resource="#target_group__adolescent_school_pe_aerobic_fitness"/>
    <isp:produces_outcome rdf:resource="#outcome__adolescent_24km_run_time_improvement"/>
    <rdfs:label xml:lang="en">Structured interval training PE lessons</rdfs:label>
    <rdfs:comment xml:lang="ko">학교체육에서 청소년 유산소 체력 향상을 위해 적용된 구조화 트레이닝 프로그램임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Structured interval training PE lessons</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">구조화 인터벌 트레이닝 체육수업</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__adolescent_school_pe_aerobic_fitness"/>
  </rdf:Description>
