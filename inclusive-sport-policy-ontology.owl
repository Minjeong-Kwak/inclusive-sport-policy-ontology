  <rdf:Description rdf:about="#outcome__diastolic_blood_pressure_reduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__diastolic_blood_pressure_reduction</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">이완기 혈압 감소</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diastolic blood pressure reduction</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유산소운동에 따른 혈관 내피세포의 SIRT1 발현이 혈압개선에 미치는 효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유산소운동 후 체지방률, 이완기 혈압, 안정시 심박수에서 유의한 감소가 나타남.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">diastolic blood pressure reduction</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing diastolic blood pressure reduction in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">diastolic blood pressure reduction</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">이완기 혈압 감소</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__parents_of_preschool_children">
