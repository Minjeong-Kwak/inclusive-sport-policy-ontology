    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Death anxiety management among elderly participants</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인의 죽음불안 관련 심리 상태를 파악하고 완화하기 위한 관리 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인의 생활체육 참여동기가 여가만족 및 죽음불안에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-15</isp:last_updated>
    <rdfs:label xml:lang="en">Death anxiety management among elderly participants</rdfs:label>
    <rdfs:comment xml:lang="ko">노인의 죽음불안 관련 심리 상태를 파악하고 완화하기 위한 관리 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Death anxiety management among elderly participants</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">노인 죽음불안 관리</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__athlete_autonomy_support_guideline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#information_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__athlete_autonomy_support_guideline</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">선수 자율성 지원 지도 지침</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Athlete autonomy support guideline</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동선수들이 지각하는 통제동기가 도핑 의도에 미치는 영향: 자율성의 조절효과 검증</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">타인의 지시나 인정 추구가 아니라 심리적 자유와 능동적 의사결정을 경험하도록 해야 한다고 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Added in v52 from uploaded academic literature; class assignment limited to directly evidenced entities.</isp:note>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <rdfs:label xml:lang="en">Athlete autonomy support guideline</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Athlete autonomy support guideline in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Athlete autonomy support guideline</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">선수 자율성 지원 지도 지침</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__state_sport_doping_human_rights_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__state_sport_doping_human_rights_education</isp:entity_id>
