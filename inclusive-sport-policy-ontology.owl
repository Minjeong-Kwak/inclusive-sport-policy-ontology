    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated v27 instance from uploaded paper</isp:note>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">literature_curated_instance</isp:source_type>
    <isp:source_identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">교양 체육 수업 교수자의 피드백이 교수자 만족, 긍정적 감정 및 운동지속의사에 미치는 영향</isp:source_identifier>
    <rdfs:label xml:lang="en">performance knowledge feedback</rdfs:label>
