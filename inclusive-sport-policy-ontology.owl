    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">youth taekwondo elementary participants</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유소년 태권도 참여자의 수련 기간과 수련 빈도가 우울 정도에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">서울·경기 소재 태권도장 초등학생 1~6학년 유소년 참여자를 대상으로 우울 정도를 분석함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">youth taekwondo elementary participants</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing youth taekwondo elementary participants in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">youth taekwondo elementary participants</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유소년 태권도 초등 수련생</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#sport_activity__underserved_children_dodgeball_class">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_sport"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__underserved_children_dodgeball_class</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">취약 아동 피구 기반 체육활동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dodgeball-based PE activity for underserved children</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Designing a Physical Activity Class for the Underserved Children</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">피구 프로그램을 체육전문가 또는 훈련된 담임교사가 지도하는 방식으로 제안함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">소외 아동 체육수업에서 활용되는 게임 기반 학교 스포츠 활동임</isp:definition_text>
    <rdfs:label xml:lang="en">Dodgeball-based PE activity for underserved children</rdfs:label>
    <rdfs:comment xml:lang="ko">소외 아동 체육수업에서 활용되는 게임 기반 학교 스포츠 활동임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Dodgeball-based PE activity for underserved children</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">취약 아동 피구 기반 체육활동</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#pe_college_exam_career_decision_counseling">
