    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인체육회 프로그램 운영 환경</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disability sport association program setting</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인체육회 또는 시설관리공단이 장애인 체육활동 프로그램을 운영·관리하는 공공기관 맥락.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동하는 장애인에 대한 장애인 체육 분야 종사자의 인식 유형 탐색</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://dx.doi.org/10.24007/ajpess.2023.11.1.015</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">15-16</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인 체육회 및 시설관리공단 종사자 32명을 대상으로 운동하는 장애인에 대한 인식 유형을 분석하였다.</isp:evidence_excerpt>
    <isp:interacts_with_target_group rdf:resource="#target_group__exercisers_with_disabilities"/>
    <rdfs:label xml:lang="en">disability sport association program setting</rdfs:label>
    <rdfs:comment xml:lang="ko">장애인체육회 또는 시설관리공단이 장애인 체육활동 프로그램을 운영·관리하는 공공기관 맥락.</rdfs:comment>
    <skos:prefLabel xml:lang="en">disability sport association program setting</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">장애인체육회 프로그램 운영 환경</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__exercisers_with_disabilities"/>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__human_enhancement_ethics_material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#ethical_guideline"/>
