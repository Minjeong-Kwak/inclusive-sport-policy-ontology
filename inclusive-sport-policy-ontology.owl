  <rdf:Description rdf:about="#target_group__elite_judo_athletes_antidoping_awareness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#target_group"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__elite_judo_athletes_antidoping_awareness</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">반도핑 인식 대상 엘리트 유도선수</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target group  elite judo athletes antidoping awareness</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 유도선수들의 반도핑 경향에 대한 근원적 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 유도선수 10명 질적연구에서 도핑 인지 수준, 도핑검사 경험, 체급 특성에 따른 도핑 유혹, 윤리교육의 필요가 제시됨.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">target group  elite judo athletes antidoping awareness</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing target group  elite judo athletes antidoping awareness in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">target group  elite judo athletes antidoping awareness</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">반도핑 인식 대상 엘리트 유도선수</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__middle_school_students_pe_happiness_school_type">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#adolescent"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__middle_school_students_pe_happiness_school_type</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학교유형별 체육수업 참여 중학생</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">middle school students in PE classes by school type</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학교유형에 따라 체육수업 행복감과 수업태도가 분석된 중학생 집단</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중학교 학교유형에 따른 체육수업에 대한 행복감과 수업태도의 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">서울 중학생 762명을 대상으로 학교유형에 따른 체육수업 행복감과 수업태도를 분석하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">middle school students in PE classes by school type</rdfs:label>
    <rdfs:comment xml:lang="ko">학교유형에 따라 체육수업 행복감과 수업태도가 분석된 중학생 집단</rdfs:comment>
    <skos:prefLabel xml:lang="en">middle school students in PE classes by school type</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">학교유형별 체육수업 참여 중학생</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__badminton_sport_ethics_q_method_assessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#measurement_tool_resource"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">배드민턴 스포츠윤리 Q방법 평가도구</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q-method assessment for badminton sport ethics</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q방법론을 활용해 배드민턴 선수의 스포츠윤리 주관적 인식을 분류하는 평가 자원.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">배드민턴 선수의 스포츠 윤리에 대한 주관적 인식 유형과 특성</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국체육학회지</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q방법론에 따라 20개 진술문과 7점 척도를 활용해 유형을 분석함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__badminton_sport_ethics_q_method_assessment</isp:entity_id>
    <rdfs:label xml:lang="en">Q-method assessment for badminton sport ethics</rdfs:label>
    <rdfs:comment xml:lang="ko">Q방법론을 활용해 배드민턴 선수의 스포츠윤리 주관적 인식을 분류하는 평가 자원.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Q-method assessment for badminton sport ethics</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">배드민턴 스포츠윤리 Q방법 평가도구</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__athlete_moral_obligation_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__athlete_moral_obligation_education</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 선수 도덕적 의무 교육</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">athlete moral obligation education</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 선수에게 정직성, 책임감, 공정성을 교육하는 스포츠윤리 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 선수의 도덕적 의무에 관한 소고</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠와 윤리</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑과 승부조작 문제를 바탕으로 스포츠 선수에게 요구되는 도덕적 의무로 정직성, 책임감, 공정성을 도출하고 교육적·제도적 실천 방안을 제안하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <isp:utilizes_support_resource rdf:resource="#support_resource__honesty_responsibility_fairness_ethics_content"/>
    <isp:produces_outcome rdf:resource="#outcome__athlete_moral_responsibility_strengthening"/>
    <isp:produces_outcome rdf:resource="#outcome__fair_play_competition_protection"/>
    <rdfs:label xml:lang="en">athlete moral obligation education</rdfs:label>
    <rdfs:comment xml:lang="ko">스포츠 선수에게 정직성, 책임감, 공정성을 교육하는 스포츠윤리 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">athlete moral obligation education</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠 선수 도덕적 의무 교육</skos:prefLabel>
  </rdf:Description>
