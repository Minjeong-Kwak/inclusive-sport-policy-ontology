    <isp:produces_outcome rdf:resource="#outcome__university_sport_multicultural_understanding"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__east_asian_olympic_sport_culture_education</isp:entity_id>
