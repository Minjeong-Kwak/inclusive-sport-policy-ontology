  <rdf:Description rdf:about="#sport_activity__combined_exercise_middle_aged_women">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#fitness_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__combined_exercise_middle_aged_women</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중년여성 복합운동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Combined exercise for middle-aged women</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중년여성의 신체구성, 체력, 혈당, 혈중지질 개선을 위해 수행된 복합운동 활동</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10주간의 복합운동 참여빈도가 중년여성의 신체구성, 체력, 혈당 및 혈중지질 변화에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10주간의 복합운동 프로그램에 참여한 중년 여성 173명을 프로그램 참여 횟수에 따라 주 평균 1회 이하, 주 1회 이상 2회 이하, 주 2회 그룹으로 분류하고, 체성분, 체력, 혈압, 혈당, 혈중 지질 변인을 사전·사후 측정하였다. 복합운동 참여자의 전반적인 신체기능 및 혈중 지질 변인이 개선되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:has_activity_outcome rdf:resource="#outcome__middle_aged_women_physical_function_improvement_combined_exercise"/>
    <isp:has_activity_outcome rdf:resource="#outcome__middle_aged_women_blood_lipid_improvement_combined_exercise"/>
    <rdfs:label xml:lang="en">Combined exercise for middle-aged women</rdfs:label>
    <rdfs:comment xml:lang="ko">중년여성의 신체구성, 체력, 혈당, 혈중지질 개선을 위해 수행된 복합운동 활동</rdfs:comment>
    <skos:prefLabel xml:lang="en">Combined exercise for middle-aged women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">중년여성 복합운동</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__elderly_hypertension_risk_identification_bmi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__elderly_hypertension_risk_identification_bmi</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BMI 기반 노인 고혈압 위험 식별</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Older adult hypertension risk identification based on BMI</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Body mass index and relative handgrip strength are associated with the prevalence of hypertension in Korean elderly: Korean national fitness assessment in 2019</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">과체중과 비만 노인은 정상체중 노인보다 고혈압 유병 가능성이 높게 나타남</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BMI에 따른 노인 고혈압 위험 식별 성과가 직접 제시됨</isp:definition_text>
    <isp:is_produced_by_program rdf:resource="#program__elderly_bmi_relative_grip_strength_screening"/>
    <rdfs:label xml:lang="en">Older adult hypertension risk identification based on BMI</rdfs:label>
    <rdfs:comment xml:lang="ko">BMI에 따른 노인 고혈압 위험 식별 성과가 직접 제시됨</rdfs:comment>
    <skos:prefLabel xml:lang="en">Older adult hypertension risk identification based on BMI</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">BMI 기반 노인 고혈압 위험 식별</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#health_outcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#outcome"/>
    <rdfs:label xml:lang="en">Health Outcome</rdfs:label>
    <rdfs:comment xml:lang="en">An outcome class for changes in physical, mental, or functional health associated with sport participation.</rdfs:comment>
    <skos:definition xml:lang="en">An outcome class for changes in physical, mental, or functional health associated with sport participation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__low_income_adolescent_stress_reduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#mental_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__low_income_adolescent_stress_reduction</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저소득층 청소년 스트레스 감소</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stress reduction among low-income adolescents</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저소득층 청소년의 학교체육활동과 비만도 및 건강인지와의 관련성</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학교체육 활동에 적극 참여한 저소득층 청소년은 평소 스트레스를 적게 느끼는 것으로 나타났다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:reflects_target_group rdf:resource="#target_group__low_income_adolescents_school_pe"/>
    <rdfs:label xml:lang="en">Stress reduction among low-income adolescents</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Stress reduction among low-income adolescents in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Stress reduction among low-income adolescents</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">저소득층 청소년 스트레스 감소</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__low_income_adolescents_school_pe"/>
  </rdf:Description>
