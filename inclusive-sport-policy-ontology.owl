  <rdf:Description rdf:about="#program__local_child_center_body_movement_program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#child_program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지역아동센터 신체 움직임 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Body movement program for students in a local children's center</isp:pref_label_en>
