  <rdf:Description rdf:about="#target_group__korean_elderly_hypertension_fitness_management">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#elderly"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__korean_elderly_hypertension_fitness_management</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고혈압 체력관리가 필요한 한국 노인</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Korean older adults requiring hypertension-related fitness management</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Body mass index and relative handgrip strength are associated with the prevalence of hypertension in Korean elderly: Korean national fitness assessment in 2019</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">65세 이상 한국 노인 44,183명의 BMI, 상대 악력, 고혈압 유병을 분석함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국 노인의 고혈압 위험과 체력 관리 필요성이 직접 제시됨</isp:definition_text>
    <isp:is_targeted_by rdf:resource="#program__elderly_bmi_relative_grip_strength_screening"/>
    <rdfs:label xml:lang="en">Korean older adults requiring hypertension-related fitness management</rdfs:label>
    <rdfs:comment xml:lang="ko">한국 노인의 고혈압 위험과 체력 관리 필요성이 직접 제시됨</rdfs:comment>
    <skos:prefLabel xml:lang="en">Korean older adults requiring hypertension-related fitness management</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">고혈압 체력관리가 필요한 한국 노인</skos:prefLabel>
  </rdf:Description>
