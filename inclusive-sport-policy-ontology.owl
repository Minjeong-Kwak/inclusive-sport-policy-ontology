    <isp:produces_outcome rdf:resource="#outcome__sport_employee_retention_and_work_effort_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__sport_service_employee_commitment_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__sport_organization_commitment_management</isp:entity_id>
