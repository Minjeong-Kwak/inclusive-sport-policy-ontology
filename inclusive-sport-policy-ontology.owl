  <rdf:Description rdf:about="#outcome__adolescent_healthy_activity_diet_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__adolescent_healthy_activity_diet_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년 건강한 신체활동·식습관 지원</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support for healthy physical activity and diet in adolescents</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">약물사용 경험 청소년이 신체활동과 균형 잡힌 식습관을 형성하도록 지원하는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년의 약물사용 경험과 신체 활동 및 건강 관련 행태와의 관련성 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">약물사용 경험 청소년은 바람직하지 않은 식습관을 보인다고 보고하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">support for healthy physical activity and diet in adolescents</rdfs:label>
    <rdfs:comment xml:lang="ko">약물사용 경험 청소년이 신체활동과 균형 잡힌 식습관을 형성하도록 지원하는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">support for healthy physical activity and diet in adolescents</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">청소년 건강한 신체활동·식습관 지원</skos:prefLabel>
  </rdf:Description>
