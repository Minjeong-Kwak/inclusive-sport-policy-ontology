  <rdf:Description rdf:about="#outcome__housewife_swimming_life_satisfaction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#life_satisfaction_improvement"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">주부 수영 생활만족 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Life satisfaction improvement through swimming</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">수영 참여와 운동몰입을 통해 생활만족이 향상되는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">주부 수영참가자의 참여동기 및 운동몰입이 생활만족에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">참여동기와 운동몰입이 생활만족에 유의한 영향을 미치는 것으로 나타남.</isp:evidence_excerpt>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">확실하게 문헌 내용에서 확인 가능한 요소만 제한 반영함.</isp:note>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__housewife_swimming_life_satisfaction</isp:entity_id>
    <rdfs:label xml:lang="en">Life satisfaction improvement through swimming</rdfs:label>
    <rdfs:comment xml:lang="ko">수영 참여와 운동몰입을 통해 생활만족이 향상되는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Life satisfaction improvement through swimming</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">주부 수영 생활만족 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__low_income_elderly_low_pa_nutrition_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#access_condition_context"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저소득 노인의 낮은 신체활동·영양섭취 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Low-income older adults’ low physical activity and nutrition intake context</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저소득 노인의 총 에너지 섭취와 신체활동 수준이 낮게 나타나는 접근 조건 맥락</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analysis of energy intakes, physical activities and metabolic syndrome according to the income level in Korean elderly people: Korean National Health and Nutrition Examination Survey 2016-2018</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">28-35</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data from 2,139 elderly individuals aged over 65 years from KNHANES 2016-2018 showed that older adults with metabolic syndrome and older adults with low income had lower energy intake and physical activity; the study suggested balanced nutrient intake, increased physical activity, education, and program development to prevent metabolic syndrome in the elderly.</isp:evidence_excerpt>
    <isp:reflects_target_group rdf:resource="#target_group__low_income_elderly_metabolic_syndrome_support"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__low_income_elderly_low_pa_nutrition_context</isp:entity_id>
    <rdfs:label xml:lang="en">Low-income older adults’ low physical activity and nutrition intake context</rdfs:label>
    <rdfs:comment xml:lang="ko">저소득 노인의 총 에너지 섭취와 신체활동 수준이 낮게 나타나는 접근 조건 맥락</rdfs:comment>
    <skos:prefLabel xml:lang="en">Low-income older adults’ low physical activity and nutrition intake context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">저소득 노인의 낮은 신체활동·영양섭취 맥락</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__low_income_elderly_metabolic_syndrome_support"/>
  </rdf:Description>
  <rdf:Description rdf:about="#policy__aging_health_promotion_national">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#aging_policy"/>
