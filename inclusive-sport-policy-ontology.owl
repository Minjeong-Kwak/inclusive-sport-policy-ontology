  <rdf:Description rdf:about="#outcome__bdnf_estradiol_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__bdnf_estradiol_improvement</isp:entity_id>
