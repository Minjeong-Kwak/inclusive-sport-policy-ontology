    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">international sport governance setting</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유럽연합(EU)과 국제스포츠기구와의 협력과 갈등: ‘굿 거버넌스’를 중심으로</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EU, IOC, FIFA 등 국제스포츠기구 간 협력과 갈등을 굿 거버넌스 관점에서 분석함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">international sport governance setting</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing international sport governance setting in the participation_context dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">international sport governance setting</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">국제 스포츠 거버넌스 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__physical_activity_importance_awareness_in_pe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__physical_activity_importance_awareness_in_pe</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육수업을 통한 신체활동 중요성 인식</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Awareness of physical activity importance through PE</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exploring Middle School Students' Perceptions of Physical Education Activities During the COVID-19 Pandemic</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학생들은 체육수업을 통해 신체활동의 중요성을 깨달았다고 보고함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학교체육 경험을 통해 신체활동 가치에 대한 인식이 높아지는 성과임</isp:definition_text>
    <rdfs:label xml:lang="en">Awareness of physical activity importance through PE</rdfs:label>
    <rdfs:comment xml:lang="ko">학교체육 경험을 통해 신체활동 가치에 대한 인식이 높아지는 성과임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Awareness of physical activity importance through PE</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">체육수업을 통한 신체활동 중요성 인식</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__visual_impairment_rehab_assessment_framework">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#information_resource"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">시각장애인 재활운동 평가도구 적용 틀</isp:pref_label_ko>
