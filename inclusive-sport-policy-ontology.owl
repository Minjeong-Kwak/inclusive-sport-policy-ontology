    <rdf:type rdf:resource="#outcome"/>
    <rdf:type rdf:resource="#social_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__community_social_participation_increase_2024</isp:entity_id>
