  <rdf:Description rdf:about="#outcome__obese_women_exercise_energy_expenditure_increase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_health_improvement"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만 여성 운동 중 에너지소비 증가</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Increased exercise energy expenditure in obese women</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만 여성의 유산소·유압저항 복합운동 참여 과정에서 고정식 자전거 운동보다 높은 에너지소비가 나타난 신체건강 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acute Energy Expenditure to Concurrent Aerobic and Hydraulic Resistance Exercise in Obese Women</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Exercise Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2010</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">199-203</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nine healthy obese women completed a maximal exercise test and performed submaximal programmed accommodating circuit exercise and stationary cycling. PACE training evoked greater energy expenditure than stationary cycling during submaximal intensity exercise in obese individuals.</isp:evidence_excerpt>
    <isp:reflects_target_group rdf:resource="#target_group__obese_women_energy_expenditure_exercise_support"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__obese_women_exercise_energy_expenditure_increase</isp:entity_id>
    <rdfs:label xml:lang="en">Increased exercise energy expenditure in obese women</rdfs:label>
    <rdfs:comment xml:lang="ko">비만 여성의 유산소·유압저항 복합운동 참여 과정에서 고정식 자전거 운동보다 높은 에너지소비가 나타난 신체건강 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Increased exercise energy expenditure in obese women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">비만 여성 운동 중 에너지소비 증가</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__obese_women_energy_expenditure_exercise_support"/>
  </rdf:Description>
