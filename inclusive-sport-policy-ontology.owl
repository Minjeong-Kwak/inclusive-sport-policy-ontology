    <isp:targets_target_group rdf:resource="#target_group__pre_service_teachers_school_bullying_prevention"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__school_bullying_prevention_policy_information"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__school_bullying_inside_outside_school_context"/>
    <isp:produces_outcome rdf:resource="#outcome__school_bullying_prevention_awareness_improvement"/>
