    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__aesthetic_sport_judging_fairness_improvement</isp:entity_id>
    <rdfs:label xml:lang="en">Improved judging fairness in aesthetic sports</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Improved judging fairness in aesthetic sports in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
