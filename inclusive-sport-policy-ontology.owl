  <rdf:Description rdf:about="#program__reflective_pe_teaching_practice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__reflective_pe_teaching_practice</isp:entity_id>
