    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">윤리적 가치관 및 윤리의식 향상</isp:pref_label_ko>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학생선수의 일상생활에서 인성이 윤리적 가치관 및 윤리의식에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__ethical_values_and_awareness_improvement</isp:entity_id>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ethical Values and Awareness Improvement</isp:pref_label_en>
    <rdfs:label xml:lang="en">Ethical Values and Awareness Improvement</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Ethical Values and Awareness Improvement in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Ethical Values and Awareness Improvement</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">윤리적 가치관 및 윤리의식 향상</skos:prefLabel>
  </rdf:Description>
