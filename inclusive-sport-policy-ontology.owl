  <rdf:Description rdf:about="#outcome__college_athlete_training_motivation_disruption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_continuity"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__college_athlete_training_motivation_disruption</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대학운동선수 훈련참여동기 저하</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disruption of training participation motivation in college athletes</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Effects of Injury of College Athletes on Training Participation Motivation and Exercise Commitment in the COVID-19 Situation</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">상해심리가 훈련참여동기의 내적동기와 외적동기에 유의한 영향을 미침</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">상해경험과 감염병 맥락에서 훈련참여 지속성이 저하되는 성과임</isp:definition_text>
    <rdfs:label xml:lang="en">Disruption of training participation motivation in college athletes</rdfs:label>
    <rdfs:comment xml:lang="ko">상해경험과 감염병 맥락에서 훈련참여 지속성이 저하되는 성과임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Disruption of training participation motivation in college athletes</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">대학운동선수 훈련참여동기 저하</skos:prefLabel>
  </rdf:Description>
