  <rdf:Description rdf:about="#support_resource__pyeongchang_paralympic_ict_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#digital_device"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__pyeongchang_paralympic_ict_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">평창동계패럴림픽 ICT 지원 자원</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PyeongChang Paralympic ICT support resource</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">첨단 ICT 패럴림픽 운영을 통해 장애인스포츠 대회 참여와 접근성을 지원한 디지털 자원</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018 평창동계패럴림픽 레거시 및 결산 고찰</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국특수체육학회지</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018 평창동계패럴림픽의 레거시를 스포츠, 사회, 환경, 도시, 경제에 더해 문화, ICT, 평화 레거시로 고찰하고, 홍보, 예산, 참가자, 관람객, 자원봉사자, 등급분류 제로정책, 체육시설 활용, 수송 및 접근성 극대화, 도핑테스트, 방송·취재 환경, 첨단 ICT 패럴림픽 운영을 결산하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <isp:supports_program rdf:resource="#program__pyeongchang_paralympic_accessibility_support"/>
    <rdfs:label xml:lang="en">PyeongChang Paralympic ICT support resource</rdfs:label>
    <rdfs:comment xml:lang="ko">첨단 ICT 패럴림픽 운영을 통해 장애인스포츠 대회 참여와 접근성을 지원한 디지털 자원</rdfs:comment>
    <skos:prefLabel xml:lang="en">PyeongChang Paralympic ICT support resource</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">평창동계패럴림픽 ICT 지원 자원</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__disabled_children_effort_importance_increase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#self_efficacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__disabled_children_effort_importance_increase</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애아동 노력·중요성 인식 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Effort and importance perception increase among disabled children</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">재활승마 프로그램 참여가 장애아동의 내적동기에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">재활승마 프로그램 참여 후 노력-중요성 요인에서 유의한 변화가 나타났다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:reflects_target_group rdf:resource="#target_group__disabled_children_hippotherapy"/>
    <rdfs:label xml:lang="en">Effort and importance perception increase among disabled children</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Effort and importance perception increase among disabled children in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Effort and importance perception increase among disabled children</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">장애아동 노력·중요성 인식 향상</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__disabled_children_hippotherapy"/>
  </rdf:Description>
  <rdf:Description rdf:about="#program__twelve_week_weight_training_program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__twelve_week_weight_training_program</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주 웨이트 트레이닝 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twelve-week weight training program</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">웨이트 트레이닝이 남자 대학생의 신체구성, 성장호르몬, 테스토스테론 및 호모시스테인에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1RM 65% 강도, 주 4회, 12주간 웨이트 트레이닝을 실시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Added in v52 from uploaded academic literature; class assignment limited to directly evidenced entities.</isp:note>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:targets_target_group rdf:resource="#target_group__male_college_students_weight_training"/>
    <isp:produces_outcome rdf:resource="#outcome__body_composition_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__muscle_mass_increase"/>
    <rdfs:label xml:lang="en">Twelve-week weight training program</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Twelve-week weight training program in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Twelve-week weight training program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">12주 웨이트 트레이닝 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__male_college_students_weight_training"/>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__after_school_care_gap_reduction_neulbom_pe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#access_equity_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__after_school_care_gap_reduction_neulbom_pe</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">늘봄학교 돌봄 공백 해소</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reduction of after-school care gaps through Neulbom PE</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">늘봄학교에서의 체육 프로그램 역할에 대한 연구</isp:source_title>
