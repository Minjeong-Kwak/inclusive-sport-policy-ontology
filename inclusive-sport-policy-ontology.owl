    <rdfs:comment xml:lang="en">Named individual representing Overweight elementary school students in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Overweight elementary school students</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">과체중 초등학생</skos:prefLabel>
  </rdf:Description>
