  <rdf:Description rdf:about="#program__game_based_pe_aerobic_fitness_lessons">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_linked_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__game_based_pe_aerobic_fitness_lessons</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">게임 기반 유산소 체력 체육수업</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Game-based PE lessons for aerobic fitness</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Effect of 4 weeks of Fun Game-Based and Structured Interval Training Physical Education Lessons on Aerobic Fitness in Adolescents</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4주간 게임 기반 체육수업이 2.4km 달리기 기록을 유의하게 개선함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년 유산소 체력 향상을 위해 게임 기반으로 설계된 학교체육 프로그램임</isp:definition_text>
    <isp:targets_target_group rdf:resource="#target_group__adolescent_school_pe_aerobic_fitness"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__small_sided_game_aerobic_training"/>
    <isp:produces_outcome rdf:resource="#outcome__adolescent_24km_run_time_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__adolescent_pe_enjoyment_based_aerobic_training"/>
    <rdfs:label xml:lang="en">Game-based PE lessons for aerobic fitness</rdfs:label>
    <rdfs:comment xml:lang="ko">청소년 유산소 체력 향상을 위해 게임 기반으로 설계된 학교체육 프로그램임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Game-based PE lessons for aerobic fitness</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">게임 기반 유산소 체력 체육수업</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__adolescent_school_pe_aerobic_fitness"/>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__cas_arbitration_procedure_knowledge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#guideline_manual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__cas_arbitration_procedure_knowledge</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAS 중재절차 지식자료</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAS arbitration procedure knowledge resource</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAS 발전과정, 중재절차, 관할권, 스포츠 분쟁 유형을 설명하는 법적 지식 자원</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 분쟁해결 -CAS 중재절차를 중심으로-</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국제거래법연구</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAS의 발전과정, 중재절차, 스포츠 분쟁해결의 신속성, 축구 고용분쟁, 징계분쟁, 승부조작 및 윤리분쟁, 한국 관련 사례와 CAS 관할권을 검토하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">CAS arbitration procedure knowledge resource</rdfs:label>
    <rdfs:comment xml:lang="ko">CAS 발전과정, 중재절차, 관할권, 스포츠 분쟁 유형을 설명하는 법적 지식 자원</rdfs:comment>
    <skos:prefLabel xml:lang="en">CAS arbitration procedure knowledge resource</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">CAS 중재절차 지식자료</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__collaborative_antidoping_governance_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#integrated_policy_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__collaborative_antidoping_governance_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">협력적 반도핑 거버넌스 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation context  collaborative antidoping governance context</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트선수의 인식을 통해 살펴본 도핑관리시스템의 문제</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 선수 인식 연구에서 대표선수 중심 도핑관리, 형식적 교육, 행정적 한계가 지적되었고 학생선수 중심 예방교육, 종목별 매뉴얼, 전담인력, 협력 거버넌스가 대안으로 제시됨.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">participation context  collaborative antidoping governance context</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing participation context  collaborative antidoping governance context in the participation_context dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">participation context  collaborative antidoping governance context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">협력적 반도핑 거버넌스 맥락</skos:prefLabel>
  </rdf:Description>
