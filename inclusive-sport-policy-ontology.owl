    <rdfs:label xml:lang="en">Sport Basic Law Regulation Resource</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Sport Basic Law Regulation Resource in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Sport Basic Law Regulation Resource</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠기본법 법령 자원</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#sport_activity__telecommunication_rehabilitation_exercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#remote_coaching"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__telecommunication_rehabilitation_exercise</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">원격 운동재활 활동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Telecommunication rehabilitation exercise</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애노인을 대상으로 비대면 방식으로 제공된 원격 운동재활 활동</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간 원격운동 프로그램이 장애노인의 삶의 질에 미치는 효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애노인 25명을 대상으로 원격운동 프로그램 참여군 12명과 비참여군 13명을 구분하고, 참여군은 12주간 주 2회 비대면 운동재활 프로그램에 참여하였다. 신체건강의 피로와 통증, 정신건강의 불안과 우울, 사회건강의 사회생활 변인에서 긍정적 효과가 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">Telecommunication rehabilitation exercise</rdfs:label>
    <rdfs:comment xml:lang="ko">장애노인을 대상으로 비대면 방식으로 제공된 원격 운동재활 활동</rdfs:comment>
    <skos:prefLabel xml:lang="en">Telecommunication rehabilitation exercise</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">원격 운동재활 활동</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__tgmd2_gross_motor_skill_assessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#information_resource"/>
