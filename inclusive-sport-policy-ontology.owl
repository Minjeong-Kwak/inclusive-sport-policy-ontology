    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__developmental_disability_physical_fitness_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">발달장애 체력 증진</isp:pref_label_ko>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">발달장애인 체력 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical fitness improvement for developmental disabilities</isp:pref_label_en>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improved physical fitness among people with developmental disabilities</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">발달장애인의 신체적 건강 및 체력 증진 성과</isp:definition_text>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">발달장애인의 운동 참여율과 체력·심혈관 건강 수준이 낮고, 유산소 및 저항운동이 체력과 심혈관 건강에 긍정적 영향을 미치는 것으로 정리함.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">발달장애 대상 특수체육 연구 트랜드 탐색: LDA 기반 토픽모델링의 활용</isp:source_title>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동과 발달장애인의 체력 및 심혈관 건강에 관한 문헌 고찰 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">발달장애인의 운동 참여율과 체력·심혈관 건강 수준이 낮고, 유산소 및 저항운동이 체력과 심혈관 건강에 긍정적 영향을 미치는 것으로 정리함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">physical fitness improvement for developmental disabilities</rdfs:label>
    <rdfs:comment xml:lang="ko">발달장애인의 신체적 건강 및 체력 증진 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">physical fitness improvement for developmental disabilities</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">발달장애 체력 증진</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__sedentary_behavior_reduction_school_pe_program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_linked_program"/>
