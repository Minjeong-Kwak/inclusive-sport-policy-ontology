    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동선수와 지도자, 팀닥터, 가족의 건강을 고려한 예방접종 필요성과 국제대회·훈련 환경에 따른 백신 가이드라인 수립 필요를 제시함.</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동선수와 지도자, 팀닥터, 가족의 건강을 고려한 예방접종 필요성과 국제대회·훈련 환경에 따른 백신 가이드라인 수립 필요를 제시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Sports Medicine</isp:source_publisher>
    <isp:targets_target_group rdf:resource="#target_group__athletes_vaccination_guideline"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__athlete_vaccination_guideline"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__team_travel_training_infection_risk_context"/>
    <isp:produces_outcome rdf:resource="#outcome__infectious_disease_risk_reduction_athletes"/>
    <rdfs:label xml:lang="en">Vaccination program for infectious disease prevention in athletes</rdfs:label>
    <rdfs:comment xml:lang="ko">운동선수와 지도자, 팀닥터, 가족의 건강을 고려한 예방접종 필요성과 국제대회·훈련 환경에 따른 백신 가이드라인 수립 필요를 제시함.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Vaccination program for infectious disease prevention in athletes</skos:prefLabel>
