  <rdf:Description rdf:about="#outcome__supplement_safety_and_doping_risk_awareness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#system_level_outcome"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">보충제 안전 및 도핑위험 인식 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improved awareness of supplement safety and doping risk</isp:pref_label_en>
