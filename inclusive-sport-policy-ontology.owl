    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">골프 여가참여</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">golf leisure participation</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">기본적 심리욕구는 골프지속참여의도를 예측하는데 얼마나 효과적인가?</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">골프 지속참여의도를 예측하는 심리욕구 변인을 분석함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__golf_leisure_participation</isp:entity_id>
    <rdfs:label xml:lang="en">golf leisure participation</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing golf leisure participation in the sport_activity dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">golf leisure participation</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">골프 여가참여</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__bodybuilding_health_risk_awareness_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">보디빌딩 건강위험 인식 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bodybuilding health risk awareness improvement</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">보디빌딩 참여자가 약물, 과훈련, 극단적 식이로 인한 건강위험을 이해하는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">보디빌딩의 의학적 문제: 약물, 고강도 훈련, 극단적 식이에 따른 건강 위험</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대한스포츠의학회지</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">갑작스런 심장사, 근골격 통증, 신장 손상, 대사기능 이상 등 건강위험을 검토함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__bodybuilding_health_risk_awareness_improvement</isp:entity_id>
    <rdfs:label xml:lang="en">Bodybuilding health risk awareness improvement</rdfs:label>
    <rdfs:comment xml:lang="ko">보디빌딩 참여자가 약물, 과훈련, 극단적 식이로 인한 건강위험을 이해하는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Bodybuilding health risk awareness improvement</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">보디빌딩 건강위험 인식 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__school_student_postural_abnormality_prevention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#functional_ability_improvement"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학생 자세 이상 예방</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Prevention of postural abnormalities among students</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">가방 하중으로 인한 자세 변화와 균형 문제를 예방하는 기능능력 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analytical parameters to check association between load carriage system and bag packs-influenced musculoskeletal complications among school going students: a scoping review</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">review_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">20-26</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The scoping review found that backpack load and load-carriage systems among school-going students were associated with lower back, shoulder, and neck pain and postural abnormalities, and recommended broader evaluation and preventive approaches.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__school_student_postural_abnormality_prevention</isp:entity_id>
    <rdfs:label xml:lang="en">Prevention of postural abnormalities among students</rdfs:label>
    <rdfs:comment xml:lang="ko">가방 하중으로 인한 자세 변화와 균형 문제를 예방하는 기능능력 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Prevention of postural abnormalities among students</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">학생 자세 이상 예방</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__visual_impairment_cognitive_social_function_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#social_integration_outcome"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">시각장애인 인지·사회성 기능 지원</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cognitive and social functioning support for people with visual impairment</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">시각장애인 재활운동 및 체육 프로그램과 평가에 대한 체계적 문헌고찰</isp:source_title>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">systematic_review</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">인지 및 사회성 관련 변인이 시각장애인 재활운동 및 체육 프로그램 평가변인으로 확인됨</isp:evidence_excerpt>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">v45 추가 인스턴스</isp:note>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">v45_batch</isp:source_identifier>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__visual_impairment_cognitive_social_function_support</isp:entity_id>
    <rdfs:label xml:lang="en">Cognitive and social functioning support for people with visual impairment</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Cognitive and social functioning support for people with visual impairment in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Cognitive and social functioning support for people with visual impairment</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">시각장애인 인지·사회성 기능 지원</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#sport_activity__morning_physical_activity_elementary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_sport"/>
