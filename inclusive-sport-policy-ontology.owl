  <rdf:Description rdf:about="#outcome__pediatric_hepatic_fat_accumulation_reduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__pediatric_hepatic_fat_accumulation_reduction</isp:entity_id>
