  <rdf:Description rdf:about="#participation_context__pyeongchang_paralympic_event_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#integrated_policy_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__pyeongchang_paralympic_event_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">평창동계패럴림픽 통합 운영 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PyeongChang Paralympic integrated event context</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠, 접근성, 수송, ICT, 자원봉사, 시설 활용이 결합된 패럴림픽 참여 및 운영 맥락</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018 평창동계패럴림픽 레거시 및 결산 고찰</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국특수체육학회지</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018 평창동계패럴림픽의 레거시를 스포츠, 사회, 환경, 도시, 경제에 더해 문화, ICT, 평화 레거시로 고찰하고, 홍보, 예산, 참가자, 관람객, 자원봉사자, 등급분류 제로정책, 체육시설 활용, 수송 및 접근성 극대화, 도핑테스트, 방송·취재 환경, 첨단 ICT 패럴림픽 운영을 결산하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">PyeongChang Paralympic integrated event context</rdfs:label>
    <rdfs:comment xml:lang="ko">스포츠, 접근성, 수송, ICT, 자원봉사, 시설 활용이 결합된 패럴림픽 참여 및 운영 맥락</rdfs:comment>
    <skos:prefLabel xml:lang="en">PyeongChang Paralympic integrated event context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">평창동계패럴림픽 통합 운영 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__elementary_sport_resilience_support">
