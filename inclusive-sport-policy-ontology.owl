  <rdf:Description rdf:about="#program__elite_athlete_dual_career_public_service_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__elite_athlete_dual_career_public_service_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">공공직 연계 엘리트 선수 듀얼커리어 지원</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program  elite athlete dual career public service support</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여섯 키워드로 본 독일 엘리트스포츠 시스템에 대한 사적 고찰</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">독일 엘리트스포츠 시스템은 독일올림픽스포츠연맹, 연구소, 올림픽훈련센터, 스포츠학교, 카더 시스템, 연방경찰·군·세관 지원을 핵심 요소로 제시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:utilizes_support_resource rdf:resource="#support_resource__german_olympic_training_center_model"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__german_sport_research_institute_model"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__german_kader_athlete_system"/>
    <isp:produces_outcome rdf:resource="#outcome__elite_athlete_support_system_professionalization"/>
    <rdfs:label xml:lang="en">program  elite athlete dual career public service support</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing program  elite athlete dual career public service support in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">program  elite athlete dual career public service support</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">공공직 연계 엘리트 선수 듀얼커리어 지원</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__weight_category_judo_competition_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#institutional_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__weight_category_judo_competition_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체급제 유도 경기 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation context  weight category judo competition context</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 유도선수들의 반도핑 경향에 대한 근원적 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 유도선수 10명 질적연구에서 도핑 인지 수준, 도핑검사 경험, 체급 특성에 따른 도핑 유혹, 윤리교육의 필요가 제시됨.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">participation context  weight category judo competition context</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing participation context  weight category judo competition context in the participation_context dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">participation context  weight category judo competition context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">체급제 유도 경기 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__middle_school_soccer_students">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#adolescent"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__middle_school_soccer_students</isp:entity_id>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Middle-school students participating in Saturday Sports Day soccer class</isp:pref_label_en>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">generated_from_existing_instance_iri</isp:source_identifier>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Literal metadata was automatically added from the existing ontology structure; bibliographic source values were not inferred.</isp:note>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">토요스포츠데이 축구수업 참여 중학생</isp:pref_label_ko>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">서울 시내 중학교 토요스포츠데이 축구수업에 참여한 2학년 남학생 집단</isp:definition_text>
    <isp:target_participant_size rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">90</isp:target_participant_size>
    <isp:applies_to_gender rdf:datatype="http://www.w3.org/2001/XMLSchema#string">male</isp:applies_to_gender>
    <isp:applies_to_age_range rdf:datatype="http://www.w3.org/2001/XMLSchema#string">middle school grade 2</isp:applies_to_age_range>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">360도 어라운드 뷰와 슬로우 모션 테크놀로지를 활용한 피드백 제공이 중학생 축구 수업만족도에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">서울 시내 3개 중학교의 토요스포츠데이 축구수업을 수강하는 2학년 남학생 90명을 대상으로 360° Around View 영상 피드백, 모바일 Slow Motion 영상 피드백, 구두 피드백 집단을 비교하였고, 교육적·신체적·심리적 수업 만족도에서 360° Around View 영상 피드백 집단의 만족도가 가장 높게 나타났다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">Middle-school students participating in Saturday Sports Day soccer class</rdfs:label>
    <rdfs:comment xml:lang="ko">서울 시내 중학교 토요스포츠데이 축구수업에 참여한 2학년 남학생 집단</rdfs:comment>
    <skos:prefLabel xml:lang="en">Middle-school students participating in Saturday Sports Day soccer class</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">토요스포츠데이 축구수업 참여 중학생</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__sport_violence_prevention_people_first_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__sport_violence_prevention_people_first_education</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">사람 우선 스포츠폭력 예방 교육</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">people-first sport violence prevention education</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠보다 사람을 우선한다는 관점에서 스포츠 폭력과 성폭력을 예방하기 위한 교육 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠보다 사람이 우선입니다</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 폭력의 원인을 금메달만 추구하는 운동문화와 사람보다 스포츠를 우선하는 구조에서 찾고, 사람 중심 스포츠로의 전환을 제안하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <isp:is_implemented_by_policy rdf:resource="#policy__people_centered_sport_culture_reform"/>
    <isp:produces_outcome rdf:resource="#outcome__sport_violence_prevention_awareness"/>
    <rdfs:label xml:lang="en">people-first sport violence prevention education</rdfs:label>
    <rdfs:comment xml:lang="ko">스포츠보다 사람을 우선한다는 관점에서 스포츠 폭력과 성폭력을 예방하기 위한 교육 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">people-first sport violence prevention education</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">사람 우선 스포츠폭력 예방 교육</skos:prefLabel>
  </rdf:Description>
