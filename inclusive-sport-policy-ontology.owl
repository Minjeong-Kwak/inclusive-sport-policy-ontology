    <skos:prefLabel xml:lang="en">community sport volunteering</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__male_student_volunteers"/>
    <isp:has_target_group_anchor rdf:resource="#target_group__college_student_volunteers"/>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__school_students_backpack_musculoskeletal_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_age_child"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">가방 하중 관련 근골격계 지원이 필요한 학생</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">School-going students requiring backpack-related musculoskeletal support</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학교 가방 하중으로 목, 어깨, 허리 통증과 자세 문제가 발생할 수 있는 학령기 학생 대상 집단</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analytical parameters to check association between load carriage system and bag packs-influenced musculoskeletal complications among school going students: a scoping review</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">review_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">20-26</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The scoping review found that backpack load and load-carriage systems among school-going students were associated with lower back, shoulder, and neck pain and postural abnormalities, and recommended broader evaluation and preventive approaches.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__school_students_backpack_musculoskeletal_support</isp:entity_id>
    <rdfs:label xml:lang="en">School-going students requiring backpack-related musculoskeletal support</rdfs:label>
    <rdfs:comment xml:lang="ko">학교 가방 하중으로 목, 어깨, 허리 통증과 자세 문제가 발생할 수 있는 학령기 학생 대상 집단</rdfs:comment>
    <skos:prefLabel xml:lang="en">School-going students requiring backpack-related musculoskeletal support</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">가방 하중 관련 근골격계 지원이 필요한 학생</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__twelve_week_circuit_plyometric_training_elementary_students">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_linked_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__twelve_week_circuit_plyometric_training_elementary_students</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">초등학생 12주 서킷-플라이오메트릭 트레이닝 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twelve-week circuit-plyometric training program for elementary school students</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">초등학생을 대상으로 12주간 주 3회, 회당 50분씩 운영된 서킷 및 플라이오메트릭 트레이닝 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간의 서킷-플라이오메트릭 트레이닝이 초등학생의 신체 구성과 체력에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">S시 소재 초등학생 30명을 대상으로 12주간 주 3회, 회당 50분씩 서킷 트레이닝과 플라이오메트릭 트레이닝을 실시하였다. 체질량지수 감소, 심폐지구력, 근지구력, 유연성, 순발력 향상이 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:program_duration_weeks rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</isp:program_duration_weeks>
    <isp:session_frequency_per_week rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</isp:session_frequency_per_week>
    <isp:session_duration_minutes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50</isp:session_duration_minutes>
    <isp:target_participant_size rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</isp:target_participant_size>
    <isp:targets_target_group rdf:resource="#target_group__elementary_students_circuit_plyometric_training"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__circuit_training_elementary_students"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__plyometric_training_elementary_students"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__twelve_week_school_fitness_training_elementary_students"/>
    <isp:produces_outcome rdf:resource="#outcome__elementary_students_bmi_reduction_circuit_plyometric"/>
    <isp:produces_outcome rdf:resource="#outcome__elementary_students_health_fitness_improvement_circuit_plyometric"/>
    <isp:produces_outcome rdf:resource="#outcome__elementary_students_power_improvement_circuit_plyometric"/>
    <rdfs:label xml:lang="en">Twelve-week circuit-plyometric training program for elementary school students</rdfs:label>
    <rdfs:comment xml:lang="ko">초등학생을 대상으로 12주간 주 3회, 회당 50분씩 운영된 서킷 및 플라이오메트릭 트레이닝 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Twelve-week circuit-plyometric training program for elementary school students</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">초등학생 12주 서킷-플라이오메트릭 트레이닝 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__elementary_students_circuit_plyometric_training"/>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__elderly_death_anxiety_monitoring">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#psychological_health_improvement"/>
    <rdf:type rdf:resource="#outcome"/>
