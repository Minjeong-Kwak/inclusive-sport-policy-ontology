  <rdf:Description rdf:about="#outcome__dance_movement_stability_improvement">
    <rdf:type rdf:resource="#physical_competence_improvement"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__dance_movement_stability_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국무용 동작 안정성 및 신체역량 개선</isp:pref_label_ko>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국무용 큰받침뜀체 동작 시 하지의 근 활성도 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">하지 힘 조절과 몸통 균형 유지를 위한 강화운동 필요성이 제시되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dance Movement Stability Improvement</isp:pref_label_en>
    <rdfs:label xml:lang="en">Dance Movement Stability Improvement</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Dance Movement Stability Improvement in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Dance Movement Stability Improvement</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">한국무용 동작 안정성 및 신체역량 개선</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__asd_children_motor_social_participation_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_competence_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__asd_children_motor_social_participation_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">자폐스펙트럼 아동 운동·사회 참여 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improved motor and social participation among children with ASD</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠게임 참여를 통해 자폐스펙트럼 아동의 운동능력과 사회적 참여를 함께 높이는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Combined Orff Music And Sports Activity To Enhances Autism Children’s Social Skills: Trials Of Intervention Effectiveness</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022 3rd Asia Sport Science Conference Abstracts</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conference_abstract</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">107-109</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The conference abstract recruited twenty-two children with ASD and applied a 9-week Orff music combined sports game intervention three times per week. The intervention improved social skills in children with mild to moderate ASD, with better social interaction effects in the experimental group than the sports-game control group.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <rdfs:label xml:lang="en">Improved motor and social participation among children with ASD</rdfs:label>
    <rdfs:comment xml:lang="ko">스포츠게임 참여를 통해 자폐스펙트럼 아동의 운동능력과 사회적 참여를 함께 높이는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Improved motor and social participation among children with ASD</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">자폐스펙트럼 아동 운동·사회 참여 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__liberal_pe_participation_satisfaction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__liberal_pe_participation_satisfaction</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">교양체육 참여만족 증진</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">liberal physical education participation satisfaction</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">교양체육 참여를 통해 건강·체력관리 능력과 여가 기술 습득에 대한 만족이 높아지는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지역사회 연계형 교양체육 모형 개발을 위한 기초연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2016</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학생들은 교양체육 효과로 건강 및 체력관리 능력과 여가생활 기술 습득을 높게 응답하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">liberal physical education participation satisfaction</rdfs:label>
    <rdfs:comment xml:lang="ko">교양체육 참여를 통해 건강·체력관리 능력과 여가 기술 습득에 대한 만족이 높아지는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">liberal physical education participation satisfaction</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">교양체육 참여만족 증진</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__students_outdoor_pe_particulate_matter_exposure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_age_child"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__students_outdoor_pe_particulate_matter_exposure</isp:entity_id>
