    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">남성 노인에서 낮은 상대악력이 고혈압 유병과 관련됨</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">상대악력에 따른 노인 고혈압 위험 식별 성과가 직접 제시됨</isp:definition_text>
    <isp:is_produced_by_program rdf:resource="#program__elderly_bmi_relative_grip_strength_screening"/>
    <rdfs:label xml:lang="en">Older adult hypertension risk identification based on relative handgrip strength</rdfs:label>
    <rdfs:comment xml:lang="ko">상대악력에 따른 노인 고혈압 위험 식별 성과가 직접 제시됨</rdfs:comment>
    <skos:prefLabel xml:lang="en">Older adult hypertension risk identification based on relative handgrip strength</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">상대악력 기반 노인 고혈압 위험 식별</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__pe_emotional_cognitive_engagement_increase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_outcome"/>
