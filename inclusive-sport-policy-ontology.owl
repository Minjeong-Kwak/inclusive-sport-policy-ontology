  <rdf:Description rdf:about="#participation_context__taekwondo_competition_sustainability_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#institutional_context"/>
