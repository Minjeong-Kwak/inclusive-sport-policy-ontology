    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동선수 정신건강 위험 인식 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">athlete mental health risk awareness improvement</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동선수도 정신질환을 경험할 수 있다는 인식과 지원 필요성을 높이는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 정신의학: 스포츠 선수도 정신질환이 생긴다</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠과학</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 선수에게도 우울, 불안, 강박, 거식, 불면 등 정신질환이 나타날 수 있으며 선수 수행과 경력에 심각한 영향을 줄 수 있다고 설명하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">athlete mental health risk awareness improvement</rdfs:label>
    <rdfs:comment xml:lang="ko">운동선수도 정신질환을 경험할 수 있다는 인식과 지원 필요성을 높이는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">athlete mental health risk awareness improvement</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">운동선수 정신건강 위험 인식 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__particulate_matter_exercise_chamber_model">
