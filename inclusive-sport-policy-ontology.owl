    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Body mass index and relative handgrip strength are associated with the prevalence of hypertension in Korean elderly: Korean national fitness assessment in 2019</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국 노인체력인증 자료를 활용하여 BMI와 상대악력에 따른 고혈압 유병을 분석함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인체력평가 자료를 활용한 건강위험 선별 프로그램으로 직접 연결 가능함</isp:definition_text>
    <isp:targets_target_group rdf:resource="#target_group__korean_elderly_hypertension_fitness_management"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__korean_national_fitness_assessment_2019_elderly"/>
    <isp:produces_outcome rdf:resource="#outcome__elderly_hypertension_risk_identification_bmi"/>
    <isp:produces_outcome rdf:resource="#outcome__elderly_hypertension_risk_identification_relative_grip_strength"/>
    <isp:produces_outcome rdf:resource="#outcome__elderly_muscle_strength_health_risk_monitoring"/>
    <rdfs:label xml:lang="en">Older adult BMI and relative handgrip strength screening program</rdfs:label>
    <rdfs:comment xml:lang="ko">노인체력평가 자료를 활용한 건강위험 선별 프로그램으로 직접 연결 가능함</rdfs:comment>
    <skos:prefLabel xml:lang="en">Older adult BMI and relative handgrip strength screening program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">노인 BMI·상대악력 기반 건강 선별 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__korean_elderly_hypertension_fitness_management"/>
  </rdf:Description>
  <rdf:Description rdf:about="#program__adapted_physical_activity_ethics_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__adapted_physical_activity_ethics_education</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">특수체육 윤리교육 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ethics education program for adapted physical activity</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">특수체육지도자가 장애 학생 및 참여자와의 관계에서 윤리적으로 판단하고 실천하도록 지원하는 교육 프로그램.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">특수체육실천영역에 관한 윤리학적 고찰</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">예비특수체육지도자를 위한 윤리교육 기초자료로 활용될 수 있음을 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:targets_target_group rdf:resource="#target_group__adapted_physical_activity_instructors_ethics"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__adapted_physical_activity_ethics_theory_framework"/>
    <isp:produces_outcome rdf:resource="#outcome__adapted_physical_activity_ethics_sensitivity"/>
    <rdfs:label xml:lang="en">ethics education program for adapted physical activity</rdfs:label>
    <rdfs:comment xml:lang="ko">특수체육지도자가 장애 학생 및 참여자와의 관계에서 윤리적으로 판단하고 실천하도록 지원하는 교육 프로그램.</rdfs:comment>
    <skos:prefLabel xml:lang="en">ethics education program for adapted physical activity</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">특수체육 윤리교육 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__adapted_physical_activity_instructors_ethics"/>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__female_nurses_standing_work">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#target_group"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__female_nurses_standing_work</isp:entity_id>
