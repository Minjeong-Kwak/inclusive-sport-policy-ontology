    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sports nutrition expert exchange and training program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠영양 전문가 양성과 학술교류를 통해 선수 및 현장 지원 역량을 강화하는 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An academic cooperation between the Japan Sports Nutrition Association (JSNA) and the Korean Society for Exercise Nutrition (KSEN)</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">20-22</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The JSNA provides evidence-based sports nutrition information, networking, and training opportunities; JSNA and KSEN exchanged an MoU in 2018 and organized academic exchange events based on the MoU.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
