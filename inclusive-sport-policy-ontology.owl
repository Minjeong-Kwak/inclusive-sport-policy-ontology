    <skos:prefLabel xml:lang="en">Identification of stress sources among elite swimmers</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">엘리트 수영선수 스트레스 원천 식별</skos:prefLabel>
  </rdf:Description>
