    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">과체중 학생 신체구성 개선</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Body composition improvement for overweight students</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">뉴스포츠 체육수업이 고등학생의 건강체력 개선에 미치는 생리학적 효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">뉴스포츠 체육수업은 과체중 남학생과 정상체중 여학생의 체중, BMI, 체지방률 개선에 효과가 있었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-15</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <rdfs:label xml:lang="en">Body composition improvement for overweight students</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Body composition improvement for overweight students in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Body composition improvement for overweight students</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">과체중 학생 신체구성 개선</skos:prefLabel>
  </rdf:Description>
