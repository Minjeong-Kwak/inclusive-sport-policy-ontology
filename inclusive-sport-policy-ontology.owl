    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">개인 성찰, 대중문화, 교차문화 교육과정을 통해 올림피즘과 스포츠문화를 교육하는 프로그램임</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:targets_target_group rdf:resource="#target_group__east_asian_university_students"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__university_sport_cultural_exchange"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__east_asian_university_sport_exchange_context"/>
