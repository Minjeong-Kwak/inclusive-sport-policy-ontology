    <isp:delivers_sport_activity rdf:resource="#sport_activity__adult_taekwondo_training"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__adult_taekwondo_safe_facility_resource"/>
    <isp:produces_outcome rdf:resource="#outcome__adult_taekwondo_participation_expansion"/>
