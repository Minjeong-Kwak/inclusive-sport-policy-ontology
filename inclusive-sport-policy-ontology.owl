  <rdf:Description rdf:about="#program__taekwondo_dojang_quarantine_guideline_program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#safety_risk_management_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__taekwondo_dojang_quarantine_guideline_program</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">태권도장 방역지침 운영 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taekwondo dojang quarantine guideline program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">코로나19 상황에서 태권도장 운영을 위한 시설·환경·직원·고객관리 중심의 방역관리 프로그램.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">코로나-19 확산 방지를 위한 태권도장 방역지침 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">태권도장에 적합한 방역지침 49개를 선별하고 시설확보, 환경관리, 직원운영, 고객관리로 범주화함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated_v68_added_from_uploaded_literature</isp:note>
    <isp:utilizes_support_resource rdf:resource="#support_resource__taekwondo_dojang_quarantine_guideline"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__taekwondo_dojang_pandemic_operation"/>
    <isp:produces_outcome rdf:resource="#outcome__infection_risk_management_in_sport_facility"/>
    <rdfs:label xml:lang="en">Taekwondo dojang quarantine guideline program</rdfs:label>
    <rdfs:comment xml:lang="ko">코로나19 상황에서 태권도장 운영을 위한 시설·환경·직원·고객관리 중심의 방역관리 프로그램.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Taekwondo dojang quarantine guideline program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">태권도장 방역지침 운영 프로그램</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__guillain_barre_quality_of_life_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#quality_of_life_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__guillain_barre_quality_of_life_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">길랭-바레 증후군 삶의 질 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quality of life improvement in Guillain-Barre syndrome</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Changes in body composition, physical fitness and quality of life on robotic gait assisted training in patients with Guillain-Barré Syndrome: a case report</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">로봇 보행 훈련 후 신체기능 및 삶의 질 지표 개선이 보고됨</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">로봇 보행 훈련이 삶의 질 향상과 연결됨</isp:definition_text>
    <rdfs:label xml:lang="en">Quality of life improvement in Guillain-Barre syndrome</rdfs:label>
