    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">개인차를 고려한 맞춤형 체육수업과 역량중심 교육 실현을 제시함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">personalized PE learning support for all students</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing personalized PE learning support for all students in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">personalized PE learning support for all students</skos:prefLabel>
