    <rdfs:label xml:lang="en">reduced adolescent drug use frequency through PE</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing reduced adolescent drug use frequency through PE in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">reduced adolescent drug use frequency through PE</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">청소년 약물 사용 빈도 감소</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__adolescents_drug_use_prevention_pe"/>
  </rdf:Description>
