    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__low_income_adolescent_school_pe_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저소득층 청소년 학교체육 참여지원</isp:pref_label_ko>
