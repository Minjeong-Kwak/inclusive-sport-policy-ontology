  </rdf:Description>
  <rdf:Description rdf:about="#program__child_adolescent_pa_guideline_based_intervention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_entry_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__child_adolescent_pa_guideline_based_intervention</isp:entity_id>
