    <rdfs:label xml:lang="en">gender-sensitive physical education teacher education</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing gender-sensitive physical education teacher education in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">gender-sensitive physical education teacher education</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">성인지 감수성 체육교사 교육</skos:prefLabel>
  </rdf:Description>
