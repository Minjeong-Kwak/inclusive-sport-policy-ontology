  <rdf:Description rdf:about="#outcome__athlete_doping_responsibility_understanding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__athlete_doping_responsibility_understanding</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">선수 도핑책임 이해 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">improved athlete understanding of doping responsibility</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑 의도 여부와 무관한 선수 책임과 금지약물 주의 의무를 이해하는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">아리스토텔레스의 체육사상(15) 무지에 의한 도핑책임론</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">무지에 의한 도핑은 의도와 무관하더라도 선수 자신에게 행위 원인이 있으므로 반도핑 정책에서 책임을 부담해야 한다고 논의하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">improved athlete understanding of doping responsibility</rdfs:label>
    <rdfs:comment xml:lang="ko">도핑 의도 여부와 무관한 선수 책임과 금지약물 주의 의무를 이해하는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">improved athlete understanding of doping responsibility</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">선수 도핑책임 이해 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__online_public_trial_risk_awareness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#equity_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__online_public_trial_risk_awareness</isp:entity_id>
