    <rdfs:comment xml:lang="ko">긍정적 스포츠태도가 수면장애, 수면결과, 수면저해 감소와 연결되는 심리·건강 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Alleviation of sleep disorder in older adults</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">노인 수면장애 완화</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__asd_children_orff_sports_social_skills_program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#disabled_person_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__asd_children_orff_sports_social_skills_program</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">자폐스펙트럼 아동 오르프 스포츠 사회성 지원 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Orff sports social skills support program for children with ASD</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">자폐스펙트럼 아동의 사회적 반응성과 또래 상호작용을 높이기 위해 오르프 음악과 스포츠게임을 결합하는 장애인 대상 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Combined Orff Music And Sports Activity To Enhances Autism Children’s Social Skills: Trials Of Intervention Effectiveness</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022 3rd Asia Sport Science Conference Abstracts</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conference_abstract</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">107-109</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The conference abstract recruited twenty-two children with ASD and applied a 9-week Orff music combined sports game intervention three times per week. The intervention improved social skills in children with mild to moderate ASD, with better social interaction effects in the experimental group than the sports-game control group.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <isp:targets_target_group rdf:resource="#target_group__asd_children_social_skills_sport_support"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__orff_music_sports_games_for_asd_children"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__special_school_asd_group_intervention_context"/>
    <isp:produces_outcome rdf:resource="#outcome__asd_children_social_communication_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__asd_children_motor_social_participation_improvement"/>
    <rdfs:label xml:lang="en">Orff sports social skills support program for children with ASD</rdfs:label>
    <rdfs:comment xml:lang="ko">자폐스펙트럼 아동의 사회적 반응성과 또래 상호작용을 높이기 위해 오르프 음악과 스포츠게임을 결합하는 장애인 대상 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Orff sports social skills support program for children with ASD</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">자폐스펙트럼 아동 오르프 스포츠 사회성 지원 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__asd_children_social_skills_sport_support"/>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__infectious_disease_risk_reduction_athletes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_outcome"/>
