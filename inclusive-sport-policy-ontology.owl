  <rdf:Description rdf:about="#program__elite_athlete_supplement_doping_awareness_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__elite_athlete_supplement_doping_awareness_education</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 선수 보충제·도핑의식 교육</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">elite athlete supplement and doping awareness education</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동영양보조물의 안전한 이용과 도핑의식 향상을 위한 교육 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 선수들의 도핑교육에 따른 운동영양 보조물 이용과 도핑인식</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2010</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2008 베이징 올림픽 참가 국가대표 엘리트 선수 자료를 분석하여 도핑교육이 운동영양보조물 이용과 도핑의식 수준과 관련됨을 보고하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:targets_target_group rdf:resource="#target_group__korean_international_team_athletes_supplement_education"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__supplement_use_doping_awareness_survey"/>
    <isp:produces_outcome rdf:resource="#outcome__doping_awareness_improvement_supplement_education"/>
    <rdfs:label xml:lang="en">elite athlete supplement and doping awareness education</rdfs:label>
    <rdfs:comment xml:lang="ko">운동영양보조물의 안전한 이용과 도핑의식 향상을 위한 교육 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">elite athlete supplement and doping awareness education</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">엘리트 선수 보충제·도핑의식 교육</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__korean_international_team_athletes_supplement_education"/>
  </rdf:Description>
  <rdf:Description rdf:about="#program__athlete_allergy_safe_participation_management">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#medical_welfare_linked_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__athlete_allergy_safe_participation_management</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">선수 운동 관련 알레르기 안전참여 관리 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Safe participation management program for athletes with exercise-related allergy</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동과 관련된 알레르기질환</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2014</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동으로 유발되거나 악화되는 천식, 아나필락시스, 두드러기 등 알레르기 질환은 선수의 안전한 훈련과 경기 참가에 영향을 주며, 스포츠의학적 진단·관리와 약물 사용의 도핑 관련 평가가 필요함.</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동으로 유발되거나 악화되는 천식, 아나필락시스, 두드러기 등 알레르기 질환은 선수의 안전한 훈련과 경기 참가에 영향을 주며, 스포츠의학적 진단·관리와 약물 사용의 도핑 관련 평가가 필요함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Sports Medicine</isp:source_publisher>
    <isp:targets_target_group rdf:resource="#target_group__athletes_exercise_related_allergy"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__allergy_medication_doping_safety_guidance"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__sports_medicine_allergy_management_context"/>
    <isp:produces_outcome rdf:resource="#outcome__athlete_safe_competition_with_allergy"/>
    <rdfs:label xml:lang="en">Safe participation management program for athletes with exercise-related allergy</rdfs:label>
    <rdfs:comment xml:lang="ko">운동으로 유발되거나 악화되는 천식, 아나필락시스, 두드러기 등 알레르기 질환은 선수의 안전한 훈련과 경기 참가에 영향을 주며, 스포츠의학적 진단·관리와 약물 사용의 도핑 관련 평가가 필요함.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Safe participation management program for athletes with exercise-related allergy</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">선수 운동 관련 알레르기 안전참여 관리 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__athletes_exercise_related_allergy"/>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__sport_sociability_measurement_validity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capability_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__sport_sociability_measurement_validity</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 사회성 측정 타당성 확보</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport sociability measurement validity</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">성별과 학년에 관계없이 스포츠 사회성 척도를 적용할 수 있는 측정 타당성이 확보되는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 사회성 척도의 다집단 요인분석과 잠재평균 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">초등학교 3~6학년 651명을 대상으로 스포츠 사회성 척도의 구인타당도, 형태동일성, 측정동일성, 절편동일성을 검증하고 초등학생 사회성 측정 도구로 적합함을 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">sport sociability measurement validity</rdfs:label>
    <rdfs:comment xml:lang="ko">성별과 학년에 관계없이 스포츠 사회성 척도를 적용할 수 있는 측정 타당성이 확보되는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">sport sociability measurement validity</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠 사회성 측정 타당성 확보</skos:prefLabel>
  </rdf:Description>
