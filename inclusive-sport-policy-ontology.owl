    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인스포츠지도자의 직업정체성, 전문성 인식, 조직정체성 강화를 지원하는 역량개발 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인스포츠지도자의 고용형태에 따른 직업정체성과 전문성 인식 및 조직정체성 비교 검증</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-15</isp:last_updated>
    <isp:targets_target_group rdf:resource="#target_group__elderly_sport_instructors"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__public_senior_sport_instruction_setting"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__elderly_sport_instructor_workforce"/>
