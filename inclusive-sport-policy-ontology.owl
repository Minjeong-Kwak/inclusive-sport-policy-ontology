  <rdf:Description rdf:about="#support_resource__national_training_center_sports_medicine_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#human_resource"/>
