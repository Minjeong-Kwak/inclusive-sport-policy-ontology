    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스쿼트·데드리프트 자세 연구동향 자료</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">squat and deadlift posture research review</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스쿼트와 데드리프트 자세 관련 국내외 연구동향을 정리한 정보 자원</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스쿼트와 데드리프트 연구 동향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2010~2020년 국내외 스쿼트·데드리프트 자세 관련 연구 25편을 수집하여 신체 변화, 기능 개선, 성장력, 미래지향적 기술개발 유형으로 연구동향을 분석하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">squat and deadlift posture research review</rdfs:label>
    <rdfs:comment xml:lang="ko">스쿼트와 데드리프트 자세 관련 국내외 연구동향을 정리한 정보 자원</rdfs:comment>
    <skos:prefLabel xml:lang="en">squat and deadlift posture research review</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스쿼트·데드리프트 자세 연구동향 자료</skos:prefLabel>
  </rdf:Description>
