    <skos:prefLabel xml:lang="ko">대학생·직업선수 이중역할 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__sport_team_negative_word_of_mouth_reduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#system_level_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__sport_team_negative_word_of_mouth_reduction</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 구단 부정적 구전 감소</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport team negative word of mouth reduction</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">선수 스캔들 이후 구단에 대한 부정적 구전 의도를 낮추는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 선수의 스캔들에 대한 스포츠 구단의 위기 커뮤니케이션 전략</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2011</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">언론과학연구</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">선수 스캔들 상황에서 스포츠 구단의 방어적·수용적 위기 커뮤니케이션 전략을 SCCT 관점에서 분석하고, 공중의 전략 수용성과 부정적 구전의지를 검토하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">sport team negative word of mouth reduction</rdfs:label>
    <rdfs:comment xml:lang="ko">선수 스캔들 이후 구단에 대한 부정적 구전 의도를 낮추는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">sport team negative word of mouth reduction</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠 구단 부정적 구전 감소</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__pe_process_fortified_assessment_guideline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#guideline_manual"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육과 과정중심평가 지침</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">process-fortified assessment guideline for PE</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육과 과정중심평가의 이해와 활용</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">성취기준 분석, 평가도구 개발 및 실행, 평가 결과 활용을 현장 사례로 제시하였다.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__pe_process_fortified_assessment_guideline</isp:entity_id>
    <rdfs:label xml:lang="en">process-fortified assessment guideline for PE</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing process-fortified assessment guideline for PE in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">process-fortified assessment guideline for PE</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">체육과 과정중심평가 지침</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#sport_activity__youth_park_jogging">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#running"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__youth_park_jogging</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년 공원 조깅</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Youth park jogging</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년이 공원에서 수행하는 조깅 기반 여가 신체활동</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Empirical Phenomenological Study of Youths’ Experiences Jogging in Singapore Parks</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1-16</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Six youth joggers aged 17-19 discussed experiences of jogging in Singapore parks; park jogging elicited positive experiences, reduced negative thoughts and stress, promoted well-being, sense of belonging, personal growth, and academic performance.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <rdfs:label xml:lang="en">Youth park jogging</rdfs:label>
    <rdfs:comment xml:lang="ko">청소년이 공원에서 수행하는 조깅 기반 여가 신체활동</rdfs:comment>
    <skos:prefLabel xml:lang="en">Youth park jogging</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">청소년 공원 조깅</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__nafld_risk_management_through_fitness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__nafld_risk_management_through_fitness</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체력 기반 비알코올성 지방간 위험 관리</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NAFLD risk management through physical fitness</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">악력과 신체체력을 활용하여 비알코올성 지방간 위험을 관리하는 건강 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Association of hand-grip strength and non-alcoholic fatty liver disease index in older adults</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition and Biochemistry</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/jenb.2018.0031</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">62-63</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This cross-sectional study of 538 older adults found linear decreases in NAFLD indices across incremental hand-grip strength levels and suggested lifestyle intervention with normal weight and physical fitness as prevention against NAFLD.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:outcome_indicator_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NAFLD risk index</isp:outcome_indicator_type>
    <rdfs:label xml:lang="en">NAFLD risk management through physical fitness</rdfs:label>
    <rdfs:comment xml:lang="ko">악력과 신체체력을 활용하여 비알코올성 지방간 위험을 관리하는 건강 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">NAFLD risk management through physical fitness</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">체력 기반 비알코올성 지방간 위험 관리</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__adolescent_athlete_self_management_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#self_efficacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__adolescent_athlete_self_management_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년 선수 자기관리 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improved self-management among adolescent athletes</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">훈련, 시합, 생활에서 청소년 운동선수가 스스로 행동과 정서를 조절하는 능력 향상 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">남자 청소년 운동선수의 절실함이 자기관리에 미치는 영향: 성취목표성향의 조절효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-15</isp:last_updated>
    <rdfs:label xml:lang="en">Improved self-management among adolescent athletes</rdfs:label>
    <rdfs:comment xml:lang="ko">훈련, 시합, 생활에서 청소년 운동선수가 스스로 행동과 정서를 조절하는 능력 향상 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Improved self-management among adolescent athletes</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">청소년 선수 자기관리 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__adolescent_athlete_dietary_behavior_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__adolescent_athlete_dietary_behavior_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년 선수 식습관 관리역량 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improved dietary behavior literacy among adolescent athletes</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">영양 정보 검색 경험에 따른 청소년기 야구선수의 식습관 및 영양교육에 대한 인식</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">영양정보 검색과 교육을 통해 청소년 선수의 식습관 관리와 영양교육 필요 인식이 향상되는 성과임</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">영양정보 검색과 교육을 통해 청소년 선수의 식습관 관리와 영양교육 필요 인식이 향상되는 성과임</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <rdfs:label xml:lang="en">Improved dietary behavior literacy among adolescent athletes</rdfs:label>
    <rdfs:comment xml:lang="ko">영양정보 검색과 교육을 통해 청소년 선수의 식습관 관리와 영양교육 필요 인식이 향상되는 성과임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Improved dietary behavior literacy among adolescent athletes</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">청소년 선수 식습관 관리역량 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__mandatory_sport_ethics_education_resource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#information_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__mandatory_sport_ethics_education_resource</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">법정 스포츠윤리 교육자료</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mandatory sport ethics education resource</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지도자, 심판, 유소년·청소년 선수 대상 윤리성과 공정성 교육을 위한 교육자료.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지도자와 심판 비리 근절을 위한 법제도적 개선 방안</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2016</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유소년이나 청소년 선수에 대해 스포츠 윤리교육을 확대·강화할 필요가 있다고 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">mandatory sport ethics education resource</rdfs:label>
    <rdfs:comment xml:lang="ko">지도자, 심판, 유소년·청소년 선수 대상 윤리성과 공정성 교육을 위한 교육자료.</rdfs:comment>
    <skos:prefLabel xml:lang="en">mandatory sport ethics education resource</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">법정 스포츠윤리 교육자료</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__deaf_baseball_continued_participation_intention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__deaf_baseball_continued_participation_intention</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청각장애 야구 지속참여 의도</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">continued participation intention in deaf baseball</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청각장애인이 야구 동호회 활동을 지속하려는 참여 동기와 의도가 강화되는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청각장애 야구 동호인의 참여의도 및 상호작용의 탐색</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">핵심 주제로 참여의도와 지속동기가 도출되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">continued participation intention in deaf baseball</rdfs:label>
    <rdfs:comment xml:lang="ko">청각장애인이 야구 동호회 활동을 지속하려는 참여 동기와 의도가 강화되는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">continued participation intention in deaf baseball</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">청각장애 야구 지속참여 의도</skos:prefLabel>
  </rdf:Description>
