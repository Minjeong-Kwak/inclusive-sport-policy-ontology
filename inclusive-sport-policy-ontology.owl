    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary_evidence</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__youth_student_athletes_psychological_test</isp:entity_id>
    <rdfs:comment xml:lang="ko">스포츠심리검사에서 응답왜곡 가능성이 확인된 유소년 학생선수 집단</rdfs:comment>
    <skos:prefLabel xml:lang="en">youth student athletes in psychological testing</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">심리검사 대상 유소년 학생선수</skos:prefLabel>
