  <rdf:Description rdf:about="#program__pre_service_pe_career_barrier_counseling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__pre_service_pe_career_barrier_counseling</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">예비 체육교사 진로장벽 상담 지원</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Career barrier counseling support for pre-service PE teachers</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">예비체육교사의 진로장벽과 진로결정수준 관계 연구</isp:source_title>
