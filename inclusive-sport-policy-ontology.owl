  <rdf:Description rdf:about="#outcome__lifelong_sport_participation_pathway_strengthening">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_continuity"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__lifelong_sport_participation_pathway_strengthening</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">평생 스포츠 참여 경로 강화</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lifelong sport participation pathway strengthening</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장기 선수발달 시스템을 통해 전문선수 발달과 평생 신체활동 참여가 함께 강화되는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 선진국의 장기적인 선수 발달 시스템 분석을 통한 우리나라 시스템 개선 방안 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">캐나다, 영국, 독일, 일본의 장기 선수 발달 시스템을 검토하고, 다양한 스포츠 참여 기회 제공, 통합 운영 전담기구, 지속성과 전문성 확보를 국내 개선 방안으로 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">lifelong sport participation pathway strengthening</rdfs:label>
    <rdfs:comment xml:lang="ko">장기 선수발달 시스템을 통해 전문선수 발달과 평생 신체활동 참여가 함께 강화되는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">lifelong sport participation pathway strengthening</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">평생 스포츠 참여 경로 강화</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__prader_willi_obesity_diabetes_metabolic_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__prader_willi_obesity_diabetes_metabolic_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프래더윌리증후군 비만·당뇨 대사요인 개선</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Metabolic improvement of obesity and diabetes in Prader-Willi syndrome</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Changes in body composition, blood lipid profile, and growth factor hormone in a patient with Prader–willi syndrome during 24 weeks of complex exercise: a single case study</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition &amp; Biochemistry</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체중, 지방량, TG/HDL 비율, 평균 혈당이 감소함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24주 복합운동 후 비만 및 당뇨 관련 지표 개선이 보고됨</isp:definition_text>
    <rdfs:label xml:lang="en">Metabolic improvement of obesity and diabetes in Prader-Willi syndrome</rdfs:label>
    <rdfs:comment xml:lang="ko">24주 복합운동 후 비만 및 당뇨 관련 지표 개선이 보고됨</rdfs:comment>
    <skos:prefLabel xml:lang="en">Metabolic improvement of obesity and diabetes in Prader-Willi syndrome</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">프래더윌리증후군 비만·당뇨 대사요인 개선</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_rate_increase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#participation_outcome"/>
    <rdfs:label xml:lang="en">Participation Rate Increase</rdfs:label>
    <rdfs:comment xml:lang="en">An outcome class representing an increase in participation rate associated with sport participation policies or programs.</rdfs:comment>
    <skos:definition xml:lang="en">An outcome class representing an increase in participation rate associated with sport participation policies or programs.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__horse_riding_education_continuation_intention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_continuity"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__horse_riding_education_continuation_intention</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">승마교육 지속 의도</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">horse-riding education continuation intention</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고급문화로서 승마교육 지속 관련 변인에 대한 메타분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">승마교육 지속 관련 유발변인과 제약변인을 분석하고, 지속을 위한 사회적 환경 조성 방안을 제언하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">horse-riding education continuation intention</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing horse-riding education continuation intention in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">horse-riding education continuation intention</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">승마교육 지속 의도</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__sports_dispute_resolution_fairness">
