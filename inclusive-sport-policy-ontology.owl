  <rdf:Description rdf:about="#target_group__elite_judoists_supplement_safety_management">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#target_group"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__elite_judoists_supplement_safety_management</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">보충제 안전관리 대상 엘리트 유도선수</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target group  elite judoists supplement safety management</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 유도 선수의 성별과 연령에 따른 운동영양 보조물 섭취와 섭취경로 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2009</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2003~2008년 엘리트 유도선수 223명을 대상으로 운동영양 보조물 섭취와 구입경로를 조사했고, 연령과 성별에 따라 섭취 경향과 정보원 차이가 나타났으며 도핑교육 필요를 권고함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">target group  elite judoists supplement safety management</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing target group  elite judoists supplement safety management in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">target group  elite judoists supplement safety management</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">보충제 안전관리 대상 엘리트 유도선수</skos:prefLabel>
  </rdf:Description>
