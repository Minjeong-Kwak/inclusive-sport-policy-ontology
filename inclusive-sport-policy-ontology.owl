  <rdf:Description rdf:about="#target_group__older_adults_nafld_physical_fitness_risk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#elderly"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__older_adults_nafld_physical_fitness_risk</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비알코올성 지방간 관련 체력 관리가 필요한 노인</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Older adults requiring physical fitness management for NAFLD risk</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">악력 수준과 비알코올성 지방간 지표가 함께 분석된 노인 대상 집단</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Association of hand-grip strength and non-alcoholic fatty liver disease index in older adults</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition and Biochemistry</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/jenb.2018.0031</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">62-63</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This cross-sectional study of 538 older adults found linear decreases in NAFLD indices across incremental hand-grip strength levels and suggested lifestyle intervention with normal weight and physical fitness as prevention against NAFLD.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:applies_to_life_stage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">older adults</isp:applies_to_life_stage>
    <isp:applies_to_health_condition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NAFLD risk</isp:applies_to_health_condition>
    <isp:sample_size rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">538</isp:sample_size>
    <rdfs:label xml:lang="en">Older adults requiring physical fitness management for NAFLD risk</rdfs:label>
    <rdfs:comment xml:lang="ko">악력 수준과 비알코올성 지방간 지표가 함께 분석된 노인 대상 집단</rdfs:comment>
    <skos:prefLabel xml:lang="en">Older adults requiring physical fitness management for NAFLD risk</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">비알코올성 지방간 관련 체력 관리가 필요한 노인</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#baseball_field_shortage_local_sport_facility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#facility_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">baseball_field_shortage_local_sport_facility</isp:entity_id>
