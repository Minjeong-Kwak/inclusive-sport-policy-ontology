  <rdf:Description rdf:about="#outcome__sports_right_policy_clarification_japan_policy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#equity_outcome"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">일본 스포츠권 정책 명확화</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sports right policy clarification in Japanese policy reference</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">일본 스포츠진흥정책 사례를 통해 스포츠권과 스포츠 진흥 책임을 법제도 속에서 명확히 하는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">일본 스포츠 진흥정책의 시사점</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2011</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">법학논총</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠권과 스포츠기본법, 스포츠진흥정책의 필요성이 논의되었다.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__sports_right_policy_clarification_japan_policy</isp:entity_id>
    <rdfs:label xml:lang="en">sports right policy clarification in Japanese policy reference</rdfs:label>
    <rdfs:comment xml:lang="ko">일본 스포츠진흥정책 사례를 통해 스포츠권과 스포츠 진흥 책임을 법제도 속에서 명확히 하는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">sports right policy clarification in Japanese policy reference</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">일본 스포츠권 정책 명확화</skos:prefLabel>
  </rdf:Description>
