    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑검사센터 보충제 분석 자료</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Doping control center supplement analysis resource</isp:pref_label_en>
