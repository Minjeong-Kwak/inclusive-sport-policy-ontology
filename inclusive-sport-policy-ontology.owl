    <skos:prefLabel xml:lang="ko">스포츠 정신의학 정보 자원</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__knhanes_accelerometer_physical_activity_surveillance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program_information"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국민건강영양조사 가속도계 신체활동 감시 자료</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KNHANES accelerometer physical activity surveillance data</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국 성인의 신체활동과 좌식행동 패턴을 객관적으로 파악하기 위한 국민건강영양조사 기반 가속도계 자료</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Accelerometer-derived physical activity and sedentary behavior patterns among Korean adults</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/pan.2023.0015</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">25-26</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The study used 2014-2017 Korea National Health and Nutrition Examination Survey data with accelerometers to measure physical activity and sedentary behavior among 2,260 Korean adults. It highlights the need to promote physical activity and reduce sedentary behavior through public health policies and interventions.</isp:evidence_excerpt>
    <isp:supports_target_group rdf:resource="#target_group__korean_adults_low_mvpa_high_sedentary_behavior"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__knhanes_accelerometer_physical_activity_surveillance</isp:entity_id>
    <rdfs:label xml:lang="en">KNHANES accelerometer physical activity surveillance data</rdfs:label>
    <rdfs:comment xml:lang="ko">한국 성인의 신체활동과 좌식행동 패턴을 객관적으로 파악하기 위한 국민건강영양조사 기반 가속도계 자료</rdfs:comment>
    <skos:prefLabel xml:lang="en">KNHANES accelerometer physical activity surveillance data</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">국민건강영양조사 가속도계 신체활동 감시 자료</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__korean_adults_low_mvpa_high_sedentary_behavior"/>
  </rdf:Description>
