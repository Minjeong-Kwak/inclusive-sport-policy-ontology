  <rdf:Description rdf:about="#target_group__people_with_visual_impairment_rehab_need">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#disabled_person"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">재활운동 및 체육 지원이 필요한 시각장애인</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">People with visual impairment requiring rehabilitation exercise and physical activity support</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">시각장애인 재활운동 및 체육 프로그램과 평가에 대한 체계적 문헌고찰</isp:source_title>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">systematic_review</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">최근 10년간 국내 시각장애인을 대상으로 수행된 재활운동 및 체육 프로그램 12편을 분석함</isp:evidence_excerpt>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">v45 추가 인스턴스</isp:note>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">v45_batch</isp:source_identifier>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__people_with_visual_impairment_rehab_need</isp:entity_id>
    <rdfs:label xml:lang="en">People with visual impairment requiring rehabilitation exercise and physical activity support</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing People with visual impairment requiring rehabilitation exercise and physical activity support in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">People with visual impairment requiring rehabilitation exercise and physical activity support</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">재활운동 및 체육 지원이 필요한 시각장애인</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__sport_career_counselor_training_curriculum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__sport_career_counselor_training_curriculum</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠진로상담사 양성교육과정</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sport career counselor training curriculum</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠진로교육과 상담을 전문적으로 수행할 상담사를 양성하기 위한 교육과정</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠진로상담사 양성교육과정 설계방안</isp:source_title>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4개 영역 6개 직무역량과 9개 양성 교과목을 도출하고 자격연수과정을 설계함</isp:evidence_excerpt>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:targets_target_group rdf:resource="#target_group__student_athletes_sport_career_counseling"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__sport_career_counselor_competency_framework"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__sport_career_counselor_certification_course"/>
    <isp:produces_outcome rdf:resource="#outcome__student_athlete_sport_career_support_access"/>
    <isp:produces_outcome rdf:resource="#outcome__sport_career_counseling_professionalization"/>
    <rdfs:label xml:lang="en">Sport career counselor training curriculum</rdfs:label>
    <rdfs:comment xml:lang="ko">스포츠진로교육과 상담을 전문적으로 수행할 상담사를 양성하기 위한 교육과정</rdfs:comment>
    <skos:prefLabel xml:lang="en">Sport career counselor training curriculum</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠진로상담사 양성교육과정</skos:prefLabel>
