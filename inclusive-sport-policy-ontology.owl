  <rdf:Description rdf:about="#support_resource__youth_volleyball_textmining_ahp_analysis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program_information"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유소년배구 텍스트마이닝·AHP 분석자료</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Youth volleyball text-mining and AHP analysis resource</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">언론기사 의미연결망 분석과 전문가 AHP 분석을 통해 유소년배구 활성화 우선순위를 도출한 정보자원.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">배구기사분석을 통한 한국 유소년배구 활성화 방안 탐색</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유소년배구 관련 기사 의미연결망과 전문가 AHP 분석을 수행함.</isp:evidence_excerpt>
