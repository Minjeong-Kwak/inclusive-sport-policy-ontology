  <rdf:Description rdf:about="#participation_context__pandemic_home_based_sedentary_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__pandemic_home_based_sedentary_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">팬데믹 재택·좌식생활 증가 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pandemic home-based sedentary context</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Global Perspective on COVID-19 and Decreased Physical Activity in Children and Adolescents</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COVID-19 기간 집에 머무르는 생활이 길어지고 스크린 시간과 앉아 있는 시간이 증가함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">팬데믹으로 인해 아동·청소년 활동 공간이 제한되고 좌식생활이 증가한 맥락임</isp:definition_text>
    <rdfs:label xml:lang="en">Pandemic home-based sedentary context</rdfs:label>
    <rdfs:comment xml:lang="ko">팬데믹으로 인해 아동·청소년 활동 공간이 제한되고 좌식생활이 증가한 맥락임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Pandemic home-based sedentary context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">팬데믹 재택·좌식생활 증가 맥락</skos:prefLabel>
  </rdf:Description>
