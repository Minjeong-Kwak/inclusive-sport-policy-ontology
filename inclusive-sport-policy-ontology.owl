    <isp:produces_outcome rdf:resource="#outcome__elderly_fall_prevention_exercise_effectiveness"/>
    <isp:produces_outcome rdf:resource="#outcome__elderly_fall_fear_reduction"/>
    <isp:produces_outcome rdf:resource="#outcome__elderly_fall_related_fitness_improvement"/>
