    <isp:conditions_outcome rdf:resource="#outcome__adolescent_drug_use_frequency_reduction_pe"/>
    <isp:conditions_outcome rdf:resource="#outcome__positive_peer_interaction_drug_prevention"/>
    <isp:conditions_outcome rdf:resource="#outcome__healthy_lifestyle_habit_drug_prevention"/>
    <isp:interacts_with_target_group rdf:resource="#target_group__adolescents_drug_use_prevention_pe"/>
    <rdfs:label xml:lang="en">long-term after-school sport club participation context</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing long-term after-school sport club participation context in the participation_context dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">long-term after-school sport club participation context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">장기 방과후 스포츠클럽 참여 맥락</skos:prefLabel>
