  <rdf:Description rdf:about="#target_group__youth_figure_skating_athletes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#youth"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__youth_figure_skating_athletes</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유소년 피겨스케이팅 선수</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">youth figure skating athletes</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장기선수발달 관점에서 지원이 필요한 국내 유소년 피겨스케이팅 선수 집단.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스케이트 캐나다의 Long Term Development 모델 고찰을 통한 국내 피겨스케이팅 장기 선수 발달 프로그램 운영방안</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국내 피겨스케이팅의 과도한 조기 전문화와 장기 발달 시스템 필요가 제시됨.</isp:evidence_excerpt>
    <rdfs:label xml:lang="en">youth figure skating athletes</rdfs:label>
    <rdfs:comment xml:lang="ko">장기선수발달 관점에서 지원이 필요한 국내 유소년 피겨스케이팅 선수 집단.</rdfs:comment>
    <skos:prefLabel xml:lang="en">youth figure skating athletes</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유소년 피겨스케이팅 선수</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__judo_specific_antidoping_ethics_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__judo_specific_antidoping_ethics_education</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유도 종목 특화 반도핑 윤리교육</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program  judo specific antidoping ethics education</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 유도선수들의 반도핑 경향에 대한 근원적 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 유도선수 10명 질적연구에서 도핑 인지 수준, 도핑검사 경험, 체급 특성에 따른 도핑 유혹, 윤리교육의 필요가 제시됨.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:targets_target_group rdf:resource="#target_group__elite_judo_athletes_antidoping_awareness"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__weight_category_judo_competition_context"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__judo_weight_category_antidoping_guideline"/>
    <isp:produces_outcome rdf:resource="#outcome__judo_antidoping_habitual_ethics_internalization"/>
    <rdfs:label xml:lang="en">program  judo specific antidoping ethics education</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing program  judo specific antidoping ethics education in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">program  judo specific antidoping ethics education</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유도 종목 특화 반도핑 윤리교육</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__elite_judo_athletes_antidoping_awareness"/>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__youth_winter_sport_seasonal_program_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#seasonal_participation"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유소년 동계스포츠 계절 프로그램 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Youth winter sport seasonal program context</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IPA기법을 활용한 유소년 동계스포츠프로그램 중요도와 만족도 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">겨울철 종목 특성과 프로그램 운영 조건에 따라 유소년이 동계스포츠에 참여하는 계절적 참여 맥락임</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">겨울철 종목 특성과 프로그램 운영 조건에 따라 유소년이 동계스포츠에 참여하는 계절적 참여 맥락임</isp:evidence_excerpt>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__youth_winter_sport_seasonal_program_context</isp:entity_id>
    <rdfs:label xml:lang="en">Youth winter sport seasonal program context</rdfs:label>
    <rdfs:comment xml:lang="ko">겨울철 종목 특성과 프로그램 운영 조건에 따라 유소년이 동계스포츠에 참여하는 계절적 참여 맥락임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Youth winter sport seasonal program context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유소년 동계스포츠 계절 프로그램 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__baseball_club_team_satisfaction_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#life_satisfaction_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__baseball_club_team_satisfaction_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">야구동호회 팀 만족도 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">baseball club team satisfaction improvement</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">환경적 커뮤니케이션과 팀 응집력에 의해 팀 만족도가 향상되는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">야구동호회의 커뮤니케이션이 응집력 및 팀 만족도에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">사회인 야구동호회 회원 331명을 조사한 결과, 사회적 커뮤니케이션은 팀 응집력에, 환경적 커뮤니케이션은 팀 만족도에 긍정적 영향을 미쳤다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">baseball club team satisfaction improvement</rdfs:label>
    <rdfs:comment xml:lang="ko">환경적 커뮤니케이션과 팀 응집력에 의해 팀 만족도가 향상되는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">baseball club team satisfaction improvement</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">야구동호회 팀 만족도 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__middle_aged_men_low_handgrip_metabolic_risk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#target_group"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__middle_aged_men_low_handgrip_metabolic_risk</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">상대악력 저하 중년 남성</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">middle-aged men with low relative handgrip strength</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">상대악력과 대사적 건강위험의 관련성 관리가 필요한 50~64세 중년 남성 집단</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중년기 성인 남성의 악력 및 신체활동, 식생활평가지수와 대사적 건강상태와의 관련성 연구: 국민건강영양조사(2016-2018년도)자료를 이용하여</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국민건강영양조사 2016~2018년 50~64세 중년 남성 3,329명의 악력, 신체활동, 식생활평가지수, 대사적 건강상태를 분석하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">middle-aged men with low relative handgrip strength</rdfs:label>
    <rdfs:comment xml:lang="ko">상대악력과 대사적 건강위험의 관련성 관리가 필요한 50~64세 중년 남성 집단</rdfs:comment>
    <skos:prefLabel xml:lang="en">middle-aged men with low relative handgrip strength</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">상대악력 저하 중년 남성</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__professional_baseball_public_good_value">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#system_level_outcome"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프로야구구단 공공재 가치</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Public good value of professional baseball teams</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프로야구구단이 지역사회에 제공하는 무형의 사회·경제적 가치.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">조건부가치평가법(CVM)을 이용한 한국 프로야구구단의 사회ㆍ경제적 가치평가</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5년간 프로야구구단의 사회·경제적 가치가 약 3,700억 원으로 추정됨.</isp:evidence_excerpt>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">확실하게 문헌 내용에서 확인 가능한 요소만 제한 반영함.</isp:note>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__professional_baseball_public_good_value</isp:entity_id>
    <rdfs:label xml:lang="en">Public good value of professional baseball teams</rdfs:label>
    <rdfs:comment xml:lang="ko">프로야구구단이 지역사회에 제공하는 무형의 사회·경제적 가치.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Public good value of professional baseball teams</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">프로야구구단 공공재 가치</skos:prefLabel>
  </rdf:Description>
