  <rdf:Description rdf:about="#program__smartphone_overdependence_physical_activity_diet_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__smartphone_overdependence_physical_activity_diet_education</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스마트폰 과의존 청소년 신체활동·식습관 교육</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical activity and dietary education for adolescents with smartphone overdependence</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스마트폰 사용이 많은 청소년에게 신체활동 참여와 균형 잡힌 식습관 형성을 지원하는 학교·가정 연계 건강교육</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중학생의 스마트폰 의존성이 건강 관련 요인, 신체활동 및 식습관에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">연구는 학교와 가정이 연계하여 신체활동과 균형 잡힌 식습관을 교육해야 한다고 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:targets_target_group rdf:resource="#target_group__middle_school_students_smartphone_overdependence_risk"/>
    <isp:produces_outcome rdf:resource="#outcome__balanced_diet_and_pa_awareness_improvement"/>
    <rdfs:label xml:lang="en">physical activity and dietary education for adolescents with smartphone overdependence</rdfs:label>
    <rdfs:comment xml:lang="ko">스마트폰 사용이 많은 청소년에게 신체활동 참여와 균형 잡힌 식습관 형성을 지원하는 학교·가정 연계 건강교육</rdfs:comment>
    <skos:prefLabel xml:lang="en">physical activity and dietary education for adolescents with smartphone overdependence</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스마트폰 과의존 청소년 신체활동·식습관 교육</skos:prefLabel>
