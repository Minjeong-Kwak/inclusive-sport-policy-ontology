  <rdf:Description rdf:about="#participation_barrier__fall_risk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_barrier_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_barrier__fall_risk</isp:entity_id>
