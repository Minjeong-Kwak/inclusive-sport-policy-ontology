    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sport pleasure ethics reflection education</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">아리스토텔레스의 체육사상(8): 스포츠와 쾌락</isp:source_title>
