  <rdf:Description rdf:about="#outcome__low_income_adolescent_sedentary_time_reduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__low_income_adolescent_sedentary_time_reduction</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저소득층 청소년 좌식행동 감소</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sedentary behavior reduction among low-income adolescents</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저소득층 청소년의 학교체육활동과 비만도 및 건강인지와의 관련성</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학교체육수업 참여 횟수에 따라 좌식행동 시간 및 인터넷 사용 시간이 유의한 차이를 보였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:reflects_target_group rdf:resource="#target_group__low_income_adolescents_school_pe"/>
    <rdfs:label xml:lang="en">Sedentary behavior reduction among low-income adolescents</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Sedentary behavior reduction among low-income adolescents in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Sedentary behavior reduction among low-income adolescents</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">저소득층 청소년 좌식행동 감소</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__low_income_adolescents_school_pe"/>
  </rdf:Description>
