    <rdfs:comment xml:lang="en">Named individual representing Jazz dance physical activity in the sport_activity dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Jazz dance physical activity</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">재즈댄스 신체활동</skos:prefLabel>
  </rdf:Description>
