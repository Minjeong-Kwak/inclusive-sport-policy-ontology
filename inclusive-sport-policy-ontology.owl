    <rdf:type rdf:resource="#target_group"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__elite_sport_athletes_doping_risk</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑 위험에 노출된 엘리트 선수</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elite athletes exposed to doping risk</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동선수의 도핑방지에 관한 엘리트스포츠 지도자의 제어전략</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트스포츠 현장의 선수 도핑방지 경험과 지도자 제어전략을 분석하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Added in v52 from uploaded academic literature; class assignment limited to directly evidenced entities.</isp:note>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <rdfs:label xml:lang="en">Elite athletes exposed to doping risk</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Elite athletes exposed to doping risk in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Elite athletes exposed to doping risk</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">도핑 위험에 노출된 엘리트 선수</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__adolescent_elite_doping_risk_awareness_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__adolescent_elite_doping_risk_awareness_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년 엘리트 선수 도핑위험 인식 개선</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improvement of doping risk awareness among adolescent elite athletes</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attitudes and Dispositions toward Doping in Adolescent Elite Athletes</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2013</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Sports Medicine</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑에 대한 사고방식과 성향 조사가 효과적 반도핑 프로그램 개발의 기초자료로 제시됨</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년 선수의 도핑 위험 인식과 지식 향상을 나타내는 성과임</isp:definition_text>
    <rdfs:label xml:lang="en">Improvement of doping risk awareness among adolescent elite athletes</rdfs:label>
    <rdfs:comment xml:lang="ko">청소년 선수의 도핑 위험 인식과 지식 향상을 나타내는 성과임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Improvement of doping risk awareness among adolescent elite athletes</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">청소년 엘리트 선수 도핑위험 인식 개선</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__exercise_constraint_self_efficacy_resilience_assessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#information_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__exercise_constraint_self_efficacy_resilience_assessment</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동제약·자기효능감·회복탄력성 평가자료</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support resource  exercise constraint self efficacy resilience assessment</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여자 고등학생의 운동행동변화단계에 따른 운동제약요인 및 운동자기효능감과 회복탄력성 비교</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여자 고등학생 330명을 대상으로 운동행동변화단계별 운동제약요인, 운동자기효능감, 회복탄력성 차이를 분석하고 단계별 체육교육 전략 필요를 제시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">support resource  exercise constraint self efficacy resilience assessment</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing support resource  exercise constraint self efficacy resilience assessment in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">support resource  exercise constraint self efficacy resilience assessment</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">운동제약·자기효능감·회복탄력성 평가자료</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__elderly_metabolic_syndrome_pa_nutrition_prevention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#elderly_program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인 대사증후군 예방 신체활동·영양 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical activity and nutrition program for metabolic syndrome prevention in older adults</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인의 대사증후군 예방을 위해 균형 잡힌 영양섭취와 신체활동 참여 증진을 결합하는 노인 대상 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analysis of energy intakes, physical activities and metabolic syndrome according to the income level in Korean elderly people: Korean National Health and Nutrition Examination Survey 2016-2018</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">28-35</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data from 2,139 elderly individuals aged over 65 years from KNHANES 2016-2018 showed that older adults with metabolic syndrome and older adults with low income had lower energy intake and physical activity; the study suggested balanced nutrient intake, increased physical activity, education, and program development to prevent metabolic syndrome in the elderly.</isp:evidence_excerpt>
    <isp:targets_target_group rdf:resource="#target_group__low_income_elderly_metabolic_syndrome_support"/>
    <isp:targets_target_group rdf:resource="#target_group__elderly_with_metabolic_syndrome_pa_nutrition_support"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__low_income_elderly_low_pa_nutrition_context"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__knhanes_elderly_pa_nutrition_surveillance_data"/>
    <isp:produces_outcome rdf:resource="#outcome__elderly_physical_activity_participation_increase"/>
    <isp:produces_outcome rdf:resource="#outcome__elderly_balanced_nutrient_intake_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__elderly_metabolic_syndrome_prevention"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__elderly_metabolic_syndrome_pa_nutrition_prevention</isp:entity_id>
    <rdfs:label xml:lang="en">Physical activity and nutrition program for metabolic syndrome prevention in older adults</rdfs:label>
    <rdfs:comment xml:lang="ko">노인의 대사증후군 예방을 위해 균형 잡힌 영양섭취와 신체활동 참여 증진을 결합하는 노인 대상 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Physical activity and nutrition program for metabolic syndrome prevention in older adults</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">노인 대사증후군 예방 신체활동·영양 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__elderly_with_metabolic_syndrome_pa_nutrition_support"/>
    <isp:has_target_group_anchor rdf:resource="#target_group__low_income_elderly_metabolic_syndrome_support"/>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__healthy_eating_index_diet_guidance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#information_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__healthy_eating_index_diet_guidance</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">식생활평가지수 기반 건강식사 지침</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">healthy eating index-based dietary guidance</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">폐경기 여성의 대사건강과 근력 유지를 위해 균형성과 다양성을 갖춘 식사 실천을 안내하는 자원.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">폐경기 여성의 악력과 신체활동에 따른 대사적 건강위험 및 식생활평가지수와의 관련성 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">건강체력 기준을 충족한 악력 집단에서 식생활평가지수 점수가 높게 나타났다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:supports_target_group rdf:resource="#target_group__menopausal_women_metabolic_health"/>
    <rdfs:label xml:lang="en">healthy eating index-based dietary guidance</rdfs:label>
    <rdfs:comment xml:lang="ko">폐경기 여성의 대사건강과 근력 유지를 위해 균형성과 다양성을 갖춘 식사 실천을 안내하는 자원.</rdfs:comment>
    <skos:prefLabel xml:lang="en">healthy eating index-based dietary guidance</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">식생활평가지수 기반 건강식사 지침</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__menopausal_women_metabolic_health"/>
  </rdf:Description>
