  <rdf:Description rdf:about="#outcome__abuse_and_safety_risk_reduction_2024">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#outcome"/>
    <rdf:type rdf:resource="#risk_reduction_outcome"/>
