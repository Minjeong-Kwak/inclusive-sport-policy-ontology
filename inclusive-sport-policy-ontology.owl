  <rdf:Description rdf:about="#participation_context__elderly_women_bone_health_screening_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#institutional_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__elderly_women_bone_health_screening_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여성노인 골건강 선별 평가 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bone health screening context for elderly women</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Characteristics of nutrient intakes, basal physical fitness and serum markers in elderly women with osteopenia</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition &amp; Biochemistry</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DEXA, 신체구성, 기초체력, 영양섭취 및 혈청지표를 이용해 골감소증 특성을 분석함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여성노인의 골건강 위험을 평가하고 지원 필요성을 식별하는 제도적 선별 맥락임</isp:definition_text>
    <isp:reflects_target_group rdf:resource="#target_group__elderly_women_osteopenia_bone_health_support"/>
    <isp:conditions_outcome rdf:resource="#outcome__elderly_women_bone_health_risk_identification"/>
    <isp:conditions_outcome rdf:resource="#outcome__elderly_women_bmd_nutrition_fitness_profile_clarification"/>
    <rdfs:label xml:lang="en">Bone health screening context for elderly women</rdfs:label>
    <rdfs:comment xml:lang="ko">여성노인의 골건강 위험을 평가하고 지원 필요성을 식별하는 제도적 선별 맥락임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Bone health screening context for elderly women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">여성노인 골건강 선별 평가 맥락</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__elderly_women_osteopenia_bone_health_support"/>
  </rdf:Description>
