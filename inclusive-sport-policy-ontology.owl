    <skos:prefLabel xml:lang="en">Self-management support based on task goal orientation</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">과제목표성향 기반 자기관리 지원</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#sport_activity__elementary_daily_step_locomotor_activity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#walking"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__elementary_daily_step_locomotor_activity</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">초등학생 일일 걸음 기반 이동활동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elementary daily step-based locomotor activity</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">초등학생의 일상적 이동활동을 걸음수로 파악하여 신체활동 수준과 연결하는 걷기 중심 활동</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Association between daily step counts and physical activity level among Korean elementary schoolchildren</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition and Biochemistry</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2016</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">51-55</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Children aged 9 to 12 years from two urban Korean elementary schools were measured for total energy expenditure with doubly labeled water and step counts with accelerometers. Steps per day were positively associated with physical activity level among all subjects and in boys, and the authors concluded that locomotor activity contributed to physical activity level differences among elementary school boys.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <rdfs:label xml:lang="en">Elementary daily step-based locomotor activity</rdfs:label>
    <rdfs:comment xml:lang="ko">초등학생의 일상적 이동활동을 걸음수로 파악하여 신체활동 수준과 연결하는 걷기 중심 활동</rdfs:comment>
    <skos:prefLabel xml:lang="en">Elementary daily step-based locomotor activity</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">초등학생 일일 걸음 기반 이동활동</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__elite_sport_integrity_governance">
    <rdf:type rdf:resource="#integrated_policy_context"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__elite_sport_integrity_governance</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">전문체육 인테그리티 거버넌스 맥락</isp:pref_label_ko>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국 전문체육의 스포츠 인테그리티 실천 전략 탐색</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">윤리조직 강화와 민주적 의사결정 도입을 통해 조직의 투명성과 공정성을 확보하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elite Sport Integrity Governance</isp:pref_label_en>
    <rdfs:label xml:lang="en">Elite Sport Integrity Governance</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Elite Sport Integrity Governance in the participation_context dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Elite Sport Integrity Governance</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">전문체육 인테그리티 거버넌스 맥락</skos:prefLabel>
  </rdf:Description>
