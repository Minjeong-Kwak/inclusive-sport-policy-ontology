    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">웨어러블 기기와 데이터 기반 피드백 시스템이 학생들의 운동 동기와 성과를 높이는 데 기여한다고 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:is_utilized_by_program rdf:resource="#program__data_driven_school_pe_feedback_program"/>
    <isp:supports_program rdf:resource="#program__data_driven_school_pe_feedback_program"/>
    <rdfs:label xml:lang="en">wearable devices for school PE</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing wearable devices for school PE in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">wearable devices for school PE</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">학교체육 웨어러블 기기</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__elderly_positive_sport_attitude_increase">
