  <rdf:Description rdf:about="#policy__esport_cognitive_enhancement_drug_ethics_policy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#sport_policy"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy__esport_cognitive_enhancement_drug_ethics_policy</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">e스포츠 인지향상 약물윤리 정책</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eSport cognitive-enhancement drug ethics policy</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">e스포츠선수의 약물복용 문제에 관한 윤리적 고찰</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Korean Journal of Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ESIC 및 WADA식 금지목록만으로는 e스포츠 특성에 적합하지 않을 수 있어 별도 약물 관련 정책이 필요하다고 제시함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">e스포츠 선수의 인지향상 약물 사용을 윤리적·교육적 관점에서 다루는 스포츠정책 도메인 인스턴스임</isp:definition_text>
    <rdfs:label xml:lang="en">eSport cognitive-enhancement drug ethics policy</rdfs:label>
    <rdfs:comment xml:lang="ko">e스포츠 선수의 인지향상 약물 사용을 윤리적·교육적 관점에서 다루는 스포츠정책 도메인 인스턴스임</rdfs:comment>
    <skos:prefLabel xml:lang="en">eSport cognitive-enhancement drug ethics policy</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">e스포츠 인지향상 약물윤리 정책</skos:prefLabel>
  </rdf:Description>
