  <rdf:Description rdf:about="#participation_context__nuri_early_childhood_play_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_institution"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__nuri_early_childhood_play_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유아교육기관 놀이 운영 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Early childhood institution play-operation context</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유아가 보육·교육기관에서 놀이를 통해 기본움직임기술을 경험하는 기관 기반 참여 맥락</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019 개정 누리과정 놀이운영 사례집 내 기본움직임 요소 내용분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019 개정 누리과정의 현장 지원자료인 놀이 운영사례집 5권을 분석하여 만 3~5세 유아의 기본움직임기술 요소를 검토하였다. 분석 결과 안정성 움직임, 복합 이동성 움직임, 조작적 움직임 요소가 균형 있게 포함될 필요가 있으며, 유아 신체 기본움직임 프로그램 지원과 교사 연수 필요가 제시되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_content_analysis</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">Early childhood institution play-operation context</rdfs:label>
    <rdfs:comment xml:lang="ko">유아가 보육·교육기관에서 놀이를 통해 기본움직임기술을 경험하는 기관 기반 참여 맥락</rdfs:comment>
    <skos:prefLabel xml:lang="en">Early childhood institution play-operation context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유아교육기관 놀이 운영 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#sport_activity__winter_paralympic_parasport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#parasport"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__winter_paralympic_parasport</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">동계패럴림픽 장애인스포츠</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Winter Paralympic parasport</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018 평창동계패럴림픽을 통해 조직·운영된 동계 장애인스포츠 활동</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018 평창동계패럴림픽 레거시 및 결산 고찰</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국특수체육학회지</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018 평창동계패럴림픽의 레거시를 스포츠, 사회, 환경, 도시, 경제에 더해 문화, ICT, 평화 레거시로 고찰하고, 홍보, 예산, 참가자, 관람객, 자원봉사자, 등급분류 제로정책, 체육시설 활용, 수송 및 접근성 극대화, 도핑테스트, 방송·취재 환경, 첨단 ICT 패럴림픽 운영을 결산하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <isp:has_activity_outcome rdf:resource="#outcome__disability_sport_legacy_strengthening"/>
    <rdfs:label xml:lang="en">Winter Paralympic parasport</rdfs:label>
    <rdfs:comment xml:lang="ko">2018 평창동계패럴림픽을 통해 조직·운영된 동계 장애인스포츠 활동</rdfs:comment>
    <skos:prefLabel xml:lang="en">Winter Paralympic parasport</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">동계패럴림픽 장애인스포츠</skos:prefLabel>
  </rdf:Description>
