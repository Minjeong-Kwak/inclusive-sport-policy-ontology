  <rdf:Description rdf:about="#target_group__elementary_students_sport_sociability_assessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_age_child"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__elementary_students_sport_sociability_assessment</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 사회성 평가 초등학생</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">elementary students for sport sociability assessment</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 사회성 척도 적용 대상인 초등학교 3~6학년 학생 집단</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 사회성 척도의 다집단 요인분석과 잠재평균 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">초등학교 3~6학년 651명을 대상으로 스포츠 사회성 척도의 구인타당도, 형태동일성, 측정동일성, 절편동일성을 검증하고 초등학생 사회성 측정 도구로 적합함을 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">elementary students for sport sociability assessment</rdfs:label>
    <rdfs:comment xml:lang="ko">스포츠 사회성 척도 적용 대상인 초등학교 3~6학년 학생 집단</rdfs:comment>
    <skos:prefLabel xml:lang="en">elementary students for sport sociability assessment</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠 사회성 평가 초등학생</skos:prefLabel>
  </rdf:Description>
