    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">생활체육지도자·시설관리자·동호인·시민 160명을 대상으로 생활체육시설 분포와 규모의 부족을 분석함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated_v66_added_from_uploaded_literature</isp:note>
    <rdfs:label xml:lang="en">Adequacy assessment data for living sport facilities in Uiwang</rdfs:label>
