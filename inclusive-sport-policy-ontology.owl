  <rdf:Description rdf:about="#outcome__esport_fairness_integrity_protection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#discrimination_experience_reduction"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">e스포츠 공정성·무결성 보호</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eSports fairness and integrity protection</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AI 보조 플레이로 인한 불공정성을 줄이고 e스포츠 경기의 공정성과 무결성을 보호하는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑 개념의 확대를 통한 e스포츠 대회에서의 AI 도핑 규제</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">문화·미디어·엔터테인먼트법</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AI 도핑은 e스포츠 대회의 윤리성, 페어플레이 정신, 정직성을 침해할 수 있다고 설명함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__esport_fairness_integrity_protection</isp:entity_id>
    <rdfs:label xml:lang="en">eSports fairness and integrity protection</rdfs:label>
    <rdfs:comment xml:lang="ko">AI 보조 플레이로 인한 불공정성을 줄이고 e스포츠 경기의 공정성과 무결성을 보호하는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">eSports fairness and integrity protection</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">e스포츠 공정성·무결성 보호</skos:prefLabel>
  </rdf:Description>
