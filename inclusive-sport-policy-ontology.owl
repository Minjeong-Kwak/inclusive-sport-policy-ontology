  <rdf:Description rdf:about="#outcome__doping_ethics_conceptual_understanding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capability_outcome"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑윤리 개념 이해 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improved conceptual understanding of doping ethics</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locke의 관점에서 본 자기에 의한 신체소유권으로서의 도핑-1988년 서울올림픽 벤 존슨 도핑의 경우-</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Korean Journal of Physical Education</isp:source_publisher>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑을 개인의 신체처분 자유가 아니라 스포츠 본질과 공정성의 관점에서 이해하는 역량 성과임</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑을 개인의 신체처분 자유가 아니라 스포츠 본질과 공정성의 관점에서 이해하는 역량 성과임</isp:evidence_excerpt>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__doping_ethics_conceptual_understanding</isp:entity_id>
    <rdfs:label xml:lang="en">Improved conceptual understanding of doping ethics</rdfs:label>
    <rdfs:comment xml:lang="ko">도핑을 개인의 신체처분 자유가 아니라 스포츠 본질과 공정성의 관점에서 이해하는 역량 성과임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Improved conceptual understanding of doping ethics</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">도핑윤리 개념 이해 향상</skos:prefLabel>
  </rdf:Description>
