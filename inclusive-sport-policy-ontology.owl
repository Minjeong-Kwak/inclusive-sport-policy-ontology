  <rdf:Description rdf:about="#sport_activity__equestrian_training">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#sport_activity"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__equestrian_training</isp:entity_id>
