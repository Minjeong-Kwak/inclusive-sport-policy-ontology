    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">트랜스젠더 선수의 배제가 타당성과 일관성을 결여할 수 있음을 비판적으로 분석함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated_v69_added_from_uploaded_literature</isp:note>
