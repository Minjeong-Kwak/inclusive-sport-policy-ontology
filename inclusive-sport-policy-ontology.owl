  <rdf:Description rdf:about="#outcome__athlete_moral_responsibility_strengthening">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__athlete_moral_responsibility_strengthening</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">선수 도덕적 책임의식 강화</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">athlete moral responsibility strengthening</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">선수가 윤리적 행동의 필요성과 자신의 도덕적 책임을 인식하는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 선수의 도덕적 의무에 관한 소고</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠와 윤리</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑과 승부조작 문제를 바탕으로 스포츠 선수에게 요구되는 도덕적 의무로 정직성, 책임감, 공정성을 도출하고 교육적·제도적 실천 방안을 제안하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">athlete moral responsibility strengthening</rdfs:label>
    <rdfs:comment xml:lang="ko">선수가 윤리적 행동의 필요성과 자신의 도덕적 책임을 인식하는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">athlete moral responsibility strengthening</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">선수 도덕적 책임의식 강화</skos:prefLabel>
  </rdf:Description>
