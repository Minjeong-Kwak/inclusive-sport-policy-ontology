  <rdf:Description rdf:about="#program__twelve_week_aquatic_exercise_knee_osteoarthritis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#medical_welfare_linked_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__twelve_week_aquatic_exercise_knee_osteoarthritis</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">퇴행성관절염 12주 수중운동 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twelve-week aquatic exercise program for knee osteoarthritis</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">무릎 퇴행성관절염 여성노인을 대상으로 12주간 주 3회, 회당 60분 운영된 수중운동 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간의 수중운동프로그램이 퇴행성 관절염 환자의 보행에 미치는 영향: 사례연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">무릎 퇴행성관절염을 가진 66세 여성 노인 1명이 12주간 주 3회, 회당 60분 수중운동 프로그램에 참여하였다. 프로그램 후 보행 능력과 무릎 안정성에 긍정적 변화가 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:program_duration_weeks rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</isp:program_duration_weeks>
    <isp:session_frequency_per_week rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</isp:session_frequency_per_week>
    <isp:session_duration_minutes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60</isp:session_duration_minutes>
    <isp:target_participant_size rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</isp:target_participant_size>
    <isp:targets_target_group rdf:resource="#target_group__elderly_woman_knee_osteoarthritis_aquatic_exercise"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__aquatic_exercise_knee_osteoarthritis"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__twelve_week_aquatic_exercise_osteoarthritis"/>
    <isp:produces_outcome rdf:resource="#outcome__knee_osteoarthritis_gait_ability_improvement_aquatic_exercise"/>
    <isp:produces_outcome rdf:resource="#outcome__knee_osteoarthritis_knee_stability_improvement_aquatic_exercise"/>
    <rdfs:label xml:lang="en">Twelve-week aquatic exercise program for knee osteoarthritis</rdfs:label>
    <rdfs:comment xml:lang="ko">무릎 퇴행성관절염 여성노인을 대상으로 12주간 주 3회, 회당 60분 운영된 수중운동 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Twelve-week aquatic exercise program for knee osteoarthritis</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">퇴행성관절염 12주 수중운동 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__elderly_woman_knee_osteoarthritis_aquatic_exercise"/>
  </rdf:Description>
