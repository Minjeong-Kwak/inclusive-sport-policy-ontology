  <rdf:Description rdf:about="#target_group__preschool_children_nuri_fundamental_movement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#preschool_child"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__preschool_children_nuri_fundamental_movement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">누리과정 기본움직임 대상 유아</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preschool children in Nuri fundamental movement activities</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019 개정 누리과정 놀이운영 사례집에서 기본움직임기술 활동의 대상이 되는 만 3~5세 유아</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019 개정 누리과정 놀이운영 사례집 내 기본움직임 요소 내용분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019 개정 누리과정의 현장 지원자료인 놀이 운영사례집 5권을 분석하여 만 3~5세 유아의 기본움직임기술 요소를 검토하였다. 분석 결과 안정성 움직임, 복합 이동성 움직임, 조작적 움직임 요소가 균형 있게 포함될 필요가 있으며, 유아 신체 기본움직임 프로그램 지원과 교사 연수 필요가 제시되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_content_analysis</isp:evidence_strength_level>
    <isp:is_involved_in_context rdf:resource="#participation_context__nuri_early_childhood_play_context"/>
    <rdfs:label xml:lang="en">Preschool children in Nuri fundamental movement activities</rdfs:label>
    <rdfs:comment xml:lang="ko">2019 개정 누리과정 놀이운영 사례집에서 기본움직임기술 활동의 대상이 되는 만 3~5세 유아</rdfs:comment>
    <skos:prefLabel xml:lang="en">Preschool children in Nuri fundamental movement activities</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">누리과정 기본움직임 대상 유아</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__doping_control_center_product_analysis">
