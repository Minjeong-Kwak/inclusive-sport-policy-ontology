    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인 야구팀 활동은 참여자의 심리적 성장과 적응에 기여하였다.</isp:evidence_excerpt>
