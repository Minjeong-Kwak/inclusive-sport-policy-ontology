  <rdf:Description rdf:about="#target_group__children_adolescents_scoliosis_exercise_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_age_child"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__children_adolescents_scoliosis_exercise_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동중재 지원이 필요한 척추측만 아동·청소년</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Children and adolescents with scoliosis requiring exercise support</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">척추측만으로 자세와 기능 개선을 위한 운동중재 지원이 필요한 아동·청소년 집단</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Effects Of Different Exercise Interventions On Scoliosis In Children And Adolescents: A Reticulated Meta-Analysis</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022 3rd Asia Sport Science Conference Abstracts</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conference_abstract</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">109-110</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The conference abstract reviewed randomized controlled studies on exercise interventions for scoliosis in children and adolescents. Twenty-two studies with 1,110 samples were included, and Schroth training, functional training, and stability training showed significant effects compared with no exercise, with Schroth plus hippotherapy, Schroth, stability, and functional training ranked as leading approaches.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <rdfs:label xml:lang="en">Children and adolescents with scoliosis requiring exercise support</rdfs:label>
    <rdfs:comment xml:lang="ko">척추측만으로 자세와 기능 개선을 위한 운동중재 지원이 필요한 아동·청소년 집단</rdfs:comment>
    <skos:prefLabel xml:lang="en">Children and adolescents with scoliosis requiring exercise support</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">운동중재 지원이 필요한 척추측만 아동·청소년</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__elderly_balance_ability_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__elderly_balance_ability_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인 균형능력 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">elderly balance ability improvement</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인의 낙상위험을 낮추기 위해 균형능력을 개선하는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">탄력밴드를 이용한 저항성 운동과 균형 운동이 여성 노인의 신체구성과 일상생활체력에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">균형 집단에서 눈뜨고외발서기 등 균형 관련 체력 요소가 향상됨.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated_v68_added_from_uploaded_literature</isp:note>
    <rdfs:label xml:lang="en">elderly balance ability improvement</rdfs:label>
    <rdfs:comment xml:lang="ko">노인의 낙상위험을 낮추기 위해 균형능력을 개선하는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">elderly balance ability improvement</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">노인 균형능력 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__national_team_athletes_anti_doping_policy">
