  <rdf:Description rdf:about="#support_resource__elite_swimmer_stress_source_assessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#information_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__elite_swimmer_stress_source_assessment</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 수영선수 스트레스 원천 평가자료</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elite swimmer stress-source assessment resource</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Examining the Difference of Stress Sources between American and Korean Elite Swimmers</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">International Journal of Human Movement Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">탐색적 요인분석을 통해 환경, 경기력, 물류·접근, 불확실성, 인내의 스트레스 요인을 도출함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">환경, 경기력, 접근·물류, 불확실성, 인내 요인으로 구성된 엘리트 수영선수 스트레스 원천 평가자료임</isp:definition_text>
    <isp:supports_target_group rdf:resource="#target_group__american_korean_elite_swimmers"/>
    <rdfs:label xml:lang="en">Elite swimmer stress-source assessment resource</rdfs:label>
    <rdfs:comment xml:lang="ko">환경, 경기력, 접근·물류, 불확실성, 인내 요인으로 구성된 엘리트 수영선수 스트레스 원천 평가자료임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Elite swimmer stress-source assessment resource</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">엘리트 수영선수 스트레스 원천 평가자료</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__american_korean_elite_swimmers"/>
  </rdf:Description>
