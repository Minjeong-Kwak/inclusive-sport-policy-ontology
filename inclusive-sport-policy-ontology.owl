    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support resource  judo weight category antidoping guideline</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 유도선수들의 반도핑 경향에 대한 근원적 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 유도선수 10명 질적연구에서 도핑 인지 수준, 도핑검사 경험, 체급 특성에 따른 도핑 유혹, 윤리교육의 필요가 제시됨.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">support resource  judo weight category antidoping guideline</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing support resource  judo weight category antidoping guideline in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">support resource  judo weight category antidoping guideline</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유도 체급 특성 반영 반도핑 지침</skos:prefLabel>
  </rdf:Description>
