  <rdf:Description rdf:about="#support_resource__german_kader_athlete_system">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program_information"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__german_kader_athlete_system</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">독일 카더 선수관리 시스템</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support resource  german kader athlete system</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여섯 키워드로 본 독일 엘리트스포츠 시스템에 대한 사적 고찰</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">독일 엘리트스포츠 시스템은 독일올림픽스포츠연맹, 연구소, 올림픽훈련센터, 스포츠학교, 카더 시스템, 연방경찰·군·세관 지원을 핵심 요소로 제시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">support resource  german kader athlete system</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing support resource  german kader athlete system in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">support resource  german kader athlete system</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">독일 카더 선수관리 시스템</skos:prefLabel>
  </rdf:Description>
