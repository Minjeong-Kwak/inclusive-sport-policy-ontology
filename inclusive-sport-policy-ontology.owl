  <rdf:Description rdf:about="#outcome__guillain_barre_gait_speed_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#daily_life_functioning_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__guillain_barre_gait_speed_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">길랭-바레 증후군 보행속도 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gait speed improvement in Guillain-Barre syndrome</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Changes in body composition, physical fitness and quality of life on robotic gait assisted training in patients with Guillain-Barré Syndrome: a case report</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">보행속도가 0.7 km/h에서 1.8 km/h로 증가함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">로봇 보행 훈련 후 보행속도 증가가 직접 보고됨</isp:definition_text>
    <rdfs:label xml:lang="en">Gait speed improvement in Guillain-Barre syndrome</rdfs:label>
    <rdfs:comment xml:lang="ko">로봇 보행 훈련 후 보행속도 증가가 직접 보고됨</rdfs:comment>
    <skos:prefLabel xml:lang="en">Gait speed improvement in Guillain-Barre syndrome</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">길랭-바레 증후군 보행속도 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__disability_sport_staff">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program_manager"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__disability_sport_staff</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인 체육 프로그램 운영 종사자</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disability sport program staff</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인 체육활동 프로그램을 운영·관리하며 참여자 인식과 서비스 전달에 영향을 미치는 인적 자원.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동하는 장애인에 대한 장애인 체육 분야 종사자의 인식 유형 탐색</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://dx.doi.org/10.24007/ajpess.2023.11.1.015</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">15-16</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인 체육회 및 시설관리공단 종사자 32명을 대상으로 운동하는 장애인에 대한 인식 유형을 분석하였다.</isp:evidence_excerpt>
    <rdfs:label xml:lang="en">disability sport program staff</rdfs:label>
    <rdfs:comment xml:lang="ko">장애인 체육활동 프로그램을 운영·관리하며 참여자 인식과 서비스 전달에 영향을 미치는 인적 자원.</rdfs:comment>
    <skos:prefLabel xml:lang="en">disability sport program staff</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">장애인 체육 프로그램 운영 종사자</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__school_posture_corrective_exercise_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_linked_program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학생 자세 교정·운동 지원 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">School posture corrective exercise support program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">가방 하중으로 인한 자세 이상과 근골격계 통증을 예방하기 위해 학교 환경에서 제공되는 운동 지원 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analytical parameters to check association between load carriage system and bag packs-influenced musculoskeletal complications among school going students: a scoping review</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">review_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">20-26</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The scoping review found that backpack load and load-carriage systems among school-going students were associated with lower back, shoulder, and neck pain and postural abnormalities, and recommended broader evaluation and preventive approaches.</isp:evidence_excerpt>
    <isp:targets_target_group rdf:resource="#target_group__school_students_backpack_musculoskeletal_support"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__school_bag_load_carriage_context"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__school_backpack_load_guideline"/>
    <isp:produces_outcome rdf:resource="#outcome__school_student_neck_back_pain_reduction"/>
    <isp:produces_outcome rdf:resource="#outcome__school_student_postural_abnormality_prevention"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__school_posture_corrective_exercise_support</isp:entity_id>
    <rdfs:label xml:lang="en">School posture corrective exercise support program</rdfs:label>
    <rdfs:comment xml:lang="ko">가방 하중으로 인한 자세 이상과 근골격계 통증을 예방하기 위해 학교 환경에서 제공되는 운동 지원 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">School posture corrective exercise support program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">학생 자세 교정·운동 지원 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__school_students_backpack_musculoskeletal_support"/>
  </rdf:Description>
  <rdf:Description rdf:about="#program__sport_volunteer_recruitment_by_motivation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">동기 기반 스포츠 자원봉사자 모집 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Motivation-based sport volunteer recruitment program</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Volunteer Motivations in Sport: Gender Differences among College Students in Singapore</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">가치, 이해, 사회, 진로, 향상, 보호 동기를 고려하여 스포츠 자원봉사자를 모집하는 프로그램임</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">가치, 이해, 사회, 진로, 향상, 보호 동기를 고려하여 스포츠 자원봉사자를 모집하는 프로그램임</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:targets_target_group rdf:resource="#target_group__singapore_sport_volunteer_college_students"/>
