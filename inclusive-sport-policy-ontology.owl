  <rdf:Description rdf:about="#program__guillain_barre_robotic_gait_assisted_training">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#medical_welfare_linked_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__guillain_barre_robotic_gait_assisted_training</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">길랭-바레 증후군 로봇 보행 보조 훈련 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Robotic gait-assisted training program for Guillain-Barre syndrome</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Changes in body composition, physical fitness and quality of life on robotic gait assisted training in patients with Guillain-Barré Syndrome: a case report</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4주간 주 3회 로봇 보행 보조 장치를 활용한 인터벌 훈련을 수행함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">길랭-바레 증후군 환자를 대상으로 한 로봇 보행 보조 훈련 프로그램임</isp:definition_text>
    <isp:targets_target_group rdf:resource="#target_group__guillain_barre_syndrome_gait_rehabilitation_patient"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__robotic_gait_assisted_rehabilitation_training"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__end_effector_robotic_gait_assistant_device"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__guillain_barre_robotic_interval_training_context"/>
    <isp:produces_outcome rdf:resource="#outcome__guillain_barre_gait_speed_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__guillain_barre_mobility_function_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__guillain_barre_exercise_self_efficacy_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__guillain_barre_quality_of_life_improvement"/>
    <rdfs:label xml:lang="en">Robotic gait-assisted training program for Guillain-Barre syndrome</rdfs:label>
    <rdfs:comment xml:lang="ko">길랭-바레 증후군 환자를 대상으로 한 로봇 보행 보조 훈련 프로그램임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Robotic gait-assisted training program for Guillain-Barre syndrome</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">길랭-바레 증후군 로봇 보행 보조 훈련 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__guillain_barre_syndrome_gait_rehabilitation_patient"/>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__retired_athlete_psychological_counseling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#human_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__retired_athlete_psychological_counseling</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">은퇴선수 심리상담 지원</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psychological counseling support for retired athletes</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">은퇴 후 심리적 공허감, 불안, 고립감을 완화하기 위한 상담 지원자원</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 리듬체조 선수들의 은퇴 후 삶에 대한 사례 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">전직 엘리트 리듬체조 선수 7명의 은퇴 후 경험을 분석한 결과, 정체성 변화, 진로 선택, 사회적 관계 변화, 심리적 고립과 공허감이 나타났다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
