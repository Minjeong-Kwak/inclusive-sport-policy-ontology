  <rdf:Description rdf:about="#program__safe_physical_activity_intervention_female_college_pandemic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#online_remote_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__safe_physical_activity_intervention_female_college_pandemic</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">코로나19 상황 여대생 안전 신체활동 중재</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">safe physical activity intervention for female college students during COVID-19</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">팬데믹 상황에서도 여대생의 신체활동량을 안전하게 늘려 우울감 감소와 자기효능감 향상을 지원하는 프로그램.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">코로나-19 상황에서 여대생의 신체활동량이 우울 및 자기효능감에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">팬데믹 상황에서 신체활동량을 안전하게 증가시킬 수 있는 중재방법이 필요하다고 제시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated_v67_added_from_uploaded_literature</isp:note>
    <isp:targets_target_group rdf:resource="#target_group__female_college_students_pandemic_physical_activity"/>
    <isp:produces_outcome rdf:resource="#outcome__female_college_depression_reduction_pandemic"/>
    <isp:produces_outcome rdf:resource="#outcome__female_college_self_efficacy_enhancement_pandemic"/>
    <rdfs:label xml:lang="en">safe physical activity intervention for female college students during COVID-19</rdfs:label>
    <rdfs:comment xml:lang="ko">팬데믹 상황에서도 여대생의 신체활동량을 안전하게 늘려 우울감 감소와 자기효능감 향상을 지원하는 프로그램.</rdfs:comment>
    <skos:prefLabel xml:lang="en">safe physical activity intervention for female college students during COVID-19</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">코로나19 상황 여대생 안전 신체활동 중재</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__female_college_students_pandemic_physical_activity"/>
  </rdf:Description>
