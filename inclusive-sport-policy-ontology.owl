  <rdf:Description rdf:about="#outcome__middle_school_soccer_competitive_anxiety_reduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#mental_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__middle_school_soccer_competitive_anxiety_reduction</isp:entity_id>
