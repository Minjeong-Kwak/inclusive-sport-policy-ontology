    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국가대표 선수들의 금지약물 적발 사건이 국내 도핑방지 정책문제 흐름을 발생시킨 것으로 분석되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">National Team Athletes Anti Doping Policy</isp:pref_label_en>
    <rdfs:label xml:lang="en">National Team Athletes Anti Doping Policy</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing National Team Athletes Anti Doping Policy in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">National Team Athletes Anti Doping Policy</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">도핑방지 정책 대상 국가대표 및 선수</skos:prefLabel>
  </rdf:Description>
