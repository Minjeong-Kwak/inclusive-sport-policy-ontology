  <rdf:Description rdf:about="#outcome__free_semester_pe_class_satisfaction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__free_semester_pe_class_satisfaction</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">자유학기제 체육활동 만족도 향상</isp:pref_label_ko>
