  </rdf:Description>
  <rdf:Description rdf:about="#program__twelve_week_telecommunication_exercise_elderly_disabilities">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#online_remote_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__twelve_week_telecommunication_exercise_elderly_disabilities</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애노인 12주 원격운동 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twelve-week telecommunication exercise program for elderly persons with disabilities</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애노인의 삶의 질 향상을 목적으로 12주간 주 2회 운영된 비대면 운동재활 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간 원격운동 프로그램이 장애노인의 삶의 질에 미치는 효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애노인 25명을 대상으로 원격운동 프로그램 참여군 12명과 비참여군 13명을 구분하고, 참여군은 12주간 주 2회 비대면 운동재활 프로그램에 참여하였다. 신체건강의 피로와 통증, 정신건강의 불안과 우울, 사회건강의 사회생활 변인에서 긍정적 효과가 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:program_duration_weeks rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</isp:program_duration_weeks>
    <isp:session_frequency_per_week rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</isp:session_frequency_per_week>
    <isp:actual_participant_size rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</isp:actual_participant_size>
    <isp:targets_target_group rdf:resource="#target_group__elderly_with_disabilities_remote_exercise"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__telecommunication_rehabilitation_exercise"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__twelve_week_remote_exercise_disability_elderly"/>
    <isp:produces_outcome rdf:resource="#outcome__elderly_disability_fatigue_reduction_remote_exercise"/>
    <isp:produces_outcome rdf:resource="#outcome__elderly_disability_pain_reduction_remote_exercise"/>
    <isp:produces_outcome rdf:resource="#outcome__elderly_disability_anxiety_reduction_remote_exercise"/>
    <isp:produces_outcome rdf:resource="#outcome__elderly_disability_depression_reduction_remote_exercise"/>
    <isp:produces_outcome rdf:resource="#outcome__elderly_disability_social_activity_improvement_remote_exercise"/>
    <isp:produces_outcome rdf:resource="#outcome__elderly_disability_quality_of_life_improvement_remote_exercise"/>
    <rdfs:label xml:lang="en">Twelve-week telecommunication exercise program for elderly persons with disabilities</rdfs:label>
    <rdfs:comment xml:lang="ko">장애노인의 삶의 질 향상을 목적으로 12주간 주 2회 운영된 비대면 운동재활 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Twelve-week telecommunication exercise program for elderly persons with disabilities</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">장애노인 12주 원격운동 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__elderly_with_disabilities_remote_exercise"/>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__secondary_school_physical_education_teachers_japan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#target_group"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">일본 중등 체육교사</isp:pref_label_ko>
