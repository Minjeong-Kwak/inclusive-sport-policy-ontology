  <rdf:Description rdf:about="#spatial_context__agricultural_fishery_seasonal_labor_area">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#remote_area"/>
