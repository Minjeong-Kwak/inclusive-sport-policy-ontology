  <rdf:Description rdf:about="#policy__elite_sport_normalization_policy_discourse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#sport_policy"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy__elite_sport_normalization_policy_discourse</isp:entity_id>
