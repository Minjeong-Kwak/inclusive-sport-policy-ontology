    <skos:prefLabel xml:lang="en">Sport organization commitment management program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠조직 몰입 관리 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__sport_organization_staff_members"/>
  </rdf:Description>
  <rdf:Description rdf:about="#has_target_group_anchor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="#ontology_entity"/>
    <rdfs:range rdf:resource="#target_group"/>
    <owl:inverseOf rdf:resource="#is_target_group_anchor_for"/>
    <rdfs:label xml:lang="en">has target group anchor</rdfs:label>
    <rdfs:comment xml:lang="en">Generic target-group anchoring relation used to support single-path queries from any ontology entity to the target group that it addresses, supports, reflects, involves, or interacts with. More specific target-group relations are declared as subproperties of this relation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__upgraded_neighbourhood_sport_facility_use">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_context"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">개선된 근린 스포츠시설 이용 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use context of upgraded neighbourhood sport facility</isp:pref_label_en>
