    <isp:produces_outcome rdf:resource="#outcome__doping_human_rights_violation_awareness"/>
    <rdfs:label xml:lang="en">program  state sport doping human rights education</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing program  state sport doping human rights education in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">program  state sport doping human rights education</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">국가주도 스포츠 도핑 인권교육</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__east_german_women_athletes_doping_victims"/>
  </rdf:Description>
