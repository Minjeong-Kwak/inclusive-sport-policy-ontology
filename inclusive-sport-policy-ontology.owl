  <rdf:Description rdf:about="#community_belonging_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#social_integration_outcome"/>
    <rdfs:label xml:lang="en">Community Belonging Improvement</rdfs:label>
    <rdfs:comment xml:lang="en">An outcome class representing improvement in community belonging associated with sport participation policies or programs.</rdfs:comment>
