  <rdf:Description rdf:about="#target_group__people_with_physical_and_visual_disabilities">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#disabled_person"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__people_with_physical_and_visual_disabilities</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지체·시각장애 운동참여자</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exercise participants with physical or visual disabilities</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인 운동 참여 경험에 관한 질적 연구: 사회학적 관점을 중심으로</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지체장애와 시각장애를 가진 연구참여자 5명을 대상으로 운동 참여 경험을 분석하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Added in v58 from uploaded academic literature; class assignment limited to directly evidenced entities.</isp:note>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <rdfs:label xml:lang="en">Exercise participants with physical or visual disabilities</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Exercise participants with physical or visual disabilities in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Exercise participants with physical or visual disabilities</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">지체·시각장애 운동참여자</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__regional_sport_ecology_curriculum_resource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#information_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__regional_sport_ecology_curriculum_resource</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지역 스포츠 생태 교육과정 자료</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">regional sport ecology curriculum resource</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지역사회 생태와 스포츠 자원을 교양체육 교육과정으로 연결하기 위한 설계 자료.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지역사회 연계형 교양체육 모형 개발을 위한 기초연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2016</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지역사회 연계형 모형 개발을 위한 학생 인식과 요구를 조사하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">regional sport ecology curriculum resource</rdfs:label>
    <rdfs:comment xml:lang="ko">지역사회 생태와 스포츠 자원을 교양체육 교육과정으로 연결하기 위한 설계 자료.</rdfs:comment>
    <skos:prefLabel xml:lang="en">regional sport ecology curriculum resource</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">지역 스포츠 생태 교육과정 자료</skos:prefLabel>
  </rdf:Description>
