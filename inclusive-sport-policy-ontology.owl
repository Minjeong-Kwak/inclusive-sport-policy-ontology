  <rdf:Description rdf:about="#support_resource__zoom_online_training_platform">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_platform"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__zoom_online_training_platform</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zoom 온라인 운동 플랫폼</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zoom online training platform</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">온라인 비대면 타바타 홈트레이닝 전달에 사용된 참여 플랫폼</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">8주간의 온라인 비대면 타바타 홈 트레이닝이 남자 청소년의 신체구성, 건강 체력 및 정신건강에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">코로나 팬데믹 상황에서 남자 청소년 17명을 대상으로, 홈 트레이닝 집단은 Zoom을 활용하여 8주간 주 3회, 1회 15분 동안 타바타 홈 트레이닝 프로그램에 참여하였다. 근지구력과 심폐지구력은 유의하게 향상되었고, 정신건강과 우울은 유의한 차이가 나타나지 않았다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:supports_program rdf:resource="#program__eight_week_online_tabata_home_training_male_adolescents"/>
    <rdfs:label xml:lang="en">Zoom online training platform</rdfs:label>
    <rdfs:comment xml:lang="ko">온라인 비대면 타바타 홈트레이닝 전달에 사용된 참여 플랫폼</rdfs:comment>
    <skos:prefLabel xml:lang="en">Zoom online training platform</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">Zoom 온라인 운동 플랫폼</skos:prefLabel>
  </rdf:Description>
