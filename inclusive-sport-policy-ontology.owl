  <rdf:Description rdf:about="#outcome__community_sport_social_integration_via_ymca">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#social_integration_outcome"/>
    <rdfs:label xml:lang="ko">YMCA 기반 지역사회 스포츠 통합</rdfs:label>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">YMCA 기반 지역사회 스포츠 통합</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">community sport social integration via YMCA</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">YMCA 체육운동을 통해 지역사회 참여자 간 통합과 연계를 강화하는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠산업 기반 스포츠·피트니스 트렌드와 YMCA 체육운동 4.0</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">YMCA가 스포츠 지식과 정보의 공유자 및 사회적 통합 플랫폼으로서 역할할 필요를 제시하고, 스포츠·피트니스 트렌드와 YMCA 체육운동의 발전과제를 논의하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary_evidence</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__community_sport_social_integration_via_ymca</isp:entity_id>
    <rdfs:comment xml:lang="ko">YMCA 체육운동을 통해 지역사회 참여자 간 통합과 연계를 강화하는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">community sport social integration via YMCA</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">YMCA 기반 지역사회 스포츠 통합</skos:prefLabel>
