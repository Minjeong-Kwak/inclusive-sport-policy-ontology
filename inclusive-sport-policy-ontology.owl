    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인의 근력 지표를 건강위험 관리에 활용하는 성과로 직접 연결됨</isp:definition_text>
    <isp:is_produced_by_program rdf:resource="#program__elderly_bmi_relative_grip_strength_screening"/>
    <rdfs:label xml:lang="en">Older adult muscle-strength-based health risk monitoring</rdfs:label>
    <rdfs:comment xml:lang="ko">노인의 근력 지표를 건강위험 관리에 활용하는 성과로 직접 연결됨</rdfs:comment>
    <skos:prefLabel xml:lang="en">Older adult muscle-strength-based health risk monitoring</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">노인 근력 기반 건강위험 모니터링</skos:prefLabel>
  </rdf:Description>
