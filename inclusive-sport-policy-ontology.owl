    <rdfs:label xml:lang="en">media engagement increase through professional baseball SNS</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing media engagement increase through professional baseball SNS in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">media engagement increase through professional baseball SNS</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">프로야구단 SNS 미디어 인게이지먼트 향상</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__college_baseball_fans_sns_engagement"/>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__menopause_women_metabolic_risk_management">
