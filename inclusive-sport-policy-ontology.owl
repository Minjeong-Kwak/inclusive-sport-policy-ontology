  <rdf:Description rdf:about="#target_group__elementary_students_ai_pe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_age_child"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__elementary_students_ai_pe</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AI 체육교육 참여 초등학생</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">elementary students participating in AI-supported physical education</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AI, 가상현실 스포츠실, 웨어러블 디바이스 등이 적용되는 초등체육교육의 학습자 집단.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4차 산업혁명 시대, AI와 초등체육교육의 초연결</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Journal of Korea Elementary Education</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://dx.doi.org/10.20972/Kjee.31.S.202101.S159</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">159-160</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">초등체육교육에서 가상현실 스포츠실, 웨어러블 디바이스, 인공지능 로봇, IoT 등이 연결될 수 있다고 제시하였다.</isp:evidence_excerpt>
    <rdfs:label xml:lang="en">elementary students participating in AI-supported physical education</rdfs:label>
    <rdfs:comment xml:lang="ko">AI, 가상현실 스포츠실, 웨어러블 디바이스 등이 적용되는 초등체육교육의 학습자 집단.</rdfs:comment>
    <skos:prefLabel xml:lang="en">elementary students participating in AI-supported physical education</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">AI 체육교육 참여 초등학생</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__health_fitness_assessment_accessibility_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__health_fitness_assessment_accessibility_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">건강관련체력 평가 접근성 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">health-related fitness assessment accessibility improvement</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고가 장비와 전문가 의존을 줄여 건강관련체력 평가 접근성을 높이는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 의과학에서 인공 신경망 분석 알고리즘의 가능성</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스마트 피트니스 플랫폼에서 건강관련체력 추정을 위해 인공신경망 분석 알고리즘이 다중회귀모델보다 효과적인 도구가 될 수 있다고 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">health-related fitness assessment accessibility improvement</rdfs:label>
    <rdfs:comment xml:lang="ko">고가 장비와 전문가 의존을 줄여 건강관련체력 평가 접근성을 높이는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">health-related fitness assessment accessibility improvement</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">건강관련체력 평가 접근성 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__intersectoral_linkage_strengthening_governance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#intersectoral_linkage_strengthening"/>
