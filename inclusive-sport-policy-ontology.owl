  <rdf:Description rdf:about="#policy__doping_double_sanction_rule_review">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#law_regulation"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑징계 이중처벌 규정 검토</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Doping double sanction rule review</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑징계 이후 추가 출전 제한이 이중처벌이 되는지 검토하는 법제 기준.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑징계의 이중처벌에 관한 고찰</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">홍익법학</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑징계 이후 국가대표 선발 제한이 이중처벌금지 원칙 및 WADA-Code와 충돌할 수 있음을 검토함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy__doping_double_sanction_rule_review</isp:entity_id>
    <isp:has_policy_outcome rdf:resource="#outcome__athlete_rights_protection_doping_sanctions"/>
    <rdfs:label xml:lang="en">Doping double sanction rule review</rdfs:label>
    <rdfs:comment xml:lang="ko">도핑징계 이후 추가 출전 제한이 이중처벌이 되는지 검토하는 법제 기준.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Doping double sanction rule review</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">도핑징계 이중처벌 규정 검토</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__sports_welfare_underprivileged_beneficiaries">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#target_group"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__sports_welfare_underprivileged_beneficiaries</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠복지 취약 수혜집단</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Underprivileged beneficiaries of sports welfare</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Constructing a Composite Index of Sports Welfare: Application to the 17 Major Provinces and Cities in South Korea</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">International Journal of Applied Sports Sciences</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠복지는 전 국민 대상 보편복지와 스포츠활동이 제한된 집단을 위한 선택복지 맥락을 함께 다룸</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠참여 기회가 제한되어 스포츠복지 지원이 필요한 집단임</isp:definition_text>
    <rdfs:label xml:lang="en">Underprivileged beneficiaries of sports welfare</rdfs:label>
    <rdfs:comment xml:lang="ko">스포츠참여 기회가 제한되어 스포츠복지 지원이 필요한 집단임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Underprivileged beneficiaries of sports welfare</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠복지 취약 수혜집단</skos:prefLabel>
  </rdf:Description>
