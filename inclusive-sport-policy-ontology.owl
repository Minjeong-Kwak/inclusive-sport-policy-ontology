    <rdfs:label xml:lang="en">Independent living support program for people with disabilities</rdfs:label>
    <rdfs:comment xml:lang="ko">장애인의 지역사회 자립을 위해 동료상담, 개인별 자립지원, 자립생활기술훈련, 지역사회 자원 연계를 제공하는 사업.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Independent living support program for people with disabilities</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">장애인 자립생활 지원 사업</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__registered_disabled_people_2024_welfare_guideline"/>
