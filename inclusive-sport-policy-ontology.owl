    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">경쟁 스포츠 현장의 비도덕적 행동과 도덕적 이탈을 분석함</isp:evidence_excerpt>
    <isp:conditions_outcome rdf:resource="#outcome__ethical_awareness_risk_identification_v75"/>
