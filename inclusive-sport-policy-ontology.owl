    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">musculoskeletal pain patients</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동중재 메타분석에서 다룬 요통·관절통 등 근골격 통증을 경험하는 환자 집단</isp:definition_text>
