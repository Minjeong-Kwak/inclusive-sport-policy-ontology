  <rdf:Description rdf:about="#policy__eu_sport_good_governance_framework">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#sport_policy"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy__eu_sport_good_governance_framework</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EU 스포츠 굿 거버넌스 체계</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EU sport good governance framework</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유럽연합(EU)과 국제스포츠기구와의 협력과 갈등: ‘굿 거버넌스’를 중심으로</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EU가 법률과 정책을 통해 국제스포츠기구의 투명성, 책임성, 공정성을 증진하는 간접 규제 역할을 수행한다고 제시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:has_policy_outcome rdf:resource="#outcome__sport_organization_transparency_accountability_improvement"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__sport_good_governance_principles"/>
