    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dedicated football stadium spectator context</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">리그 승격과 경기장 신축에 따른 소비자행동 차이: 대구FC 2015, 2019 시즌 비교</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">literature_curated_instance</isp:source_type>
    <isp:source_identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">리그 승격과 경기장 신축에 따른 소비자행동 차이: 대구FC 2015, 2019 시즌 비교</isp:source_identifier>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2015년 구 종합경기장과 2019년 신축 축구전용경기장 관람객의 소비자행동을 비교함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated v33 instance from uploaded paper</isp:note>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <rdfs:label xml:lang="en">Dedicated football stadium spectator context</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Dedicated football stadium spectator context in the participation_context dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Dedicated football stadium spectator context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">축구전용경기장 관람 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__volleyball_agility_lower_power_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#performance_outcome"/>
    <rdf:type rdf:resource="#outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__volleyball_agility_lower_power_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">배구 민첩성·하체 근파워 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">improved volleyball agility and lower body power</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">기능적 움직임 평가와 훈련을 통해 배구 경기력과 관련된 민첩성 및 하체 근파워가 향상되는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프로 여자 배구선수의 기능적 움직임 평가 점수에 따른 운동수행능력의 차이</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMS 점수가 높은 집단에서 민첩성과 하체 근파워가 더 우수하게 나타났다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">improved volleyball agility and lower body power</rdfs:label>
    <rdfs:comment xml:lang="ko">기능적 움직임 평가와 훈련을 통해 배구 경기력과 관련된 민첩성 및 하체 근파워가 향상되는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">improved volleyball agility and lower body power</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">배구 민첩성·하체 근파워 향상</skos:prefLabel>
  </rdf:Description>
