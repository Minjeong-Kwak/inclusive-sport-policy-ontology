  <rdf:Description rdf:about="#target_group__high_school_female_pe_participants">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#adolescent"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__high_school_female_pe_participants</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고등학교 여학생 체육수업 참여자</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Female high-school physical education participants</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">뉴스포츠 체육수업이 고등학생의 건강체력 개선에 미치는 생리학적 효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">뉴스포츠 체육수업은 여학생의 건강체력 향상에 기여할 수 있는 수업으로 제시되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-15</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <rdfs:label xml:lang="en">Female high-school physical education participants</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Female high-school physical education participants in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Female high-school physical education participants</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">고등학교 여학생 체육수업 참여자</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__elderly_women_twice_weekly_theraband_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#regular_participation"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__elderly_women_twice_weekly_theraband_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여성노인 주 2회 탄력밴드 운동 참여 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twice-weekly Theraband exercise context for elderly women</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여성노인이 8주 동안 주 2회 탄력밴드 저항운동에 참여한 규칙적 참여 맥락</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Associations Between Skeletal Muscle Mass, Grip Strength, and Physical and Cognitive Functions in Elderly Women: Effect of Exercise with Resistive Theraband</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition and Biochemistry</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/jenb.2019.0023</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">50-51</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twenty-eight elderly women participated; 15 underwent elastic band exercise for 1 hour per day, twice per week for 8 weeks. Theraband exercise significantly improved gait speed and physical function.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">Twice-weekly Theraband exercise context for elderly women</rdfs:label>
    <rdfs:comment xml:lang="ko">여성노인이 8주 동안 주 2회 탄력밴드 저항운동에 참여한 규칙적 참여 맥락</rdfs:comment>
    <skos:prefLabel xml:lang="en">Twice-weekly Theraband exercise context for elderly women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">여성노인 주 2회 탄력밴드 운동 참여 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__technology_assisted_sport_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#institutional_context"/>
    <rdfs:label xml:lang="ko">과학기술 보조 스포츠 맥락</rdfs:label>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">과학기술 보조 스포츠 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">technology-assisted sport context</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장비, 의료기술, 인공지능 등 과학기술이 경기 수행과 판정에 개입하는 제도적 맥락</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠에서 과학의 개입한도와 기준 문제</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠에서 과학기술의 허용과 금지 기준이 모호한 경우 도핑, 의료기술, 장비, 필수장비와 관련한 공정성 논쟁이 발생함을 논의하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary_evidence</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__technology_assisted_sport_context</isp:entity_id>
    <rdfs:comment xml:lang="ko">장비, 의료기술, 인공지능 등 과학기술이 경기 수행과 판정에 개입하는 제도적 맥락</rdfs:comment>
    <skos:prefLabel xml:lang="en">technology-assisted sport context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">과학기술 보조 스포츠 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#sport_activity__asian_para_games_disability_sport">
