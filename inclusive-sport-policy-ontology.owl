  <rdf:Description rdf:about="#program__child_adolescent_obesity_prevention_management">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#child_program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">아동·청소년 비만 예방·관리 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Child and adolescent obesity prevention and management program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국가 비만관리 정책에서 중요한 세부 과제로 제시된 아동·청소년 비만 예방 및 관리 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analysis of public perception of national obesity management policy</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">27-35</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A national online survey of citizens aged 15-69 identified lifestyle improvement for obesity prevention, child and adolescent obesity prevention and management, community-based obesity and exercise clinics, and an integrated information platform for nutrition, diet, and physical activity as important national obesity policy tasks.</isp:evidence_excerpt>
    <isp:targets_target_group rdf:resource="#target_group__children_adolescents_obesity_prevention_support"/>
    <isp:produces_outcome rdf:resource="#outcome__lifestyle_improvement_for_obesity_prevention"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__child_adolescent_obesity_prevention_management</isp:entity_id>
    <rdfs:label xml:lang="en">Child and adolescent obesity prevention and management program</rdfs:label>
    <rdfs:comment xml:lang="ko">국가 비만관리 정책에서 중요한 세부 과제로 제시된 아동·청소년 비만 예방 및 관리 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Child and adolescent obesity prevention and management program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">아동·청소년 비만 예방·관리 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__children_adolescents_obesity_prevention_support"/>
  </rdf:Description>
