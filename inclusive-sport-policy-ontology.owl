  <rdf:Description rdf:about="#support_resource__ski_curriculum_standard_v75">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#guideline_manual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__ski_curriculum_standard_v75</isp:entity_id>
