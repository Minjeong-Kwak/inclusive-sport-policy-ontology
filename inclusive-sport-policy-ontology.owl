  <rdf:Description rdf:about="#program__student_athlete_first_doping_prevention_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__student_athlete_first_doping_prevention_education</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학생선수 우선 도핑예방교육</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program  student athlete first doping prevention education</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트선수의 인식을 통해 살펴본 도핑관리시스템의 문제</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 선수 인식 연구에서 대표선수 중심 도핑관리, 형식적 교육, 행정적 한계가 지적되었고 학생선수 중심 예방교육, 종목별 매뉴얼, 전담인력, 협력 거버넌스가 대안으로 제시됨.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:utilizes_support_resource rdf:resource="#support_resource__sport_specific_doping_management_manual"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__dedicated_sport_antidoping_staff"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__collaborative_antidoping_governance_context"/>
    <isp:produces_outcome rdf:resource="#outcome__doping_management_system_improvement"/>
    <rdfs:label xml:lang="en">program  student athlete first doping prevention education</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing program  student athlete first doping prevention education in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">program  student athlete first doping prevention education</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">학생선수 우선 도핑예방교육</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__older_women_physical_fitness_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__older_women_physical_fitness_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고령 여성 체력 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical fitness improvement in older women</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고령 여성의 순환운동빈도에 따른 Estradiol, Cortisol 및 체력 수준에 미치는 효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">65세 이상 고령 여성에게 12주간 순환운동을 적용하고 운동빈도에 따른 estradiol, cortisol, 체력 변화를 분석하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">physical fitness improvement in older women</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing physical fitness improvement in older women in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">physical fitness improvement in older women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">고령 여성 체력 향상</skos:prefLabel>
  </rdf:Description>
