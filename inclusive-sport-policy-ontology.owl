  <rdf:Description rdf:about="#participation_context__post_covid_mask_limited_pe_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#access_condition_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__post_covid_mask_limited_pe_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">방역지침 기반 체육활동 제한 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PE participation context limited by preventive measures</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exploring Middle School Students' Perceptions of Physical Education Activities During the COVID-19 Pandemic</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대면 체육수업에서도 마스크 착용과 방역 지침에 따른 활동 제한이 확인됨</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">방역수칙으로 인해 체육활동 범위가 제한된 참여 조건 맥락임</isp:definition_text>
    <rdfs:label xml:lang="en">PE participation context limited by preventive measures</rdfs:label>
    <rdfs:comment xml:lang="ko">방역수칙으로 인해 체육활동 범위가 제한된 참여 조건 맥락임</rdfs:comment>
    <skos:prefLabel xml:lang="en">PE participation context limited by preventive measures</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">방역지침 기반 체육활동 제한 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#sport_activity__developmental_disability_aerobic_resistance_exercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#adapted_physical_activity"/>
