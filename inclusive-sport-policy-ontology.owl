  <rdf:Description rdf:about="#outcome__school_pe_particulate_matter_guideline_evidence_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#policy_effectiveness_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__school_pe_particulate_matter_guideline_evidence_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학교체육 미세먼지 지침 근거 지원</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evidence support for particulate matter guidelines in school PE</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동 중 미세먼지 과흡입 생체 실험모델 고안</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동 중 미세먼지 과흡입에 따른 생체 실험모델인 미세먼지 운동 챔버를 구축하고, 학교체육 시행 기준의 과학적 근거 제공 가능성을 제시함.</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동 중 미세먼지 과흡입에 따른 생체 실험모델인 미세먼지 운동 챔버를 구축하고, 학교체육 시행 기준의 과학적 근거 제공 가능성을 제시함.</isp:evidence_excerpt>
