  <rdf:Description rdf:about="#sport_activity__aqua_rehabilitation_exercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#therapeutic_exercise"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__aqua_rehabilitation_exercise</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">수중재활운동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aqua-rehabilitation exercise</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">수중운동과 수중체험활동을 활용하여 장애인의 신체·심리 회복을 지원하는 치료적 운동.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">수중재활운동이 편측사지 중도 뇌병변장애인의 심리적 안정과 정신적 준비기에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">주 1회 60분 수중운동 및 수중체험활동을 8개월간 진행함.</isp:evidence_excerpt>
    <isp:has_activity_outcome rdf:resource="#outcome__brain_lesion_psychological_stability_improvement"/>
    <isp:has_activity_outcome rdf:resource="#outcome__brain_lesion_mental_preparation_improvement"/>
    <rdfs:label xml:lang="en">aqua-rehabilitation exercise</rdfs:label>
    <rdfs:comment xml:lang="ko">수중운동과 수중체험활동을 활용하여 장애인의 신체·심리 회복을 지원하는 치료적 운동.</rdfs:comment>
    <skos:prefLabel xml:lang="en">aqua-rehabilitation exercise</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">수중재활운동</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__breast_cancer_survivor_physical_activity_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#medical_welfare_linked_program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유방암 생존자 신체활동 지원 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical activity support program for breast cancer survivors</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유방암 생존자의 건강 증진과 재발 위험 관리를 지원하는 신체활동 기반 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A systematic review of the biological mechanisms linking physical activity and breast cancer</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">review_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/pan.2020.0018</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">25-26</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leisure-time physical activity and structured exercise before and after breast cancer diagnosis contribute to reducing the risk of breast cancer recurrence and mortality. The review describes physical activity as a non-pharmacological strategy for primary cancer prevention.</isp:evidence_excerpt>
    <isp:targets_target_group rdf:resource="#target_group__breast_cancer_survivors_physical_activity_support"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__structured_physical_activity_breast_cancer_support"/>
    <isp:produces_outcome rdf:resource="#outcome__breast_cancer_recurrence_mortality_risk_reduction"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__breast_cancer_survivor_physical_activity_support</isp:entity_id>
    <rdfs:label xml:lang="en">Physical activity support program for breast cancer survivors</rdfs:label>
    <rdfs:comment xml:lang="ko">유방암 생존자의 건강 증진과 재발 위험 관리를 지원하는 신체활동 기반 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Physical activity support program for breast cancer survivors</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유방암 생존자 신체활동 지원 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__breast_cancer_survivors_physical_activity_support"/>
  </rdf:Description>
