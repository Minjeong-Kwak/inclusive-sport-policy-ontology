  <rdf:Description rdf:about="#sport_activity__dance_sports_exercise_obese_middle_aged_women">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#leisure_sport"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__dance_sports_exercise_obese_middle_aged_women</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만 중년여성 댄스스포츠 운동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dance sports exercise for obese middle-aged women</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만 중년여성에게 적용된 12주 댄스스포츠 운동 활동</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간의 댄스스포츠 운동이 비만 중년여성의 신체구성 및 항산화 효소 활성에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2008</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Exercise Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만 중년여성 20명을 대상으로 실험군과 통제군을 구성하고 12주간 댄스스포츠 프로그램을 적용하였다. 실험군에서 체지방과 체지방률 감소, SOD와 CAT 등 항산화 효소 활성 변화가 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">Dance sports exercise for obese middle-aged women</rdfs:label>
    <rdfs:comment xml:lang="ko">비만 중년여성에게 적용된 12주 댄스스포츠 운동 활동</rdfs:comment>
    <skos:prefLabel xml:lang="en">Dance sports exercise for obese middle-aged women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">비만 중년여성 댄스스포츠 운동</skos:prefLabel>
  </rdf:Description>
