  <rdf:Description rdf:about="#program__hrr_based_shuttle_run_cardiorespiratory_training">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__hrr_based_shuttle_run_cardiorespiratory_training</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여유심박수 기반 왕복오래달리기 심폐지구력 트레이닝</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program  hrr based shuttle run cardiorespiratory training</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여유심박수 방법을 적용한 왕복오래달리기 트레이닝에 따른 여대생의 심폐지구력 변화</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여대생 150명을 대상으로 12주간 여유심박수 기반 왕복오래달리기 트레이닝을 적용하여 중강도·고강도 집단의 심폐지구력 향상을 보고함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:targets_target_group rdf:resource="#target_group__female_college_students_hrr_shuttle_run"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__activity_tracker_target_heart_rate_monitoring"/>
    <isp:produces_outcome rdf:resource="#outcome__female_college_cardiorespiratory_endurance_improvement"/>
    <rdfs:label xml:lang="en">program  hrr based shuttle run cardiorespiratory training</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing program  hrr based shuttle run cardiorespiratory training in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">program  hrr based shuttle run cardiorespiratory training</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">여유심박수 기반 왕복오래달리기 심폐지구력 트레이닝</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__female_college_students_hrr_shuttle_run"/>
  </rdf:Description>
