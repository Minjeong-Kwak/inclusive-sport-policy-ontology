  <rdf:Description rdf:about="#policy__korean_adult_physical_activity_guideline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#guideline_standard"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy__korean_adult_physical_activity_guideline</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국 성인 신체활동 지침</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Korean adult physical activity guideline</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">성인에게 주당 중강도 150분 또는 고강도 75분 이상의 신체활동을 권고하는 지침형 정책 수단</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Association between Meeting Physical Activity Guidelines and Mortality in Korean Adults: An 8-year Prospective Study</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition and Biochemistry</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/jenb.2016.0054</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">23-24</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This prospective study used the Korean Longitudinal Study of Ageing with 9,177 adults aged 45 years or older over an 8-year follow-up. Meeting physical activity guidelines was associated with decreased all-cause mortality risk in Korean adults.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">Korean adult physical activity guideline</rdfs:label>
    <rdfs:comment xml:lang="ko">성인에게 주당 중강도 150분 또는 고강도 75분 이상의 신체활동을 권고하는 지침형 정책 수단</rdfs:comment>
    <skos:prefLabel xml:lang="en">Korean adult physical activity guideline</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">한국 성인 신체활동 지침</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__intellectual_disability_sport_balanced_support_system">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#disabled_person_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__intellectual_disability_sport_balanced_support_system</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지적장애인 스포츠 균형지원 시스템</isp:pref_label_ko>
