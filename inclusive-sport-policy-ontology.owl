    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data-supported school physical education activity</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학교 체육에서 데이터의 역할과 중요성</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
