    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Public senior sport instruction setting</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국민건강보험공단 및 생활체육 조직 등을 통해 노인 운동 프로그램이 운영되는 공공 지도 환경</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인스포츠지도자의 고용형태에 따른 직업정체성과 전문성 인식 및 조직정체성 비교 검증</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-15</isp:last_updated>
    <rdfs:label xml:lang="en">Public senior sport instruction setting</rdfs:label>
    <rdfs:comment xml:lang="ko">국민건강보험공단 및 생활체육 조직 등을 통해 노인 운동 프로그램이 운영되는 공공 지도 환경</rdfs:comment>
    <skos:prefLabel xml:lang="en">Public senior sport instruction setting</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">공공 노인생활체육 지도 환경</skos:prefLabel>
  </rdf:Description>
