    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <rdfs:label xml:lang="en">Expansion of public participation in horseback riding</rdfs:label>
    <rdfs:comment xml:lang="ko">승마가 대중스포츠로 확산되고 생활체육 참여가 증가하는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Expansion of public participation in horseback riding</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">승마 대중스포츠 참여 확대</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__unintentional_doping_risk_management">
