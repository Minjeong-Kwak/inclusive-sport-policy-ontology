  <rdf:Description rdf:about="#outcome__disabled_children_confidence_challenge_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#self_efficacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__disabled_children_confidence_challenge_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애아동 자신감·도전성 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Confidence and challenge improvement among disabled children</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">재활승마 프로그램 참여가 장애아동의 내적동기에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">질적 분석에서 지각된 유능감과 관련해 자신감 향상과 도전하는 모습이 확인되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:reflects_target_group rdf:resource="#target_group__disabled_children_hippotherapy"/>
    <rdfs:label xml:lang="en">Confidence and challenge improvement among disabled children</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Confidence and challenge improvement among disabled children in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Confidence and challenge improvement among disabled children</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">장애아동 자신감·도전성 향상</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__disabled_children_hippotherapy"/>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__handgrip_strength_nafld_screening">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program_information"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__handgrip_strength_nafld_screening</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">악력 기반 비알코올성 지방간 위험 선별 정보</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hand-grip strength based NAFLD risk screening information</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인의 악력 수준을 비알코올성 지방간 위험 선별과 연결하는 정보 자원</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Association of hand-grip strength and non-alcoholic fatty liver disease index in older adults</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition and Biochemistry</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/jenb.2018.0031</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">62-63</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This cross-sectional study of 538 older adults found linear decreases in NAFLD indices across incremental hand-grip strength levels and suggested lifestyle intervention with normal weight and physical fitness as prevention against NAFLD.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">Hand-grip strength based NAFLD risk screening information</rdfs:label>
    <rdfs:comment xml:lang="ko">노인의 악력 수준을 비알코올성 지방간 위험 선별과 연결하는 정보 자원</rdfs:comment>
    <skos:prefLabel xml:lang="en">Hand-grip strength based NAFLD risk screening information</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">악력 기반 비알코올성 지방간 위험 선별 정보</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__judo_supplement_safety_and_doping_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__judo_supplement_safety_and_doping_education</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유도선수 보충제 안전·도핑교육</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program  judo supplement safety and doping education</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 유도 선수의 성별과 연령에 따른 운동영양 보조물 섭취와 섭취경로 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2009</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2003~2008년 엘리트 유도선수 223명을 대상으로 운동영양 보조물 섭취와 구입경로를 조사했고, 연령과 성별에 따라 섭취 경향과 정보원 차이가 나타났으며 도핑교육 필요를 권고함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:targets_target_group rdf:resource="#target_group__elite_judoists_supplement_safety_management"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__supplement_purchase_pathway_guidance"/>
    <isp:produces_outcome rdf:resource="#outcome__supplement_doping_awareness_improvement_judo"/>
    <rdfs:label xml:lang="en">program  judo supplement safety and doping education</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing program  judo supplement safety and doping education in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">program  judo supplement safety and doping education</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유도선수 보충제 안전·도핑교육</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__elite_judoists_supplement_safety_management"/>
  </rdf:Description>
  <rdf:Description rdf:about="#policy__unesco_fit_for_life_sport_policy_agenda">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#sport_policy"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy__unesco_fit_for_life_sport_policy_agenda</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유네스코 Fit for Life 스포츠 정책 의제</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UNESCO Fit for Life sport policy agenda</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">올림픽과 Fit for Life: 유네스코 국제 체육교육과 스포츠 이해 관계자(CIGEPS) 회의 참가 후기</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠와 신체활동의 사회·경제적 효과를 분석하고 공공·민간 투자를 유도하는 국제 정책 의제임</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠와 신체활동의 사회·경제적 효과를 분석하고 공공·민간 투자를 유도하는 국제 정책 의제임</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
