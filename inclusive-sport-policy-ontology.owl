  <rdf:Description rdf:about="#outcome__athlete_safe_competition_with_allergy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__athlete_safe_competition_with_allergy</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">알레르기 선수 안전 경기참가 보장</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Safe competition participation for athletes with allergy</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동과 관련된 알레르기질환</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2014</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동으로 유발되거나 악화되는 천식, 아나필락시스, 두드러기 등 알레르기 질환은 선수의 안전한 훈련과 경기 참가에 영향을 주며, 스포츠의학적 진단·관리와 약물 사용의 도핑 관련 평가가 필요함.</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동으로 유발되거나 악화되는 천식, 아나필락시스, 두드러기 등 알레르기 질환은 선수의 안전한 훈련과 경기 참가에 영향을 주며, 스포츠의학적 진단·관리와 약물 사용의 도핑 관련 평가가 필요함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Sports Medicine</isp:source_publisher>
    <rdfs:label xml:lang="en">Safe competition participation for athletes with allergy</rdfs:label>
    <rdfs:comment xml:lang="ko">운동으로 유발되거나 악화되는 천식, 아나필락시스, 두드러기 등 알레르기 질환은 선수의 안전한 훈련과 경기 참가에 영향을 주며, 스포츠의학적 진단·관리와 약물 사용의 도핑 관련 평가가 필요함.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Safe competition participation for athletes with allergy</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">알레르기 선수 안전 경기참가 보장</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__dance_perception_change_college_students">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__dance_perception_change_college_students</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대학생 무용 인식 변화</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Change in dance perception among college students</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">재즈댄스를 경험한 교양수업 대학생의 인식 변화 탐색</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">재즈댄스 경험을 통해 춤에 대한 거리감이 줄고 흥미와 인식 변화가 나타났다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Added in v58 from uploaded academic literature; class assignment limited to directly evidenced entities.</isp:note>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <rdfs:label xml:lang="en">Change in dance perception among college students</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Change in dance perception among college students in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Change in dance perception among college students</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">대학생 무용 인식 변화</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__aerobic_blood_pressure_improvement_program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#medical_welfare_linked_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__aerobic_blood_pressure_improvement_program</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유산소 혈압개선 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aerobic blood pressure improvement program</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유산소운동에 따른 혈관 내피세포의 SIRT1 발현이 혈압개선에 미치는 효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1일 1시간, 주 2~3회, 10주간 유산소운동을 실시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:targets_target_group rdf:resource="#target_group__female_prehypertensives"/>
    <isp:produces_outcome rdf:resource="#outcome__diastolic_blood_pressure_reduction"/>
    <isp:produces_outcome rdf:resource="#outcome__vascular_endothelial_function_support"/>
    <rdfs:label xml:lang="en">aerobic blood pressure improvement program</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing aerobic blood pressure improvement program in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">aerobic blood pressure improvement program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유산소 혈압개선 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__female_prehypertensives"/>
  </rdf:Description>
  <rdf:Description rdf:about="#program__developmental_disability_fitness_cv_exercise_program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#disabled_person_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__developmental_disability_fitness_cv_exercise_program</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">발달장애인 체력·심혈관 건강 운동프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exercise program for fitness and cardiovascular health in developmental disabilities</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동과 발달장애인의 체력 및 심혈관 건강에 관한 문헌 고찰 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">발달장애인의 운동 참여율과 체력·심혈관 건강 수준이 낮고, 유산소 및 저항운동이 체력과 심혈관 건강에 긍정적 영향을 미치는 것으로 정리함.</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">발달장애인의 운동 참여율과 체력·심혈관 건강 수준이 낮고, 유산소 및 저항운동이 체력과 심혈관 건강에 긍정적 영향을 미치는 것으로 정리함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:targets_target_group rdf:resource="#target_group__developmental_disabilities_fitness_cv_health"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__developmental_disability_aerobic_resistance_exercise"/>
    <isp:produces_outcome rdf:resource="#outcome__developmental_disability_physical_fitness_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__developmental_disability_cardiovascular_health_improvement"/>
    <rdfs:label xml:lang="en">Exercise program for fitness and cardiovascular health in developmental disabilities</rdfs:label>
    <rdfs:comment xml:lang="ko">발달장애인의 운동 참여율과 체력·심혈관 건강 수준이 낮고, 유산소 및 저항운동이 체력과 심혈관 건강에 긍정적 영향을 미치는 것으로 정리함.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Exercise program for fitness and cardiovascular health in developmental disabilities</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">발달장애인 체력·심혈관 건강 운동프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__developmental_disabilities_fitness_cv_health"/>
  </rdf:Description>
