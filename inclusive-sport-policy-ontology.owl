    <skos:prefLabel xml:lang="ko">CAS 스포츠 분쟁해결 절차</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__community_obesity_exercise_clinic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#community_based_program"/>
