  <rdf:Description rdf:about="#program__anti_doping_autonomy_support_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__anti_doping_autonomy_support_education</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">자율성 기반 도핑방지 교육 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Autonomy-informed anti-doping education program</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동선수들의 자율성과 도핑 의도의 관계에서 도핑방지 교육 경험의 조절효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동선수의 자율성과 도핑의도 관계에서 도핑방지 교육 경험이 조절효과를 보이며, 의무교육을 넘어 별도의 반도핑 프로그램 개발 필요를 제시함.</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동선수의 자율성과 도핑의도 관계에서 도핑방지 교육 경험이 조절효과를 보이며, 의무교육을 넘어 별도의 반도핑 프로그램 개발 필요를 제시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Korean Journal of Convergence Science</isp:source_publisher>
    <isp:targets_target_group rdf:resource="#target_group__athletes_autonomy_doping_education"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__separate_anti_doping_program"/>
    <isp:produces_outcome rdf:resource="#outcome__doping_intention_reduction_autonomy_education"/>
    <rdfs:label xml:lang="en">Autonomy-informed anti-doping education program</rdfs:label>
    <rdfs:comment xml:lang="ko">운동선수의 자율성과 도핑의도 관계에서 도핑방지 교육 경험이 조절효과를 보이며, 의무교육을 넘어 별도의 반도핑 프로그램 개발 필요를 제시함.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Autonomy-informed anti-doping education program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">자율성 기반 도핑방지 교육 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__athletes_autonomy_doping_education"/>
  </rdf:Description>
