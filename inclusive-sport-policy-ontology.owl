    <skos:prefLabel xml:lang="en">Sport Career Interest Scale version 2</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">일반학생용 체육진로흥미검사지 v2</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__child_gut_microbiota_composition_profile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__child_gut_microbiota_composition_profile</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">아동 장내미생물 조성 프로파일</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Child gut microbiota composition profile</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체활동 권고 준수와 관련되어 관찰된 아동 장내미생물 조성의 건강 관련 프로파일</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Associations of physical activity with gut microbiota in pre-adolescent children</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/pan.2021.0023</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24-25</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This study analyzed 321 children with physical activity and 16S rRNA sequencing data. Children meeting physical activity recommendations had altered gut microbiota compositions.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:outcome_indicator_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gut microbiota composition</isp:outcome_indicator_type>
    <rdfs:label xml:lang="en">Child gut microbiota composition profile</rdfs:label>
    <rdfs:comment xml:lang="ko">신체활동 권고 준수와 관련되어 관찰된 아동 장내미생물 조성의 건강 관련 프로파일</rdfs:comment>
    <skos:prefLabel xml:lang="en">Child gut microbiota composition profile</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">아동 장내미생물 조성 프로파일</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__aesthetic_sport_judging_fairness_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#system_level_outcome"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">심미스포츠 판정 공정성 향상</isp:pref_label_ko>
