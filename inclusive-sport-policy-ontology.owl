    <isp:is_delivered_in_context rdf:resource="#participation_context__immigrant_social_integration_weekday_learning"/>
    <isp:is_delivered_in_context rdf:resource="#spatial_context__foreign_resident_concentrated_area"/>
    <isp:is_delivered_in_context rdf:resource="#spatial_context__rural_farm_fishery_labor_demand_area"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__multilingual_information_for_long_stay_immigrants"/>
    <rdfs:label xml:lang="en">Early adaptation program for immigrants</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Early adaptation program for immigrants in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Early adaptation program for immigrants</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">이민자 조기적응 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__long_term_residence_aspiring_immigrants"/>
