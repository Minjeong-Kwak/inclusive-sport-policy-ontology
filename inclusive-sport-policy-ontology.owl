    <skos:prefLabel xml:lang="en">Improved athletic director leadership competency</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">애슬레틱 디렉터 리더십 역량 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__sport_instructor_turnover_intention_risk_identification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#system_level_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__sport_instructor_turnover_intention_risk_identification</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠강사 이직의도 위험 식별</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identification of turnover intention risk among sport instructors</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠강사의 높은 이직의도를 파악하여 인력관리 개선 필요를 드러내는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중학교 체육교사와 스포츠강사의 조직동일시, 직무몰입, 그리고 이직의도의 관계</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2013</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">이직의도는 스포츠강사가 체육교사보다 높은 평균값을 나타냈다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">identification of turnover intention risk among sport instructors</rdfs:label>
    <rdfs:comment xml:lang="ko">스포츠강사의 높은 이직의도를 파악하여 인력관리 개선 필요를 드러내는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">identification of turnover intention risk among sport instructors</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠강사 이직의도 위험 식별</skos:prefLabel>
  </rdf:Description>
