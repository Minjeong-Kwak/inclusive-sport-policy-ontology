  <rdf:Description rdf:about="#program__system_level_anti_doping_communication_reform">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#policy_design_program"/>
    <rdf:type rdf:resource="#program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체계수준 반도핑 커뮤니케이션 개선 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">System-level anti-doping communication reform program</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">니클라스 루만(Niklas Luhmann)의 체계이론적 관점에서 본 반-도핑 커뮤니케이션의 한계와 과제</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2016</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">기존 반도핑 커뮤니케이션이 개인화 전략에 치우쳐 구조적 문제를 은폐할 수 있음을 지적하고, 스포츠조직과 사회체계 수준의 전략을 제안함.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__system_level_anti_doping_communication_reform</isp:entity_id>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:targets_target_group rdf:resource="#target_group__elite_athletes_anti_doping_communication"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__system_theory_anti_doping_diagnosis"/>
    <isp:produces_outcome rdf:resource="#outcome__structural_doping_problem_recognition"/>
    <rdfs:label xml:lang="en">System-level anti-doping communication reform program</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing System-level anti-doping communication reform program in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">System-level anti-doping communication reform program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">체계수준 반도핑 커뮤니케이션 개선 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__elite_athletes_anti_doping_communication"/>
  </rdf:Description>
