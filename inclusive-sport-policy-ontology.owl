  <rdf:Description rdf:about="#program__para_athlete_doping_awareness_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#anti_doping_program"/>
    <rdf:type rdf:resource="#program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인 국가대표 선수 도핑인식 교육</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Doping awareness education for para national athletes</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">인천 장애인 아시안게임에 참가한 대한민국 국가대표선수들의 도핑의식에 대한 태도 및 성향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인 국가대표 선수와 지도자를 위한 도핑교육과 정보 제공 필요를 제시함.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__para_athlete_doping_awareness_education</isp:entity_id>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:targets_target_group rdf:resource="#target_group__asian_para_games_korean_disabled_athletes"/>
    <isp:applies_to_sport_activity rdf:resource="#sport_activity__asian_para_games_disability_sport"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__performance_enhancement_attitude_scale_para"/>
    <isp:produces_outcome rdf:resource="#outcome__para_athlete_doping_awareness_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__doping_tendency_risk_identification"/>
    <rdfs:label xml:lang="en">Doping awareness education for para national athletes</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Doping awareness education for para national athletes in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Doping awareness education for para national athletes</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">장애인 국가대표 선수 도핑인식 교육</skos:prefLabel>
