    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">improved fairness of Paralympic classification</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인 선수의 장애 유형과 수행능력을 고려한 경기 등급분류의 공정성 향상 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">파랄림픽과 스포츠 과학</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2000</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">등급분류와 경기력 관련 스포츠과학 연구의 필요성을 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">improved fairness of Paralympic classification</rdfs:label>
    <rdfs:comment xml:lang="ko">장애인 선수의 장애 유형과 수행능력을 고려한 경기 등급분류의 공정성 향상 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">improved fairness of Paralympic classification</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">파랄림픽 등급분류 공정성 향상</skos:prefLabel>
  </rdf:Description>
