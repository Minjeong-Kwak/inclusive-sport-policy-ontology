    <rdfs:comment xml:lang="en">Named individual representing school dance learners using creative choreography in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">school dance learners using creative choreography</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">창작안무 학습 학교무용 학생</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__disabled_exercise_self_care">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__disabled_exercise_self_care</isp:entity_id>
