    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elderly life sport motivation support program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인의 생활체육 참여동기와 여가만족을 높이고 심리적 불안을 완화하기 위한 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인의 생활체육 참여동기가 여가만족 및 죽음불안에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-15</isp:last_updated>
    <isp:targets_target_group rdf:resource="#target_group__elderly_life_sport_club_participants"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__elderly_life_sport_participation"/>
