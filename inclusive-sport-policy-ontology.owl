    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tai Chi gait training program for sarcopenic elderly women</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tai Chi Enhances Gait Performance Independently of Muscle Strength in Female Elderly with Severe Sarcopenia</isp:source_title>
