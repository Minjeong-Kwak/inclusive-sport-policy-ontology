  <rdf:Description rdf:about="#outcome__knee_osteoarthritis_knee_stability_improvement_aquatic_exercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#functional_ability_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__knee_osteoarthritis_knee_stability_improvement_aquatic_exercise</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">퇴행성관절염 무릎 안정성 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Knee stability improvement in knee osteoarthritis</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주 수중운동 프로그램 후 무릎관절강성과 다리스프링강성 증가가 보고된 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간의 수중운동프로그램이 퇴행성 관절염 환자의 보행에 미치는 영향: 사례연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">무릎 퇴행성관절염을 가진 66세 여성 노인 1명이 12주간 주 3회, 회당 60분 수중운동 프로그램에 참여하였다. 프로그램 후 보행 능력과 무릎 안정성에 긍정적 변화가 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">Knee stability improvement in knee osteoarthritis</rdfs:label>
    <rdfs:comment xml:lang="ko">12주 수중운동 프로그램 후 무릎관절강성과 다리스프링강성 증가가 보고된 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Knee stability improvement in knee osteoarthritis</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">퇴행성관절염 무릎 안정성 향상</skos:prefLabel>
  </rdf:Description>
