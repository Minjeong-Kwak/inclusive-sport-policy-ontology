    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#facility_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__disability_esports_facility_competition_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인 e스포츠 시설·대회 지원</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Facility and competition support for disability esports</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인 e스포츠 활성화를 위한 IPA(Importance-Performance Analysis) 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">시설과 대회는 중요도와 성과가 모두 높은 영역으로 유지와 지속적 실현이 필요하다고 제시되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Added in v58 from uploaded academic literature; class assignment limited to directly evidenced entities.</isp:note>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <rdfs:label xml:lang="en">Facility and competition support for disability esports</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Facility and competition support for disability esports in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Facility and competition support for disability esports</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">장애인 e스포츠 시설·대회 지원</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__community_based_obesity_management_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#public_institution"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지역사회 기반 비만관리 참여 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Community-based obesity management context</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">보건소, 지역사회 기관, 운동 클리닉 등을 통해 비만관리 서비스에 접근하는 제도적 참여 맥락</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analysis of public perception of national obesity management policy</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">27-35</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A national online survey of citizens aged 15-69 identified lifestyle improvement for obesity prevention, child and adolescent obesity prevention and management, community-based obesity and exercise clinics, and an integrated information platform for nutrition, diet, and physical activity as important national obesity policy tasks.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__community_based_obesity_management_context</isp:entity_id>
    <rdfs:label xml:lang="en">Community-based obesity management context</rdfs:label>
    <rdfs:comment xml:lang="ko">보건소, 지역사회 기관, 운동 클리닉 등을 통해 비만관리 서비스에 접근하는 제도적 참여 맥락</rdfs:comment>
    <skos:prefLabel xml:lang="en">Community-based obesity management context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">지역사회 기반 비만관리 참여 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__soccer_career_transition_pressure_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__soccer_career_transition_pressure_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중·고 축구선수 진로전환 압박 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">career transition pressure context for youth soccer players</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">진학, 프로 진출, 경기수행 기대가 결합되어 진로불안이 발생하는 유소년 축구 참여 맥락.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중ㆍ고 축구선수의 진로불안이 권력거리신념과 경기수행능력에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">축구선수 진로가 대학과 프로 진출이라는 한정된 선택에 놓여 진로불안이 발생한다고 설명하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">career transition pressure context for youth soccer players</rdfs:label>
    <rdfs:comment xml:lang="ko">진학, 프로 진출, 경기수행 기대가 결합되어 진로불안이 발생하는 유소년 축구 참여 맥락.</rdfs:comment>
    <skos:prefLabel xml:lang="en">career transition pressure context for youth soccer players</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">중·고 축구선수 진로전환 압박 맥락</skos:prefLabel>
  </rdf:Description>
