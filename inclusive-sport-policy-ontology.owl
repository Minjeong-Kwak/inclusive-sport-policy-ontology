  <rdf:Description rdf:about="#facility_resource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#support_resource"/>
    <rdfs:label xml:lang="en">Facility Resource</rdfs:label>
