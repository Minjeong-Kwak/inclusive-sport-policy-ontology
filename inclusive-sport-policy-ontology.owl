    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">예비 체육교사의 진로장벽 하위요인을 파악하기 위한 평가 자원임</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">예비 체육교사의 진로장벽 하위요인을 파악하기 위한 평가 자원임</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <rdfs:label xml:lang="en">Career barrier assessment resource for PE teacher candidates</rdfs:label>
    <rdfs:comment xml:lang="ko">예비 체육교사의 진로장벽 하위요인을 파악하기 위한 평가 자원임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Career barrier assessment resource for PE teacher candidates</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">예비 체육교사 진로장벽 평가 자원</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__doping_test_psychological_preparation_program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__doping_test_psychological_preparation_program</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑검사 심리적 준비 지원 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program  doping test psychological preparation program</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 선수의 도핑검사에 대한 심리적 경험</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K대학 엘리트 선수 150명의 개방형 설문과 의미연결망 분석에서 도핑검사는 걱정, 불안, 수치심 등 부정적 심리 경험이면서도 선수 윤리와 실력 증명의 도구로 인식됨.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:targets_target_group rdf:resource="#target_group__elite_athletes_doping_test_psychological_support"/>
    <isp:produces_outcome rdf:resource="#outcome__doping_test_anxiety_and_shame_reduction"/>
    <isp:produces_outcome rdf:resource="#outcome__doping_test_as_fair_performance_proof"/>
    <rdfs:label xml:lang="en">program  doping test psychological preparation program</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing program  doping test psychological preparation program in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">program  doping test psychological preparation program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">도핑검사 심리적 준비 지원 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__elite_athletes_doping_test_psychological_support"/>
  </rdf:Description>
  <rdf:Description rdf:about="#program__body_satisfaction_self_esteem_wellbeing_program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대학생 신체만족·자아존중감 웰빙 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">College body satisfaction and self-esteem well-being program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">교양체육과 신체활동을 통해 대학생의 신체만족도와 자아존중감, 심리적 행복감을 높이는 건강증진 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대학생의 신체만족도와 심리적 행복감 관계에서 자아존중감 매개효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체만족도와 심리적 행복감 관계에서 긍정적·부정적 자아존중감이 부분 매개하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:targets_target_group rdf:resource="#target_group__college_liberal_pe_students_body_satisfaction"/>
    <isp:produces_outcome rdf:resource="#outcome__body_satisfaction_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__self_esteem_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__well_being_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__body_satisfaction_self_esteem_wellbeing_program</isp:entity_id>
    <rdfs:label xml:lang="en">College body satisfaction and self-esteem well-being program</rdfs:label>
    <rdfs:comment xml:lang="ko">교양체육과 신체활동을 통해 대학생의 신체만족도와 자아존중감, 심리적 행복감을 높이는 건강증진 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">College body satisfaction and self-esteem well-being program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">대학생 신체만족·자아존중감 웰빙 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__college_liberal_pe_students_body_satisfaction"/>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__twelve_week_aerobic_exercise_obese_children">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#regular_participation"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__twelve_week_aerobic_exercise_obese_children</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만아동 12주 유산소 운동 정기참여 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twelve-week regular aerobic exercise context for obese children</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만아동이 12주간 주 4회 유산소 운동에 정기적으로 참여한 맥락</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간의 유산소 운동에 의한 비만아동의 신체구성 및 혈액성분 변화</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1997</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Exercise Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만 초등학생 20명을 대상으로 12주간 주 4회, 하루 30분, VO2max 60% 강도의 유산소 운동을 실시하였다. 신체구성과 혈액성분의 긍정적 변화가 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">Twelve-week regular aerobic exercise context for obese children</rdfs:label>
    <rdfs:comment xml:lang="ko">비만아동이 12주간 주 4회 유산소 운동에 정기적으로 참여한 맥락</rdfs:comment>
    <skos:prefLabel xml:lang="en">Twelve-week regular aerobic exercise context for obese children</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">비만아동 12주 유산소 운동 정기참여 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__standing_work_pain_balance_worsening">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__standing_work_pain_balance_worsening</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">입식근로 통증 및 신체균형 악화</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pain and balance worsening from prolonged standing work</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장시간의 입식 근로가 하지부종, 신체균형 및 통증지수 변화에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">근무 2주 후 두 집단 모두 신체균형과 통증지수가 유의하게 증가하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Added in v58 from uploaded academic literature; class assignment limited to directly evidenced entities.</isp:note>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <rdfs:label xml:lang="en">Pain and balance worsening from prolonged standing work</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Pain and balance worsening from prolonged standing work in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Pain and balance worsening from prolonged standing work</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">입식근로 통증 및 신체균형 악화</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__menopausal_women_aerobic_strength_exercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_promotion_program"/>
    <rdf:type rdf:resource="#program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__menopausal_women_aerobic_strength_exercise</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">폐경기 여성 유산소·근력운동 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aerobic and strength exercise program for menopausal women</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">폐경기 여성의 근력 유지와 복부비만 및 대사건강 위험 완화를 위한 유산소·근력운동 프로그램.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">폐경기 여성의 악력과 신체활동에 따른 대사적 건강위험 및 식생활평가지수와의 관련성 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유산소 및 근력운동을 실천한 경우 복부비만 및 대사적 건강지표 위험률이 낮았다고 보고하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:targets_target_group rdf:resource="#target_group__menopausal_women_metabolic_health"/>
    <isp:produces_outcome rdf:resource="#outcome__menopausal_women_metabolic_risk_reduction"/>
    <rdfs:label xml:lang="en">aerobic and strength exercise program for menopausal women</rdfs:label>
    <rdfs:comment xml:lang="ko">폐경기 여성의 근력 유지와 복부비만 및 대사건강 위험 완화를 위한 유산소·근력운동 프로그램.</rdfs:comment>
    <skos:prefLabel xml:lang="en">aerobic and strength exercise program for menopausal women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">폐경기 여성 유산소·근력운동 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__menopausal_women_metabolic_health"/>
  </rdf:Description>
  <rdf:Description rdf:about="#program__a_three_sport_for_all_service_matching">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#online_remote_program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A-three 생활체육 서비스 매칭 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A-three Sport for All service matching program</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open services innovation through an app to assist “Sport for All”</isp:source_title>
