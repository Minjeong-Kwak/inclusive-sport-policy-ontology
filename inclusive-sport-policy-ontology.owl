    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">improved PE class goals methods and environment</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">반성적 티칭을 통해 체육수업의 목표, 방법, 환경이 개선되는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중학교 체육 교사의 수업 일기를 통해서 바라 본 반성적 티칭 탐색</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2012</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육수업에서 수업목표, 수업방법, 수업환경의 변화가 나타났다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">improved PE class goals methods and environment</rdfs:label>
    <rdfs:comment xml:lang="ko">반성적 티칭을 통해 체육수업의 목표, 방법, 환경이 개선되는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">improved PE class goals methods and environment</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">체육수업 목표·방법·환경 개선</skos:prefLabel>
  </rdf:Description>
