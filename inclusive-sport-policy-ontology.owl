    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">통합체육은 장애학생과 비장애학생 모두를 위한 신체활동 교육으로 설명됨</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__inclusive_pe_non_disabled_peers</isp:entity_id>
    <rdfs:label xml:lang="en">non-disabled peers in inclusive PE</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing non-disabled peers in inclusive PE in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">non-disabled peers in inclusive PE</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">통합체육 비장애 또래학생</skos:prefLabel>
  </rdf:Description>
