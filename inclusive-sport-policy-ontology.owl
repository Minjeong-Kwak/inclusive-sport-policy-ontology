  <rdf:Description rdf:about="#program__athlete_vaccination_prevention_program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#medical_welfare_linked_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__athlete_vaccination_prevention_program</isp:entity_id>
