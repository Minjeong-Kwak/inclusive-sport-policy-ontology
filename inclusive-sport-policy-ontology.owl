    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">뇌성마비 아동을 위한 가상현실 기반 운동중재의 보행효과에 대한 체계적 문헌고찰 및 효과크기 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2008~2023년 연구 7편을 분석하여 뇌성마비 아동 대상 VR 기반 운동중재의 보행 효과를 검토하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-15</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <isp:targets_target_group rdf:resource="#target_group__cerebral_palsy_children"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__vr_balance_posture_exercise_cp"/>
