  <rdf:Description rdf:about="#outcome__migrant_worker_belonging_enhancement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#community_belonging_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__migrant_worker_belonging_enhancement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">외국인노동자 소속감 강화</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">migrant worker belonging enhancement</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">축구클럽 참여를 통해 가족 같은 관계와 소속감이 강화되는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 활동이 외국인노동자 삶의 변화에 미치는 영향 연구: 베트남 출신 노동자 축구클럽을 사례로</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">베트남 출신 노동자 축구클럽 참여를 통해 즐거움과 스트레스 해소, 소속감 강화, 대인관계 확대, 동료의식 강화 등 삶의 변화가 나타났다고 분석하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">migrant worker belonging enhancement</rdfs:label>
    <rdfs:comment xml:lang="ko">축구클럽 참여를 통해 가족 같은 관계와 소속감이 강화되는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">migrant worker belonging enhancement</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">외국인노동자 소속감 강화</skos:prefLabel>
  </rdf:Description>
