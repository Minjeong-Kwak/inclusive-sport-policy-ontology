    <rdfs:comment xml:lang="en">Named individual representing University students in physical activity enjoyment and satisfaction program in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">University students in physical activity enjoyment and satisfaction program</skos:prefLabel>
