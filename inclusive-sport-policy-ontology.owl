    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">폐경기 여성 삶의 질 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quality of life improvement among menopausal women</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저소득층 폐경기 여성의 비만에 따른 대사적 건강상태와 신체활동 및 좌식행동과의 관련성</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">걷기 운동을 주 5일 이상 실천한 비만 여성은 삶의 질이 높게 나타났다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:reflects_target_group rdf:resource="#target_group__low_income_menopause_women"/>
    <rdfs:label xml:lang="en">Quality of life improvement among menopausal women</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Quality of life improvement among menopausal women in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Quality of life improvement among menopausal women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">폐경기 여성 삶의 질 향상</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__low_income_menopause_women"/>
  </rdf:Description>
