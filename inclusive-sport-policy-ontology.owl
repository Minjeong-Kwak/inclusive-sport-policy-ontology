    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">승마지도자의 PCK 요소와 형성 과정을 심층 면담, 참여관찰, 텍스트 분석으로 탐색함</isp:evidence_excerpt>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:targets_target_group rdf:resource="#target_group__equestrian_instructors_pck"/>
