  <rdf:Description rdf:about="#program__youth_soccer_career_anxiety_counseling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#youth_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__youth_soccer_career_anxiety_counseling</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유소년 축구선수 진로불안 상담 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">career anxiety counseling program for youth soccer players</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중·고 축구선수의 진로불안을 이해하고 공정한 지도 권력 관계를 성찰하도록 지원하는 상담 프로그램.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중ㆍ고 축구선수의 진로불안이 권력거리신념과 경기수행능력에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지도자가 선수의 진로불안을 이해하고 공정하고 성숙한 권력과 지휘 체계를 성찰할 필요가 있다고 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:targets_target_group rdf:resource="#target_group__middle_high_school_soccer_players_career_anxiety"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__soccer_career_transition_pressure_context"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__career_anxiety_power_distance_assessment_resource"/>
    <isp:produces_outcome rdf:resource="#outcome__soccer_career_anxiety_support_need_identification"/>
    <rdfs:label xml:lang="en">career anxiety counseling program for youth soccer players</rdfs:label>
    <rdfs:comment xml:lang="ko">중·고 축구선수의 진로불안을 이해하고 공정한 지도 권력 관계를 성찰하도록 지원하는 상담 프로그램.</rdfs:comment>
    <skos:prefLabel xml:lang="en">career anxiety counseling program for youth soccer players</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유소년 축구선수 진로불안 상담 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__middle_high_school_soccer_players_career_anxiety"/>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__ski_instruction_professionalism_improvement">
