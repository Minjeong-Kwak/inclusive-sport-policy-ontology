  <rdf:Description rdf:about="#support_resource__prader_willi_metabolic_monitoring_assessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program_information"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__prader_willi_metabolic_monitoring_assessment</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프래더윌리증후군 대사 지표 모니터링 자료</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Metabolic monitoring assessment for Prader-Willi syndrome exercise</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Changes in body composition, blood lipid profile, and growth factor hormone in a patient with Prader–willi syndrome during 24 weeks of complex exercise: a single case study</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition &amp; Biochemistry</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동 전과 8, 16, 20, 24주에 혈액 및 신체구성 변화를 측정함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체구성, 혈당, 혈중지질, 성장인자 호르몬 측정이 프로그램 평가 자원으로 제시됨</isp:definition_text>
    <rdfs:label xml:lang="en">Metabolic monitoring assessment for Prader-Willi syndrome exercise</rdfs:label>
    <rdfs:comment xml:lang="ko">신체구성, 혈당, 혈중지질, 성장인자 호르몬 측정이 프로그램 평가 자원으로 제시됨</rdfs:comment>
    <skos:prefLabel xml:lang="en">Metabolic monitoring assessment for Prader-Willi syndrome exercise</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">프래더윌리증후군 대사 지표 모니터링 자료</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__high_school_judo_antidoping_nutrition_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__high_school_judo_antidoping_nutrition_education</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고등학교 유도선수 반도핑·운동영양 교육</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anti-doping and sports nutrition education for high school judo athletes</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고등학교 유도선수들의 체급별 운동영양 보조물 섭취형태와 도핑의식에 관한 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2007</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고등학교 유도선수의 영양보조물 섭취와 도핑교육 실태를 분석하고 도핑교육의 필요성을 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:targets_target_group rdf:resource="#target_group__high_school_judo_athletes"/>
