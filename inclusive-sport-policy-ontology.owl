  <rdf:Description rdf:about="#program__health_maintenance_physical_activity_participation_system">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#community_based_program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">건강유지 신체활동 참여체계</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical activity participation system for health maintenance</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체활동량이 삶의 질과 주관적 건강에 미치는 영향</isp:source_title>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">empirical_study</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국민 개개인이 원하는 대로 건강유지를 위한 스포츠 활동에 참여할 수 있는 체계 마련을 언급함</isp:evidence_excerpt>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">v45 추가 인스턴스</isp:note>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2016</isp:source_year>
    <isp:source_identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">v45_batch</isp:source_identifier>
    <isp:utilizes_support_resource rdf:resource="#support_resource__national_fitness_certification_activity_guidance"/>
    <isp:produces_outcome rdf:resource="#outcome__leisure_physical_activity_quality_of_life_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__subjective_health_improvement_physical_activity"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__health_maintenance_physical_activity_participation_system</isp:entity_id>
