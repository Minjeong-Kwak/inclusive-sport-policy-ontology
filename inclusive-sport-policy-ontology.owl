    <rdfs:comment xml:lang="en">Named individual representing EU sport good governance framework in the policy dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">EU sport good governance framework</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">EU 스포츠 굿 거버넌스 체계</skos:prefLabel>
  </rdf:Description>
