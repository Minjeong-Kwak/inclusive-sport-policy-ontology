  <rdf:Description rdf:about="#program__elderly_women_resistive_theraband_exercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#elderly_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__elderly_women_resistive_theraband_exercise</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여성노인 탄력밴드 저항운동 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Resistive Theraband exercise program for elderly women</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여성노인을 대상으로 8주간 주 2회 실시한 탄력밴드 저항운동 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Associations Between Skeletal Muscle Mass, Grip Strength, and Physical and Cognitive Functions in Elderly Women: Effect of Exercise with Resistive Theraband</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition and Biochemistry</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/jenb.2019.0023</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">50-51</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twenty-eight elderly women participated; 15 underwent elastic band exercise for 1 hour per day, twice per week for 8 weeks. Theraband exercise significantly improved gait speed and physical function.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:program_duration_weeks rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</isp:program_duration_weeks>
    <isp:frequency_per_week rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</isp:frequency_per_week>
    <isp:session_duration_minutes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60</isp:session_duration_minutes>
    <isp:targets_target_group rdf:resource="#target_group__elderly_women_sarcopenia_function_support"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__theraband_resistance_senior_fitness"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__theraband_resistive_equipment"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__elderly_women_twice_weekly_theraband_context"/>
    <isp:produces_outcome rdf:resource="#outcome__elderly_women_gait_speed_improvement_theraband"/>
    <isp:produces_outcome rdf:resource="#outcome__elderly_women_mobility_improvement_theraband"/>
    <rdfs:label xml:lang="en">Resistive Theraband exercise program for elderly women</rdfs:label>
    <rdfs:comment xml:lang="ko">여성노인을 대상으로 8주간 주 2회 실시한 탄력밴드 저항운동 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Resistive Theraband exercise program for elderly women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">여성노인 탄력밴드 저항운동 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__elderly_women_sarcopenia_function_support"/>
  </rdf:Description>
