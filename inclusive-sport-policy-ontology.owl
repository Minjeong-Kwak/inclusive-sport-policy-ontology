  <rdf:Description rdf:about="#outcome__middle_school_girls_pe_class_attitude_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__middle_school_girls_pe_class_attitude_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여중생 체육수업 태도 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">improved PE class attitude among middle school girls</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육교사의 리더십을 통해 여중생의 체육수업 태도가 개선되는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육 교사의 리더십 유형이 여중생의 수업 참여도에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">긍정적 보상형 리더십이 수업 태도에 긍정적인 영향을 미쳤다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">improved PE class attitude among middle school girls</rdfs:label>
    <rdfs:comment xml:lang="ko">체육교사의 리더십을 통해 여중생의 체육수업 태도가 개선되는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">improved PE class attitude among middle school girls</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">여중생 체육수업 태도 향상</skos:prefLabel>
  </rdf:Description>
