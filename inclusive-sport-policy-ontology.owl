  <rdf:Description rdf:about="#program__migrant_worker_soccer_club_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#migrant_worker_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__migrant_worker_soccer_club_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">외국인노동자 축구클럽 지원 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">migrant worker soccer club support program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">외국인노동자의 사회적 적응과 소속감 형성을 지원하는 지역사회 축구클럽 기반 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 활동이 외국인노동자 삶의 변화에 미치는 영향 연구: 베트남 출신 노동자 축구클럽을 사례로</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">베트남 출신 노동자 축구클럽 참여를 통해 즐거움과 스트레스 해소, 소속감 강화, 대인관계 확대, 동료의식 강화 등 삶의 변화가 나타났다고 분석하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <isp:targets_target_group rdf:resource="#target_group__vietnamese_migrant_workers"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__migrant_worker_soccer_club"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__migrant_worker_sport_community"/>
    <isp:produces_outcome rdf:resource="#outcome__migrant_worker_belonging_enhancement"/>
    <isp:produces_outcome rdf:resource="#outcome__migrant_worker_stress_relief"/>
    <rdfs:label xml:lang="en">migrant worker soccer club support program</rdfs:label>
    <rdfs:comment xml:lang="ko">외국인노동자의 사회적 적응과 소속감 형성을 지원하는 지역사회 축구클럽 기반 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">migrant worker soccer club support program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">외국인노동자 축구클럽 지원 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__vietnamese_migrant_workers"/>
  </rdf:Description>
