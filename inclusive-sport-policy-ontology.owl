  <rdf:Description rdf:about="#policy__professional_sport_anti_doping_regulation">
    <rdf:type rdf:resource="#law_regulation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy__professional_sport_anti_doping_regulation</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프로스포츠 도핑방지 규정</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">professional sport anti-doping regulation</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프로스포츠에서 반도핑(도핑방지)의 적용과 해석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2016</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">우리나라 프로스포츠에서 도핑 제재가 강화되었고 각 단체 현실에 맞는 규정이 마련되었다고 설명하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:uses_policy_instrument rdf:resource="#policy_instrument__law_regulation"/>
    <isp:has_policy_domain rdf:resource="#policy_domain__sport_policy"/>
    <isp:has_policy_goal rdf:resource="#policy_goal__discrimination_reduction"/>
    <isp:implements_program rdf:resource="#program__professional_sport_anti_doping_activity"/>
    <isp:has_policy_outcome rdf:resource="#outcome__professional_sport_doping_awareness_increase"/>
    <isp:has_policy_outcome rdf:resource="#outcome__professional_sport_rule_harmonization_need"/>
    <rdfs:label xml:lang="en">professional sport anti-doping regulation</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing professional sport anti-doping regulation in the policy dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">professional sport anti-doping regulation</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">프로스포츠 도핑방지 규정</skos:prefLabel>
  </rdf:Description>
