  <rdf:Description rdf:about="#sport_activity__mixed_martial_arts_club_activity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#club_sport"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">종합격투기 동호회 활동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mixed martial arts club activity</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">동호회 기반으로 이루어지는 종합격투기 생활체육 참여 활동.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">종합격투기 동호인들의 참여경험에 관한 내러티브 탐구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">종합격투기가 생활체육으로 확산되고 아마추어 대회가 열리는 맥락이 제시됨.</isp:evidence_excerpt>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">확실하게 문헌 내용에서 확인 가능한 요소만 제한 반영함.</isp:note>
    <isp:reflects_target_group rdf:resource="#target_group__mixed_martial_arts_club_members"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__mixed_martial_arts_club_activity</isp:entity_id>
    <rdfs:label xml:lang="en">Mixed martial arts club activity</rdfs:label>
    <rdfs:comment xml:lang="ko">동호회 기반으로 이루어지는 종합격투기 생활체육 참여 활동.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Mixed martial arts club activity</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">종합격투기 동호회 활동</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__mixed_martial_arts_club_members"/>
  </rdf:Description>
