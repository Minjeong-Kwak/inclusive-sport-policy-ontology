  <rdf:Description rdf:about="#participation_context__twelve_week_remote_exercise_disability_elderly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#regular_participation"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__twelve_week_remote_exercise_disability_elderly</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애노인 12주 비대면 정기참여 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twelve-week non-face-to-face regular participation context for elderly persons with disabilities</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애노인이 12주간 주 2회 원격운동 프로그램에 정기적으로 참여한 맥락</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간 원격운동 프로그램이 장애노인의 삶의 질에 미치는 효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애노인 25명을 대상으로 원격운동 프로그램 참여군 12명과 비참여군 13명을 구분하고, 참여군은 12주간 주 2회 비대면 운동재활 프로그램에 참여하였다. 신체건강의 피로와 통증, 정신건강의 불안과 우울, 사회건강의 사회생활 변인에서 긍정적 효과가 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">Twelve-week non-face-to-face regular participation context for elderly persons with disabilities</rdfs:label>
    <rdfs:comment xml:lang="ko">장애노인이 12주간 주 2회 원격운동 프로그램에 정기적으로 참여한 맥락</rdfs:comment>
    <skos:prefLabel xml:lang="en">Twelve-week non-face-to-face regular participation context for elderly persons with disabilities</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">장애노인 12주 비대면 정기참여 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__postoperative_shoulder_rehabilitation_exercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#medical_welfare_linked_program"/>
