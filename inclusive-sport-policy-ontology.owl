  <rdf:Description rdf:about="#participation_context__twelve_week_preschool_complex_exercise_sessions">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#regular_participation"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__twelve_week_preschool_complex_exercise_sessions</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주 유아 복합운동 정기 참여</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twelve-week regular preschool complex exercise participation</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주 동안 복합운동 프로그램에 참여한 유아의 정기 참여 맥락</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간 복합운동 프로그램이 유아의 기초체력에 미치는 효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2008</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Exercise Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유아 230명을 대상으로 실험집단과 통제집단으로 구분하여 12주간 복합운동 프로그램을 적용하였다. 사전·사후 측정 결과, 근지구력, 유연성, 순발력, 민첩성, 평형성 등 기초체력과 운동기능에서 긍정적 향상이 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:operating_period_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12 weeks</isp:operating_period_text>
    <isp:reflects_target_group rdf:resource="#target_group__preschool_children_complex_exercise"/>
    <rdfs:label xml:lang="en">Twelve-week regular preschool complex exercise participation</rdfs:label>
    <rdfs:comment xml:lang="ko">12주 동안 복합운동 프로그램에 참여한 유아의 정기 참여 맥락</rdfs:comment>
    <skos:prefLabel xml:lang="en">Twelve-week regular preschool complex exercise participation</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">12주 유아 복합운동 정기 참여</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__preschool_children_complex_exercise"/>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__elderly_sport_instructors">
