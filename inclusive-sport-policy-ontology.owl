  <rdf:Description rdf:about="#sport_activity__immersive_vr_soccer_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#elementary_school_sport"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">가상현실 기반 초등 축구 학습활동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Virtual reality-based elementary soccer learning activity</isp:pref_label_en>
