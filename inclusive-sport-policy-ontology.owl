    <skos:prefLabel xml:lang="ko">입식근로 여성 간호사</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__school_pe_adolescent_drug_prevention">
    <rdf:type rdf:resource="#youth_program"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__school_pe_adolescent_drug_prevention</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년 약물 사용 예방 학교체육 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">school PE program for adolescent drug use prevention</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년의 건강한 성장과 약물 사용 예방을 목적으로 운영되는 학교 기반 체육 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학교 체육 프로그램이 청소년 약물 사용 예방에 미치는 영향에 대한 문헌고찰</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2010년부터 2023년까지의 연구 50편을 검토하여 체육 프로그램 참여 청소년의 약물 사용 빈도가 낮았다고 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:targets_target_group rdf:resource="#target_group__adolescents_drug_use_prevention_pe"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__long_term_after_school_sport_club_context"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__after_school_sport_drug_prevention"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__school_sport_club_drug_prevention"/>
    <isp:produces_outcome rdf:resource="#outcome__adolescent_drug_use_frequency_reduction_pe"/>
    <isp:produces_outcome rdf:resource="#outcome__positive_peer_interaction_drug_prevention"/>
    <isp:produces_outcome rdf:resource="#outcome__healthy_lifestyle_habit_drug_prevention"/>
    <rdfs:label xml:lang="en">school PE program for adolescent drug use prevention</rdfs:label>
    <rdfs:comment xml:lang="ko">청소년의 건강한 성장과 약물 사용 예방을 목적으로 운영되는 학교 기반 체육 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">school PE program for adolescent drug use prevention</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">청소년 약물 사용 예방 학교체육 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__adolescents_drug_use_prevention_pe"/>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__taekwondo_peace_education_card_game">
