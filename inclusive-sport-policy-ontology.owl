    <isp:is_target_group_supported_by_resource rdf:resource="#support_resource__automatic_immigration_screening_service"/>
    <rdfs:label xml:lang="en">Immigrants addressed in the 4th Master Plan</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Immigrants addressed in the 4th Master Plan in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Immigrants addressed in the 4th Master Plan</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">제4차 기본계획의 이민자</skos:prefLabel>
