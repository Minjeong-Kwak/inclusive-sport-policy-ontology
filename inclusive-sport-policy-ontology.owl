    <isp:produces_outcome rdf:resource="#outcome__older_women_sleep_disorder_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__older_women_stress_reduction"/>
    <isp:produces_outcome rdf:resource="#outcome__older_women_inflammation_alleviation"/>
