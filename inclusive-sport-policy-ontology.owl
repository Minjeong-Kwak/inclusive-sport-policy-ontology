  <rdf:Description rdf:about="#policy__ai_doping_esport_regulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#law_regulation"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">e스포츠 AI 도핑 규제</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AI doping regulation in eSports</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">e스포츠 공식 대회에서 생성형 AI나 보조 AI 사용을 도핑 개념으로 규제하기 위한 법제 기준.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑 개념의 확대를 통한 e스포츠 대회에서의 AI 도핑 규제</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">문화·미디어·엔터테인먼트법</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AI 도핑을 공식 대회에서 AI가 선수의 플레이를 도와주거나 대체하는 행위로 보고 도핑 개념 확대를 제안함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy__ai_doping_esport_regulation</isp:entity_id>
    <isp:implements_program rdf:resource="#program__ai_doping_prevention_esport_education"/>
    <rdfs:label xml:lang="en">AI doping regulation in eSports</rdfs:label>
    <rdfs:comment xml:lang="ko">e스포츠 공식 대회에서 생성형 AI나 보조 AI 사용을 도핑 개념으로 규제하기 위한 법제 기준.</rdfs:comment>
    <skos:prefLabel xml:lang="en">AI doping regulation in eSports</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">e스포츠 AI 도핑 규제</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#policy__pyeongchang_2018_winter_paralympic_legacy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#national_policy"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy__pyeongchang_2018_winter_paralympic_legacy</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018 평창동계패럴림픽 레거시 정책 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PyeongChang 2018 Winter Paralympic legacy policy context</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018 평창동계패럴림픽 이후 장애인체육 발전과 레거시 계승을 다루는 국가 수준의 정책 맥락</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018 평창동계패럴림픽 레거시 및 결산 고찰</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국특수체육학회지</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018 평창동계패럴림픽의 레거시를 스포츠, 사회, 환경, 도시, 경제에 더해 문화, ICT, 평화 레거시로 고찰하고, 홍보, 예산, 참가자, 관람객, 자원봉사자, 등급분류 제로정책, 체육시설 활용, 수송 및 접근성 극대화, 도핑테스트, 방송·취재 환경, 첨단 ICT 패럴림픽 운영을 결산하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <isp:uses_policy_instrument rdf:resource="#policy_instrument__pyeongchang_paralympic_legacy_plan_strategy"/>
    <isp:shapes_participation_context rdf:resource="#participation_context__pyeongchang_paralympic_event_context"/>
    <isp:has_policy_outcome rdf:resource="#outcome__paralympic_accessibility_improvement"/>
    <isp:has_policy_outcome rdf:resource="#outcome__disability_sport_legacy_strengthening"/>
    <rdfs:label xml:lang="en">PyeongChang 2018 Winter Paralympic legacy policy context</rdfs:label>
    <rdfs:comment xml:lang="ko">2018 평창동계패럴림픽 이후 장애인체육 발전과 레거시 계승을 다루는 국가 수준의 정책 맥락</rdfs:comment>
    <skos:prefLabel xml:lang="en">PyeongChang 2018 Winter Paralympic legacy policy context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">2018 평창동계패럴림픽 레거시 정책 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#addresses_participation_barrier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="#ontology_entity"/>
    <rdfs:range rdf:resource="#ontology_entity"/>
