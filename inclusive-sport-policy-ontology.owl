  <rdf:Description rdf:about="#program__secondary_content_based_online_pe_class">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#online_remote_program"/>
