    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">해방공간(1945-1948) 경기단체의 재건(창립) 및 활동</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">domestic_academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">광복 이후 한국 스포츠 재건과 경기단체 활동 맥락을 반영함</isp:evidence_excerpt>
