    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">예비 체육교사의 학교체육 기반 건강교육 요구도 분석: Borich 요구도와 LF 모델 활용</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
