  <rdf:Description rdf:about="#target_group__female_aquatic_rehabilitation_instructors">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#target_group"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__female_aquatic_rehabilitation_instructors</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여성 수중재활운동 지도자</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target group  female aquatic rehabilitation instructors</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여성 수중재활운동 지도자의 전문성 발달 과정에 관한 내러티브 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장기 경력 여성 수중재활운동 지도자 1명의 내러티브를 통해 물의 리듬, 직관적 안전관리, 개별화 지도전략, 멘토링 기반 전문성 형성 과정을 제시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">target group  female aquatic rehabilitation instructors</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing target group  female aquatic rehabilitation instructors in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">target group  female aquatic rehabilitation instructors</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">여성 수중재활운동 지도자</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__finswimmer_vitamin_mineral_intake_increase">
    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__finswimmer_vitamin_mineral_intake_increase</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">핀수영 선수 일부 영양소 섭취 증가</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">increased selected nutrient intake among finswimmers</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">핀수영 선수의 영양관련 상태와 영양교육 효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">영양교육 후 비타민 E, 비타민 C, 니아신, 비타민 B6, 엽산, 인, 나트륨, 아연 섭취량이 유의하게 증가하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:is_result_of_program rdf:resource="#program__finswimming_athlete_nutrition_education"/>
    <isp:reflects_target_group rdf:resource="#target_group__finswimming_business_team_athletes"/>
    <rdfs:label xml:lang="en">increased selected nutrient intake among finswimmers</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing increased selected nutrient intake among finswimmers in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">increased selected nutrient intake among finswimmers</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">핀수영 선수 일부 영양소 섭취 증가</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__finswimming_business_team_athletes"/>
  </rdf:Description>
  <rdf:Description rdf:about="#policy_domain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#policy"/>
    <rdfs:label xml:lang="en">Policy Domain</rdfs:label>
    <rdfs:comment xml:lang="en">A policy classification that identifies the substantive sector or policy field related to sport participation.</rdfs:comment>
    <skos:definition xml:lang="en">A policy classification that identifies the substantive sector or policy field related to sport participation.</skos:definition>
    <skos:scopeNote xml:lang="en">Abstract organizing class retained to group more specific subclasses; no direct individual assignment is expected in the current curation policy.</skos:scopeNote>
    <skos:editorialNote xml:lang="en">Curated in step 6 as abstract/non-leaf empty class. Direct instances should normally be assigned to its leaf subclasses rather than to policy_domain.</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__twelve_week_hybrid_balance_walking_pt_sessions">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#regular_participation"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__twelve_week_hybrid_balance_walking_pt_sessions</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주 온·오프라인 병행 밸런스워킹PT 참여</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twelve-week hybrid Balance Walking PT participation</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간 주 2회, 온라인 1회와 오프라인 1회로 진행된 정기 참여 맥락</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간 밸런스워킹PT 운동이 중년 여성의 신체적·정신적 건강에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중년기 여성 30명을 대상으로 12주간 주 2회, 온라인 1회와 오프라인 1회 방식의 밸런스워킹PT 운동을 적용하였다. 운동 프로그램은 제자리 걷기, 사방돌기 회전, 스트레칭, 균형, 점핑 등을 조합하였고, 건강 관련 체력, 신체적 특성, 혈중 지질 지표, 정신 건강에서 긍정적 변화를 보고하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:operating_period_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12 weeks; 2 sessions per week; 1 online and 1 offline session per week</isp:operating_period_text>
    <isp:reflects_target_group rdf:resource="#target_group__middle_aged_women_balance_walking_pt"/>
    <rdfs:label xml:lang="en">Twelve-week hybrid Balance Walking PT participation</rdfs:label>
    <rdfs:comment xml:lang="ko">12주간 주 2회, 온라인 1회와 오프라인 1회로 진행된 정기 참여 맥락</rdfs:comment>
    <skos:prefLabel xml:lang="en">Twelve-week hybrid Balance Walking PT participation</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">12주 온·오프라인 병행 밸런스워킹PT 참여</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__middle_aged_women_balance_walking_pt"/>
  </rdf:Description>
  <rdf:Description rdf:about="#sport_activity__small_sided_game_aerobic_training">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#youth_sport"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__small_sided_game_aerobic_training</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">소규모 게임 기반 유산소 훈련</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Small-sided game-based aerobic training</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Effect of 4 weeks of Fun Game-Based and Structured Interval Training Physical Education Lessons on Aerobic Fitness in Adolescents</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학생 동기와 즐거움을 높이기 위해 소규모 게임을 유산소 훈련 방식으로 활용할 수 있다고 제시함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년 체육수업에서 게임 형식으로 수행되는 유산소 신체활동임</isp:definition_text>
    <rdfs:label xml:lang="en">Small-sided game-based aerobic training</rdfs:label>
    <rdfs:comment xml:lang="ko">청소년 체육수업에서 게임 형식으로 수행되는 유산소 신체활동임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Small-sided game-based aerobic training</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">소규모 게임 기반 유산소 훈련</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__anti_doping_chaperone_volunteers">
