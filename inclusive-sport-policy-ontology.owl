    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대한스포츠의학회지</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">의료진이 보디빌딩의 생리적 요구와 건강위험을 이해해야 한다고 제언함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__bodybuilding_medical_risk_guideline</isp:entity_id>
