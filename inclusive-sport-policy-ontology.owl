    <isp:produces_outcome rdf:resource="#outcome__elderly_leisure_satisfaction_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__elderly_death_anxiety_monitoring"/>
    <rdfs:label xml:lang="en">Elderly life sport motivation support program</rdfs:label>
    <rdfs:comment xml:lang="ko">노인의 생활체육 참여동기와 여가만족을 높이고 심리적 불안을 완화하기 위한 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Elderly life sport motivation support program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">노인 생활체육 참여동기 지원 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__elderly_life_sport_club_participants"/>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__supplement_purchase_pathway_guidance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#guideline_manual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__supplement_purchase_pathway_guidance</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동영양 보조물 구입경로 안전지침</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support resource  supplement purchase pathway guidance</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 유도 선수의 성별과 연령에 따른 운동영양 보조물 섭취와 섭취경로 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2009</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2003~2008년 엘리트 유도선수 223명을 대상으로 운동영양 보조물 섭취와 구입경로를 조사했고, 연령과 성별에 따라 섭취 경향과 정보원 차이가 나타났으며 도핑교육 필요를 권고함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">support resource  supplement purchase pathway guidance</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing support resource  supplement purchase pathway guidance in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">support resource  supplement purchase pathway guidance</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">운동영양 보조물 구입경로 안전지침</skos:prefLabel>
  </rdf:Description>
