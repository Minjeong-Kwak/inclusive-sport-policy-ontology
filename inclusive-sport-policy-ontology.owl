    <skos:prefLabel xml:lang="en">University soccer players</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">대학 축구선수</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__doping_drug_ocr_recognition_system">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#digital_device"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑 약물 OCR 인식 시스템</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Doping drug OCR recognition system</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">금지약물 데이터베이스와 OCR 기술을 활용해 처방전 약물을 분석하는 디지털 지원도구.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑 약물 인식 시스템 개발: 딥러닝 기반의 OCR 기술 적용</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국체육학회지</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">336개 금지약물 DB와 CLOVA OCR 모델을 활용하여 도핑 약물 인식 시스템을 구축함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__doping_drug_ocr_recognition_system</isp:entity_id>
    <rdfs:label xml:lang="en">Doping drug OCR recognition system</rdfs:label>
    <rdfs:comment xml:lang="ko">금지약물 데이터베이스와 OCR 기술을 활용해 처방전 약물을 분석하는 디지털 지원도구.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Doping drug OCR recognition system</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">도핑 약물 OCR 인식 시스템</skos:prefLabel>
  </rdf:Description>
