  <rdf:Description rdf:about="#policy__national_obesity_management_policy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#welfare_policy"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국가 비만관리 정책</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">National obesity management policy</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국민의 비만 예방과 관리를 위해 생활습관 개선, 지역사회 기반 관리, 정보 플랫폼 구축 등을 포함하는 국가 단위 보건복지 정책</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analysis of public perception of national obesity management policy</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">27-35</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A national online survey of citizens aged 15-69 identified lifestyle improvement for obesity prevention, child and adolescent obesity prevention and management, community-based obesity and exercise clinics, and an integrated information platform for nutrition, diet, and physical activity as important national obesity policy tasks.</isp:evidence_excerpt>
    <isp:implements_program rdf:resource="#program__child_adolescent_obesity_prevention_management"/>
    <isp:implements_program rdf:resource="#program__community_obesity_exercise_clinic"/>
    <isp:has_policy_outcome rdf:resource="#outcome__lifestyle_improvement_for_obesity_prevention"/>
    <isp:has_policy_outcome rdf:resource="#outcome__obesity_policy_public_demand_alignment"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy__national_obesity_management_policy</isp:entity_id>
    <rdfs:label xml:lang="en">National obesity management policy</rdfs:label>
    <rdfs:comment xml:lang="ko">국민의 비만 예방과 관리를 위해 생활습관 개선, 지역사회 기반 관리, 정보 플랫폼 구축 등을 포함하는 국가 단위 보건복지 정책</rdfs:comment>
    <skos:prefLabel xml:lang="en">National obesity management policy</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">국가 비만관리 정책</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__face_to_face_antidoping_workshop">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#guideline_manual"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대면 도핑방지교육 워크숍</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Face-to-face anti-doping workshop</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑방지교육의 이해도와 실천성을 높이기 위한 사례 기반 대면교육 운영 자료</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대학 학생선수의 도핑방지교육 인식을 통한 효과적인 교육전략 탐색</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Physical Education</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대면 도핑방지교육 내용과 방법의 혁신이 제시되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__face_to_face_antidoping_workshop</isp:entity_id>
    <rdfs:label xml:lang="en">Face-to-face anti-doping workshop</rdfs:label>
    <rdfs:comment xml:lang="ko">도핑방지교육의 이해도와 실천성을 높이기 위한 사례 기반 대면교육 운영 자료</rdfs:comment>
    <skos:prefLabel xml:lang="en">Face-to-face anti-doping workshop</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">대면 도핑방지교육 워크숍</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__fair_sport_environment_protection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#equity_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__fair_sport_environment_protection</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">공정한 스포츠 환경 보호</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Protection of fair sport environment</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attitudes and Dispositions toward Doping in Adolescent Elite Athletes</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2013</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Sports Medicine</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WADA 반도핑 규약과 프로그램이 선수 건강과 공정한 스포츠 환경 조성을 목표로 함을 설명함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑 예방을 통해 공정한 경기 참여 환경을 보호하는 형평 성과임</isp:definition_text>
    <rdfs:label xml:lang="en">Protection of fair sport environment</rdfs:label>
    <rdfs:comment xml:lang="ko">도핑 예방을 통해 공정한 경기 참여 환경을 보호하는 형평 성과임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Protection of fair sport environment</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">공정한 스포츠 환경 보호</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__supplement_doping_awareness_improvement_judo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__supplement_doping_awareness_improvement_judo</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유도선수 보충제 도핑의식 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome  supplement doping awareness improvement judo</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 유도 선수의 성별과 연령에 따른 운동영양 보조물 섭취와 섭취경로 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2009</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2003~2008년 엘리트 유도선수 223명을 대상으로 운동영양 보조물 섭취와 구입경로를 조사했고, 연령과 성별에 따라 섭취 경향과 정보원 차이가 나타났으며 도핑교육 필요를 권고함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">outcome  supplement doping awareness improvement judo</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing outcome  supplement doping awareness improvement judo in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">outcome  supplement doping awareness improvement judo</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유도선수 보충제 도핑의식 향상</skos:prefLabel>
  </rdf:Description>
