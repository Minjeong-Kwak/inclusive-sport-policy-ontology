  <rdf:Description rdf:about="#participation_context__problem_based_learning_pe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#public_institution"/>
    <isp:interacts_with_target_group rdf:resource="#target_group__physical_education_students"/>
