  <rdf:Description rdf:about="#policy_domain__multicultural_family_and_integration_policy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#multicultural_policy"/>
