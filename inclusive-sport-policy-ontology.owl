    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년 엘리트 선수 반도핑 예방 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anti-doping prevention program for adolescent elite athletes</isp:pref_label_en>
