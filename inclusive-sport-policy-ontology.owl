  <rdf:Description rdf:about="#target_group__breast_cancer_survivors_physical_activity_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#target_group"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체활동 지원이 필요한 유방암 생존자</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Breast cancer survivors requiring physical activity support</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유방암 진단 전후 구조화된 운동과 여가 신체활동을 통한 건강 지원이 필요한 대상 집단</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A systematic review of the biological mechanisms linking physical activity and breast cancer</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">review_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/pan.2020.0018</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">25-26</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leisure-time physical activity and structured exercise before and after breast cancer diagnosis contribute to reducing the risk of breast cancer recurrence and mortality. The review describes physical activity as a non-pharmacological strategy for primary cancer prevention.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__breast_cancer_survivors_physical_activity_support</isp:entity_id>
    <rdfs:label xml:lang="en">Breast cancer survivors requiring physical activity support</rdfs:label>
    <rdfs:comment xml:lang="ko">유방암 진단 전후 구조화된 운동과 여가 신체활동을 통한 건강 지원이 필요한 대상 집단</rdfs:comment>
    <skos:prefLabel xml:lang="en">Breast cancer survivors requiring physical activity support</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">신체활동 지원이 필요한 유방암 생존자</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__sport_ethics_video_clip_worksheets">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#information_resource"/>
    <rdfs:label xml:lang="ko">스포츠윤리 영상·학습지 자료</rdfs:label>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠윤리 영상·학습지 자료</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport ethics video clips and worksheets</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">사례기반 스포츠윤리교육을 위해 활용되는 영상 클립과 학습지 형태의 정보 자원</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠윤리 교육프로그램 개발</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중·고등학교 학생선수를 위한 사례기반 스포츠윤리 교육프로그램을 개발하고, 적용 후 스포츠윤리성 점수 향상을 보고하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary_evidence</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__sport_ethics_video_clip_worksheets</isp:entity_id>
    <rdfs:comment xml:lang="ko">사례기반 스포츠윤리교육을 위해 활용되는 영상 클립과 학습지 형태의 정보 자원</rdfs:comment>
    <skos:prefLabel xml:lang="en">sport ethics video clips and worksheets</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠윤리 영상·학습지 자료</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__prader_willi_insulin_management_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__prader_willi_insulin_management_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프래더윌리증후군 인슐린 관리 개선</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insulin management improvement in Prader-Willi syndrome</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Changes in body composition, blood lipid profile, and growth factor hormone in a patient with Prader–willi syndrome during 24 weeks of complex exercise: a single case study</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition &amp; Biochemistry</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">15주와 20주에 인슐린 주사가 중단되고 평균 혈당이 정상 수준으로 감소함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동 중재 과정에서 인슐린 주사 중단과 혈당 정상화가 보고됨</isp:definition_text>
    <rdfs:label xml:lang="en">Insulin management improvement in Prader-Willi syndrome</rdfs:label>
    <rdfs:comment xml:lang="ko">운동 중재 과정에서 인슐린 주사 중단과 혈당 정상화가 보고됨</rdfs:comment>
    <skos:prefLabel xml:lang="en">Insulin management improvement in Prader-Willi syndrome</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">프래더윌리증후군 인슐린 관리 개선</skos:prefLabel>
  </rdf:Description>
