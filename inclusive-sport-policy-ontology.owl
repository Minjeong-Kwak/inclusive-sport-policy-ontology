  <rdf:Description rdf:about="#outcome__dance_education_curriculum_quality_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#system_level_outcome"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">무용교육 교육과정 질 개선</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improved quality of dance education curriculum</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCS 기반 대학 무용교육전문인 양성 교육과정 평가 시스템 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">무용교육 전문인 양성 교육과정의 체계성과 현장 적용 가능성이 향상되는 성과임</isp:definition_text>
