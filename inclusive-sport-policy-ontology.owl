    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Physical Education</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
