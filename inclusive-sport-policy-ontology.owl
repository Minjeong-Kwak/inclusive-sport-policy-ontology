    <skos:prefLabel xml:lang="ko">취약 아동 교내외 신체활동 증가</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__edutech_online_kdance_microlearning_program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#online_remote_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__edutech_online_kdance_microlearning_program</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">에듀테크 기반 비대면 K-Dance 수업 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">edtech-based online K-Dance microlearning program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">온라인 실습 기반 체육수업에서 AI 평가와 TMS 연동, 백워드 설계, 마이크로러닝 콘텐츠를 활용한 비대면 K-Dance 수업 프로그램을 개발하였다.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">에듀테크 기반 비대면 K-Dance 수업 프로그램 개발 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">온라인 실습 기반 체육수업에서 AI 평가와 TMS 연동, 백워드 설계, 마이크로러닝 콘텐츠를 활용한 비대면 K-Dance 수업 프로그램을 개발하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__online_kdance_practice"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__ai_dance_evaluation_tms"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__microlearning_kdance_content"/>
    <isp:produces_outcome rdf:resource="#outcome__online_practice_based_pe_assessment_improvement"/>
    <rdfs:label xml:lang="en">edtech-based online K-Dance microlearning program</rdfs:label>
    <rdfs:comment xml:lang="ko">온라인 실습 기반 체육수업에서 AI 평가와 TMS 연동, 백워드 설계, 마이크로러닝 콘텐츠를 활용한 비대면 K-Dance 수업 프로그램을 개발하였다.</rdfs:comment>
