  <rdf:Description rdf:about="#outcome__disability_sport_legacy_strengthening">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#policy_effectiveness_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__disability_sport_legacy_strengthening</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인체육 레거시 강화</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disability sport legacy strengthening</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">평창동계패럴림픽 운영 경험과 유무형 레거시가 후속 장애인체육 발전에 기여하는 정책 수준 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018 평창동계패럴림픽 레거시 및 결산 고찰</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국특수체육학회지</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018 평창동계패럴림픽의 레거시를 스포츠, 사회, 환경, 도시, 경제에 더해 문화, ICT, 평화 레거시로 고찰하고, 홍보, 예산, 참가자, 관람객, 자원봉사자, 등급분류 제로정책, 체육시설 활용, 수송 및 접근성 극대화, 도핑테스트, 방송·취재 환경, 첨단 ICT 패럴림픽 운영을 결산하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">Disability sport legacy strengthening</rdfs:label>
    <rdfs:comment xml:lang="ko">평창동계패럴림픽 운영 경험과 유무형 레거시가 후속 장애인체육 발전에 기여하는 정책 수준 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Disability sport legacy strengthening</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">장애인체육 레거시 강화</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__para_game_classification_integrity_stakeholders">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#disabled_person"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__para_game_classification_integrity_stakeholders</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">패러게임 등급분류 공정성 이해관계자</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Para Games classification integrity stakeholders</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비장애 운동선수의 아시안 패러 게임 참가 행위에 대한 법률적 접근과 해석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인아시안게임 부정 참가 의혹을 장애인 스포츠 복지와 공정성 관점에서 다룸</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">Para Games classification integrity stakeholders</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Para Games classification integrity stakeholders in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Para Games classification integrity stakeholders</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">패러게임 등급분류 공정성 이해관계자</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__community_social_participation_increase_2024">
