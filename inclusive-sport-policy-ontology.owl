  <rdf:Description rdf:about="#program__athlete_lower_limb_injury_risk_screening">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#safety_risk_management_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__athlete_lower_limb_injury_risk_screening</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동선수 하지 부상위험 선별 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">athlete lower-limb injury risk screening program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">H/Q 비율과 등속성 근력 평가를 활용하여 청소년 및 대학생 운동선수의 부상위험을 선별하는 프로그램.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년 및 대학생 운동선수의 대퇴이두근 / 대퇴사두근 근력 비율: 체계적인 검토</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">근력 불균형을 평가하거나 부상 위험성 예측을 위한 추가 연구가 필요하다고 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:targets_target_group rdf:resource="#target_group__youth_collegiate_athletes_lower_limb_injury_risk"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__hamstring_quadriceps_strength_ratio_assessment"/>
    <isp:produces_outcome rdf:resource="#outcome__lower_limb_muscle_imbalance_identification"/>
    <rdfs:label xml:lang="en">athlete lower-limb injury risk screening program</rdfs:label>
    <rdfs:comment xml:lang="ko">H/Q 비율과 등속성 근력 평가를 활용하여 청소년 및 대학생 운동선수의 부상위험을 선별하는 프로그램.</rdfs:comment>
    <skos:prefLabel xml:lang="en">athlete lower-limb injury risk screening program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">운동선수 하지 부상위험 선별 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__youth_collegiate_athletes_lower_limb_injury_risk"/>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__taekwondo_instructor_reeducation_system">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
