    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육교사가 과정중심평가의 개념과 방향을 이해하고 실행하는 것이 중요하다고 강조하였다.</isp:evidence_excerpt>
    <isp:utilizes_support_resource rdf:resource="#support_resource__pe_process_fortified_assessment_guideline"/>
    <isp:produces_outcome rdf:resource="#outcome__pe_teacher_assessment_expertise_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__curriculum_instruction_assessment_alignment"/>
