  <rdf:Description rdf:about="#sport_activity__concurrent_aerobic_hydraulic_resistance_exercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#fitness_program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유산소·유압저항 복합운동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Concurrent aerobic and hydraulic resistance exercise</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유산소운동과 유압식 저항운동을 결합하여 비만 여성의 운동 중 에너지소비와 체력 개선 가능성을 평가한 운동 활동</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acute Energy Expenditure to Concurrent Aerobic and Hydraulic Resistance Exercise in Obese Women</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Exercise Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2010</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">199-203</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nine healthy obese women completed a maximal exercise test and performed submaximal programmed accommodating circuit exercise and stationary cycling. PACE training evoked greater energy expenditure than stationary cycling during submaximal intensity exercise in obese individuals.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__concurrent_aerobic_hydraulic_resistance_exercise</isp:entity_id>
    <rdfs:label xml:lang="en">Concurrent aerobic and hydraulic resistance exercise</rdfs:label>
    <rdfs:comment xml:lang="ko">유산소운동과 유압식 저항운동을 결합하여 비만 여성의 운동 중 에너지소비와 체력 개선 가능성을 평가한 운동 활동</rdfs:comment>
    <skos:prefLabel xml:lang="en">Concurrent aerobic and hydraulic resistance exercise</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유산소·유압저항 복합운동</skos:prefLabel>
  </rdf:Description>
