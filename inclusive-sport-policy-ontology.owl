    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">government_guideline</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">보건복지부</isp:source_publisher>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:reflects_target_group rdf:resource="#target_group__registered_disabled_people_2024_welfare_guideline"/>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5</isp:source_page>
    <rdfs:label xml:lang="en">Reduced abuse and safety risks for people with disabilities</rdfs:label>
    <rdfs:comment xml:lang="ko">학대 신고의무, 권익옹호기관, 피해장애인 쉼터, 시설 안전관리 등을 통해 학대와 안전사고 위험을 낮추는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Reduced abuse and safety risks for people with disabilities</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">장애인 학대 및 안전사고 위험 감소</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__registered_disabled_people_2024_welfare_guideline"/>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__protective_equipment_improvement_taekwondo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#equipment_resource"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">태권도 보호장비 개선 자원</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">protective equipment improvement resource for taekwondo</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">세계태권도선수권대회 선수의 부상 기전에 관한 비디오 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Sports Medicine</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">접촉 부상 예방을 위해 더 나은 헤드기어, 정강이 보호대, 손 보호대 개발을 권고함.</isp:evidence_excerpt>
    <isp:supports_program rdf:resource="#program__taekwondo_injury_surveillance_video_analysis"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__protective_equipment_improvement_taekwondo</isp:entity_id>
