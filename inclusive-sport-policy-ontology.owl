  <rdf:Description rdf:about="#outcome__sedentary_behavior_health_risk_awareness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__sedentary_behavior_health_risk_awareness</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">좌식행동 건강위험 인식 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome  sedentary behavior health risk awareness</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여자 청소년의 좌식행동양상과 학교체육활동 및 건강요인과의 관련성 - 제 12차 (2016년) 청소년건강행태온라인 조사 자료를 이용하여 -</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016년 청소년건강행태온라인조사 자료를 활용하여 여자 청소년의 좌식행동, 신체활동, 학교체육활동, 식이행동 및 건강요인의 관련성을 분석함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">outcome  sedentary behavior health risk awareness</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing outcome  sedentary behavior health risk awareness in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">outcome  sedentary behavior health risk awareness</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">좌식행동 건강위험 인식 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#policy__people_centered_sport_culture_reform">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#sport_policy"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy__people_centered_sport_culture_reform</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">사람 중심 스포츠문화 개혁</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">people-centered sport culture reform</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">금메달과 기록보다 사람을 우선하는 스포츠문화 전환을 지향하는 정책 방향</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠보다 사람이 우선입니다</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 폭력의 원인을 금메달만 추구하는 운동문화와 사람보다 스포츠를 우선하는 구조에서 찾고, 사람 중심 스포츠로의 전환을 제안하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <isp:has_policy_goal rdf:resource="#policy_goal__discrimination_reduction"/>
    <isp:has_policy_goal rdf:resource="#policy_goal__social_integration"/>
    <rdfs:label xml:lang="en">people-centered sport culture reform</rdfs:label>
    <rdfs:comment xml:lang="ko">금메달과 기록보다 사람을 우선하는 스포츠문화 전환을 지향하는 정책 방향</rdfs:comment>
    <skos:prefLabel xml:lang="en">people-centered sport culture reform</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">사람 중심 스포츠문화 개혁</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__liberal_pe_affective_commitment_increase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_continuity"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__liberal_pe_affective_commitment_increase</isp:entity_id>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">liberal PE affective commitment increase</isp:pref_label_en>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">교양체육 정서적 몰입 향상</isp:pref_label_ko>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">교양체육의 LMS 품질, 사용만족도, 조직지원인식, 정서적 몰입, 구전의도 간의 관계</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">조직지원인식이 정서적 몰입에 긍정적 영향을 미침</isp:evidence_excerpt>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated v27 instance from uploaded paper</isp:note>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">literature_curated_instance</isp:source_type>
    <isp:source_identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">교양체육의 LMS 품질, 사용만족도, 조직지원인식, 정서적 몰입, 구전의도 간의 관계</isp:source_identifier>
    <rdfs:label xml:lang="en">liberal PE affective commitment increase</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing liberal PE affective commitment increase in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">liberal PE affective commitment increase</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">교양체육 정서적 몰입 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#sport_activity__guideline_based_moderate_vigorous_physical_activity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#fitness_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__guideline_based_moderate_vigorous_physical_activity</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지침 기반 중고강도 신체활동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guideline-based moderate-to-vigorous physical activity</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중강도 또는 고강도 신체활동 권고량을 충족하는 건강증진형 신체활동</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Association between Meeting Physical Activity Guidelines and Mortality in Korean Adults: An 8-year Prospective Study</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition and Biochemistry</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/jenb.2016.0054</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">23-24</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This prospective study used the Korean Longitudinal Study of Ageing with 9,177 adults aged 45 years or older over an 8-year follow-up. Meeting physical activity guidelines was associated with decreased all-cause mortality risk in Korean adults.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">Guideline-based moderate-to-vigorous physical activity</rdfs:label>
    <rdfs:comment xml:lang="ko">중강도 또는 고강도 신체활동 권고량을 충족하는 건강증진형 신체활동</rdfs:comment>
    <skos:prefLabel xml:lang="en">Guideline-based moderate-to-vigorous physical activity</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">지침 기반 중고강도 신체활동</skos:prefLabel>
  </rdf:Description>
