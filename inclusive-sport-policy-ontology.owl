  <rdf:Description rdf:about="#program__finswimming_athlete_nutrition_education">
    <rdf:type rdf:resource="#capacity_building_program"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__finswimming_athlete_nutrition_education</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">핀수영 선수 영양교육 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nutrition education program for finswimming athletes</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">핀수영 선수의 영양관련 상태와 영양교육 효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">실업팀 소속 핀수영 선수 11명을 대상으로 영양인식과 영양섭취 상태를 조사하고 영양교육 전후 식이섭취량 변화를 분석하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:targets_target_group rdf:resource="#target_group__finswimming_business_team_athletes"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__elite_finswimming_training_nutrition_context"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__finswimming_training"/>
    <isp:produces_outcome rdf:resource="#outcome__finswimmer_vitamin_mineral_intake_increase"/>
    <isp:produces_outcome rdf:resource="#outcome__finswimmer_energy_mineral_intake_unresolved"/>
    <rdfs:label xml:lang="en">nutrition education program for finswimming athletes</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing nutrition education program for finswimming athletes in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">nutrition education program for finswimming athletes</skos:prefLabel>
