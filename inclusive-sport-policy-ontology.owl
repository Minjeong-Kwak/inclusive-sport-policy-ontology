  <rdf:Description rdf:about="#outcome__adolescent_depression_anxiety_reduction_martial_arts">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#mental_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__adolescent_depression_anxiety_reduction_martial_arts</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">무술훈련 참여 청소년 우울·불안 감소</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reduced depression and anxiety among adolescents in martial arts training</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">무술훈련 참여 청소년에게서 우울과 불안 수준이 낮게 나타난 정신건강 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Empirical Analysis on the Relation between Martial Arts Training and Adolescent Mental Health</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">31-43</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adolescents who participated in martial arts training showed significantly lower depression, anxiety, and hostility than non-participants; training for more than 1.5 hours per session and over 3 years was associated with better mental health indicators.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <isp:reflects_target_group rdf:resource="#target_group__adolescents_martial_arts_mental_health_support"/>
    <rdfs:label xml:lang="en">Reduced depression and anxiety among adolescents in martial arts training</rdfs:label>
    <rdfs:comment xml:lang="ko">무술훈련 참여 청소년에게서 우울과 불안 수준이 낮게 나타난 정신건강 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Reduced depression and anxiety among adolescents in martial arts training</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">무술훈련 참여 청소년 우울·불안 감소</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__adolescents_martial_arts_mental_health_support"/>
  </rdf:Description>
