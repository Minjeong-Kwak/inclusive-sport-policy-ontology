    <rdfs:comment xml:lang="ko">도핑교육과 관련하여 도핑의식이 향상되는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">improved doping awareness through supplement education</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">도핑의식 향상</skos:prefLabel>
  </rdf:Description>
