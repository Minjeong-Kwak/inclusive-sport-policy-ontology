  <rdf:Description rdf:about="#support_resource__doping_civil_liability_guideline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#guideline_manual"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑 민사책임 안내자료</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Doping civil liability guideline</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">선수, 구단, 경기단체, 후원단체 간 도핑 관련 민사법적 책임을 안내하는 자료.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑의 민사법적 문제</isp:source_title>
