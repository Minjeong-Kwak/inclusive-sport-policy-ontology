  <rdf:Description rdf:about="#program__taekwondo_leader_education_curriculum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#leadership_instructor_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__taekwondo_leader_education_curriculum</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">태권도지도자 양성 교육과정</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taekwondo leader education curriculum</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 선수교육, 글로벌 태권도 지도자교육, 국내 전문 태권도 지도자교육으로 교육프로그램을 구분하여 목표·내용·방법·평가를 제시함.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">태권도지도자 양성을 위한 태권도학과 교육프로그램 개발</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2016</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
