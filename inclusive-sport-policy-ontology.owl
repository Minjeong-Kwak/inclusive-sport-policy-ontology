  <rdf:Description rdf:about="#target_group__seoul_elementary_students_4_6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_age_child"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">서울시 초등학교 4–6학년 학생</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Seoul elementary school students in grades 4-6</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">서울시 초등학생의 체육활동 참여가 공격성에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">서울 소재 초등학교 4~6학년 616명을 대상으로 체육활동 참여와 공격성의 관계를 분석함.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__seoul_elementary_students_4_6</isp:entity_id>
    <rdfs:label xml:lang="en">Seoul elementary school students in grades 4-6</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Seoul elementary school students in grades 4-6 in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Seoul elementary school students in grades 4-6</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">서울시 초등학교 4–6학년 학생</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#weekend_participation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#temporal_context"/>
    <rdfs:label xml:lang="en">Weekend Participation</rdfs:label>
    <rdfs:comment xml:lang="en">A temporal context class representing weekend participation as a condition of sport participation.</rdfs:comment>
    <skos:definition xml:lang="en">A temporal context class representing weekend participation as a condition of sport participation.</skos:definition>
    <skos:scopeNote xml:lang="en">Leaf class currently retained for ontology coverage, but no direct individuals are available in the current evidence base.</skos:scopeNote>
    <skos:editorialNote xml:lang="en">Curated in step 6 as unpopulated leaf class. Keep for conceptual coverage unless later evidence confirms that weekend_participation should be deprecated, renamed, merged, or populated.</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="#program__regular_extracurricular_pe_linkage_class">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_linked_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__regular_extracurricular_pe_linkage_class</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">정과·정과외 연계 체육수업</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Regular and extracurricular linked physical education class</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지역 스포츠 클러스터를 활용하여 정과 수업과 정과외 체육활동을 연결하는 학교 기반 체육수업</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2015 개정 체육과 교육과정에 대한 체육 교사 인식 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육교사 5명을 대상으로 심층면담을 실시하여 2015 개정 체육과 교육과정의 학교 현장 적용 인식을 분석하였다. 교사들은 지역 스포츠 클러스터를 활용한 정과·정과외 수업 연계, 체육수업 내 인문적 활동과 간접체험을 시도하고 있었으며, 간접체험 수업 가이드라인과 체계적 교사 연수의 필요성을 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_qualitative</isp:evidence_strength_level>
    <isp:utilizes_support_resource rdf:resource="#support_resource__local_sports_cluster_school_pe"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__physical_education_indirect_experience_guideline"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__school_pe_curriculum_application_context"/>
    <rdfs:label xml:lang="en">Regular and extracurricular linked physical education class</rdfs:label>
    <rdfs:comment xml:lang="ko">지역 스포츠 클러스터를 활용하여 정과 수업과 정과외 체육활동을 연결하는 학교 기반 체육수업</rdfs:comment>
    <skos:prefLabel xml:lang="en">Regular and extracurricular linked physical education class</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">정과·정과외 연계 체육수업</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__youth_taekwondo_elementary_participants">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_age_child"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__youth_taekwondo_elementary_participants</isp:entity_id>
