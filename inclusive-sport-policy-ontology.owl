    <rdfs:comment xml:lang="en">Named individual representing Obesity risk reduction among low-income adolescents in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Obesity risk reduction among low-income adolescents</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">저소득층 청소년 비만 위험 감소</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__low_income_adolescents_school_pe"/>
  </rdf:Description>
