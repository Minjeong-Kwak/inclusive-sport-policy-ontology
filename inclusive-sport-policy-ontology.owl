  <rdf:Description rdf:about="#participation_context__young_men_obesity_training_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__young_men_obesity_training_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">20대 남성 비만운동 참여 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Obesity exercise training context for young men</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저항성 운동 트레이닝이 20대 비만 남성의 신체구성, 아디포넥틴, C-반응성 단백질 및 호모시스테인에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">20대 비만 남성을 대상으로 통제된 저항성 운동 프로그램을 적용한 맥락이다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <rdfs:label xml:lang="en">Obesity exercise training context for young men</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Obesity exercise training context for young men in the participation_context dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Obesity exercise training context for young men</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">20대 남성 비만운동 참여 맥락</skos:prefLabel>
  </rdf:Description>
