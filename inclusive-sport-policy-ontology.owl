    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 선수에게도 우울, 불안, 강박, 거식, 불면 등 정신질환이 나타날 수 있으며 선수 수행과 경력에 심각한 영향을 줄 수 있다고 설명하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">sport psychiatry mental health information resource</rdfs:label>
