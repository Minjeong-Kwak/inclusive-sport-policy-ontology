    <rdf:type rdf:resource="#medical_welfare_linked_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__sport_philosophy_counseling_for_athletes</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">선수 대상 스포츠철학상담</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sport philosophy counseling for athletes</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동선수와 체육전공자의 삶의 의미, 가치관, 세계관을 상담하는 철학 기반 지원 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠철학상담의 세 가지 철학적 성찰</isp:source_title>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠철학상담은 선수와 체육학 전공 학생에게 인생관, 세계관, 가치관 상담과 대화를 제공할 필요가 있다고 설명함</isp:evidence_excerpt>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:targets_target_group rdf:resource="#target_group__athletes_existential_counseling_support"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__sport_philosophy_counselor"/>
    <isp:produces_outcome rdf:resource="#outcome__athlete_existential_meaning_support"/>
    <isp:produces_outcome rdf:resource="#outcome__sport_philosophy_counseling_professionalization"/>
    <rdfs:label xml:lang="en">Sport philosophy counseling for athletes</rdfs:label>
    <rdfs:comment xml:lang="ko">운동선수와 체육전공자의 삶의 의미, 가치관, 세계관을 상담하는 철학 기반 지원 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Sport philosophy counseling for athletes</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">선수 대상 스포츠철학상담</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__athletes_existential_counseling_support"/>
  </rdf:Description>
