    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">smart fitness algorithm based assessment program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">인공신경망 알고리즘을 활용하여 건강관련체력 추정과 맞춤형 운동처방을 지원하는 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 의과학에서 인공 신경망 분석 알고리즘의 가능성</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스마트 피트니스 플랫폼에서 건강관련체력 추정을 위해 인공신경망 분석 알고리즘이 다중회귀모델보다 효과적인 도구가 될 수 있다고 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <isp:utilizes_support_resource rdf:resource="#support_resource__artificial_neural_network_fitness_algorithm"/>
    <isp:produces_outcome rdf:resource="#outcome__health_fitness_assessment_accessibility_improvement"/>
    <rdfs:label xml:lang="en">smart fitness algorithm based assessment program</rdfs:label>
    <rdfs:comment xml:lang="ko">인공신경망 알고리즘을 활용하여 건강관련체력 추정과 맞춤형 운동처방을 지원하는 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">smart fitness algorithm based assessment program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스마트 피트니스 알고리즘 기반 체력평가 프로그램</skos:prefLabel>
  </rdf:Description>
