    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#target_group"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__resistance_training_participants</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저항운동 참여자</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resistance training participants</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스쿼트와 데드리프트 등 복합관절 저항운동에 참여하는 일반 운동 참여자</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스쿼트와 데드리프트 연구 동향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2010~2020년 국내외 스쿼트·데드리프트 자세 관련 연구 25편을 수집하여 신체 변화, 기능 개선, 성장력, 미래지향적 기술개발 유형으로 연구동향을 분석하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">resistance training participants</rdfs:label>
    <rdfs:comment xml:lang="ko">스쿼트와 데드리프트 등 복합관절 저항운동에 참여하는 일반 운동 참여자</rdfs:comment>
    <skos:prefLabel xml:lang="en">resistance training participants</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">저항운동 참여자</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__expressive_activity_positive_perception">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__expressive_activity_positive_perception</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">표현활동 긍정 인식 형성</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">positive perception of expressive activity</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">무용과 표현활동을 재미있고 즐겁게 할 수 있는 신체활동으로 인식하게 되는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">초등학생 춤놀이 수업 만족도 및 참여활동에 대한 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">춤놀이 수업은 학생들에게 무용과 표현활동이 재미있고 즐거운 활동이라는 인식을 갖게 함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated_v67_added_from_uploaded_literature</isp:note>
    <rdfs:label xml:lang="en">positive perception of expressive activity</rdfs:label>
    <rdfs:comment xml:lang="ko">무용과 표현활동을 재미있고 즐겁게 할 수 있는 신체활동으로 인식하게 되는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">positive perception of expressive activity</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">표현활동 긍정 인식 형성</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__obese_middle_aged_women_spinning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#target_group"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__obese_middle_aged_women_spinning</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스피닝 운동 대상 비만 중년 여성</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Obese middle-aged women in spinning exercise</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체지방률 30% 이상으로 스피닝 운동 중재가 필요한 중년 여성</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스피닝 운동 트레이닝이 비만 중년 여성의 혈중지질, 인슐린 저항성, Leptin 및 Ghrelin에 미치는 영향</isp:source_title>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만 중년 여성 18명을 스피닝 운동 트레이닝집단과 통제집단으로 구성함</isp:evidence_excerpt>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <rdfs:label xml:lang="en">Obese middle-aged women in spinning exercise</rdfs:label>
    <rdfs:comment xml:lang="ko">체지방률 30% 이상으로 스피닝 운동 중재가 필요한 중년 여성</rdfs:comment>
    <skos:prefLabel xml:lang="en">Obese middle-aged women in spinning exercise</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스피닝 운동 대상 비만 중년 여성</skos:prefLabel>
  </rdf:Description>
