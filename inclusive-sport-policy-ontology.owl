  <rdf:Description rdf:about="#outcome__task_goal_orientation_based_self_management_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#psychological_health_improvement"/>
    <rdf:type rdf:resource="#outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__task_goal_orientation_based_self_management_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">과제목표성향 기반 자기관리 지원</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Self-management support based on task goal orientation</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">절실함과 자기관리의 관계에서 과제목표성향을 활용하는 심리지원 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">남자 청소년 운동선수의 절실함이 자기관리에 미치는 영향: 성취목표성향의 조절효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-15</isp:last_updated>
    <rdfs:label xml:lang="en">Self-management support based on task goal orientation</rdfs:label>
