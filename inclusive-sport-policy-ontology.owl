    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <rdfs:label xml:lang="en">Insulin resistance improvement through spinning exercise</rdfs:label>
    <rdfs:comment xml:lang="ko">스피닝 운동을 통해 공복혈당, 공복 인슐린, HOMA-IR이 감소하는 성과</rdfs:comment>
