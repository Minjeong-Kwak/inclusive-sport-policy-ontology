  <rdf:Description rdf:about="#target_group__elementary_students_circuit_plyometric_training">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_age_child"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__elementary_students_circuit_plyometric_training</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">서킷-플라이오메트릭 트레이닝 참여 초등학생</isp:pref_label_ko>
