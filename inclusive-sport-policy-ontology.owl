  <rdf:Description rdf:about="#participation_context__special_school_and_special_class_setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#institutional_context"/>
