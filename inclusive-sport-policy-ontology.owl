  <rdf:Description rdf:about="#outcome__structural_doping_problem_recognition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#system_level_outcome"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑 구조문제 인식 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Recognition of structural doping problems</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">니클라스 루만(Niklas Luhmann)의 체계이론적 관점에서 본 반-도핑 커뮤니케이션의 한계와 과제</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2016</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑 현상을 개인 결정이 아니라 스포츠체계와 주변체계의 복합적 이해관계 속에서 파악해야 함을 제시함.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__structural_doping_problem_recognition</isp:entity_id>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <rdfs:label xml:lang="en">Recognition of structural doping problems</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Recognition of structural doping problems in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Recognition of structural doping problems</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">도핑 구조문제 인식 향상</skos:prefLabel>
  </rdf:Description>
