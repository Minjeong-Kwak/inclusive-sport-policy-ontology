  <rdf:Description rdf:about="#program__low_income_community_one_year_exercise_program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#community_based_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__low_income_community_one_year_exercise_program</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저소득 취약계층 1년 운동프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">one-year exercise program for low-income vulnerable community residents</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저소득 취약계층 성인을 대상으로 12개월간 제공된 수영, 요가, 복합운동 기반 운동증진 프로그램.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지역사회 저소득 취약계층 주민을 위한 1년간의 운동프로그램이 대사 및 심혈관 건강 위험요인에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">주 3회 수영, 요가, 복합운동을 각 1회씩 12개월간 제공하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:targets_target_group rdf:resource="#target_group__low_income_vulnerable_community_adults"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__swimming_yoga_combined_exercise"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__community_health_equity_context"/>
    <isp:produces_outcome rdf:resource="#outcome__metabolic_cardiovascular_risk_improvement_low_income"/>
    <rdfs:label xml:lang="en">one-year exercise program for low-income vulnerable community residents</rdfs:label>
    <rdfs:comment xml:lang="ko">저소득 취약계층 성인을 대상으로 12개월간 제공된 수영, 요가, 복합운동 기반 운동증진 프로그램.</rdfs:comment>
    <skos:prefLabel xml:lang="en">one-year exercise program for low-income vulnerable community residents</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">저소득 취약계층 1년 운동프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__low_income_vulnerable_community_adults"/>
