  <rdf:Description rdf:about="#program__smart_fitness_algorithm_based_assessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__smart_fitness_algorithm_based_assessment</isp:entity_id>
