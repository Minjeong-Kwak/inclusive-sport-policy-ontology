  <rdf:Description rdf:about="#program__equine_industry_curriculum_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__equine_industry_curriculum_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">말산업 대학 교육과정 개선 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equine industry university curriculum improvement program</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">말산업 대학 교육과정의 국제 비교 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">literature_curated_instance</isp:source_type>
    <isp:source_identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">말산업 대학 교육과정의 국제 비교 연구</isp:source_identifier>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국내외 말산업 대학 교육과정을 비교하여 국내 교육과정 개선 방향을 제시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated v33 instance from uploaded paper</isp:note>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <rdfs:label xml:lang="en">Equine industry university curriculum improvement program</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Equine industry university curriculum improvement program in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Equine industry university curriculum improvement program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">말산업 대학 교육과정 개선 프로그램</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__migrant_worker_stress_relief">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#mental_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__migrant_worker_stress_relief</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">외국인노동자 스트레스 해소</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">migrant worker stress relief</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 활동을 통해 외국인노동자의 즐거움과 스트레스 해소가 이루어지는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 활동이 외국인노동자 삶의 변화에 미치는 영향 연구: 베트남 출신 노동자 축구클럽을 사례로</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">베트남 출신 노동자 축구클럽 참여를 통해 즐거움과 스트레스 해소, 소속감 강화, 대인관계 확대, 동료의식 강화 등 삶의 변화가 나타났다고 분석하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">migrant worker stress relief</rdfs:label>
    <rdfs:comment xml:lang="ko">스포츠 활동을 통해 외국인노동자의 즐거움과 스트레스 해소가 이루어지는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">migrant worker stress relief</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">외국인노동자 스트레스 해소</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__vr_physical_education_teacher_training">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
