  <rdf:Description rdf:about="#sport_activity__water_safety_swimming_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_sport"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__water_safety_swimming_education</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">수상안전 수영교육</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">water safety swimming education</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">수영과 수상안전 상황 대처 능력을 함께 기르는 교육 기반 신체활동.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">수상안전교육 프로그램의 효과성 검증: 창의·인성 함양을 중심으로</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">수상안전교육을 수영 관련 교양체육 교과목에서 적용함.</isp:evidence_excerpt>
    <rdfs:label xml:lang="en">water safety swimming education</rdfs:label>
    <rdfs:comment xml:lang="ko">수영과 수상안전 상황 대처 능력을 함께 기르는 교육 기반 신체활동.</rdfs:comment>
    <skos:prefLabel xml:lang="en">water safety swimming education</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">수상안전 수영교육</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#sport_activity__voluntary_gait_adaptability_task_older_adults">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#fall_prevention_exercise"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인 자발적 보행 적응성 과제</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Voluntary gait adaptability task for older adults</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">시각 또는 청각 자극, 장애물 회피, 보폭 조정 등 인지 요구가 포함된 노인 보행 적응성 과제</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A scoping review of voluntary gait adaptability tasks requiring cognitive demands in older adults</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/pan.2023.0004</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">30-31</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Older adults often suffer from walking problems including reduced adaptability to environmental changes and hazards, which can increase fall risk. The review identified voluntary gait adaptability tasks requiring cognitive demands while walking.</isp:evidence_excerpt>
    <isp:supports_target_group rdf:resource="#target_group__older_adults_gait_adaptability_support"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__voluntary_gait_adaptability_task_older_adults</isp:entity_id>
    <rdfs:label xml:lang="en">Voluntary gait adaptability task for older adults</rdfs:label>
    <rdfs:comment xml:lang="ko">시각 또는 청각 자극, 장애물 회피, 보폭 조정 등 인지 요구가 포함된 노인 보행 적응성 과제</rdfs:comment>
    <skos:prefLabel xml:lang="en">Voluntary gait adaptability task for older adults</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">노인 자발적 보행 적응성 과제</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__older_adults_gait_adaptability_support"/>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__intellectual_disability_fair_sport_system">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#equity_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__intellectual_disability_fair_sport_system</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지적장애인스포츠 공정성 체계 구축</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fair sport system for intellectual disability sport</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">윤리교육, 금지약물·도핑검사 교육 및 홍보를 통해 지적장애인스포츠의 공정성을 강화하는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지적장애스포츠 조직의 변천 및 발전방향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2016</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">선수, 심판, 지도자를 대상으로 윤리교육, 금지약물과 도핑검사 교육 및 홍보를 실시해야 한다고 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">fair sport system for intellectual disability sport</rdfs:label>
    <rdfs:comment xml:lang="ko">윤리교육, 금지약물·도핑검사 교육 및 홍보를 통해 지적장애인스포츠의 공정성을 강화하는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">fair sport system for intellectual disability sport</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">지적장애인스포츠 공정성 체계 구축</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__elderly_balanced_nutrient_intake_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_health_improvement"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인 균형 영양섭취 개선</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improved balanced nutrient intake among older adults</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인의 대사증후군 예방을 위해 에너지와 주요 영양소 섭취 균형을 개선하는 신체건강 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analysis of energy intakes, physical activities and metabolic syndrome according to the income level in Korean elderly people: Korean National Health and Nutrition Examination Survey 2016-2018</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">28-35</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data from 2,139 elderly individuals aged over 65 years from KNHANES 2016-2018 showed that older adults with metabolic syndrome and older adults with low income had lower energy intake and physical activity; the study suggested balanced nutrient intake, increased physical activity, education, and program development to prevent metabolic syndrome in the elderly.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__elderly_balanced_nutrient_intake_improvement</isp:entity_id>
    <rdfs:label xml:lang="en">Improved balanced nutrient intake among older adults</rdfs:label>
    <rdfs:comment xml:lang="ko">노인의 대사증후군 예방을 위해 에너지와 주요 영양소 섭취 균형을 개선하는 신체건강 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Improved balanced nutrient intake among older adults</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">노인 균형 영양섭취 개선</skos:prefLabel>
  </rdf:Description>
