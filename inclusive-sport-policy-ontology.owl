    <skos:prefLabel xml:lang="en">support resource  sedentary behavior physical activity monitoring guideline</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">좌식행동과 신체활동 모니터링 지침</skos:prefLabel>
