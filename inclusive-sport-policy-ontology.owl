    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improved PE-based health education teaching capacity</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">예비 체육교사의 학교체육 기반 건강교육 요구도 분석: Borich 요구도와 LF 모델 활용</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">예비 체육교사가 건강교육 내용을 이해하고 학교체육 기반 건강교육을 실행할 수 있는 역량 향상 성과임</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">예비 체육교사가 건강교육 내용을 이해하고 학교체육 기반 건강교육을 실행할 수 있는 역량 향상 성과임</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <rdfs:label xml:lang="en">Improved PE-based health education teaching capacity</rdfs:label>
    <rdfs:comment xml:lang="ko">예비 체육교사가 건강교육 내용을 이해하고 학교체육 기반 건강교육을 실행할 수 있는 역량 향상 성과임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Improved PE-based health education teaching capacity</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">체육 기반 건강교육 교수역량 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__doping_intention_reduction_autonomy_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#policy_effectiveness_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__doping_intention_reduction_autonomy_education</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑 의도 감소</isp:pref_label_ko>
