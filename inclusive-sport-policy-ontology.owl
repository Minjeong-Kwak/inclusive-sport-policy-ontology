  <rdf:Description rdf:about="#outcome__youth_jogging_belonging_and_wellbeing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#community_belonging_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__youth_jogging_belonging_and_wellbeing</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년 조깅 소속감·웰빙 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enhanced belonging and well-being through youth jogging</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">공원 조깅 경험을 통해 청소년의 소속감, 긍정적 사고, 웰빙이 향상되는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Empirical Phenomenological Study of Youths’ Experiences Jogging in Singapore Parks</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1-16</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Six youth joggers aged 17-19 discussed experiences of jogging in Singapore parks; park jogging elicited positive experiences, reduced negative thoughts and stress, promoted well-being, sense of belonging, personal growth, and academic performance.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <isp:reflects_target_group rdf:resource="#target_group__singapore_youth_park_joggers"/>
    <rdfs:label xml:lang="en">Enhanced belonging and well-being through youth jogging</rdfs:label>
    <rdfs:comment xml:lang="ko">공원 조깅 경험을 통해 청소년의 소속감, 긍정적 사고, 웰빙이 향상되는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Enhanced belonging and well-being through youth jogging</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">청소년 조깅 소속감·웰빙 향상</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__singapore_youth_park_joggers"/>
  </rdf:Description>
