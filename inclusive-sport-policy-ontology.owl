    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">일반학생의 꿈, 끼, 진로를 탐색하는 데 활용할 수 있는 검사로 제시되었다.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__sport_career_interest_clarification</isp:entity_id>
    <rdfs:label xml:lang="en">sport career interest clarification</rdfs:label>
