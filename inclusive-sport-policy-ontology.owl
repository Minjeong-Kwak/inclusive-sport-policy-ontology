  <rdf:Description rdf:about="#program__disability_free_legal_aid_2024">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program"/>
    <rdf:type rdf:resource="#legal_support_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__disability_free_legal_aid_2024</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인 무료 법률구조제도</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Free legal aid program for people with disabilities</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인 소송 시 인지대, 송달료, 변호사 비용 등을 지원하고 법률상담과 소송대리를 제공하는 제도.</isp:definition_text>
