    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TGMD-2가 유아의 이동운동기술과 조작운동기술 평가도구로 사용되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-15</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
