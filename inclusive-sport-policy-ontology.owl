    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__sports_ethics_leadership_curriculum</isp:entity_id>
    <rdfs:label xml:lang="en">Sports ethics leadership curriculum</rdfs:label>
    <rdfs:comment xml:lang="ko">스포츠지도자 자격과 지도자 교육에서 윤리적 행동과 스포츠윤리 의식을 다루기 위한 교육자료</rdfs:comment>
    <skos:prefLabel xml:lang="en">Sports ethics leadership curriculum</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠 윤리 리더십 교육자료</skos:prefLabel>
  </rdf:Description>
