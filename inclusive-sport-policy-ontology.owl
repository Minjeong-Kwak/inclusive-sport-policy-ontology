  <rdf:Description rdf:about="#program__youth_park_jogging_wellbeing_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#community_based_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__youth_park_jogging_wellbeing_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년 공원 조깅 웰빙 지원 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Youth park jogging well-being support program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년의 긍정적 정서, 스트레스 완화, 소속감 형성을 지원하기 위해 공원 조깅을 활용하는 지역사회 기반 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Empirical Phenomenological Study of Youths’ Experiences Jogging in Singapore Parks</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1-16</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Six youth joggers aged 17-19 discussed experiences of jogging in Singapore parks; park jogging elicited positive experiences, reduced negative thoughts and stress, promoted well-being, sense of belonging, personal growth, and academic performance.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <isp:targets_target_group rdf:resource="#target_group__singapore_youth_park_joggers"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__youth_park_jogging"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__park_based_youth_jogging_context"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__park_jogging_space"/>
    <isp:produces_outcome rdf:resource="#outcome__youth_jogging_stress_reduction"/>
    <isp:produces_outcome rdf:resource="#outcome__youth_jogging_belonging_and_wellbeing"/>
    <rdfs:label xml:lang="en">Youth park jogging well-being support program</rdfs:label>
    <rdfs:comment xml:lang="ko">청소년의 긍정적 정서, 스트레스 완화, 소속감 형성을 지원하기 위해 공원 조깅을 활용하는 지역사회 기반 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Youth park jogging well-being support program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">청소년 공원 조깅 웰빙 지원 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__singapore_youth_park_joggers"/>
  </rdf:Description>
