    <isp:produces_outcome rdf:resource="#outcome__coach_learning_fatigue_reduction"/>
    <isp:produces_outcome rdf:resource="#outcome__compulsory_education_quality_improvement"/>
    <rdfs:label xml:lang="en">program  integrated compulsory education for elite sport</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing program  integrated compulsory education for elite sport in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">program  integrated compulsory education for elite sport</skos:prefLabel>
