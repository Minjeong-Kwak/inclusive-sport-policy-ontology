    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">구현 수준 6문항과 구현 실태 원인 6문항을 활용함</isp:evidence_excerpt>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated v27 instance from uploaded paper</isp:note>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">literature_curated_instance</isp:source_type>
    <isp:source_identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국가수준 체육과 교육과정의 구현 실태 및 제고 방안</isp:source_identifier>
    <rdfs:label xml:lang="en">PE curriculum implementation survey tool</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing PE curriculum implementation survey tool in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">PE curriculum implementation survey tool</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">체육과 교육과정 구현 실태 설문도구</skos:prefLabel>
