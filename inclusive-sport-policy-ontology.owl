    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">참여자들은 팀원들과 서로를 지지하며 어려움을 극복하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">strengthened social bonding through para baseball</rdfs:label>
    <rdfs:comment xml:lang="ko">팀원과의 지지관계와 공동체 의식이 강화되는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">strengthened social bonding through para baseball</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">장애인 야구를 통한 사회적 유대 강화</skos:prefLabel>
  </rdf:Description>
