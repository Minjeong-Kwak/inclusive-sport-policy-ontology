  <rdf:Description rdf:about="#outcome__fair_play_competition_protection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#equity_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__fair_play_competition_protection</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">페어플레이 경쟁 보호</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fair play competition protection</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑과 승부조작을 예방하고 공정한 경쟁의 장을 보호하는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 선수의 도덕적 의무에 관한 소고</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠와 윤리</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑과 승부조작 문제를 바탕으로 스포츠 선수에게 요구되는 도덕적 의무로 정직성, 책임감, 공정성을 도출하고 교육적·제도적 실천 방안을 제안하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">fair play competition protection</rdfs:label>
    <rdfs:comment xml:lang="ko">도핑과 승부조작을 예방하고 공정한 경쟁의 장을 보호하는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">fair play competition protection</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">페어플레이 경쟁 보호</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__eight_month_aqua_rehabilitation_for_brain_lesion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#medical_welfare_linked_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__eight_month_aqua_rehabilitation_for_brain_lesion</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">8개월 수중재활운동 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eight-month aqua rehabilitation program for acquired brain lesions</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">편측사지 중도 뇌병변장애인을 대상으로 심리적 안정과 운동 준비성을 지원하는 장기 수중재활 프로그램.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">수중재활운동이 편측사지 중도 뇌병변장애인의 심리적 안정과 정신적 준비기에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">8개월간 주 1회 60분 수중재활운동 프로그램을 적용함.</isp:evidence_excerpt>
    <isp:targets_target_group rdf:resource="#target_group__adults_with_acquired_brain_lesion_hemiplegia"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__aqua_rehabilitation_exercise"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__community_aquatic_rehabilitation_setting"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__aquatic_rehabilitation_pool_facility"/>
    <isp:produces_outcome rdf:resource="#outcome__brain_lesion_psychological_stability_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__brain_lesion_mental_preparation_improvement"/>
    <rdfs:label xml:lang="en">eight-month aqua rehabilitation program for acquired brain lesions</rdfs:label>
    <rdfs:comment xml:lang="ko">편측사지 중도 뇌병변장애인을 대상으로 심리적 안정과 운동 준비성을 지원하는 장기 수중재활 프로그램.</rdfs:comment>
    <skos:prefLabel xml:lang="en">eight-month aqua rehabilitation program for acquired brain lesions</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">8개월 수중재활운동 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__adults_with_acquired_brain_lesion_hemiplegia"/>
  </rdf:Description>
