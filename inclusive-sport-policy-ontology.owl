  <rdf:Description rdf:about="#support_resource__bia_ecw_icw_metabolic_screening">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#digital_device"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__bia_ecw_icw_metabolic_screening</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BIA 기반 ECW/ICW 대사건강 선별 자원</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BIA-based ECW/ICW metabolic screening resource</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">생체전기임피던스 분석을 통해 체수분 분포와 대사건강 특성을 확인하는 선별 자원</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Association between extracellular-to-intracellular water ratio and type 2 diabetes mellitus in Korean males aged 19-80 years: analysis of KNHANES 2022-2023</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/pan.2025.0017</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">77-78</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The study analyzed 2,281 Korean males aged 19-80 years from KNHANES 2022-2023 and identified an association between ECW/ICW ratio and T2DM prevalence independent of age, BMI, and muscle strength.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:supports_target_group rdf:resource="#target_group__korean_males_t2dm_body_composition_risk"/>
    <rdfs:label xml:lang="en">BIA-based ECW/ICW metabolic screening resource</rdfs:label>
    <rdfs:comment xml:lang="ko">생체전기임피던스 분석을 통해 체수분 분포와 대사건강 특성을 확인하는 선별 자원</rdfs:comment>
    <skos:prefLabel xml:lang="en">BIA-based ECW/ICW metabolic screening resource</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">BIA 기반 ECW/ICW 대사건강 선별 자원</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__korean_males_t2dm_body_composition_risk"/>
  </rdf:Description>
