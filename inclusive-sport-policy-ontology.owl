  <rdf:Description rdf:about="#context__military_rank_constrained_physical_activity_v75">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#group_participation"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">context__military_rank_constrained_physical_activity_v75</isp:entity_id>
