  <rdf:Description rdf:about="#support_resource__professional_baseball_cvm_evaluation_method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#information_resource"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프로야구 CVM 가치평가 방법</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CVM valuation method for professional baseball teams</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프로야구구단의 무형적 공공재 가치를 추정하는 정보·평가 자원.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">조건부가치평가법(CVM)을 이용한 한국 프로야구구단의 사회ㆍ경제적 가치평가</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지역주민 1,119명의 지불의사를 바탕으로 프로야구구단의 사회·경제적 가치를 추정함.</isp:evidence_excerpt>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">확실하게 문헌 내용에서 확인 가능한 요소만 제한 반영함.</isp:note>
    <isp:is_reflected_in_outcome rdf:resource="#outcome__professional_baseball_public_good_value"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__professional_baseball_cvm_evaluation_method</isp:entity_id>
    <rdfs:label xml:lang="en">CVM valuation method for professional baseball teams</rdfs:label>
    <rdfs:comment xml:lang="ko">프로야구구단의 무형적 공공재 가치를 추정하는 정보·평가 자원.</rdfs:comment>
    <skos:prefLabel xml:lang="en">CVM valuation method for professional baseball teams</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">프로야구 CVM 가치평가 방법</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__early_childhood_fundamental_movement_teacher_training">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program_information"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__early_childhood_fundamental_movement_teacher_training</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유아 기본움직임 교사 연수 정보</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Teacher training information for preschool fundamental movement</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">교사가 유아 기본움직임기술 요소를 이해하고 놀이 활동에 균형 있게 반영하도록 지원하는 연수 정보 자원</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019 개정 누리과정 놀이운영 사례집 내 기본움직임 요소 내용분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019 개정 누리과정의 현장 지원자료인 놀이 운영사례집 5권을 분석하여 만 3~5세 유아의 기본움직임기술 요소를 검토하였다. 분석 결과 안정성 움직임, 복합 이동성 움직임, 조작적 움직임 요소가 균형 있게 포함될 필요가 있으며, 유아 신체 기본움직임 프로그램 지원과 교사 연수 필요가 제시되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_content_analysis</isp:evidence_strength_level>
    <isp:supports_program rdf:resource="#program__nuri_fundamental_movement_support_program"/>
    <rdfs:label xml:lang="en">Teacher training information for preschool fundamental movement</rdfs:label>
    <rdfs:comment xml:lang="ko">교사가 유아 기본움직임기술 요소를 이해하고 놀이 활동에 균형 있게 반영하도록 지원하는 연수 정보 자원</rdfs:comment>
    <skos:prefLabel xml:lang="en">Teacher training information for preschool fundamental movement</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유아 기본움직임 교사 연수 정보</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#policy__sport_science_fairness_policy_discourse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#sport_policy"/>
    <rdfs:label xml:lang="ko">스포츠 과학기술 공정성 정책 담론</rdfs:label>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 과학기술 공정성 정책 담론</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport science fairness policy discourse</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠에서 과학기술의 허용과 금지 기준을 공정성 관점에서 다루는 정책 담론</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠에서 과학의 개입한도와 기준 문제</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠에서 과학기술의 허용과 금지 기준이 모호한 경우 도핑, 의료기술, 장비, 필수장비와 관련한 공정성 논쟁이 발생함을 논의하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary_evidence</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:has_policy_outcome rdf:resource="#outcome__science_technology_fairness_criteria_clarification"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__science_intervention_criteria_guideline"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy__sport_science_fairness_policy_discourse</isp:entity_id>
    <rdfs:comment xml:lang="ko">스포츠에서 과학기술의 허용과 금지 기준을 공정성 관점에서 다루는 정책 담론</rdfs:comment>
    <skos:prefLabel xml:lang="en">sport science fairness policy discourse</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠 과학기술 공정성 정책 담론</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__anti_doping_policy_institutionalization">
    <rdf:type rdf:resource="#policy_effectiveness_improvement"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__anti_doping_policy_institutionalization</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑방지 정책 제도화 개선</isp:pref_label_ko>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국의 스포츠 도핑 방지 정책형성 과정에 관한 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KADA 설립과 국민체육진흥법 개정이라는 정책 산출물이 확인되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anti Doping Policy Institutionalization</isp:pref_label_en>
    <rdfs:label xml:lang="en">Anti Doping Policy Institutionalization</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Anti Doping Policy Institutionalization in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Anti Doping Policy Institutionalization</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">도핑방지 정책 제도화 개선</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__preschool_children_functional_skill_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#functional_ability_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__preschool_children_functional_skill_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유아 운동기능 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Functional movement skill improvement in preschool children</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간 복합운동 프로그램 참여 후 유아의 운동기능이 향상된 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간 복합운동 프로그램이 유아의 기초체력에 미치는 효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2008</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Exercise Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유아 230명을 대상으로 실험집단과 통제집단으로 구분하여 12주간 복합운동 프로그램을 적용하였다. 사전·사후 측정 결과, 근지구력, 유연성, 순발력, 민첩성, 평형성 등 기초체력과 운동기능에서 긍정적 향상이 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_significant</isp:evidence_strength_level>
    <isp:outcome_indicator_name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">functional movement skill</isp:outcome_indicator_name>
    <isp:measurement_timepoint rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pre-post</isp:measurement_timepoint>
    <rdfs:label xml:lang="en">Functional movement skill improvement in preschool children</rdfs:label>
    <rdfs:comment xml:lang="ko">12주간 복합운동 프로그램 참여 후 유아의 운동기능이 향상된 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Functional movement skill improvement in preschool children</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유아 운동기능 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__theory_of_planned_behavior_physical_activity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#information_resource"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">계획행동이론 기반 신체활동 설명틀</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">theory of planned behavior framework for physical activity</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">성인의 신체활동과 계획행동이론의 연관성: 다중수준 메타분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">계획행동이론 모형이 성인 신체활동 설명에 우수한 적합도를 보였음.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__theory_of_planned_behavior_physical_activity</isp:entity_id>
    <rdfs:label xml:lang="en">theory of planned behavior framework for physical activity</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing theory of planned behavior framework for physical activity in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">theory of planned behavior framework for physical activity</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">계획행동이론 기반 신체활동 설명틀</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__vr_based_cp_child_gait_intervention_review">
