  <rdf:Description rdf:about="#target_group__prader_willi_syndrome_obesity_diabetes_exercise_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#target_group"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__prader_willi_syndrome_obesity_diabetes_exercise_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">복합운동 지원이 필요한 프래더윌리증후군 비만·당뇨 환자</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Prader-Willi syndrome patient requiring complex exercise support for obesity and diabetes</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Changes in body composition, blood lipid profile, and growth factor hormone in a patient with Prader–willi syndrome during 24 weeks of complex exercise: a single case study</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition &amp; Biochemistry</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">23세 프래더윌리증후군 남성 환자에게 24주 복합운동을 적용함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프래더윌리증후군 환자의 비만 및 제2형 당뇨 관리에 운동 중재가 직접 적용됨</isp:definition_text>
    <rdfs:label xml:lang="en">Prader-Willi syndrome patient requiring complex exercise support for obesity and diabetes</rdfs:label>
    <rdfs:comment xml:lang="ko">프래더윌리증후군 환자의 비만 및 제2형 당뇨 관리에 운동 중재가 직접 적용됨</rdfs:comment>
    <skos:prefLabel xml:lang="en">Prader-Willi syndrome patient requiring complex exercise support for obesity and diabetes</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">복합운동 지원이 필요한 프래더윌리증후군 비만·당뇨 환자</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__pre_service_teacher_school_bullying_prevention_awareness">
