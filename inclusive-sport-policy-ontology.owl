  <rdf:Description rdf:about="#program__pyeongchang_paralympic_accessibility_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#accessibility_support_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__pyeongchang_paralympic_accessibility_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">평창동계패럴림픽 접근성 지원 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PyeongChang Paralympic accessibility support program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인 참여자와 관람객의 이동, 시설 이용, 대회 참여 접근성을 높이기 위한 패럴림픽 운영 지원 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018 평창동계패럴림픽 레거시 및 결산 고찰</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국특수체육학회지</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018 평창동계패럴림픽의 레거시를 스포츠, 사회, 환경, 도시, 경제에 더해 문화, ICT, 평화 레거시로 고찰하고, 홍보, 예산, 참가자, 관람객, 자원봉사자, 등급분류 제로정책, 체육시설 활용, 수송 및 접근성 극대화, 도핑테스트, 방송·취재 환경, 첨단 ICT 패럴림픽 운영을 결산하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <isp:targets_target_group rdf:resource="#target_group__paralympic_participants_with_disabilities"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__winter_paralympic_parasport"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__pyeongchang_paralympic_event_context"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__pyeongchang_paralympic_accessible_transport"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__pyeongchang_paralympic_accessible_facilities"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__pyeongchang_paralympic_ict_support"/>
    <isp:produces_outcome rdf:resource="#outcome__paralympic_accessibility_improvement"/>
    <rdfs:label xml:lang="en">PyeongChang Paralympic accessibility support program</rdfs:label>
    <rdfs:comment xml:lang="ko">장애인 참여자와 관람객의 이동, 시설 이용, 대회 참여 접근성을 높이기 위한 패럴림픽 운영 지원 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">PyeongChang Paralympic accessibility support program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">평창동계패럴림픽 접근성 지원 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__paralympic_participants_with_disabilities"/>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__physical_activity_class_satisfaction_increase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#life_satisfaction_improvement"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체활동 수업만족도 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Increased satisfaction with physical activity classes</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체활동 프로그램을 통한 즐거움 및 만족도에 관한 연구</isp:source_title>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">empirical_study</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육수업 참여 집단이 표현활동 참여 집단보다 수업 만족도가 높게 나타남</isp:evidence_excerpt>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">v45 추가 인스턴스</isp:note>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">v45_batch</isp:source_identifier>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__physical_activity_class_satisfaction_increase</isp:entity_id>
    <rdfs:label xml:lang="en">Increased satisfaction with physical activity classes</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Increased satisfaction with physical activity classes in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Increased satisfaction with physical activity classes</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">신체활동 수업만족도 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__professional_sport_doping_awareness_increase">
    <rdf:type rdf:resource="#equity_outcome"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__professional_sport_doping_awareness_increase</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프로스포츠 도핑 경각심 제고</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">increased doping awareness in professional sports</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프로스포츠에서 반도핑(도핑방지)의 적용과 해석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2016</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3차 적발 시 영구제명 규정은 프로스포츠에서 도핑에 대한 경각심과 반도핑의 의미를 상기시켰다고 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:is_result_of_program rdf:resource="#program__professional_sport_anti_doping_activity"/>
    <isp:is_result_of_policy rdf:resource="#policy__professional_sport_anti_doping_regulation"/>
    <isp:reflects_target_group rdf:resource="#target_group__professional_sport_athletes_anti_doping"/>
    <rdfs:label xml:lang="en">increased doping awareness in professional sports</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing increased doping awareness in professional sports in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">increased doping awareness in professional sports</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">프로스포츠 도핑 경각심 제고</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__professional_sport_athletes_anti_doping"/>
  </rdf:Description>
