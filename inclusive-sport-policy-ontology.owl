    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Changes in physical activity and energy intake according to abdominal obesity in Korean adult men before and after COVID-19: Data from 2019 and 2020 Korea National Health and Nutrition Examination Survey (KNHANES)</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
