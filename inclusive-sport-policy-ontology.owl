  <rdf:Description rdf:about="#participation_context__covid_school_pe_remote_learning_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__covid_school_pe_remote_learning_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COVID-19 학교체육 원격수업 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remote learning context for school PE during COVID-19</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exploring Middle School Students' Perceptions of Physical Education Activities During the COVID-19 Pandemic</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학생들은 원격수업에서 활발한 신체활동과 대인관계 기대가 충분히 충족되지 못했다고 인식함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학교체육 참여가 온라인 환경으로 제한된 참여 맥락임</isp:definition_text>
    <rdfs:label xml:lang="en">Remote learning context for school PE during COVID-19</rdfs:label>
    <rdfs:comment xml:lang="ko">학교체육 참여가 온라인 환경으로 제한된 참여 맥락임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Remote learning context for school PE during COVID-19</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">COVID-19 학교체육 원격수업 맥락</skos:prefLabel>
  </rdf:Description>
