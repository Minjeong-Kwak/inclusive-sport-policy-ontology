  <rdf:Description rdf:about="#outcome__taekwondo_basic_psychological_need_satisfaction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#well_being_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__taekwondo_basic_psychological_need_satisfaction</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">태권도 선수 기본심리욕구 만족</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taekwondo athlete basic psychological need satisfaction</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">태권도 선수가 자율성, 유능성, 관계성 욕구 충족을 경험하는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">태권도 선수들이 지각하는 자율성지지와 기본심리욕구, 자기조절동기 및 도핑의도의 관계</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">자율성지지가 자율성, 유능성, 관계성에 모두 정적 영향을 미침.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated_v68_added_from_uploaded_literature</isp:note>
    <rdfs:label xml:lang="en">Taekwondo athlete basic psychological need satisfaction</rdfs:label>
    <rdfs:comment xml:lang="ko">태권도 선수가 자율성, 유능성, 관계성 욕구 충족을 경험하는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Taekwondo athlete basic psychological need satisfaction</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">태권도 선수 기본심리욕구 만족</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__hrr_rpe_intensity_setting_protocol">
