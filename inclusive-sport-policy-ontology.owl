  <rdf:Description rdf:about="#participation_context__elementary_pe_expression_domain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#institutional_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__elementary_pe_expression_domain</isp:entity_id>
