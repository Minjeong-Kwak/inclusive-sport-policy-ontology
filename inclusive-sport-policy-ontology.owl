  <rdf:Description rdf:about="#program__swimming_coach_sport_ethics_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#leadership_instructor_program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">수영지도자 스포츠윤리교육</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sport ethics education for swimming coaches</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">수영지도자의 도핑, 폭력, 승부조작 예방을 위한 윤리교육 프로그램.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중국 엘리트 수영지도자의 윤리의식 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지도자들은 스포츠윤리교육의 필요성과 아동기부터의 윤리교육 필요를 제시함.</isp:evidence_excerpt>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">확실하게 문헌 내용에서 확인 가능한 요소만 제한 반영함.</isp:note>
    <isp:targets_target_group rdf:resource="#target_group__chinese_elite_swimming_coaches"/>
    <isp:produces_outcome rdf:resource="#outcome__swimming_coach_ethics_awareness"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__swimming_coach_sport_ethics_education</isp:entity_id>
    <rdfs:label xml:lang="en">Sport ethics education for swimming coaches</rdfs:label>
    <rdfs:comment xml:lang="ko">수영지도자의 도핑, 폭력, 승부조작 예방을 위한 윤리교육 프로그램.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Sport ethics education for swimming coaches</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">수영지도자 스포츠윤리교육</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__chinese_elite_swimming_coaches"/>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__chaperone_pool_stability_improvement">
