    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">보편적 학습설계(Universal Design for Learning) 기반 체육 수업 운영 구조 설계</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
