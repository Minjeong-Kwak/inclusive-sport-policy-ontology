  <rdf:Description rdf:about="#outcome__supplement_doping_consciousness_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">보충제 도핑의식 향상</isp:pref_label_ko>
