  <rdf:Description rdf:about="#support_resource__doping_control_officer_qualification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#human_resource"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑검사관 자격</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">doping control officer qualification</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WADA 검사국제표준과 KADA 절차에 따라 소변 시료 채취와 관련 서류를 담당하는 도핑검사 인력 자격.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">임상병리기술학 전공 유사 취업연계 자격 현황</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Korean Journal of Clinical Laboratory Science</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑검사관은 소변이나 혈액 시료 채취와 관련 서류 작성을 담당하는 공식 도핑 검사 요원으로 설명되었다.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__doping_control_officer_qualification</isp:entity_id>
    <rdfs:label xml:lang="en">doping control officer qualification</rdfs:label>
    <rdfs:comment xml:lang="ko">WADA 검사국제표준과 KADA 절차에 따라 소변 시료 채취와 관련 서류를 담당하는 도핑검사 인력 자격.</rdfs:comment>
    <skos:prefLabel xml:lang="en">doping control officer qualification</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">도핑검사관 자격</skos:prefLabel>
  </rdf:Description>
