  <rdf:Description rdf:about="#multicultural_policy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#policy_domain"/>
    <rdfs:label xml:lang="en">Multicultural Policy</rdfs:label>
    <rdfs:comment xml:lang="en">A policy domain class representing multicultural policy as it relates to sport participation.</rdfs:comment>
