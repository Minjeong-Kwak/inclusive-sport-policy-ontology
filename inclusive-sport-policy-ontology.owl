  <rdf:Description rdf:about="#program__student_athlete_character_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__student_athlete_character_education</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학생선수 인성교육 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">student-athlete character education program</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고등학교 야구선수의 인성과 자아존중감 및 스트레스의 구조적 관계 검증</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고등학교 야구선수 1,585명을 대상으로 인성, 자아존중감, 스트레스의 구조적 관계를 분석하고 인성교육 프로그램 필요성을 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:targets_target_group rdf:resource="#target_group__high_school_baseball_players"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__school_elite_baseball_training_context"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__student_athlete_character_questionnaire"/>
    <isp:produces_outcome rdf:resource="#outcome__student_athlete_self_esteem_reinforcement"/>
    <isp:produces_outcome rdf:resource="#outcome__student_athlete_stress_reduction"/>
    <rdfs:label xml:lang="en">student-athlete character education program</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing student-athlete character education program in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">student-athlete character education program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">학생선수 인성교육 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__high_school_baseball_players"/>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__covid19_social_distancing_pa_change_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#policy_exposure_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__covid19_social_distancing_pa_change_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COVID-19 사회적 거리두기 신체활동 변화 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COVID-19 social distancing physical activity change context</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Changes in physical activity and energy intake according to abdominal obesity in Korean adult men before and after COVID-19: Data from 2019 and 2020 Korea National Health and Nutrition Examination Survey (KNHANES)</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">사회적 거리두기 기간 중 외부활동 감소와 재택·온라인 수업 증가가 논의됨</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">감염병 대응 정책으로 인한 신체활동 변화 맥락이 직접 제시됨</isp:definition_text>
    <rdfs:label xml:lang="en">COVID-19 social distancing physical activity change context</rdfs:label>
    <rdfs:comment xml:lang="ko">감염병 대응 정책으로 인한 신체활동 변화 맥락이 직접 제시됨</rdfs:comment>
    <skos:prefLabel xml:lang="en">COVID-19 social distancing physical activity change context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">COVID-19 사회적 거리두기 신체활동 변화 맥락</skos:prefLabel>
  </rdf:Description>
