  <rdf:Description rdf:about="#support_resource__virtual_taekwondo_discourse_analysis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program_information"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">버추얼 태권도 담론 분석자료</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Virtual Taekwondo discourse analysis resource</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Google News와 Reddit 자료를 기반으로 버추얼 태권도 인식과 주요 담론을 파악하는 정보자원.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">버추얼 태권도의 발전가능성: 미디어 및 온라인 커뮤니티 담론에 대한 토픽모델링</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Google News와 Reddit 데이터를 수집하여 토픽모델링과 감성분석을 수행함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__virtual_taekwondo_discourse_analysis</isp:entity_id>
    <rdfs:label xml:lang="en">Virtual Taekwondo discourse analysis resource</rdfs:label>
    <rdfs:comment xml:lang="ko">Google News와 Reddit 자료를 기반으로 버추얼 태권도 인식과 주요 담론을 파악하는 정보자원.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Virtual Taekwondo discourse analysis resource</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">버추얼 태권도 담론 분석자료</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__scoliosis_exercise_intervention_comparison_evidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program_information"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__scoliosis_exercise_intervention_comparison_evidence</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">척추측만 운동중재 비교 근거 자료</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Comparative evidence for scoliosis exercise interventions</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">척추측만 아동·청소년에게 적용 가능한 운동중재 유형과 우선순위를 비교하는 근거 정보 자원</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Effects Of Different Exercise Interventions On Scoliosis In Children And Adolescents: A Reticulated Meta-Analysis</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022 3rd Asia Sport Science Conference Abstracts</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conference_abstract</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">109-110</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The conference abstract reviewed randomized controlled studies on exercise interventions for scoliosis in children and adolescents. Twenty-two studies with 1,110 samples were included, and Schroth training, functional training, and stability training showed significant effects compared with no exercise, with Schroth plus hippotherapy, Schroth, stability, and functional training ranked as leading approaches.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <rdfs:label xml:lang="en">Comparative evidence for scoliosis exercise interventions</rdfs:label>
    <rdfs:comment xml:lang="ko">척추측만 아동·청소년에게 적용 가능한 운동중재 유형과 우선순위를 비교하는 근거 정보 자원</rdfs:comment>
    <skos:prefLabel xml:lang="en">Comparative evidence for scoliosis exercise interventions</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">척추측만 운동중재 비교 근거 자료</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__health_promoting_behavior_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
