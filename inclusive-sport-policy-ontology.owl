    <isp:utilizes_support_resource rdf:resource="#support_resource__volunteer_functions_inventory_sport"/>
    <isp:produces_outcome rdf:resource="#outcome__sport_volunteer_recruitment_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__sport_volunteer_values_understanding_motivation"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__sport_volunteer_recruitment_by_motivation</isp:entity_id>
    <rdfs:label xml:lang="en">Motivation-based sport volunteer recruitment program</rdfs:label>
    <rdfs:comment xml:lang="ko">가치, 이해, 사회, 진로, 향상, 보호 동기를 고려하여 스포츠 자원봉사자를 모집하는 프로그램임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Motivation-based sport volunteer recruitment program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">동기 기반 스포츠 자원봉사자 모집 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__singapore_sport_volunteer_college_students"/>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__online_pe_feedback_task_structure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#information_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__online_pe_feedback_task_structure</isp:entity_id>
