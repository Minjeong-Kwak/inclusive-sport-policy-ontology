    <rdfs:comment xml:lang="en">Named individual representing protective equipment improvement resource for taekwondo in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">protective equipment improvement resource for taekwondo</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">태권도 보호장비 개선 자원</skos:prefLabel>
