  <rdf:Description rdf:about="#outcome__soccer_decision_time_reduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capability_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__soccer_decision_time_reduction</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">축구 의사결정 시간 감소</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reduction of soccer decision-making time</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">축구 경기 상황에서 의사결정에 소요되는 시간이 감소하는 능력 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지각기술훈련이 유소년 축구선수의 의사결정능력에 미치는 효과 검증</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지각기술훈련 집단은 사후검사에서 의사결정 시간이 감소하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">reduction of soccer decision-making time</rdfs:label>
    <rdfs:comment xml:lang="ko">축구 경기 상황에서 의사결정에 소요되는 시간이 감소하는 능력 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">reduction of soccer decision-making time</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">축구 의사결정 시간 감소</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__national_pa_guideline_adherence_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#policy_exposure_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__national_pa_guideline_adherence_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국가 신체활동 지침 준수 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">National physical activity guideline adherence context</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국가 수준 신체활동 지침에 대한 준수 여부가 건강성과와 연결되는 정책 노출 맥락</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Association between Meeting Physical Activity Guidelines and Mortality in Korean Adults: An 8-year Prospective Study</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition and Biochemistry</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/jenb.2016.0054</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">23-24</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This prospective study used the Korean Longitudinal Study of Ageing with 9,177 adults aged 45 years or older over an 8-year follow-up. Meeting physical activity guidelines was associated with decreased all-cause mortality risk in Korean adults.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">National physical activity guideline adherence context</rdfs:label>
    <rdfs:comment xml:lang="ko">국가 수준 신체활동 지침에 대한 준수 여부가 건강성과와 연결되는 정책 노출 맥락</rdfs:comment>
    <skos:prefLabel xml:lang="en">National physical activity guideline adherence context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">국가 신체활동 지침 준수 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__high_school_overweight_low_activity_students">
