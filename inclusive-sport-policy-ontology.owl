    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multicultural open attitude improvement</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bennett의 상호문화적 감수성 발달모델을 통한 초등 민속표현 제고 방안</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">우리나라 민속무용과 세계민속무용의 공통점과 차이점을 찾아 개방적 태도를 지닐 수 있다고 제시함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">상호문화적 민속표현 활동의 태도 변화 성과로 직접 제시됨</isp:definition_text>
    <isp:is_produced_by_program rdf:resource="#program__elementary_intercultural_folk_expression_program"/>
    <rdfs:label xml:lang="en">Multicultural open attitude improvement</rdfs:label>
    <rdfs:comment xml:lang="ko">상호문화적 민속표현 활동의 태도 변화 성과로 직접 제시됨</rdfs:comment>
    <skos:prefLabel xml:lang="en">Multicultural open attitude improvement</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">다문화적 개방 태도 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__college_athlete_professional_dual_role">
