    <isp:provides_delivery_context_for rdf:resource="#program__early_adaptation_program_for_immigrants"/>
    <isp:provides_delivery_context_for rdf:resource="#program__marriage_immigrant_settlement_support"/>
    <isp:provides_delivery_context_for rdf:resource="#program__multicultural_family_policy_support"/>
    <rdfs:label xml:lang="en">Rural farm and fishery labor-demand area</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Rural farm and fishery labor-demand area in the participation_context dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Rural farm and fishery labor-demand area</skos:prefLabel>
