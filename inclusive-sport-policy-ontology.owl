  <rdf:Description rdf:about="#support_resource__autonomy_supportive_taekwondo_coaching_for_morality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#support_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__autonomy_supportive_taekwondo_coaching_for_morality</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">태권도 자율적 코칭 기반 도덕행동 지도</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">autonomy-supportive Taekwondo coaching for moral behavior</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">태권도 선수의 친사회적 행동을 높이고 반사회적 행동을 낮추기 위한 자율성지지 기반 코칭 자원.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">코칭 방식이 태권도 선수들의 친사회적, 반사회적 행동에 미치는 영향: 도덕적 이탈의 다중매개효과 검증</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2016</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">자율적 코칭 방식이 팀 동료에 대한 친사회적 행동에 정적 영향을 미치는 것으로 제시됨.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated_v68_added_from_uploaded_literature</isp:note>
    <isp:supports_target_group rdf:resource="#target_group__middle_high_school_taekwondo_athletes"/>
    <isp:conditions_outcome rdf:resource="#outcome__taekwondo_prosocial_behavior_increase"/>
    <isp:conditions_outcome rdf:resource="#outcome__taekwondo_antisocial_behavior_reduction"/>
    <rdfs:label xml:lang="en">autonomy-supportive Taekwondo coaching for moral behavior</rdfs:label>
    <rdfs:comment xml:lang="ko">태권도 선수의 친사회적 행동을 높이고 반사회적 행동을 낮추기 위한 자율성지지 기반 코칭 자원.</rdfs:comment>
    <skos:prefLabel xml:lang="en">autonomy-supportive Taekwondo coaching for moral behavior</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">태권도 자율적 코칭 기반 도덕행동 지도</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__middle_high_school_taekwondo_athletes"/>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__professional_baseball_club_loyalty_increase_sns">
    <rdf:type rdf:resource="#participation_continuity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__professional_baseball_club_loyalty_increase_sns</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프로야구단 SNS 구단 충성도 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">club loyalty increase through professional baseball SNS</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프로야구단의 SNS특성이 인게이지먼트를 매개로 브랜드(구단) 태도와 구단 충성도에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">브랜드 인게이지먼트는 구단 충성도에 긍정적으로 유의한 영향을 미쳤다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:is_result_of_program rdf:resource="#program__professional_baseball_team_sns_engagement_strategy"/>
    <isp:reflects_target_group rdf:resource="#target_group__college_baseball_fans_sns_engagement"/>
    <rdfs:label xml:lang="en">club loyalty increase through professional baseball SNS</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing club loyalty increase through professional baseball SNS in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">club loyalty increase through professional baseball SNS</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">프로야구단 SNS 구단 충성도 향상</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__college_baseball_fans_sns_engagement"/>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__community_sport_hub_users">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#target_group"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지역 스포츠허브 이용자</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Community sport hub users</isp:pref_label_en>
