  <rdf:Description rdf:about="#outcome__abdominal_obesity_suppression_strength_training">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__abdominal_obesity_suppression_strength_training</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">근력운동 관련 복부비만 억제</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Abdominal obesity suppression associated with strength training</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Changes in physical activity and energy intake according to abdominal obesity in Korean adult men before and after COVID-19: Data from 2019 and 2020 Korea National Health and Nutrition Examination Survey (KNHANES)</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">근력운동은 2019년과 2020년 모두 복부비만 억제에 영향을 미침</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">근력운동이 복부비만 억제와 관련된 성과로 직접 보고됨</isp:definition_text>
    <rdfs:label xml:lang="en">Abdominal obesity suppression associated with strength training</rdfs:label>
    <rdfs:comment xml:lang="ko">근력운동이 복부비만 억제와 관련된 성과로 직접 보고됨</rdfs:comment>
    <skos:prefLabel xml:lang="en">Abdominal obesity suppression associated with strength training</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">근력운동 관련 복부비만 억제</skos:prefLabel>
  </rdf:Description>
