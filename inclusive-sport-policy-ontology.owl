  <rdf:Description rdf:about="#outcome__adolescent_interpersonal_relationship_improvement_martial_arts">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#social_relationship_expansion"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__adolescent_interpersonal_relationship_improvement_martial_arts</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">무술훈련 참여 청소년 대인관계 개선</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improved interpersonal relationship among adolescents in martial arts training</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">무술훈련 기간과 참여 수준에 따라 대인관계 관련 장애 요인이 낮게 나타난 사회관계 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Empirical Analysis on the Relation between Martial Arts Training and Adolescent Mental Health</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">31-43</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adolescents who participated in martial arts training showed significantly lower depression, anxiety, and hostility than non-participants; training for more than 1.5 hours per session and over 3 years was associated with better mental health indicators.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <isp:reflects_target_group rdf:resource="#target_group__adolescents_martial_arts_mental_health_support"/>
    <rdfs:label xml:lang="en">Improved interpersonal relationship among adolescents in martial arts training</rdfs:label>
    <rdfs:comment xml:lang="ko">무술훈련 기간과 참여 수준에 따라 대인관계 관련 장애 요인이 낮게 나타난 사회관계 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Improved interpersonal relationship among adolescents in martial arts training</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">무술훈련 참여 청소년 대인관계 개선</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__adolescents_martial_arts_mental_health_support"/>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__career_optimism_improvement_school_sport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#well_being_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__career_optimism_improvement_school_sport</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">진로 낙관성 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">improved career optimism through school sport</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학교스포츠클럽 대회 경험을 통해 진로에 대한 긍정적 전망이 높아지는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중학생의 학교스포츠클럽 대회 참여가 진로성숙도에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대회 참여 집단과 미참여 집단은 진로 낙관성에서 유의미한 차이를 보였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">improved career optimism through school sport</rdfs:label>
    <rdfs:comment xml:lang="ko">학교스포츠클럽 대회 경험을 통해 진로에 대한 긍정적 전망이 높아지는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">improved career optimism through school sport</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">진로 낙관성 향상</skos:prefLabel>
  </rdf:Description>
