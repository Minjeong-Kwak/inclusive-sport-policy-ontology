    <rdf:type rdf:resource="#program_information"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__disability_sport_value_issue_framework</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인스포츠 가치논제 분석틀</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Value issue framework for disability sport</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인스포츠의 주요 관점과 가치 논제에 대한 고찰</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2012</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인스포츠의 참여대상, 서비스 제공, 행정, 대중매체, 마케팅, 약물규제 논제를 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Added in v58 from uploaded academic literature; class assignment limited to directly evidenced entities.</isp:note>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <rdfs:label xml:lang="en">Value issue framework for disability sport</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Value issue framework for disability sport in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Value issue framework for disability sport</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">장애인스포츠 가치논제 분석틀</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__student_athlete_ethics_awareness_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__student_athlete_ethics_awareness_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학생선수 스포츠윤리 인식 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improved sport ethics awareness among student athletes</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동부 감독교사의 학생 선수 대상 스포츠윤리 교육에 관한 자문화기술지</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동부 감독교사가 학생선수에게 실시하는 스포츠윤리 교육의 형식성, 관심 부족, 체계적 프로그램 부족을 분석하고 효율적 윤리교육의 정책적 방향을 제시함.</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동부 감독교사가 학생선수에게 실시하는 스포츠윤리 교육의 형식성, 관심 부족, 체계적 프로그램 부족을 분석하고 효율적 윤리교육의 정책적 방향을 제시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <rdfs:label xml:lang="en">Improved sport ethics awareness among student athletes</rdfs:label>
    <rdfs:comment xml:lang="ko">운동부 감독교사가 학생선수에게 실시하는 스포츠윤리 교육의 형식성, 관심 부족, 체계적 프로그램 부족을 분석하고 효율적 윤리교육의 정책적 방향을 제시함.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Improved sport ethics awareness among student athletes</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">학생선수 스포츠윤리 인식 향상</skos:prefLabel>
  </rdf:Description>
