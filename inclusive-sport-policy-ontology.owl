    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__college_athlete_professional_dual_role</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대학생·직업선수 이중역할 맥락</isp:pref_label_ko>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학생인가 직업인인가: 여대생 프로골퍼의 대학에 대한 인식 탐색</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대학생과 직업선수라는 두 가지 역할을 동시에 수행하는 현상이 논의되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">College Athlete Professional Dual Role</isp:pref_label_en>
    <rdfs:label xml:lang="en">College Athlete Professional Dual Role</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing College Athlete Professional Dual Role in the participation_context dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
