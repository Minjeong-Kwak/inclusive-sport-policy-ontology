  <rdf:Description rdf:about="#program__transformational_leadership_pe_higher_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육계열 변혁적 리더십 기반 수업운영</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transformational leadership-based instruction in physical education higher education</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육계열 대학생들이 지각한 교수의 변혁적 리더십이 교수신뢰, 학습몰입 및 강의만족도 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">교수의 변혁적 리더십 하위요인이 교수신뢰, 학습몰입, 강의만족도에 정적 영향을 미쳤다.</isp:evidence_excerpt>
    <isp:targets_target_group rdf:resource="#target_group__sport_related_college_students"/>
    <isp:produces_outcome rdf:resource="#outcome__teaching_trust_improvement_pe_college"/>
    <isp:produces_outcome rdf:resource="#outcome__learning_flow_improvement_pe_college"/>
    <isp:produces_outcome rdf:resource="#outcome__lecture_satisfaction_improvement_pe_college"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__transformational_leadership_pe_higher_education</isp:entity_id>
    <rdfs:label xml:lang="en">transformational leadership-based instruction in physical education higher education</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing transformational leadership-based instruction in physical education higher education in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">transformational leadership-based instruction in physical education higher education</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">체육계열 변혁적 리더십 기반 수업운영</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__sport_related_college_students"/>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__para_sport_legal_accountability_guidance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#information_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__para_sport_legal_accountability_guidance</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">패러스포츠 법적 책임 가이드</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">legal accountability guidance for Para sport participation</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비장애 운동선수의 아시안 패러 게임 참가 행위에 대한 법률적 접근과 해석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">사기죄, 업무방해죄, 손해배상 청구 가능성을 검토함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">legal accountability guidance for Para sport participation</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing legal accountability guidance for Para sport participation in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">legal accountability guidance for Para sport participation</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">패러스포츠 법적 책임 가이드</skos:prefLabel>
