    <isp:produces_outcome rdf:resource="#outcome__elite_sport_human_centered_character_development"/>
    <isp:produces_outcome rdf:resource="#outcome__elite_sport_joy_beauty_experience_recovery"/>
    <isp:produces_outcome rdf:resource="#outcome__elite_sport_academic_rights_awareness"/>
    <rdfs:label xml:lang="en">Character and fair play practical education in elite sport</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Character and fair play practical education in elite sport in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Character and fair play practical education in elite sport</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">전문체육 인성·페어플레이 실천교육</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__college_athletes_covid_injury_experience">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#young_adult"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__college_athletes_covid_injury_experience</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COVID-19 상해 경험 대학운동선수</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">College athletes with injury experience during COVID-19</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Effects of Injury of College Athletes on Training Participation Motivation and Exercise Commitment in the COVID-19 Situation</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">전국 대학운동선수 266명을 대상으로 상해심리, 훈련참여동기, 운동몰입을 분석함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COVID-19 상황에서 상해경험과 훈련 참여 변화를 경험한 대학운동선수 집단임</isp:definition_text>
    <rdfs:label xml:lang="en">College athletes with injury experience during COVID-19</rdfs:label>
    <rdfs:comment xml:lang="ko">COVID-19 상황에서 상해경험과 훈련 참여 변화를 경험한 대학운동선수 집단임</rdfs:comment>
    <skos:prefLabel xml:lang="en">College athletes with injury experience during COVID-19</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">COVID-19 상해 경험 대학운동선수</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__horse_riding_education_participants">
