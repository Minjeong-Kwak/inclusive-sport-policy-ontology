    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Secondary PE teachers in occupational domain analysis</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">우리나라 체육교사의 직무영역 및 직무내용 분석</isp:source_title>
