  <rdf:Description rdf:about="#support_resource__equestrian_instructor_community_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#support_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__equestrian_instructor_community_learning</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">승마지도자 공동체 학습 자원</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equestrian instructor community learning resource</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">승마지도자의 자기주도 학습과 주변 지도자 공동체 형성을 지원하는 자원</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">승마지도자의 교수내용지식(PCK) 요소와 형성 과정 탐색</isp:source_title>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PCK 형성이 선수 시절 경험, 자기주도 학습, 주변 지도자와 공동체 형성을 통해 이루어진다고 제시함</isp:evidence_excerpt>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <rdfs:label xml:lang="en">Equestrian instructor community learning resource</rdfs:label>
    <rdfs:comment xml:lang="ko">승마지도자의 자기주도 학습과 주변 지도자 공동체 형성을 지원하는 자원</rdfs:comment>
    <skos:prefLabel xml:lang="en">Equestrian instructor community learning resource</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">승마지도자 공동체 학습 자원</skos:prefLabel>
  </rdf:Description>
