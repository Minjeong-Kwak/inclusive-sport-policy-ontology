    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">다문화가족 및 사회통합 정책 영역</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multicultural family and social integration policy domain</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">제4차 외국인정책 기본계획</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">법무부</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">government_policy_document</isp:source_type>
    <isp:source_section rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비전 및 정책목표</isp:source_section>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">제4차 기본계획은 국민과 이민자가 함께하는 사회통합과 이민자의 인권 가치를 존중하는 사회 실현을 정책목표로 제시한다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-18</isp:last_updated>
    <isp:implements_program rdf:resource="#program__social_integration_program_for_immigrants"/>
    <isp:implements_program rdf:resource="#program__early_adaptation_program_for_immigrants"/>
    <isp:implements_program rdf:resource="#program__marriage_immigrant_settlement_support"/>
    <isp:implements_program rdf:resource="#program__multicultural_family_policy_support"/>
    <rdfs:label xml:lang="en">Multicultural family and social integration policy domain</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Multicultural family and social integration policy domain in the policy dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Multicultural family and social integration policy domain</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">다문화가족 및 사회통합 정책 영역</skos:prefLabel>
  </rdf:Description>
