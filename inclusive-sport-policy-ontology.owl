    <skos:prefLabel xml:lang="en">Current Sports Ethics Education Sports Ethics Education Effectiveness Improvement</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__national_preschool_motor_assessment_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_institution"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__national_preschool_motor_assessment_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">전국 유아 운동능력 측정 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">national preschool motor assessment context</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유아 운동능력에 따른 군집유형: 연령과 BMI에 따른 비교분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">전국 유아를 대상으로 운동능력 측정자료를 분석한 맥락을 반영함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">national preschool motor assessment context</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing national preschool motor assessment context in the participation_context dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">national preschool motor assessment context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">전국 유아 운동능력 측정 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__diabetes_body_composition_profile_identification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__diabetes_body_composition_profile_identification</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">당뇨 관련 체성분 특성 식별</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Identification of diabetes-related body composition profile</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">제2형 당뇨와 관련된 체수분 분포 및 체성분 특성을 식별하는 정보 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Association between extracellular-to-intracellular water ratio and type 2 diabetes mellitus in Korean males aged 19-80 years: analysis of KNHANES 2022-2023</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/pan.2025.0017</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">77-78</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The study analyzed 2,281 Korean males aged 19-80 years from KNHANES 2022-2023 and identified an association between ECW/ICW ratio and T2DM prevalence independent of age, BMI, and muscle strength.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:outcome_indicator_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">body composition profile</isp:outcome_indicator_type>
    <rdfs:label xml:lang="en">Identification of diabetes-related body composition profile</rdfs:label>
    <rdfs:comment xml:lang="ko">제2형 당뇨와 관련된 체수분 분포 및 체성분 특성을 식별하는 정보 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Identification of diabetes-related body composition profile</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">당뇨 관련 체성분 특성 식별</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__autonomy_support_anti_doping_intervention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__autonomy_support_anti_doping_intervention</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">자율성 지원 반도핑 중재</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Autonomy-supportive anti-doping intervention</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동선수들이 지각하는 통제동기가 도핑 의도에 미치는 영향: 자율성의 조절효과 검증</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">통제동기가 도핑 의도에 영향을 미치며 자율성이 조절효과를 보인다고 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Added in v52 from uploaded academic literature; class assignment limited to directly evidenced entities.</isp:note>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:targets_target_group rdf:resource="#target_group__controlled_motivation_athletes"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__athlete_autonomy_support_guideline"/>
    <isp:produces_outcome rdf:resource="#outcome__controlled_motivation_doping_intention_reduction"/>
    <rdfs:label xml:lang="en">Autonomy-supportive anti-doping intervention</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Autonomy-supportive anti-doping intervention in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Autonomy-supportive anti-doping intervention</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">자율성 지원 반도핑 중재</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__controlled_motivation_athletes"/>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__professional_baseball_fans_national_team_perception">
    <rdf:type rdf:resource="#young_adult"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__professional_baseball_fans_national_team_perception</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">야구 국가대표 의미 인식 프로야구 팬</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">professional baseball fans perceiving national team meaning</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프로야구 팬의 사회공정성, 사회신뢰성, 국가정체성 인식이 야구 국가대표 의미에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021년 4월부터 7월까지 지역별 프로야구장 세 곳을 찾은 프로야구 팬을 대상으로 설문조사하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:is_targeted_by rdf:resource="#program__baseball_national_team_social_meaning_survey"/>
    <rdfs:label xml:lang="en">professional baseball fans perceiving national team meaning</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing professional baseball fans perceiving national team meaning in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">professional baseball fans perceiving national team meaning</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">야구 국가대표 의미 인식 프로야구 팬</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__herbal_medicine_doping_safety_testing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#information_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__herbal_medicine_doping_safety_testing</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한약 도핑안정성 검증자료</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">herbal medicine doping safety testing resource</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한약 시료의 WADA 금지약물 존재 여부를 검사하는 도핑 안전성 검증 자원</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">엘리트 선수들의 한약섭취 실태와 도핑안정성 검증</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2009</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">현역 엘리트 선수 228명을 조사하고 한약 시료 10개를 도핑콘트롤센터에서 분석한 결과, WADA 금지목록 9항목 210종 물질에서 음성 결과가 나타났다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">herbal medicine doping safety testing resource</rdfs:label>
    <rdfs:comment xml:lang="ko">한약 시료의 WADA 금지약물 존재 여부를 검사하는 도핑 안전성 검증 자원</rdfs:comment>
    <skos:prefLabel xml:lang="en">herbal medicine doping safety testing resource</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">한약 도핑안정성 검증자료</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__sports_dispute_speedy_resolution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#service_delivery_efficiency"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__sports_dispute_speedy_resolution</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 분쟁 신속해결</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sports dispute speedy resolution</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 경기 일정의 특성에 맞추어 분쟁을 신속하게 처리하는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 분쟁해결 -CAS 중재절차를 중심으로-</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국제거래법연구</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAS의 발전과정, 중재절차, 스포츠 분쟁해결의 신속성, 축구 고용분쟁, 징계분쟁, 승부조작 및 윤리분쟁, 한국 관련 사례와 CAS 관할권을 검토하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">sports dispute speedy resolution</rdfs:label>
    <rdfs:comment xml:lang="ko">스포츠 경기 일정의 특성에 맞추어 분쟁을 신속하게 처리하는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">sports dispute speedy resolution</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠 분쟁 신속해결</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__urban_elementary_free_living_pa_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_institution"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__urban_elementary_free_living_pa_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도시 초등학생 자유생활 신체활동 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Urban elementary free-living physical activity context</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도시 지역 초등학생이 학교와 일상생활 환경에서 수행하는 자유생활 신체활동 맥락</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Association between daily step counts and physical activity level among Korean elementary schoolchildren</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition and Biochemistry</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2016</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">51-55</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Children aged 9 to 12 years from two urban Korean elementary schools were measured for total energy expenditure with doubly labeled water and step counts with accelerometers. Steps per day were positively associated with physical activity level among all subjects and in boys, and the authors concluded that locomotor activity contributed to physical activity level differences among elementary school boys.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <rdfs:label xml:lang="en">Urban elementary free-living physical activity context</rdfs:label>
    <rdfs:comment xml:lang="ko">도시 지역 초등학생이 학교와 일상생활 환경에서 수행하는 자유생활 신체활동 맥락</rdfs:comment>
    <skos:prefLabel xml:lang="en">Urban elementary free-living physical activity context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">도시 초등학생 자유생활 신체활동 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__nuri_fundamental_movement_support_program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#child_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__nuri_fundamental_movement_support_program</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유아 기본움직임 지원 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preschool fundamental movement support program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">누리과정 활동 안에서 유아의 기본움직임기술 요소를 균형 있게 포함하고 연습하도록 지원하는 아동 대상 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019 개정 누리과정 놀이운영 사례집 내 기본움직임 요소 내용분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019 개정 누리과정의 현장 지원자료인 놀이 운영사례집 5권을 분석하여 만 3~5세 유아의 기본움직임기술 요소를 검토하였다. 분석 결과 안정성 움직임, 복합 이동성 움직임, 조작적 움직임 요소가 균형 있게 포함될 필요가 있으며, 유아 신체 기본움직임 프로그램 지원과 교사 연수 필요가 제시되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_content_analysis</isp:evidence_strength_level>
    <isp:targets_target_group rdf:resource="#target_group__preschool_children_nuri_fundamental_movement"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__nuri_fundamental_movement_play"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__nuri_early_childhood_play_context"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__nuri_play_operation_casebook"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__early_childhood_fundamental_movement_teacher_training"/>
    <isp:produces_outcome rdf:resource="#outcome__balanced_fundamental_movement_activity_inclusion"/>
    <rdfs:label xml:lang="en">Preschool fundamental movement support program</rdfs:label>
    <rdfs:comment xml:lang="ko">누리과정 활동 안에서 유아의 기본움직임기술 요소를 균형 있게 포함하고 연습하도록 지원하는 아동 대상 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Preschool fundamental movement support program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유아 기본움직임 지원 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__preschool_children_nuri_fundamental_movement"/>
  </rdf:Description>
