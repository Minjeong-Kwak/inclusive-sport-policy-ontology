  <rdf:Description rdf:about="#outcome__elderly_women_mobility_improvement_theraband">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#daily_life_functioning_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__elderly_women_mobility_improvement_theraband</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여성노인 이동성 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mobility improvement in elderly women</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">탄력밴드 운동 후 여성노인의 이동성과 신체기능이 개선되는 일상기능 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Associations Between Skeletal Muscle Mass, Grip Strength, and Physical and Cognitive Functions in Elderly Women: Effect of Exercise with Resistive Theraband</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition and Biochemistry</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/jenb.2019.0023</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">50-51</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twenty-eight elderly women participated; 15 underwent elastic band exercise for 1 hour per day, twice per week for 8 weeks. Theraband exercise significantly improved gait speed and physical function.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:outcome_indicator_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mobility</isp:outcome_indicator_type>
    <rdfs:label xml:lang="en">Mobility improvement in elderly women</rdfs:label>
    <rdfs:comment xml:lang="ko">탄력밴드 운동 후 여성노인의 이동성과 신체기능이 개선되는 일상기능 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Mobility improvement in elderly women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">여성노인 이동성 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__sport_career_interest_clarification">
