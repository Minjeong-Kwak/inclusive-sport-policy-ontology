  <rdf:Description rdf:about="#sport_activity__middle_school_soccer_class">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#middle_high_school_sport"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__middle_school_soccer_class</isp:entity_id>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Middle-school soccer class</isp:pref_label_en>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">generated_from_existing_instance_iri</isp:source_identifier>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Literal metadata was automatically added from the existing ontology structure; bibliographic source values were not inferred.</isp:note>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중학교 축구수업</isp:pref_label_ko>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">토요스포츠데이 맥락에서 운영된 중학교 축구 수업 활동</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">360도 어라운드 뷰와 슬로우 모션 테크놀로지를 활용한 피드백 제공이 중학생 축구 수업만족도에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">서울 시내 3개 중학교의 토요스포츠데이 축구수업을 수강하는 2학년 남학생 90명을 대상으로 360° Around View 영상 피드백, 모바일 Slow Motion 영상 피드백, 구두 피드백 집단을 비교하였고, 교육적·신체적·심리적 수업 만족도에서 360° Around View 영상 피드백 집단의 만족도가 가장 높게 나타났다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:has_activity_outcome rdf:resource="#outcome__educational_satisfaction_improvement_around_view_feedback"/>
    <isp:has_activity_outcome rdf:resource="#outcome__physical_satisfaction_improvement_around_view_feedback"/>
    <isp:has_activity_outcome rdf:resource="#outcome__psychological_satisfaction_improvement_around_view_feedback"/>
    <rdfs:label xml:lang="en">Middle-school soccer class</rdfs:label>
    <rdfs:comment xml:lang="ko">토요스포츠데이 맥락에서 운영된 중학교 축구 수업 활동</rdfs:comment>
    <skos:prefLabel xml:lang="en">Middle-school soccer class</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">중학교 축구수업</skos:prefLabel>
  </rdf:Description>
