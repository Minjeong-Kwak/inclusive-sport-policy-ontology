    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-15</isp:last_updated>
    <rdfs:label xml:lang="en">Reduced metabolic syndrome risk among male adolescents</rdfs:label>
    <rdfs:comment xml:lang="ko">상대악력과 신체활동 증가를 통해 대사증후군 발생 위험을 낮추는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Reduced metabolic syndrome risk among male adolescents</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">남자 청소년 대사증후군 위험 감소</skos:prefLabel>
  </rdf:Description>
