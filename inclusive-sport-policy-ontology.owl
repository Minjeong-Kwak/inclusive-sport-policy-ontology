    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#quality_of_life_outcome"/>
    <rdfs:label xml:lang="en">Daily Life Functioning Improvement</rdfs:label>
