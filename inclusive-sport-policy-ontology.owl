  <rdf:Description rdf:about="#outcome__balanced_diet_and_pa_awareness_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__balanced_diet_and_pa_awareness_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">균형식습관·신체활동 인식 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">improved awareness of balanced diet and physical activity</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">청소년이 신체활동과 균형 잡힌 식습관의 중요성을 이해하는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중학생의 스마트폰 의존성이 건강 관련 요인, 신체활동 및 식습관에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스마트폰 사용이 많은 청소년에게 신체활동과 균형 잡힌 식습관 형성을 교육할 필요가 제시되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">improved awareness of balanced diet and physical activity</rdfs:label>
    <rdfs:comment xml:lang="ko">청소년이 신체활동과 균형 잡힌 식습관의 중요성을 이해하는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">improved awareness of balanced diet and physical activity</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">균형식습관·신체활동 인식 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__university_team_social_exclusion_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#institutional_context"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대학운동팀 사회적 배제 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">University team social exclusion context</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대학운동팀 내 무시·거절 경험이 발생할 수 있는 제도적·관계적 맥락.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대학운동선수의 사회적 배제경험이 은퇴불안 및 포기의도에 미치는 영향</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">무시경험과 거절경험이 은퇴불안과 포기의도에 영향을 미친다고 보고함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__university_team_social_exclusion_context</isp:entity_id>
    <rdfs:label xml:lang="en">University team social exclusion context</rdfs:label>
    <rdfs:comment xml:lang="ko">대학운동팀 내 무시·거절 경험이 발생할 수 있는 제도적·관계적 맥락.</rdfs:comment>
    <skos:prefLabel xml:lang="en">University team social exclusion context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">대학운동팀 사회적 배제 맥락</skos:prefLabel>
  </rdf:Description>
