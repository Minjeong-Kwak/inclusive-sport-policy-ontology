    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__former_student_athlete_learning_transfer_support</isp:entity_id>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Former Student Athlete Learning Transfer Support</isp:pref_label_en>
