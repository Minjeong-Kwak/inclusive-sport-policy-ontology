  <rdf:Description rdf:about="#outcome__health_related_factor_monitoring_by_pa_level">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#policy_effectiveness_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__health_related_factor_monitoring_by_pa_level</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체활동 수준별 건강요인 모니터링</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Health-related factor monitoring by physical activity level</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체활동 수준에 따른 비만, 혈당, 혈중지질, 혈압 등 건강 관련 요인의 정책 감시 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Association of daily physical activity level with health-related factors by gender and age-specific differences among Korean adults based on the sixth (2014-2015) Korea National Health and Nutrition Examination Survey</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition and Biochemistry</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/jenb.2017.0026</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">30-31</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using KNHANES VI data from 6,457 Korean adults aged 19-64 years, the study examined associations between daily physical activity level and health-related factors by gender and age.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:outcome_indicator_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">health surveillance</isp:outcome_indicator_type>
    <rdfs:label xml:lang="en">Health-related factor monitoring by physical activity level</rdfs:label>
    <rdfs:comment xml:lang="ko">신체활동 수준에 따른 비만, 혈당, 혈중지질, 혈압 등 건강 관련 요인의 정책 감시 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Health-related factor monitoring by physical activity level</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">신체활동 수준별 건강요인 모니터링</skos:prefLabel>
  </rdf:Description>
