  <rdf:Description rdf:about="#target_group__older_women_circuit_exercise_participants">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#elderly"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__older_women_circuit_exercise_participants</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">순환운동 참여 고령 여성</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">older women participating in circuit exercise</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고령 여성의 순환운동빈도에 따른 Estradiol, Cortisol 및 체력 수준에 미치는 효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">65세 이상 고령 여성에게 12주간 순환운동을 적용하고 운동빈도에 따른 estradiol, cortisol, 체력 변화를 분석하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">older women participating in circuit exercise</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing older women participating in circuit exercise in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
