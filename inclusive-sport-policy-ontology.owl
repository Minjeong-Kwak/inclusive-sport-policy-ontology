    <isp:utilizes_support_resource rdf:resource="#support_resource__nutrition_supplement_risk_information"/>
    <isp:produces_outcome rdf:resource="#outcome__judo_athlete_doping_awareness_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__unintentional_doping_risk_reduction"/>
    <rdfs:label xml:lang="en">anti-doping and sports nutrition education for high school judo athletes</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing anti-doping and sports nutrition education for high school judo athletes in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">anti-doping and sports nutrition education for high school judo athletes</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">고등학교 유도선수 반도핑·운동영양 교육</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__high_school_judo_athletes"/>
  </rdf:Description>
