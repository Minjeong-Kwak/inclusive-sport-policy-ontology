  <rdf:Description rdf:about="#program__mci_bdnf_cognitive_exercise_intervention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#elderly_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__mci_bdnf_cognitive_exercise_intervention</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">경도인지장애 BDNF 기반 운동중재 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BDNF-informed exercise intervention for older adults with MCI</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동 중재가 경도인지장애 노인의 뇌 유래 신경영양인자와 인지기능에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">경도인지장애 노인을 대상으로 한 운동 중재가 BDNF 발현과 인지기능 개선에 기여하며, 중·고강도 유산소운동과 유산소·저항성 복합운동, 인지중재 병행의 효과를 제시함.</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">경도인지장애 노인을 대상으로 한 운동 중재가 BDNF 발현과 인지기능 개선에 기여하며, 중·고강도 유산소운동과 유산소·저항성 복합운동, 인지중재 병행의 효과를 제시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:targets_target_group rdf:resource="#target_group__mci_older_adults_bdnf_exercise"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__mci_aerobic_resistance_combined_exercise"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__mci_bdnf_exercise_prescription_evidence"/>
    <isp:produces_outcome rdf:resource="#outcome__mci_bdnf_expression_support"/>
    <isp:produces_outcome rdf:resource="#outcome__mci_cognitive_function_improvement"/>
    <rdfs:label xml:lang="en">BDNF-informed exercise intervention for older adults with MCI</rdfs:label>
    <rdfs:comment xml:lang="ko">경도인지장애 노인을 대상으로 한 운동 중재가 BDNF 발현과 인지기능 개선에 기여하며, 중·고강도 유산소운동과 유산소·저항성 복합운동, 인지중재 병행의 효과를 제시함.</rdfs:comment>
    <skos:prefLabel xml:lang="en">BDNF-informed exercise intervention for older adults with MCI</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">경도인지장애 BDNF 기반 운동중재 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__mci_older_adults_bdnf_exercise"/>
  </rdf:Description>
  <rdf:Description rdf:about="#local_sport_facility_planning_guideline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#guideline_manual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">local_sport_facility_planning_guideline</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">생활체육시설 규모·적정성 계획 지침</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guideline for community sport facility size and adequacy planning</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육활동 활성화를 위한 생활체육시설 규모 및 적정성에 관한 연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">생활체육 활성화를 위해 시설 분포와 규모의 적정성 검토가 필요함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated_v66_added_from_uploaded_literature</isp:note>
    <isp:is_enabled_by_resource rdf:resource="#uiwang_living_sport_facility_adequacy_assessment"/>
    <rdfs:label xml:lang="en">Guideline for community sport facility size and adequacy planning</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Guideline for community sport facility size and adequacy planning in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Guideline for community sport facility size and adequacy planning</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">생활체육시설 규모·적정성 계획 지침</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__elderly_women_gait_speed_improvement_theraband">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#functional_ability_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__elderly_women_gait_speed_improvement_theraband</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여성노인 보행속도 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gait speed improvement in elderly women</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">탄력밴드 운동 후 여성노인의 보행속도 향상으로 나타난 기능 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Associations Between Skeletal Muscle Mass, Grip Strength, and Physical and Cognitive Functions in Elderly Women: Effect of Exercise with Resistive Theraband</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition and Biochemistry</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/jenb.2019.0023</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">50-51</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twenty-eight elderly women participated; 15 underwent elastic band exercise for 1 hour per day, twice per week for 8 weeks. Theraband exercise significantly improved gait speed and physical function.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:outcome_indicator_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gait speed</isp:outcome_indicator_type>
    <rdfs:label xml:lang="en">Gait speed improvement in elderly women</rdfs:label>
    <rdfs:comment xml:lang="ko">탄력밴드 운동 후 여성노인의 보행속도 향상으로 나타난 기능 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Gait speed improvement in elderly women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">여성노인 보행속도 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__foreign_service_workers_employment_permit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#foreign_service_worker"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__foreign_service_workers_employment_permit</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">서비스업 외국인근로자</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Foreign service-sector workers</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">제4차 외국인정책 기본계획</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">법무부</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">government_policy_document</isp:source_type>
    <isp:source_section rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고용허가제 외국인근로자 업종별 도입 현황</isp:source_section>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고용허가제 외국인근로자 도입 현황은 제조업, 건설업, 농축산업, 서비스업, 어업으로 구분하여 제시된다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-18</isp:last_updated>
    <rdfs:label xml:lang="en">Foreign service-sector workers</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Foreign service-sector workers in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Foreign service-sector workers</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">서비스업 외국인근로자</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__knhanes_physical_activity_health_surveillance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program_information"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__knhanes_physical_activity_health_surveillance</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국민건강영양조사 기반 신체활동·건강 감시 자료</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KNHANES-based physical activity and health surveillance data</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국 성인의 신체활동 수준과 건강 관련 요인을 연령·성별로 분석할 수 있는 국가 조사 기반 정보 자원</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Association of daily physical activity level with health-related factors by gender and age-specific differences among Korean adults based on the sixth (2014-2015) Korea National Health and Nutrition Examination Survey</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition and Biochemistry</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/jenb.2017.0026</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">30-31</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using KNHANES VI data from 6,457 Korean adults aged 19-64 years, the study examined associations between daily physical activity level and health-related factors by gender and age.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:sample_size rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6457</isp:sample_size>
    <isp:provides_resource rdf:resource="#participation_context__adult_daily_pa_health_monitoring_context"/>
    <rdfs:label xml:lang="en">KNHANES-based physical activity and health surveillance data</rdfs:label>
    <rdfs:comment xml:lang="ko">한국 성인의 신체활동 수준과 건강 관련 요인을 연령·성별로 분석할 수 있는 국가 조사 기반 정보 자원</rdfs:comment>
    <skos:prefLabel xml:lang="en">KNHANES-based physical activity and health surveillance data</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">국민건강영양조사 기반 신체활동·건강 감시 자료</skos:prefLabel>
  </rdf:Description>
