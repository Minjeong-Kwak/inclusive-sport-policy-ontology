  <rdf:Description rdf:about="#program__elderly_sport_instructor_professional_development">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__elderly_sport_instructor_professional_development</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">노인스포츠지도자 전문성 강화 프로그램</isp:pref_label_ko>
