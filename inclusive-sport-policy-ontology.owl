  <rdf:Description rdf:about="#support_resource__sport_career_interest_scale_v2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#guideline_manual"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">일반학생용 체육진로흥미검사지 v2</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sport Career Interest Scale version 2</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">일반학생의 체육 분야 직업 흥미를 관계형, 탐구형, 창조형, 전략형, 관리형, 예능형으로 측정하는 진로상담 도구.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">일반학생용 체육진로흥미검사지 version2 개발 및 타당도 검증</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">최종 개발된 검사지는 6개 유형 72개 문항으로 구성되었다.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__sport_career_interest_scale_v2</isp:entity_id>
    <rdfs:label xml:lang="en">Sport Career Interest Scale version 2</rdfs:label>
