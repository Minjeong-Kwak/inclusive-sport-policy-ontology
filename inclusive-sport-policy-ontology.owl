  <rdf:Description rdf:about="#support_resource__artificial_neural_network_fitness_algorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#digital_device"/>
