  <rdf:Description rdf:about="#target_group__elderly_with_disabilities_remote_exercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#disabled_person"/>
    <rdf:type rdf:resource="#elderly"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__elderly_with_disabilities_remote_exercise</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">원격운동 참여 장애노인</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elderly persons with disabilities in telecommunication exercise</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주 원격운동 프로그램 참여 대상으로 설정된 장애노인 집단</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간 원격운동 프로그램이 장애노인의 삶의 질에 미치는 효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애노인 25명을 대상으로 원격운동 프로그램 참여군 12명과 비참여군 13명을 구분하고, 참여군은 12주간 주 2회 비대면 운동재활 프로그램에 참여하였다. 신체건강의 피로와 통증, 정신건강의 불안과 우울, 사회건강의 사회생활 변인에서 긍정적 효과가 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:applies_to_age_range rdf:datatype="http://www.w3.org/2001/XMLSchema#string">65세 이상 노인</isp:applies_to_age_range>
    <isp:applies_to_disability_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disability</isp:applies_to_disability_type>
    <isp:target_participant_size rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25</isp:target_participant_size>
    <rdfs:label xml:lang="en">Elderly persons with disabilities in telecommunication exercise</rdfs:label>
    <rdfs:comment xml:lang="ko">12주 원격운동 프로그램 참여 대상으로 설정된 장애노인 집단</rdfs:comment>
    <skos:prefLabel xml:lang="en">Elderly persons with disabilities in telecommunication exercise</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">원격운동 참여 장애노인</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__para_baseball_adaptation_support_program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#disabled_person_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__para_baseball_adaptation_support_program</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중도지체장애인 야구 적응지원 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adaptation support program through para baseball</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중도지체장애인이 야구팀 활동을 통해 장애 수용과 사회적 적응을 경험하도록 지원하는 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중도지체장애인 야구선수의 적응과정 및 경험 탐색</isp:source_title>
