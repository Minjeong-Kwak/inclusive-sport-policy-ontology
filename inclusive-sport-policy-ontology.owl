  <rdf:Description rdf:about="#outcome__all_cause_mortality_risk_reduction_pa_guideline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__all_cause_mortality_risk_reduction_pa_guideline</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체활동 지침 준수 관련 전체 사망위험 감소</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">All-cause mortality risk reduction associated with PA guideline adherence</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체활동 지침을 충족한 성인에서 전체 사망위험 감소와 관련된 건강 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Association between Meeting Physical Activity Guidelines and Mortality in Korean Adults: An 8-year Prospective Study</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition and Biochemistry</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/jenb.2016.0054</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">23-24</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This prospective study used the Korean Longitudinal Study of Ageing with 9,177 adults aged 45 years or older over an 8-year follow-up. Meeting physical activity guidelines was associated with decreased all-cause mortality risk in Korean adults.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:outcome_indicator_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mortality risk</isp:outcome_indicator_type>
    <rdfs:label xml:lang="en">All-cause mortality risk reduction associated with PA guideline adherence</rdfs:label>
    <rdfs:comment xml:lang="ko">신체활동 지침을 충족한 성인에서 전체 사망위험 감소와 관련된 건강 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">All-cause mortality risk reduction associated with PA guideline adherence</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">신체활동 지침 준수 관련 전체 사망위험 감소</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__taekwondo_judgment_reliability_improvement">
