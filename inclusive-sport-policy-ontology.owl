    <isp:is_target_group_supported_by_resource rdf:resource="#support_resource__multilingual_information_for_long_stay_immigrants"/>
    <rdfs:label xml:lang="en">Immigrants aspiring to continue residence</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Immigrants aspiring to continue residence in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Immigrants aspiring to continue residence</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">계속체류 희망 이민자</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__elderly_women_bone_health_risk_identification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_literacy_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__elderly_women_bone_health_risk_identification</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여성노인 골건강 위험 식별</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bone health risk identification in elderly women</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Characteristics of nutrient intakes, basal physical fitness and serum markers in elderly women with osteopenia</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition &amp; Biochemistry</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">골감소증 여성노인에서 제지방량, 에너지 섭취, 혈청 인과 BMD의 관련성을 제시함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여성노인의 골감소증 위험과 관련 요인을 식별하는 성과임</isp:definition_text>
    <rdfs:label xml:lang="en">Bone health risk identification in elderly women</rdfs:label>
    <rdfs:comment xml:lang="ko">여성노인의 골감소증 위험과 관련 요인을 식별하는 성과임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Bone health risk identification in elderly women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">여성노인 골건강 위험 식별</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__older_women_estradiol_increase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#health_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__older_women_estradiol_increase</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고령 여성 에스트라디올 증가</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">estradiol increase in older women</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고령 여성의 순환운동빈도에 따른 Estradiol, Cortisol 및 체력 수준에 미치는 효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">65세 이상 고령 여성에게 12주간 순환운동을 적용하고 운동빈도에 따른 estradiol, cortisol, 체력 변화를 분석하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">estradiol increase in older women</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing estradiol increase in older women in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">estradiol increase in older women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">고령 여성 에스트라디올 증가</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__hamstring_quadriceps_strength_ratio_assessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#information_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__hamstring_quadriceps_strength_ratio_assessment</isp:entity_id>
