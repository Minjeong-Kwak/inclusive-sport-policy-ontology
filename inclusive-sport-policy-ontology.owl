    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">보편적 학습설계 기반 수업을 온전한 통합체육 실행방안으로 제시함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:targets_target_group rdf:resource="#target_group__inclusive_pe_students_with_disabilities"/>
    <isp:targets_target_group rdf:resource="#target_group__inclusive_pe_non_disabled_peers"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__udl_adapted_physical_activity"/>
