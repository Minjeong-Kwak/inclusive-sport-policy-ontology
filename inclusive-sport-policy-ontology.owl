    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sports marketing data-driven decision support</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 광고 및 후원 의사결정을 데이터 기반으로 지원하는 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠중계 브랜드 광고 노출효과 분석 시스템 개발: 인공지능 기반 OCR 기술적용</isp:source_title>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대규모 스포츠중계 데이터를 처리하여 스포츠산업 및 광고시장의 데이터 기반 의사결정을 지원한다고 제시함</isp:evidence_excerpt>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <rdfs:label xml:lang="en">Sports marketing data-driven decision support</rdfs:label>
    <rdfs:comment xml:lang="ko">스포츠 광고 및 후원 의사결정을 데이터 기반으로 지원하는 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Sports marketing data-driven decision support</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠마케팅 데이터 기반 의사결정 지원</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__multicultural_open_attitude_improvement">
