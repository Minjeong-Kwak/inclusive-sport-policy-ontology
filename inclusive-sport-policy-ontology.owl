  <rdf:Description rdf:about="#support_resource__taekwondo_autonomy_support_coaching_for_anti_doping">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#support_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__taekwondo_autonomy_support_coaching_for_anti_doping</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">태권도 반도핑 자율성지지 코칭</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taekwondo autonomy-support coaching for anti-doping</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">태권도 선수의 자율성, 유능성, 관계성 욕구를 충족시켜 도핑 의도를 낮추는 코칭 자원.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">태권도 선수들이 지각하는 자율성지지와 기본심리욕구, 자기조절동기 및 도핑의도의 관계</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지도자의 자율성지지가 기본심리욕구와 자기조절동기를 통해 도핑 의도 감소와 관련됨.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated_v68_added_from_uploaded_literature</isp:note>
    <isp:supports_target_group rdf:resource="#target_group__university_and_pro_taekwondo_athletes"/>
    <isp:conditions_outcome rdf:resource="#outcome__taekwondo_basic_psychological_need_satisfaction"/>
    <isp:conditions_outcome rdf:resource="#outcome__taekwondo_doping_intention_reduction"/>
    <rdfs:label xml:lang="en">Taekwondo autonomy-support coaching for anti-doping</rdfs:label>
    <rdfs:comment xml:lang="ko">태권도 선수의 자율성, 유능성, 관계성 욕구를 충족시켜 도핑 의도를 낮추는 코칭 자원.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Taekwondo autonomy-support coaching for anti-doping</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">태권도 반도핑 자율성지지 코칭</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__university_and_pro_taekwondo_athletes"/>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__adapted_physical_activity_ethics_theory_framework">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#ethical_guideline"/>
    <rdf:type rdf:resource="#support_resource"/>
