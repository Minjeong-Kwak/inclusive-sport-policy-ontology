    <rdfs:comment xml:lang="en">Named individual representing Physical activity participation system for health maintenance in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Physical activity participation system for health maintenance</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">건강유지 신체활동 참여체계</skos:prefLabel>
