  <rdf:Description rdf:about="#participation_context__guillain_barre_robotic_interval_training_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__guillain_barre_robotic_interval_training_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">길랭-바레 증후군 로봇 인터벌 보행훈련 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Robotic interval gait training context for Guillain-Barre syndrome</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Changes in body composition, physical fitness and quality of life on robotic gait assisted training in patients with Guillain-Barré Syndrome: a case report</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4주간 주 3회, 목표 심박예비율 70–85% 강도로 훈련함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">주 3회 4주간 심박예비율 기반 강도 설정이 제시된 시설 기반 훈련 맥락임</isp:definition_text>
    <rdfs:label xml:lang="en">Robotic interval gait training context for Guillain-Barre syndrome</rdfs:label>
    <rdfs:comment xml:lang="ko">주 3회 4주간 심박예비율 기반 강도 설정이 제시된 시설 기반 훈련 맥락임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Robotic interval gait training context for Guillain-Barre syndrome</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">길랭-바레 증후군 로봇 인터벌 보행훈련 맥락</skos:prefLabel>
  </rdf:Description>
