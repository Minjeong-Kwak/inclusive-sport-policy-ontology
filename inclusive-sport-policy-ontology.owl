  <rdf:Description rdf:about="#sport_activity__resistance_training_obesity_management">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#fitness_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__resistance_training_obesity_management</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만관리 저항성 운동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Resistance training for obesity management</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저항성 운동 트레이닝이 20대 비만 남성의 신체구성, 아디포넥틴, C-반응성 단백질 및 호모시스테인에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저항성 운동 트레이닝은 20대 비만 남성의 신체구성에 긍정적 영향을 미쳤다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <rdfs:label xml:lang="en">Resistance training for obesity management</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Resistance training for obesity management in the sport_activity dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Resistance training for obesity management</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">비만관리 저항성 운동</skos:prefLabel>
  </rdf:Description>
