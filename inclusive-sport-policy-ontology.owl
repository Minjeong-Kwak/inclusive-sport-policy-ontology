    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__online_antidoping_learning_platform</isp:entity_id>
