  <rdf:Description rdf:about="#outcome__teaching_trust_improvement_pe_college">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_outcome"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육계열 교수신뢰 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">improvement of teaching trust in PE college classes</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육계열 대학생들이 지각한 교수의 변혁적 리더십이 교수신뢰, 학습몰입 및 강의만족도 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">변혁적 리더십의 모든 하위요인이 교수신뢰에 정적인 영향을 미쳤다.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__teaching_trust_improvement_pe_college</isp:entity_id>
    <rdfs:label xml:lang="en">improvement of teaching trust in PE college classes</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing improvement of teaching trust in PE college classes in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">improvement of teaching trust in PE college classes</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">체육계열 교수신뢰 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#sport_activity__preschool_complex_exercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#fitness_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__preschool_complex_exercise</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유아 복합운동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Complex exercise for preschool children</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유아의 기초체력과 운동기능 향상을 위해 구성된 복합운동 활동</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간 복합운동 프로그램이 유아의 기초체력에 미치는 효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2008</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Exercise Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유아 230명을 대상으로 실험집단과 통제집단으로 구분하여 12주간 복합운동 프로그램을 적용하였다. 사전·사후 측정 결과, 근지구력, 유연성, 순발력, 민첩성, 평형성 등 기초체력과 운동기능에서 긍정적 향상이 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:has_activity_outcome rdf:resource="#outcome__preschool_children_basic_fitness_improvement"/>
    <isp:has_activity_outcome rdf:resource="#outcome__preschool_children_functional_skill_improvement"/>
    <rdfs:label xml:lang="en">Complex exercise for preschool children</rdfs:label>
    <rdfs:comment xml:lang="ko">유아의 기초체력과 운동기능 향상을 위해 구성된 복합운동 활동</rdfs:comment>
    <skos:prefLabel xml:lang="en">Complex exercise for preschool children</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유아 복합운동</skos:prefLabel>
  </rdf:Description>
