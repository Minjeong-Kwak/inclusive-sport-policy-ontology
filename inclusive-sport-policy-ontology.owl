  <rdf:Description rdf:about="#support_resource__automatic_immigration_screening_service">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#transport_access_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__automatic_immigration_screening_service</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">자동출입국심사 서비스</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Automated immigration screening service</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">제4차 외국인정책 기본계획</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">법무부</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">government_policy_document</isp:source_type>
    <isp:source_section rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국경관리 강화 및 출입국심사 편의 증진</isp:source_section>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">자동출입국심사제도 도입으로 대한민국을 방문하는 승객의 출입국 편의를 제공한다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-18</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육시설 이동지원이 아니라 이민정책의 출입국 접근성 자원으로 매핑하였다.</isp:note>
    <isp:supports_target_group rdf:resource="#target_group__immigrants_fourth_master_plan"/>
    <rdfs:label xml:lang="en">Automated immigration screening service</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Automated immigration screening service in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Automated immigration screening service</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">자동출입국심사 서비스</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__immigrants_fourth_master_plan"/>
  </rdf:Description>
  <rdf:Description rdf:about="#sport_activity__figure_skating_long_term_development">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#elite_pathway_sport"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__figure_skating_long_term_development</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">피겨스케이팅 장기선수발달</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">figure skating long-term athlete development</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">피겨스케이팅 선수의 단계별 훈련 목표와 개인 발달을 함께 고려하는 엘리트 경로 스포츠활동.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스케이트 캐나다의 Long Term Development 모델 고찰을 통한 국내 피겨스케이팅 장기 선수 발달 프로그램 운영방안</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Skate Canada LTD 모델을 참고하여 한국형 LTD 모델이 제안됨.</isp:evidence_excerpt>
    <rdfs:label xml:lang="en">figure skating long-term athlete development</rdfs:label>
    <rdfs:comment xml:lang="ko">피겨스케이팅 선수의 단계별 훈련 목표와 개인 발달을 함께 고려하는 엘리트 경로 스포츠활동.</rdfs:comment>
    <skos:prefLabel xml:lang="en">figure skating long-term athlete development</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">피겨스케이팅 장기선수발달</skos:prefLabel>
  </rdf:Description>
