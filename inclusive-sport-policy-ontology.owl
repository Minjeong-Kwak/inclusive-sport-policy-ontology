  <rdf:Description rdf:about="#support_resource__emotional_intelligence_coaching_resource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#information_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__emotional_intelligence_coaching_resource</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">정서지능 기반 코칭 자료</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Emotional-intelligence-based coaching resource</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Emotional intelligence and autonomy-supportive interpersonal style in coaching: Review of literature</isp:source_title>
