    <isp:produces_outcome rdf:resource="#outcome__cp_child_gait_speed_improvement_vr"/>
    <isp:produces_outcome rdf:resource="#outcome__cp_child_cadence_improvement_vr"/>
    <isp:produces_outcome rdf:resource="#outcome__cp_child_stride_length_improvement_vr"/>
    <isp:produces_outcome rdf:resource="#outcome__cp_child_gmfm_e_improvement_vr"/>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Original session_frequency_per_week value removed during datatype normalization: 2-5</isp:note>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Original program_duration_weeks value removed during datatype normalization: 2-8</isp:note>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Original session_duration_minutes value removed during datatype normalization: 20-40</isp:note>
