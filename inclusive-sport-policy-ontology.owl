  <rdf:Description rdf:about="#outcome__early_childhood_pa_guideline_standardization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#policy_effectiveness_improvement"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유아 신체활동 지침 표준화</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">standardization of early-childhood PA guidelines</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국내·외 유아 신체활동 가이드라인 비교 분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">기준이 통일되어 있지 않아 국내 가이드라인 개발이 필요하다고 제시함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__early_childhood_pa_guideline_standardization</isp:entity_id>
    <rdfs:label xml:lang="en">standardization of early-childhood PA guidelines</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing standardization of early-childhood PA guidelines in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">standardization of early-childhood PA guidelines</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유아 신체활동 지침 표준화</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#policy_instrument__nuri_play_operation_guideline_standard">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#guideline_standard"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy_instrument__nuri_play_operation_guideline_standard</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">누리과정 놀이운영 사례집 기준</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nuri play operation casebook guideline standard</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유아 놀이 운영 사례와 기본움직임기술 활동 분석의 기준이 되는 현장 지원자료</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019 개정 누리과정 놀이운영 사례집 내 기본움직임 요소 내용분석</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019 개정 누리과정의 현장 지원자료인 놀이 운영사례집 5권을 분석하여 만 3~5세 유아의 기본움직임기술 요소를 검토하였다. 분석 결과 안정성 움직임, 복합 이동성 움직임, 조작적 움직임 요소가 균형 있게 포함될 필요가 있으며, 유아 신체 기본움직임 프로그램 지원과 교사 연수 필요가 제시되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_content_analysis</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">Nuri play operation casebook guideline standard</rdfs:label>
    <rdfs:comment xml:lang="ko">유아 놀이 운영 사례와 기본움직임기술 활동 분석의 기준이 되는 현장 지원자료</rdfs:comment>
    <skos:prefLabel xml:lang="en">Nuri play operation casebook guideline standard</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">누리과정 놀이운영 사례집 기준</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__balanced_aesthetics_bodybuilding_standard">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#guideline_manual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__balanced_aesthetics_bodybuilding_standard</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">균형미 중심 보디빌딩 평가 기준</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support resource  balanced aesthetics bodybuilding standard</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여성 보디빌딩의 변천 세계와 한국의 흐름을 중심으로</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">세계와 한국 여성 보디빌딩의 발전과 변천을 분석하고, 건강위험, 약물 사용, 도핑방지 정책 강화와 균형미 중심 평가 필요를 논의함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">support resource  balanced aesthetics bodybuilding standard</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing support resource  balanced aesthetics bodybuilding standard in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">support resource  balanced aesthetics bodybuilding standard</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">균형미 중심 보디빌딩 평가 기준</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__knee_isokinetic_muscle_function_improvement">
