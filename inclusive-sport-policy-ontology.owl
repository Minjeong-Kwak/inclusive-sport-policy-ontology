  <rdf:Description rdf:about="#target_group__adult_developmental_disabilities_adapted_baseball">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#intellectual_disability"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">변형 야구 프로그램 참여 성인 발달장애인</isp:pref_label_ko>
