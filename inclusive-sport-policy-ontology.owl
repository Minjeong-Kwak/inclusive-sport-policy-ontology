  <rdf:Description rdf:about="#target_group__elderly_women_sarcopenia_function_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#elderly"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__elderly_women_sarcopenia_function_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">근감소 관련 기능 지원이 필요한 여성노인</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elderly women requiring sarcopenia-related functional support</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">골격근량, 악력, 보행속도, 신체기능이 함께 분석된 여성노인 대상 집단</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Associations Between Skeletal Muscle Mass, Grip Strength, and Physical and Cognitive Functions in Elderly Women: Effect of Exercise with Resistive Theraband</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition and Biochemistry</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/jenb.2019.0023</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">50-51</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twenty-eight elderly women participated; 15 underwent elastic band exercise for 1 hour per day, twice per week for 8 weeks. Theraband exercise significantly improved gait speed and physical function.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:applies_to_gender rdf:datatype="http://www.w3.org/2001/XMLSchema#string">female</isp:applies_to_gender>
    <isp:applies_to_life_stage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">older adults</isp:applies_to_life_stage>
    <isp:sample_size rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28</isp:sample_size>
    <rdfs:label xml:lang="en">Elderly women requiring sarcopenia-related functional support</rdfs:label>
    <rdfs:comment xml:lang="ko">골격근량, 악력, 보행속도, 신체기능이 함께 분석된 여성노인 대상 집단</rdfs:comment>
    <skos:prefLabel xml:lang="en">Elderly women requiring sarcopenia-related functional support</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">근감소 관련 기능 지원이 필요한 여성노인</skos:prefLabel>
  </rdf:Description>
