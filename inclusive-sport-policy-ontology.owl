    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__female_college_students_shuttle_run_training</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">왕복오래달리기 트레이닝 대상 여대생</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target group  female college students shuttle run training</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여대생 대상 12주 왕복오래달리기 트레이닝을 통한 운동자각도와 여유심박수 비교</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여대생 대상 12주 중강도 왕복오래달리기 트레이닝에서 운동자각도와 여유심박수 방식 모두 심폐지구력 향상에 효과가 있었고, 여유심박수 방식이 운동강도 조절에 유용하다고 보고됨.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">target group  female college students shuttle run training</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing target group  female college students shuttle run training in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">target group  female college students shuttle run training</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">왕복오래달리기 트레이닝 대상 여대생</skos:prefLabel>
  </rdf:Description>
