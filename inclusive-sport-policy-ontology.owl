  <rdf:Description rdf:about="#program__collegiate_athlete_career_interest_assessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대학생 학생선수 체육진로흥미 진단 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Collegiate athlete sport career interest assessment program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대학생 학생선수의 체육진로흥미를 진단하고 진로교육과 경력 설계를 지원하는 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대학생 학생선수용 체육진로흥미검사지 개발 및 타당화 검증</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육진로흥미검사지는 유능감, 성격, 활동 상위요인과 관계형, 탐구형, 창조형, 전략형 하위요인으로 구조화되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:targets_target_group rdf:resource="#target_group__college_athletes_doping_risk"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__sport_career_interest_inventory"/>
    <isp:produces_outcome rdf:resource="#outcome__student_athlete_career_planning_support"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__collegiate_athlete_career_interest_assessment</isp:entity_id>
    <rdfs:label xml:lang="en">Collegiate athlete sport career interest assessment program</rdfs:label>
    <rdfs:comment xml:lang="ko">대학생 학생선수의 체육진로흥미를 진단하고 진로교육과 경력 설계를 지원하는 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Collegiate athlete sport career interest assessment program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">대학생 학생선수 체육진로흥미 진단 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__college_athletes_doping_risk"/>
