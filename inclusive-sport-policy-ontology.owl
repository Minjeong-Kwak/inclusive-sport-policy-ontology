    <isp:utilizes_support_resource rdf:resource="#support_resource__pe_major_linked_extracurricular_framework"/>
    <isp:produces_outcome rdf:resource="#outcome__pre_service_pe_teacher_competency_development"/>
    <rdfs:label xml:lang="en">program  competency based pe extracurricular model</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing program  competency based pe extracurricular model in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
