  <rdf:Description rdf:about="#outcome__positive_psychological_capital_formation_after_doping_sanction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#mental_health_improvement"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑 제재 후 긍정심리자본 형성</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Positive psychological capital formation after doping sanction</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑 제재 경험 이후 희망, 낙관성, 탄력성, 자신감 등 긍정심리자본을 형성하는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑 제재 극복과정에서 형성된 긍정심리자본</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국체육학회지</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">도핑 제재를 삶의 전환점으로 지각하면서 낙관성, 희망, 탄력성, 자신감이 형성되었다고 보고함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__positive_psychological_capital_formation_after_doping_sanction</isp:entity_id>
    <rdfs:label xml:lang="en">Positive psychological capital formation after doping sanction</rdfs:label>
    <rdfs:comment xml:lang="ko">도핑 제재 경험 이후 희망, 낙관성, 탄력성, 자신감 등 긍정심리자본을 형성하는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Positive psychological capital formation after doping sanction</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">도핑 제재 후 긍정심리자본 형성</skos:prefLabel>
  </rdf:Description>
