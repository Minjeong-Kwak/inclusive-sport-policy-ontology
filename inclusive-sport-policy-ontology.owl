  <rdf:Description rdf:about="#support_resource__sports_for_all_standard_curriculum_framework">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#support_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__sports_for_all_standard_curriculum_framework</isp:entity_id>
