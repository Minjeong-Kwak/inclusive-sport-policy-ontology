  </rdf:Description>
  <rdf:Description rdf:about="#outcome__athlete_psychological_need_satisfaction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#mental_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__athlete_psychological_need_satisfaction</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">선수 심리적 욕구만족 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">athlete psychological need satisfaction</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">선수의 자율성, 유능감, 관계성 등 심리적 욕구가 충족되는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지도자의 코칭방식, 선수들의 심리적 욕구만족, 욕구좌절, 정신력과 도핑 의도와의 관계</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">심리적 욕구만족은 정신력을 정적으로 예측하고 도핑 의도를 부적으로 예측하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <rdfs:label xml:lang="en">athlete psychological need satisfaction</rdfs:label>
    <rdfs:comment xml:lang="ko">선수의 자율성, 유능감, 관계성 등 심리적 욕구가 충족되는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">athlete psychological need satisfaction</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">선수 심리적 욕구만족 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__prader_willi_24week_complex_exercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#medical_welfare_linked_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__prader_willi_24week_complex_exercise</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프래더윌리증후군 24주 복합운동 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24-week complex exercise program for Prader-Willi syndrome</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Changes in body composition, blood lipid profile, and growth factor hormone in a patient with Prader–willi syndrome during 24 weeks of complex exercise: a single case study</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition &amp; Biochemistry</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">근력운동과 유산소운동을 24주간 주 5회 60분씩 실시함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프래더윌리증후군 환자에게 적용된 장기 복합운동 중재 프로그램임</isp:definition_text>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__prader_willi_strength_aerobic_complex_exercise"/>
    <isp:targets_target_group rdf:resource="#target_group__prader_willi_syndrome_obesity_diabetes_exercise_support"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__prader_willi_metabolic_monitoring_assessment"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__prader_willi_long_term_supervised_exercise_context"/>
    <isp:produces_outcome rdf:resource="#outcome__prader_willi_obesity_diabetes_metabolic_improvement"/>
    <isp:produces_outcome rdf:resource="#outcome__prader_willi_insulin_management_improvement"/>
    <rdfs:label xml:lang="en">24-week complex exercise program for Prader-Willi syndrome</rdfs:label>
    <rdfs:comment xml:lang="ko">프래더윌리증후군 환자에게 적용된 장기 복합운동 중재 프로그램임</rdfs:comment>
    <skos:prefLabel xml:lang="en">24-week complex exercise program for Prader-Willi syndrome</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">프래더윌리증후군 24주 복합운동 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__prader_willi_syndrome_obesity_diabetes_exercise_support"/>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__high_school_soccer_student_athletes_learning_rights">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#adolescent"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__high_school_soccer_student_athletes_learning_rights</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학습권 지원 고등학교 축구 학생선수</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high school soccer student athletes for learning rights</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">축구 주말리그 도입 이후 정규수업 참여와 학습권 보장 상태가 분석된 고등학교 학생선수 집단.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">축구 주말리그 도입 이후의 고등학교 학생선수 학습권 현황</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">서울과 경기 지역의 고등학교 축구 학생선수 332명을 대상으로 학습권 현황을 조사함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated_v67_added_from_uploaded_literature</isp:note>
    <rdfs:label xml:lang="en">high school soccer student athletes for learning rights</rdfs:label>
    <rdfs:comment xml:lang="ko">축구 주말리그 도입 이후 정규수업 참여와 학습권 보장 상태가 분석된 고등학교 학생선수 집단.</rdfs:comment>
    <skos:prefLabel xml:lang="en">high school soccer student athletes for learning rights</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">학습권 지원 고등학교 축구 학생선수</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__lifelong_sport_leader_pedagogy_training">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__lifelong_sport_leader_pedagogy_training</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">생활체육 지도자 교육학 역량강화 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pedagogy capacity-building program for daily sport leaders</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">생활체육 지도자의 교수·학습, 교육과정 이해, 학습자 지원 역량을 강화하는 프로그램.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">평생체육 활성화를 위한 스포츠 교육학의 기여와 한계</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">생활체육 현장의 학습자, 지도자, 교육과정 이해를 스포츠교육학이 도울 수 있다고 설명하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:utilizes_support_resource rdf:resource="#support_resource__lifelong_sport_educator_training_framework"/>
    <isp:produces_outcome rdf:resource="#outcome__lifelong_sport_participation_quality_improvement"/>
    <rdfs:label xml:lang="en">pedagogy capacity-building program for daily sport leaders</rdfs:label>
    <rdfs:comment xml:lang="ko">생활체육 지도자의 교수·학습, 교육과정 이해, 학습자 지원 역량을 강화하는 프로그램.</rdfs:comment>
    <skos:prefLabel xml:lang="en">pedagogy capacity-building program for daily sport leaders</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">생활체육 지도자 교육학 역량강화 프로그램</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__pe_teacher_textbook_development_professional_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__pe_teacher_textbook_development_professional_learning</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육교사 교과서 개발 전문학습 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PE teacher textbook-development professional learning program</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육교사의 교과서 개발 경험을 전문성 발달과 연결하는 역량강화 프로그램.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육 교사의 교과서 개발 경험에 대한 내러티브 탐구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">교과서 개발 경험을 통해 체육교사로서 더욱 성장하는 모습을 발견했다고 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:utilizes_support_resource rdf:resource="#support_resource__physical_education_textbook_development_experience"/>
    <isp:produces_outcome rdf:resource="#outcome__pe_teacher_curriculum_design_expertise"/>
    <isp:produces_outcome rdf:resource="#outcome__physical_education_textbook_use_reflection"/>
    <rdfs:label xml:lang="en">PE teacher textbook-development professional learning program</rdfs:label>
    <rdfs:comment xml:lang="ko">체육교사의 교과서 개발 경험을 전문성 발달과 연결하는 역량강화 프로그램.</rdfs:comment>
    <skos:prefLabel xml:lang="en">PE teacher textbook-development professional learning program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">체육교사 교과서 개발 전문학습 프로그램</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__fear_of_failure_reduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#mental_health_improvement"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">실패공포 완화</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fear of failure reduction</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">선수로서 성공하지 못할 가능성에 대한 두려움과 수치심을 완화하는 심리적 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">대학 운동선수의 부정행위 수용도, 스포츠 동기화, 스포츠 완벽주의가 실패공포와 도핑 의도 및 태도에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">부정행위 수용도, 내사된 조절, 코치 기준 완벽주의가 실패공포에 유의한 영향을 미쳤다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__fear_of_failure_reduction</isp:entity_id>
    <rdfs:label xml:lang="en">Fear of failure reduction</rdfs:label>
    <rdfs:comment xml:lang="ko">선수로서 성공하지 못할 가능성에 대한 두려움과 수치심을 완화하는 심리적 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Fear of failure reduction</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">실패공포 완화</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__pre_service_teacher_vr_simulation_experience">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#group_participation"/>
