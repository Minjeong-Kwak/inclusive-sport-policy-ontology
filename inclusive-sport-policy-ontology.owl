  <rdf:Description rdf:about="#support_resource__awgs_sarcopenia_diagnostic_criteria">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#guideline_manual"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AWGS 근감소증 진단 기준</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AWGS sarcopenia diagnostic criteria</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tai Chi Enhances Gait Performance Independently of Muscle Strength in Female Elderly with Severe Sarcopenia</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">아시아 노인을 대상으로 근감소증 및 중증 근감소증 분류에 활용되는 진단 기준 자원임</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">아시아 노인을 대상으로 근감소증 및 중증 근감소증 분류에 활용되는 진단 기준 자원임</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
