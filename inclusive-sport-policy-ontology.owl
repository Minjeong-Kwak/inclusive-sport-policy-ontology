    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fourth industrial revolution PE context</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4차 산업혁명 시대의 체육교육과 수업 공간·수업 운영방식 변화를 다룸.</isp:definition_text>
