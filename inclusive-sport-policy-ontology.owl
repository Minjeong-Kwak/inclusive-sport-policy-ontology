    <rdfs:label xml:lang="en">Physical Education Professor Relationship</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Physical Education Professor Relationship in the support_resource dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
