  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__obese_women_submaximal_circuit_exercise_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_context"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만 여성 최대하 순환운동 참여 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Submaximal circuit exercise context for obese women</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만 여성이 시설 기반 최대하 강도 순환운동에 참여하여 에너지소비를 평가받는 참여 맥락</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acute Energy Expenditure to Concurrent Aerobic and Hydraulic Resistance Exercise in Obese Women</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Exercise Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2010</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">199-203</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nine healthy obese women completed a maximal exercise test and performed submaximal programmed accommodating circuit exercise and stationary cycling. PACE training evoked greater energy expenditure than stationary cycling during submaximal intensity exercise in obese individuals.</isp:evidence_excerpt>
    <isp:reflects_target_group rdf:resource="#target_group__obese_women_energy_expenditure_exercise_support"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__obese_women_submaximal_circuit_exercise_context</isp:entity_id>
    <rdfs:label xml:lang="en">Submaximal circuit exercise context for obese women</rdfs:label>
    <rdfs:comment xml:lang="ko">비만 여성이 시설 기반 최대하 강도 순환운동에 참여하여 에너지소비를 평가받는 참여 맥락</rdfs:comment>
    <skos:prefLabel xml:lang="en">Submaximal circuit exercise context for obese women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">비만 여성 최대하 순환운동 참여 맥락</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__obese_women_energy_expenditure_exercise_support"/>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__elementary_children_movement_sleep_routine_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_age_child"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__elementary_children_movement_sleep_routine_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">움직임·수면·생활습관 지원이 필요한 초등학생</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elementary children requiring movement and sleep routine support</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체활동, 수면, 좌식행동과 기상·취침·아침식사 규칙성의 관계가 분석된 초등학생 대상 집단</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Empirical Study on Variables Affecting the Regularity of Children’s Wakeup Time, Bedtime and Breakfast: Focusing on Activities Related to Sweat, Step, Sleep, and Sit</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">101-114</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The study analyzed 594 elementary school students in grades 1 to 6 and found that more weekly days of physical activity, adequate sleep duration, and fewer daily hours of electronic device use were associated with higher regularity of wakeup time, bedtime, and breakfast.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <rdfs:label xml:lang="en">Elementary children requiring movement and sleep routine support</rdfs:label>
    <rdfs:comment xml:lang="ko">신체활동, 수면, 좌식행동과 기상·취침·아침식사 규칙성의 관계가 분석된 초등학생 대상 집단</rdfs:comment>
    <skos:prefLabel xml:lang="en">Elementary children requiring movement and sleep routine support</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">움직임·수면·생활습관 지원이 필요한 초등학생</skos:prefLabel>
  </rdf:Description>
