    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">national PE curriculum implementation improvement policy</isp:pref_label_en>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국가수준 체육과 교육과정 구현 제고 정책</isp:pref_label_ko>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국가수준 체육과 교육과정의 구현 실태 및 제고 방안</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">전국 체육교사 341명을 대상으로 2015 개정 체육과 교육과정 구현 실태를 조사함</isp:evidence_excerpt>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated v27 instance from uploaded paper</isp:note>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">literature_curated_instance</isp:source_type>
    <isp:source_identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국가수준 체육과 교육과정의 구현 실태 및 제고 방안</isp:source_identifier>
    <isp:implements_program rdf:resource="#program__pe_curriculum_implementation_teacher_support"/>
    <rdfs:label xml:lang="en">national PE curriculum implementation improvement policy</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing national PE curriculum implementation improvement policy in the policy dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">national PE curriculum implementation improvement policy</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">국가수준 체육과 교육과정 구현 제고 정책</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__middle_school_pe_instructional_practice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#institutional_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__middle_school_pe_instructional_practice</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중학교 체육수업 실행 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">middle school PE instructional practice context</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">경력 체육 교사의 내용 교수 지식(PCK) 형성 과정 탐색</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">내용 교수 지식 형성에 영향을 미친 요소는 경험과 연수, 대학원 진학, 연구팀 활동, 교수 실제 경험, 동료교사 등으로 나타났다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">middle school PE instructional practice context</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing middle school PE instructional practice context in the participation_context dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">middle school PE instructional practice context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">중학교 체육수업 실행 맥락</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__regular_long_term_martial_arts_training">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#long_term_participation"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__regular_long_term_martial_arts_training</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장기적 정기 무술훈련 참여</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Regular long-term martial arts training participation</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1회 1.5시간 이상, 3년 이상 훈련과 연결되는 장기적·정기적 참여 맥락</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Empirical Analysis on the Relation between Martial Arts Training and Adolescent Mental Health</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">31-43</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adolescents who participated in martial arts training showed significantly lower depression, anxiety, and hostility than non-participants; training for more than 1.5 hours per session and over 3 years was associated with better mental health indicators.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <rdfs:label xml:lang="en">Regular long-term martial arts training participation</rdfs:label>
    <rdfs:comment xml:lang="ko">1회 1.5시간 이상, 3년 이상 훈련과 연결되는 장기적·정기적 참여 맥락</rdfs:comment>
    <skos:prefLabel xml:lang="en">Regular long-term martial arts training participation</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">장기적 정기 무술훈련 참여</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__adolescent_elite_athletes_anti_doping_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#youth"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__adolescent_elite_athletes_anti_doping_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">반도핑 지원이 필요한 청소년 엘리트 선수</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adolescent elite athletes requiring anti-doping support</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Attitudes and Dispositions toward Doping in Adolescent Elite Athletes</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2013</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Sports Medicine</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">제2회 아시아청소년경기대회에 참가한 청소년 엘리트 선수 123명을 조사함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">반도핑 정보와 예방 교육이 필요한 청소년 엘리트 선수 대상 집단임</isp:definition_text>
    <isp:is_involved_in_context rdf:resource="#participation_context__adolescent_elite_competition_anti_doping_context"/>
    <rdfs:label xml:lang="en">Adolescent elite athletes requiring anti-doping support</rdfs:label>
    <rdfs:comment xml:lang="ko">반도핑 정보와 예방 교육이 필요한 청소년 엘리트 선수 대상 집단임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Adolescent elite athletes requiring anti-doping support</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">반도핑 지원이 필요한 청소년 엘리트 선수</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__baseball_national_team_national_value_recognition">
    <rdf:type rdf:resource="#social_integration_outcome"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__baseball_national_team_national_value_recognition</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">야구 국가대표 국가 가치 인식</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">national value recognition of baseball national team</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프로야구 팬의 사회공정성, 사회신뢰성, 국가정체성 인식이 야구 국가대표 의미에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">사회공정성, 사회신뢰성, 국가정체성 인식이 국가 가치에 정적인 영향을 미쳤다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:is_result_of_program rdf:resource="#program__baseball_national_team_social_meaning_survey"/>
    <isp:reflects_target_group rdf:resource="#target_group__professional_baseball_fans_national_team_perception"/>
    <rdfs:label xml:lang="en">national value recognition of baseball national team</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing national value recognition of baseball national team in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">national value recognition of baseball national team</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">야구 국가대표 국가 가치 인식</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__professional_baseball_fans_national_team_perception"/>
  </rdf:Description>
  <rdf:Description rdf:about="#program__scoliosis_children_adolescents_exercise_intervention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_linked_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__scoliosis_children_adolescents_exercise_intervention</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">아동·청소년 척추측만 운동중재 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exercise intervention program for scoliosis in children and adolescents</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">척추측만 아동·청소년에게 슈로스, 안정화, 기능훈련 등 운동중재를 제공하는 학교·지역 연계 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Effects Of Different Exercise Interventions On Scoliosis In Children And Adolescents: A Reticulated Meta-Analysis</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022 3rd Asia Sport Science Conference Abstracts</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conference_abstract</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">109-110</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The conference abstract reviewed randomized controlled studies on exercise interventions for scoliosis in children and adolescents. Twenty-two studies with 1,110 samples were included, and Schroth training, functional training, and stability training showed significant effects compared with no exercise, with Schroth plus hippotherapy, Schroth, stability, and functional training ranked as leading approaches.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <isp:targets_target_group rdf:resource="#target_group__children_adolescents_scoliosis_exercise_support"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__scoliosis_schroth_stability_functional_training"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__scoliosis_exercise_intervention_comparison_evidence"/>
    <isp:produces_outcome rdf:resource="#outcome__scoliosis_posture_and_spinal_curve_improvement"/>
    <rdfs:label xml:lang="en">Exercise intervention program for scoliosis in children and adolescents</rdfs:label>
    <rdfs:comment xml:lang="ko">척추측만 아동·청소년에게 슈로스, 안정화, 기능훈련 등 운동중재를 제공하는 학교·지역 연계 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Exercise intervention program for scoliosis in children and adolescents</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">아동·청소년 척추측만 운동중재 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__children_adolescents_scoliosis_exercise_support"/>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__knee_osteoarthritis_gait_ability_improvement_aquatic_exercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#functional_ability_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__knee_osteoarthritis_gait_ability_improvement_aquatic_exercise</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">퇴행성관절염 보행 능력 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gait ability improvement in knee osteoarthritis</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주 수중운동 프로그램 후 보행 관련 변인의 긍정적 변화가 보고된 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간의 수중운동프로그램이 퇴행성 관절염 환자의 보행에 미치는 영향: 사례연구</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">무릎 퇴행성관절염을 가진 66세 여성 노인 1명이 12주간 주 3회, 회당 60분 수중운동 프로그램에 참여하였다. 프로그램 후 보행 능력과 무릎 안정성에 긍정적 변화가 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">Gait ability improvement in knee osteoarthritis</rdfs:label>
    <rdfs:comment xml:lang="ko">12주 수중운동 프로그램 후 보행 관련 변인의 긍정적 변화가 보고된 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Gait ability improvement in knee osteoarthritis</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">퇴행성관절염 보행 능력 향상</skos:prefLabel>
  </rdf:Description>
