    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__sport_university_students_v75</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">체육대학교 학생</isp:pref_label_ko>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국체육대학교 학생들의 도핑에 대한 지식, 믿음 및 성향</isp:source_title>
