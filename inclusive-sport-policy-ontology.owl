    <isp:produces_outcome rdf:resource="#outcome__remote_pe_feedback_and_activity_limitation"/>
    <rdfs:label xml:lang="en">Remote middle school PE class during COVID-19</rdfs:label>
    <rdfs:comment xml:lang="ko">감염병 상황에서 온라인으로 운영된 중학교 체육수업 프로그램임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Remote middle school PE class during COVID-19</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">COVID-19 중학교 원격 체육수업</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__middle_school_students_covid_pe_experience"/>
  </rdf:Description>
