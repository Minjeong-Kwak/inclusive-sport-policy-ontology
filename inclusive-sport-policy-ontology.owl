    <rdfs:label xml:lang="en">exergame device and content</rdfs:label>
    <rdfs:comment xml:lang="ko">전신 움직임과 비디오 게임을 결합하여 노인 운동참여를 돕는 디지털 자원</rdfs:comment>
    <skos:prefLabel xml:lang="en">exergame device and content</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">엑서게임 기기 및 콘텐츠</skos:prefLabel>
  </rdf:Description>
