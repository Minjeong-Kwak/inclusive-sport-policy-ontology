    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__doping_control_center_product_analysis</isp:entity_id>
    <rdfs:label xml:lang="en">Doping control center supplement analysis resource</rdfs:label>
    <rdfs:comment xml:lang="ko">선수 혈액 또는 제품 성분을 도핑검사 기준으로 분석하여 안전성을 확인하는 정보 자원임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Doping control center supplement analysis resource</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">도핑검사센터 보충제 분석 자료</skos:prefLabel>
  </rdf:Description>
