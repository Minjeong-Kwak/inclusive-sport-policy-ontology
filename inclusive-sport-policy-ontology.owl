    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">초등학교 저학년의 태권도 수련이 사회성에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">수련 기간에 따라 학교생활 태도 요인에서 유의한 차이가 나타남</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated_v66_added_from_uploaded_literature</isp:note>
    <rdfs:label xml:lang="en">School life attitude improvement through Taekwondo</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing School life attitude improvement through Taekwondo in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
