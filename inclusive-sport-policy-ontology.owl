  <rdf:Description rdf:about="#target_group__female_adolescents_sedentary_behavior_risk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#adolescent"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__female_adolescents_sedentary_behavior_risk</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">좌식행동 위험 여자 청소년</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target group  female adolescents sedentary behavior risk</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">여자 청소년의 좌식행동양상과 학교체육활동 및 건강요인과의 관련성 - 제 12차 (2016년) 청소년건강행태온라인 조사 자료를 이용하여 -</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016년 청소년건강행태온라인조사 자료를 활용하여 여자 청소년의 좌식행동, 신체활동, 학교체육활동, 식이행동 및 건강요인의 관련성을 분석함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">target group  female adolescents sedentary behavior risk</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing target group  female adolescents sedentary behavior risk in the target_group dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">target group  female adolescents sedentary behavior risk</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">좌식행동 위험 여자 청소년</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__obese_elementary_children_aerobic_exercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_age_child"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__obese_elementary_children_aerobic_exercise</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유산소 운동 참여 비만아동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Obese elementary school children in aerobic exercise</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주 유산소 운동 연구의 대상이 된 비만 초등학생 집단</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간의 유산소 운동에 의한 비만아동의 신체구성 및 혈액성분 변화</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1997</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Exercise Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만 초등학생 20명을 대상으로 12주간 주 4회, 하루 30분, VO2max 60% 강도의 유산소 운동을 실시하였다. 신체구성과 혈액성분의 긍정적 변화가 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:applies_to_health_condition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">obesity</isp:applies_to_health_condition>
    <isp:applies_to_age_range rdf:datatype="http://www.w3.org/2001/XMLSchema#string">elementary school children</isp:applies_to_age_range>
    <isp:target_participant_size rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</isp:target_participant_size>
    <rdfs:label xml:lang="en">Obese elementary school children in aerobic exercise</rdfs:label>
    <rdfs:comment xml:lang="ko">12주 유산소 운동 연구의 대상이 된 비만 초등학생 집단</rdfs:comment>
    <skos:prefLabel xml:lang="en">Obese elementary school children in aerobic exercise</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유산소 운동 참여 비만아동</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__taekwondo_dojang_quarantine_guideline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#guideline_manual"/>
