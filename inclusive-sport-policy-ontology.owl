  <rdf:Description rdf:about="#outcome__children_daily_routine_regularity_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#daily_life_functioning_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__children_daily_routine_regularity_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">아동 기상·취침·아침식사 규칙성 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improved regularity of children’s wakeup, bedtime, and breakfast</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체활동 증가, 충분한 수면, 전자기기 사용 감소와 연결되는 아동 일상생활 규칙성 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Empirical Study on Variables Affecting the Regularity of Children’s Wakeup Time, Bedtime and Breakfast: Focusing on Activities Related to Sweat, Step, Sleep, and Sit</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">101-114</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The study analyzed 594 elementary school students in grades 1 to 6 and found that more weekly days of physical activity, adequate sleep duration, and fewer daily hours of electronic device use were associated with higher regularity of wakeup time, bedtime, and breakfast.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <isp:reflects_target_group rdf:resource="#target_group__elementary_children_movement_sleep_routine_support"/>
    <rdfs:label xml:lang="en">Improved regularity of children’s wakeup, bedtime, and breakfast</rdfs:label>
    <rdfs:comment xml:lang="ko">신체활동 증가, 충분한 수면, 전자기기 사용 감소와 연결되는 아동 일상생활 규칙성 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Improved regularity of children’s wakeup, bedtime, and breakfast</skos:prefLabel>
