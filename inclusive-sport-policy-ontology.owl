    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__service_quality_evaluation_improvement_2024</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애인복지서비스 질 평가 개선</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improved evaluation of disability welfare service quality</isp:pref_label_en>
