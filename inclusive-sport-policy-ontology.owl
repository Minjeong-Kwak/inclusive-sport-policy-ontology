    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rural farm and fishery labor-demand area</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">제4차 외국인정책 기본계획</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">법무부</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">government_policy_document</isp:source_type>
    <isp:source_section rdf:datatype="http://www.w3.org/2001/XMLSchema#string">고용허가제 및 계절근로자 도입 현황</isp:source_section>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">지방자치단체가 지역 농어가에 필요한 외국인력 수요를 직접 신청하고 배정받아 농어촌 구인난 해소에 기여한다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-18</isp:last_updated>
