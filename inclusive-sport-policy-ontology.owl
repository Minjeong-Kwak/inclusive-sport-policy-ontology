  <rdf:Description rdf:about="#sport_activity__walking_for_menopause_health">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#walking"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__walking_for_menopause_health</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">폐경기 여성 걷기 신체활동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Walking physical activity for menopausal women</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저소득층 폐경기 여성의 비만에 따른 대사적 건강상태와 신체활동 및 좌식행동과의 관련성</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만 여성도 걷기 같은 가벼운 운동을 주 5일 이상 실천할 경우 복부비만 위험율이 낮게 나타났다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <rdfs:label xml:lang="en">Walking physical activity for menopausal women</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Walking physical activity for menopausal women in the sport_activity dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Walking physical activity for menopausal women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">폐경기 여성 걷기 신체활동</skos:prefLabel>
  </rdf:Description>
