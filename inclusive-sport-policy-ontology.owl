  <rdf:Description rdf:about="#program__ski_instructor_certification_restructuring">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#leadership_instructor_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__ski_instructor_certification_restructuring</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스키지도자 자격양성 프로그램 재구조화</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Restructured ski instructor certification program</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">우리나라 스키지도자 자격양성 프로그램의 재구조화 방안 고찰</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</isp:source_year>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국내 스키지도자 양성 프로그램의 목표·내용 연계, 전문 지도법 교육, 교육내용과 검정내용의 일원화 필요를 일본 사례와 비교하여 제시함.</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국내 스키지도자 양성 프로그램의 목표·내용 연계, 전문 지도법 교육, 교육내용과 검정내용의 일원화 필요를 일본 사례와 비교하여 제시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:targets_target_group rdf:resource="#target_group__ski_instructors_certification"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__standardized_ski_instruction_curriculum"/>
    <isp:produces_outcome rdf:resource="#outcome__ski_instruction_professionalism_improvement"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__ski_school_lifelong_sport_setting"/>
    <rdfs:label xml:lang="en">Restructured ski instructor certification program</rdfs:label>
    <rdfs:comment xml:lang="ko">국내 스키지도자 양성 프로그램의 목표·내용 연계, 전문 지도법 교육, 교육내용과 검정내용의 일원화 필요를 일본 사례와 비교하여 제시함.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Restructured ski instructor certification program</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스키지도자 자격양성 프로그램 재구조화</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__ski_instructors_certification"/>
  </rdf:Description>
