    <rdfs:comment xml:lang="ko">스포츠 현장에서 활용 가능한 사례 중심 윤리교육 자료</rdfs:comment>
    <skos:prefLabel xml:lang="en">sport ethics case-learning materials</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠윤리 사례학습 자료</skos:prefLabel>
  </rdf:Description>
