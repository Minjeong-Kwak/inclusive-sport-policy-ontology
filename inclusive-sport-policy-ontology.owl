  <rdf:Description rdf:about="#support_resource__multilingual_information_for_long_stay_immigrants">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#distance_access_support"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__multilingual_information_for_long_stay_immigrants</isp:entity_id>
