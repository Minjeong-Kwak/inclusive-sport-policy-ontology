  <rdf:Description rdf:about="#target_group__pre_adolescent_children_pa_guideline_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#school_age_child"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__pre_adolescent_children_pa_guideline_support</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">신체활동 권고 준수가 필요한 전청소년기 아동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pre-adolescent children requiring PA guideline support</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">하루 60분 중고강도 신체활동 권고 준수 여부와 장내미생물 조성이 함께 분석된 아동 대상 집단</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Associations of physical activity with gut microbiota in pre-adolescent children</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/pan.2021.0023</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24-25</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This study analyzed 321 children with physical activity and 16S rRNA sequencing data. Children meeting physical activity recommendations had altered gut microbiota compositions.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:applies_to_life_stage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pre-adolescent children</isp:applies_to_life_stage>
    <isp:sample_size rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">321</isp:sample_size>
    <isp:interacts_with_target_group rdf:resource="#target_group__pre_adolescent_children_pa_guideline_support"/>
    <rdfs:label xml:lang="en">Pre-adolescent children requiring PA guideline support</rdfs:label>
    <rdfs:comment xml:lang="ko">하루 60분 중고강도 신체활동 권고 준수 여부와 장내미생물 조성이 함께 분석된 아동 대상 집단</rdfs:comment>
    <skos:prefLabel xml:lang="en">Pre-adolescent children requiring PA guideline support</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">신체활동 권고 준수가 필요한 전청소년기 아동</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__pre_adolescent_children_pa_guideline_support"/>
  </rdf:Description>
