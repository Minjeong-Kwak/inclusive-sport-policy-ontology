  <rdf:Description rdf:about="#sport_activity__structured_physical_activity_breast_cancer_support">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#fitness_program"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유방암 생존자 구조화 신체활동</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Structured physical activity for breast cancer support</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">유방암 생존자의 재발 및 사망 위험 감소와 건강 관리를 위해 활용되는 구조화된 신체활동</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A systematic review of the biological mechanisms linking physical activity and breast cancer</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">review_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/pan.2020.0018</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">25-26</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leisure-time physical activity and structured exercise before and after breast cancer diagnosis contribute to reducing the risk of breast cancer recurrence and mortality. The review describes physical activity as a non-pharmacological strategy for primary cancer prevention.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__structured_physical_activity_breast_cancer_support</isp:entity_id>
    <rdfs:label xml:lang="en">Structured physical activity for breast cancer support</rdfs:label>
    <rdfs:comment xml:lang="ko">유방암 생존자의 재발 및 사망 위험 감소와 건강 관리를 위해 활용되는 구조화된 신체활동</rdfs:comment>
    <skos:prefLabel xml:lang="en">Structured physical activity for breast cancer support</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">유방암 생존자 구조화 신체활동</skos:prefLabel>
  </rdf:Description>
