    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Changes in body composition, physical fitness and quality of life on robotic gait assisted training in patients with Guillain-Barré Syndrome: a case report</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">end-effector gait robotic device를 사용함</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">보행훈련에 사용된 핵심 디지털·재활 장비가 직접 제시됨</isp:definition_text>
    <rdfs:label xml:lang="en">End-effector robotic gait assistant device</rdfs:label>
    <rdfs:comment xml:lang="ko">보행훈련에 사용된 핵심 디지털·재활 장비가 직접 제시됨</rdfs:comment>
    <skos:prefLabel xml:lang="en">End-effector robotic gait assistant device</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">엔드이펙터형 로봇 보행 보조 장치</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__sports_nutrition_expert_exchange_training">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#capacity_building_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__sports_nutrition_expert_exchange_training</isp:entity_id>
