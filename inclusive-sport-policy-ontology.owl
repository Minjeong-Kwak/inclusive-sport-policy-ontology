    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Athlete sportsmanship education</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동선수의 스포츠맨십이 도덕적 이탈 및 반사회적 행동에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2016</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">중·고·대학교 운동선수 313명을 대상으로 스포츠맨십, 도덕적 이탈, 반사회적 행동의 관계를 분석하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Added in v52 from uploaded academic literature; class assignment limited to directly evidenced entities.</isp:note>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:targets_target_group rdf:resource="#target_group__middle_high_university_athletes"/>
    <isp:produces_outcome rdf:resource="#outcome__moral_disengagement_reduction"/>
    <isp:produces_outcome rdf:resource="#outcome__antisocial_behavior_reduction"/>
    <rdfs:label xml:lang="en">Athlete sportsmanship education</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Athlete sportsmanship education in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Athlete sportsmanship education</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">운동선수 스포츠맨십 교육</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__middle_high_university_athletes"/>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__virtuous_sport_pleasure_understanding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
