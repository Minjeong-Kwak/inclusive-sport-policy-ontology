  <rdf:Description rdf:about="#target_group__professional_female_volleyball_players_fms">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#elite_athlete"/>
    <rdf:type rdf:resource="#target_group"/>
