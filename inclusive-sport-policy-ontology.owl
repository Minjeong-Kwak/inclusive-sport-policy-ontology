  </rdf:Description>
  <rdf:Description rdf:about="#participation_context__prader_willi_long_term_supervised_exercise_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#participation_frequency_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__prader_willi_long_term_supervised_exercise_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">프래더윌리증후군 장기 감독형 운동 참여 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Long-term supervised exercise participation context for Prader-Willi syndrome</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Changes in body composition, blood lipid profile, and growth factor hormone in a patient with Prader–willi syndrome during 24 weeks of complex exercise: a single case study</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition &amp; Biochemistry</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24주 동안 주 5회, 회당 60분 운동이 수행됨</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">24주간 주 5회 60분 참여 조건이 명확히 제시된 운동 참여 맥락임</isp:definition_text>
    <rdfs:label xml:lang="en">Long-term supervised exercise participation context for Prader-Willi syndrome</rdfs:label>
    <rdfs:comment xml:lang="ko">24주간 주 5회 60분 참여 조건이 명확히 제시된 운동 참여 맥락임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Long-term supervised exercise participation context for Prader-Willi syndrome</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">프래더윌리증후군 장기 감독형 운동 참여 맥락</skos:prefLabel>
  </rdf:Description>
