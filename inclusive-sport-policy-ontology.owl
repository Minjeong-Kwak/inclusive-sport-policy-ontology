  <rdf:Description rdf:about="#program__twelve_week_dance_sports_obese_middle_aged_women">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#community_based_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__twelve_week_dance_sports_obese_middle_aged_women</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만 중년여성 12주 댄스스포츠 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twelve-week dance sports program for obese middle-aged women</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만 중년여성의 신체구성 및 항산화 효소 활성 변화를 확인하기 위해 적용된 12주 댄스스포츠 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간의 댄스스포츠 운동이 비만 중년여성의 신체구성 및 항산화 효소 활성에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2008</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Exercise Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만 중년여성 20명을 대상으로 실험군과 통제군을 구성하고 12주간 댄스스포츠 프로그램을 적용하였다. 실험군에서 체지방과 체지방률 감소, SOD와 CAT 등 항산화 효소 활성 변화가 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:program_duration_weeks rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</isp:program_duration_weeks>
    <isp:target_participant_size rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</isp:target_participant_size>
    <isp:targets_target_group rdf:resource="#target_group__obese_middle_aged_women_dance_sports"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__dance_sports_exercise_obese_middle_aged_women"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__twelve_week_dance_sports_obese_middle_aged_women"/>
    <isp:produces_outcome rdf:resource="#outcome__dance_sports_body_composition_improvement_obese_middle_aged_women"/>
    <isp:produces_outcome rdf:resource="#outcome__dance_sports_antioxidant_enzyme_change_obese_middle_aged_women"/>
    <rdfs:label xml:lang="en">Twelve-week dance sports program for obese middle-aged women</rdfs:label>
    <rdfs:comment xml:lang="ko">비만 중년여성의 신체구성 및 항산화 효소 활성 변화를 확인하기 위해 적용된 12주 댄스스포츠 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Twelve-week dance sports program for obese middle-aged women</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">비만 중년여성 12주 댄스스포츠 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__obese_middle_aged_women_dance_sports"/>
  </rdf:Description>
