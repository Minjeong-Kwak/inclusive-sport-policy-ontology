  <rdf:Description rdf:about="#support_resource__asoif_good_governance_evaluation_indicators">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#guideline_manual"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__asoif_good_governance_evaluation_indicators</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ASOIF 굿 거버넌스 평가지표</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ASOIF good governance evaluation indicators</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">국제연맹의 투명성, 무결성, 민주성, 윤리성, 공정성 수준을 평가하는 지표 기반 지침 자원</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ASOIF 굿 거버넌스 보고서 평가지표 내용분석을 통한 WT 성과 및 개선방향</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taekwondo Journal of Kukkiwon</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">99-107</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The study analyzed World Taekwondo governance using ASOIF good governance indicators. It reported that World Taekwondo improved from grade C in 2016 to A2, complied with transparency indicators, strengthened ethical standards and gender equality, maintained systematic election procedures and relations with national associations, and operated an independent ethics committee.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <rdfs:label xml:lang="en">ASOIF good governance evaluation indicators</rdfs:label>
    <rdfs:comment xml:lang="ko">국제연맹의 투명성, 무결성, 민주성, 윤리성, 공정성 수준을 평가하는 지표 기반 지침 자원</rdfs:comment>
    <skos:prefLabel xml:lang="en">ASOIF good governance evaluation indicators</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">ASOIF 굿 거버넌스 평가지표</skos:prefLabel>
  </rdf:Description>
