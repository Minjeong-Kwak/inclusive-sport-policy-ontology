  <rdf:Description rdf:about="#program__taekwondo_refugee_camp_peace_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#social_integration_support_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__taekwondo_refugee_camp_peace_education</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">난민캠프 태권도 평화교육 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taekwondo peace education program in refugee camps</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ethics of Education in Sport Taekwondo</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acta Taekwondo et Martialis Artium</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">세계태권도와 태권도인도주의재단이 난민캠프 태권도 교육 자료를 개발하고 평화 구축을 목표로 실험했다고 제시됨</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">난민캠프의 태권도 수련과 올림피즘·세계시민성·지속가능한 평화 교육을 결합한 사회통합 지원 프로그램임</isp:definition_text>
    <isp:targets_target_group rdf:resource="#target_group__refugee_camp_young_taekwondo_practitioners"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__refugee_camp_taekwondo_training"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__refugee_camp_taekwondo_education_context"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__taekwondo_peace_education_card_game"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__taekwondo_six_level_peace_curriculum"/>
    <isp:produces_outcome rdf:resource="#outcome__global_citizenship_through_taekwondo"/>
    <isp:produces_outcome rdf:resource="#outcome__sustainable_peace_building_through_taekwondo"/>
    <rdfs:label xml:lang="en">Taekwondo peace education program in refugee camps</rdfs:label>
    <rdfs:comment xml:lang="ko">난민캠프의 태권도 수련과 올림피즘·세계시민성·지속가능한 평화 교육을 결합한 사회통합 지원 프로그램임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Taekwondo peace education program in refugee camps</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">난민캠프 태권도 평화교육 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__refugee_camp_young_taekwondo_practitioners"/>
