    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">poomsae lower limb strength profile identification</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">품새 선수의 하지근기능 특성을 평가하여 훈련 방향을 설정하는 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">태권도 품새 선수의 학교급과 수준에 따른 체력, 무산소성 능력, 슬관절 등속성 근기능 및 고유수용성감각의 비교</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uploaded_pdf</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">슬관절 등속성 근력 및 근지구력에서 학교급과 수준에 따른 차이를 분석함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated_v68_added_from_uploaded_literature</isp:note>
    <rdfs:label xml:lang="en">poomsae lower limb strength profile identification</rdfs:label>
    <rdfs:comment xml:lang="ko">품새 선수의 하지근기능 특성을 평가하여 훈련 방향을 설정하는 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">poomsae lower limb strength profile identification</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">품새 하지근기능 특성 식별</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__equestrian_animal_welfare_improvement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#system_level_outcome"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__equestrian_animal_welfare_improvement</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">승마 동물복지 개선</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equestrian animal welfare improvement</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">원헬스(One Health) 관점에서 승마 산업을 위한 ‘관련 법’ 탐색</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">승용마 사육환경 개선과 말의 동물복지 강화를 법제 개선 방향으로 제시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Added in v52 from uploaded academic literature; class assignment limited to directly evidenced entities.</isp:note>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <rdfs:label xml:lang="en">Equestrian animal welfare improvement</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Equestrian animal welfare improvement in the outcome dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Equestrian animal welfare improvement</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">승마 동물복지 개선</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#anti_doping_program">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Anti-doping program</rdfs:label>
    <rdfs:comment xml:lang="en">A program designed to prevent, detect, or educate about doping in sport.</rdfs:comment>
