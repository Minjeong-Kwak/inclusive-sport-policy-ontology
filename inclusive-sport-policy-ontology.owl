  <rdf:Description rdf:about="#target_group__children_adolescents_pandemic_pa_decline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#youth"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_group__children_adolescents_pandemic_pa_decline</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">팬데믹 신체활동 감소 어린이·청소년</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Children and adolescents with pandemic-related physical activity decline</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Global Perspective on COVID-19 and Decreased Physical Activity in Children and Adolescents</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">학술논문</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COVID-19 기간 어린이·청소년의 신체활동 감소와 좌식시간 증가가 글로벌 문제로 제시됨</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">팬데믹으로 신체활동 감소와 좌식행동 증가를 경험한 어린이·청소년 집단임</isp:definition_text>
    <rdfs:label xml:lang="en">Children and adolescents with pandemic-related physical activity decline</rdfs:label>
    <rdfs:comment xml:lang="ko">팬데믹으로 신체활동 감소와 좌식행동 증가를 경험한 어린이·청소년 집단임</rdfs:comment>
    <skos:prefLabel xml:lang="en">Children and adolescents with pandemic-related physical activity decline</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">팬데믹 신체활동 감소 어린이·청소년</skos:prefLabel>
  </rdf:Description>
