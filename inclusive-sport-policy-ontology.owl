    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">의왕시 내 야구장 부재가 시설 규모 부족 인식과 연결됨</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">curated_v66_added_from_uploaded_literature</isp:note>
    <rdfs:label xml:lang="en">Local baseball field shortage issue</rdfs:label>
