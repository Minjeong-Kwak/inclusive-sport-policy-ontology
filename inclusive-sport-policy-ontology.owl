    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Particulate matter risk assessment protocol for school PE</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동 중 미세먼지 과흡입 생체 실험모델 고안</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</isp:source_year>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동 중 미세먼지 과흡입에 따른 생체 실험모델인 미세먼지 운동 챔버를 구축하고, 학교체육 시행 기준의 과학적 근거 제공 가능성을 제시함.</isp:definition_text>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">운동 중 미세먼지 과흡입에 따른 생체 실험모델인 미세먼지 운동 챔버를 구축하고, 학교체육 시행 기준의 과학적 근거 제공 가능성을 제시함.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Instance added from uploaded literature after topic-fit screening for inclusive sport participation policy ontology.</isp:note>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:targets_target_group rdf:resource="#target_group__students_outdoor_pe_particulate_matter_exposure"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__particulate_matter_exercise_chamber_model"/>
    <isp:produces_outcome rdf:resource="#outcome__school_pe_particulate_matter_guideline_evidence_support"/>
    <rdfs:label xml:lang="en">Particulate matter risk assessment protocol for school PE</rdfs:label>
    <rdfs:comment xml:lang="ko">운동 중 미세먼지 과흡입에 따른 생체 실험모델인 미세먼지 운동 챔버를 구축하고, 학교체육 시행 기준의 과학적 근거 제공 가능성을 제시함.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Particulate matter risk assessment protocol for school PE</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">미세먼지 학교체육 위험평가 프로토콜</skos:prefLabel>
