    <rdfs:label xml:lang="en">regional youth athlete talent pool</rdfs:label>
    <rdfs:comment xml:lang="ko">학령인구 감소로 선수 수급이 어려워진 지방의 유소년·청소년 잠재 우수선수 집단.</rdfs:comment>
    <skos:prefLabel xml:lang="en">regional youth athlete talent pool</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">지방 유소년 우수선수 잠재집단</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#target_group__elite_athletes_positive_psych_capital">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#target_group"/>
