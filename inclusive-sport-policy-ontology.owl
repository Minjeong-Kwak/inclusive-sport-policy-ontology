  <rdf:Description rdf:about="#outcome__elderly_disability_quality_of_life_improvement_remote_exercise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#well_being_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__elderly_disability_quality_of_life_improvement_remote_exercise</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애노인 삶의 질 향상</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quality-of-life improvement in elderly persons with disabilities</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">원격운동 프로그램 참여가 장애노인의 삶의 질에 긍정적 영향을 미친 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간 원격운동 프로그램이 장애노인의 삶의 질에 미치는 효과</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asian Journal of Physical Education and Sport Science</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">장애노인 25명을 대상으로 원격운동 프로그램 참여군 12명과 비참여군 13명을 구분하고, 참여군은 12주간 주 2회 비대면 운동재활 프로그램에 참여하였다. 신체건강의 피로와 통증, 정신건강의 불안과 우울, 사회건강의 사회생활 변인에서 긍정적 효과가 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">Quality-of-life improvement in elderly persons with disabilities</rdfs:label>
    <rdfs:comment xml:lang="ko">원격운동 프로그램 참여가 장애노인의 삶의 질에 긍정적 영향을 미친 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Quality-of-life improvement in elderly persons with disabilities</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">장애노인 삶의 질 향상</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#outcome__figure_skating_injury_risk_reduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__figure_skating_injury_risk_reduction</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">피겨스케이팅 부상위험 감소</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">figure skating injury risk reduction</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">선수의 부상 위험을 낮추고 안전한 기량 향상을 지원하는 건강 성과.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스케이트 캐나다의 Long Term Development 모델 고찰을 통한 국내 피겨스케이팅 장기 선수 발달 프로그램 운영방안</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">선수들이 부상 위험에서 벗어나 기량 향상에 집중할 환경 개선 필요가 제시됨.</isp:evidence_excerpt>
    <rdfs:label xml:lang="en">figure skating injury risk reduction</rdfs:label>
    <rdfs:comment xml:lang="ko">선수의 부상 위험을 낮추고 안전한 기량 향상을 지원하는 건강 성과.</rdfs:comment>
    <skos:prefLabel xml:lang="en">figure skating injury risk reduction</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">피겨스케이팅 부상위험 감소</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__resistance_training_obese_men_13week">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__resistance_training_obese_men_13week</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">20대 비만 남성 13주 저항성 운동 프로그램</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">13-week resistance training program for obese young men</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">저항성 운동 트레이닝이 20대 비만 남성의 신체구성, 아디포넥틴, C-반응성 단백질 및 호모시스테인에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1RM의 60% 강도로 주 4회, 13주간 저항성 운동 트레이닝을 실시하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-17</isp:last_updated>
    <isp:program_duration_weeks rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</isp:program_duration_weeks>
    <isp:session_frequency_per_week rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</isp:session_frequency_per_week>
    <isp:targets_target_group rdf:resource="#target_group__obese_men_20s_resistance_training"/>
    <isp:delivers_sport_activity rdf:resource="#sport_activity__resistance_training_obesity_management"/>
    <isp:is_delivered_in_context rdf:resource="#participation_context__young_men_obesity_training_context"/>
    <isp:produces_outcome rdf:resource="#outcome__obese_men_weight_bmi_bodyfat_reduction"/>
    <isp:produces_outcome rdf:resource="#outcome__obese_men_homocysteine_reduction"/>
    <isp:produces_outcome rdf:resource="#outcome__obese_men_body_composition_improvement"/>
    <rdfs:label xml:lang="en">13-week resistance training program for obese young men</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing 13-week resistance training program for obese young men in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">13-week resistance training program for obese young men</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">20대 비만 남성 13주 저항성 운동 프로그램</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__obese_men_20s_resistance_training"/>
  </rdf:Description>
