  <rdf:Description rdf:about="#program__anabolic_steroid_neuropsychological_risk_prevention_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__anabolic_steroid_neuropsychological_risk_prevention_education</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">단백동화스테로이드 신경심리 위험 예방교육</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anabolic steroid neuropsychological risk prevention education</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">단백동화스테로이드 사용의 정서·신경생리 위험을 예방하기 위한 교육 프로그램</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">습관적 단백동화스테로이드 사용에 따른 신경심리학적 정서와 운동 심상 시 대뇌 감각운동영역의 활성화 변화</isp:source_title>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">단백동화스테로이드 사용은 부정적 정서 형성과 운동심상 시 감각운동영역 활성 변화와 관련될 수 있음</isp:evidence_excerpt>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2022</isp:source_year>
    <isp:targets_target_group rdf:resource="#target_group__habitual_anabolic_steroid_users_exercise_context"/>
    <isp:utilizes_support_resource rdf:resource="#support_resource__anabolic_steroid_neuropsychological_risk_material"/>
    <isp:produces_outcome rdf:resource="#outcome__anabolic_steroid_neuropsychological_risk_awareness"/>
    <rdfs:label xml:lang="en">Anabolic steroid neuropsychological risk prevention education</rdfs:label>
    <rdfs:comment xml:lang="ko">단백동화스테로이드 사용의 정서·신경생리 위험을 예방하기 위한 교육 프로그램</rdfs:comment>
    <skos:prefLabel xml:lang="en">Anabolic steroid neuropsychological risk prevention education</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">단백동화스테로이드 신경심리 위험 예방교육</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__habitual_anabolic_steroid_users_exercise_context"/>
  </rdf:Description>
  <rdf:Description rdf:about="#support_resource__pyeongchang_paralympic_accessible_facilities">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#accessible_facility"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__pyeongchang_paralympic_accessible_facilities</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">평창동계패럴림픽 장애인체육시설 활용 자원</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PyeongChang Paralympic accessible facility resource</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">평창동계패럴림픽 이후 장애인체육 발전과 레거시 계승을 위해 활용될 수 있는 패럴림픽 체육시설 자원</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018 평창동계패럴림픽 레거시 및 결산 고찰</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">한국특수체육학회지</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018 평창동계패럴림픽의 레거시를 스포츠, 사회, 환경, 도시, 경제에 더해 문화, ICT, 평화 레거시로 고찰하고, 홍보, 예산, 참가자, 관람객, 자원봉사자, 등급분류 제로정책, 체육시설 활용, 수송 및 접근성 극대화, 도핑테스트, 방송·취재 환경, 첨단 ICT 패럴림픽 운영을 결산하였다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct_documentary</isp:evidence_strength_level>
    <isp:supports_program rdf:resource="#program__pyeongchang_paralympic_accessibility_support"/>
    <rdfs:label xml:lang="en">PyeongChang Paralympic accessible facility resource</rdfs:label>
    <rdfs:comment xml:lang="ko">평창동계패럴림픽 이후 장애인체육 발전과 레거시 계승을 위해 활용될 수 있는 패럴림픽 체육시설 자원</rdfs:comment>
    <skos:prefLabel xml:lang="en">PyeongChang Paralympic accessible facility resource</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">평창동계패럴림픽 장애인체육시설 활용 자원</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#policy__sports_basic_act_legislative_model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#law_regulation"/>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠기본법 제정 모델</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sports basic act legislative model</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠 전반을 종합적으로 규율하는 기본법 체계를 통해 스포츠권과 진흥정책을 정비하는 법제 모델.</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">일본 스포츠 진흥정책의 시사점</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2011</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">법학논총</isp:source_publisher>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">현행 국민체육진흥법을 대체할 스포츠기본법 제정 필요가 제시되었다.</isp:evidence_excerpt>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">policy__sports_basic_act_legislative_model</isp:entity_id>
    <rdfs:label xml:lang="en">sports basic act legislative model</rdfs:label>
    <rdfs:comment xml:lang="ko">스포츠 전반을 종합적으로 규율하는 기본법 체계를 통해 스포츠권과 진흥정책을 정비하는 법제 모델.</rdfs:comment>
    <skos:prefLabel xml:lang="en">sports basic act legislative model</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠기본법 제정 모델</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#program__sport_organization_commitment_management">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
