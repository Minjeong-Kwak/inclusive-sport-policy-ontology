  <rdf:Description rdf:about="#outcome__dance_sports_antioxidant_enzyme_change_obese_middle_aged_women">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#physical_health_improvement"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__dance_sports_antioxidant_enzyme_change_obese_middle_aged_women</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">댄스스포츠 항산화 효소 활성 변화</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Antioxidant enzyme activity change after dance sports</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주 댄스스포츠 운동 후 항산화 효소 활성 변화가 보고된 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">12주간의 댄스스포츠 운동이 비만 중년여성의 신체구성 및 항산화 효소 활성에 미치는 영향</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2008</isp:source_year>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Korean Journal of Exercise Nutrition</isp:source_publisher>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">비만 중년여성 20명을 대상으로 실험군과 통제군을 구성하고 12주간 댄스스포츠 프로그램을 적용하였다. 실험군에서 체지방과 체지방률 감소, SOD와 CAT 등 항산화 효소 활성 변화가 보고되었다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <rdfs:label xml:lang="en">Antioxidant enzyme activity change after dance sports</rdfs:label>
    <rdfs:comment xml:lang="ko">12주 댄스스포츠 운동 후 항산화 효소 활성 변화가 보고된 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Antioxidant enzyme activity change after dance sports</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">댄스스포츠 항산화 효소 활성 변화</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#law_regulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#policy_instrument"/>
    <rdfs:label xml:lang="en">Law Regulation</rdfs:label>
    <rdfs:comment xml:lang="en">A policy instrument class representing law regulation in the policy structure of inclusive sport participation.</rdfs:comment>
    <skos:definition xml:lang="en">A policy instrument class representing law regulation in the policy structure of inclusive sport participation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="#program__wearable_based_physical_activity_monitoring">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#online_remote_program"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">program__wearable_based_physical_activity_monitoring</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">웨어러블 기반 신체활동 모니터링</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wearable-based physical activity monitoring</isp:pref_label_en>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">웨어러블 스마트기기의 개발 동향과 전망</isp:source_title>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2016</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">academic_article</isp:source_type>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">웨어러블 기기의 항시성, 센서 기반 입력, 생체정보 수집 특성은 신체활동 모니터링 자원으로 활용 가능하다.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Added in v52 from uploaded academic literature; class assignment limited to directly evidenced entities.</isp:note>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</isp:last_updated>
    <isp:utilizes_support_resource rdf:resource="#support_resource__wearable_smart_device"/>
    <isp:produces_outcome rdf:resource="#outcome__physical_activity_self_monitoring_improvement"/>
    <rdfs:label xml:lang="en">Wearable-based physical activity monitoring</rdfs:label>
    <rdfs:comment xml:lang="en">Named individual representing Wearable-based physical activity monitoring in the program dimension of the Inclusive Sport Participation Policy Ontology.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Wearable-based physical activity monitoring</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">웨어러블 기반 신체활동 모니터링</skos:prefLabel>
  </rdf:Description>
