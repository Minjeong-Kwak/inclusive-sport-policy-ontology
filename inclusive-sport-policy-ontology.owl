  <rdf:Description rdf:about="#support_resource__baseball_club_communication_channels">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#information_resource"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">support_resource__baseball_club_communication_channels</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">야구동호회 커뮤니케이션 채널</isp:pref_label_ko>
