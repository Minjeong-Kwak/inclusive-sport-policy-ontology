  <rdf:Description rdf:about="#participation_context__adult_daily_pa_health_monitoring_context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#policy_exposure_context"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">participation_context__adult_daily_pa_health_monitoring_context</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">성인 일상 신체활동 건강 모니터링 맥락</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adult daily physical activity health monitoring context</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">일상 신체활동 수준이 생활습관병 관련 건강 요인과 함께 모니터링되는 정책 분석 맥락</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Association of daily physical activity level with health-related factors by gender and age-specific differences among Korean adults based on the sixth (2014-2015) Korea National Health and Nutrition Examination Survey</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Journal of Exercise Nutrition and Biochemistry</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.20463/jenb.2017.0026</isp:source_url>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">30-31</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Using KNHANES VI data from 6,457 Korean adults aged 19-64 years, the study examined associations between daily physical activity level and health-related factors by gender and age.</isp:evidence_excerpt>
    <isp:evidence_strength_level rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct</isp:evidence_strength_level>
    <isp:conditions_outcome rdf:resource="#outcome__health_related_factor_monitoring_by_pa_level"/>
    <rdfs:label xml:lang="en">Adult daily physical activity health monitoring context</rdfs:label>
    <rdfs:comment xml:lang="ko">일상 신체활동 수준이 생활습관병 관련 건강 요인과 함께 모니터링되는 정책 분석 맥락</rdfs:comment>
    <skos:prefLabel xml:lang="en">Adult daily physical activity health monitoring context</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">성인 일상 신체활동 건강 모니터링 맥락</skos:prefLabel>
  </rdf:Description>
