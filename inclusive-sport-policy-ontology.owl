  <rdf:Description rdf:about="#outcome__sports_nutrition_expert_capacity_strengthening">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#intersectoral_linkage_strengthening"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outcome__sports_nutrition_expert_capacity_strengthening</isp:entity_id>
    <isp:pref_label_ko rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠영양 전문가 역량 및 학술연계 강화</isp:pref_label_ko>
    <isp:pref_label_en rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strengthened sports nutrition expert capacity and academic linkage</isp:pref_label_en>
    <isp:definition_text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">스포츠영양 전문가 양성, 연구자 네트워킹, 학술교류 확대를 통해 현장 지원 역량이 강화되는 시스템 수준 성과</isp:definition_text>
    <isp:source_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An academic cooperation between the Japan Sports Nutrition Association (JSNA) and the Korean Society for Exercise Nutrition (KSEN)</isp:source_title>
    <isp:source_publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Activity and Nutrition</isp:source_publisher>
    <isp:source_year rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</isp:source_year>
    <isp:source_type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">journal_article</isp:source_type>
    <isp:source_page rdf:datatype="http://www.w3.org/2001/XMLSchema#string">20-22</isp:source_page>
    <isp:evidence_excerpt rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The JSNA provides evidence-based sports nutrition information, networking, and training opportunities; JSNA and KSEN exchanged an MoU in 2018 and organized academic exchange events based on the MoU.</isp:evidence_excerpt>
    <isp:last_updated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</isp:last_updated>
    <isp:is_currently_active rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isp:is_currently_active>
    <rdfs:label xml:lang="en">Strengthened sports nutrition expert capacity and academic linkage</rdfs:label>
    <rdfs:comment xml:lang="ko">스포츠영양 전문가 양성, 연구자 네트워킹, 학술교류 확대를 통해 현장 지원 역량이 강화되는 시스템 수준 성과</rdfs:comment>
    <skos:prefLabel xml:lang="en">Strengthened sports nutrition expert capacity and academic linkage</skos:prefLabel>
    <skos:prefLabel xml:lang="ko">스포츠영양 전문가 역량 및 학술연계 강화</skos:prefLabel>
  </rdf:Description>
