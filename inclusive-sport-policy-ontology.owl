  <rdf:Description rdf:about="#sport_activity__ai_elementary_physical_education">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="#elementary_school_sport"/>
    <isp:entity_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sport_activity__ai_elementary_physical_education</isp:entity_id>
