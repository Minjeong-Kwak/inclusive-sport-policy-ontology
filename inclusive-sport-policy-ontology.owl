    <skos:prefLabel xml:lang="ko">여자 청소년 건강위험행동 군집 맞춤 중재</skos:prefLabel>
    <isp:has_target_group_anchor rdf:resource="#target_group__female_adolescents_health_risk_behavior_clusters"/>
